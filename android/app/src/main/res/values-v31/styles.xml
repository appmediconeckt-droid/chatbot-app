<resources>

    <!-- Android 12+ system splash screen. Without these the platform picks the
         launcher icon on windowBackground, which resolved to dark grey under
         the DayNight parent theme. -->
    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <!-- windowBackground is deliberately NOT overridden here: it inherits the
             splash_screen layer-list, which keeps the same centred mark on screen
             between the system splash dismissing and React Native's first frame.
             A flat colour there left a blank white gap for as long as the JS
             bundle took to load.

             No windowSplashScreenBrandingImage either - the platform already
             draws the mark in the centre, so a wordmark at the bottom showed the
             tree twice. And there is no android:postSplashScreenTheme attribute;
             that belongs to the androidx core-splashscreen library. -->
    </style>

</resources>
