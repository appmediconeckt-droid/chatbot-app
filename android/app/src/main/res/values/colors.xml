<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plate behind the adaptive launcher icon's tree foreground. White keeps
         the mark's teal/blue/purple readable at small sizes. -->
    <color name="ic_launcher_background">#FFFFFF</color>

    <!-- Splash plate. Fixed light value on purpose: AppTheme is a DayNight
         theme, so an unset splash background can resolve dark in dark mode. -->
    <color name="splash_background">#FFFFFF</color>

    <!-- Tint for the status-bar notification icon (brand teal). -->
    <color name="notification_color">#0F8A9D</color>
</resources>
