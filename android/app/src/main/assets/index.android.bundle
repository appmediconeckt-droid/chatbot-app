47\u0928\u094d\u0926\u094d\u0930 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0926\u093e\u092f\u093e\u0901 Humaeli \u0938\u0941\u0935\u093f\u0927\u093e\u092e\u093e \u091c\u093e\u0928\u0941\u0939\u094b\u0938\u094d, \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u0939\u0930\u0942\u0915\u094b \u0928\u093f\u0935\u093e\u0930\u0923 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u090f\u092a \u092c\u093e\u0939\u093f\u0930\u0915\u094b \u0924\u0924\u094d\u0915\u093e\u0932 \u092e\u0926\u094d\u0926\u0924\u0932\u093e\u0908 \u0915\u0939\u093f\u0932\u0947 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0928\u0947 \u092d\u0928\u0947\u0930 \u092c\u0941\u091d\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",aiWellnessChat:"\u090f\u0906\u0908 \u0915\u0932\u094d\u092f\u093e\u0923 \u091a\u094d\u092f\u093e\u091f",aiWellnessDesc:"\u092e\u093e\u0928\u0938\u093f\u0915-\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u0939\u0930\u0942 \u0938\u094b\u0927\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0906\u0935\u093e\u091c \u0907\u0928\u092a\u0941\u091f \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0926\u094d\u0930\u0941\u0924 \u091c\u0935\u093e\u092b\u0939\u0930\u0942 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u0921\u094d\u092f\u093e\u0938\u092c\u094b\u0930\u094d\u0921\u092c\u093e\u091f \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092d\u0930\u094d\u0916\u0930\ufffd\ufffd\ufffd\u094b AI \u091a\u094d\u092f\u093e\u091f \u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",aiWellnessAction:"AI \u091a\u094d\u092f\u093e\u091f \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d",counselorSupport:"\u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u092e\u0930\u094d\u0925\u0928",counselorDesc:"\u0939\u0947\u0930\u091a\u093e\u0939 \u0938\u0941\u0930\u0941 \u0917\u0930\u094d\u0928\u0941 \u0905\u0918\u093f \u0928\u093e\u092e, \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e, \u092d\u093e\u0937\u093e, \u0938\u094d\u0925\u093e\u0928, \u092e\u0942\u0932\u094d\u092f\u093e\u0919\u094d\u0915\u0928, \u0930 \u0905\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942 \u092c\u094d\u0930\u093e\u0909\u091c \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",counselorAction:"\u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u094d\u0928\u0941\u0939\u094b\u0938\u094d",appointments:"\u0928\u093f\u092f\u0941\u0915\u094d\u0924\u093f\u0939\u0930\u0942",appointmentsDesc:"\u0906\u0917\u093e\u092e\u0940 \u0930 \u0935\u093f\u0917\u0924\u0915\u093e \u092d\u0947\u091f\u0918\u093e\u091f\u0939\u0930\u0942 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0901\u091a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0938\u0901\u0917 \u092c\u0941\u0915 \u0938\u0924\u094d\u0930\u0939\u0930\u0942\u0964",appointmentsAction:"\u092d\u0947\u091f\u0918\u093e\u091f\u0939\u0930\u0942 \u0939\u0947\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",walletPayments:"\u0935\u093e\u0932\u0947\u091f \u0930 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940\u0939\u0930\u0942",walletDesc:"\u092a\u0948\u0938\u093e \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0932\u0947\u0928\u0926\u0947\u0928\u0915\u094b \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0935\u093e\u0932\u0947\u091f \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u0939\u0930\u0942 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u092a\u094d\u0930\u0936\u094d\u0928\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f \u0938\u092e\u0930\u094d\u0925\u0928\u0932\u093e\u0908 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",walletAction:"\u0935\u093e\u0932\u0947\u091f \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d",beforeContact:"\u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0938\u092e\u0930\u094d\u0925\u0928\u0932\u093e\u0908 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0928\u0941 \u0905\u0918\u093f",checklist1:"\u0924\u092a\u093e\u0907\u0901\u0915\u094b \u0907\u0928\u094d\u091f\u0930\u0928\u0947\u091f \u091c\u0921\u093e\u0928 \u092a\u0941\u0937\u094d\u091f\u093f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0930 \u0932\u094b\u0921\u093f\u0919 \u0938\u092e\u0938\u094d\u092f\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0917\u0930\u094d\u0928\u0941 \u0905\u0918\u093f \u090f\u092a \u0930\u093f\u092b\u094d\u0930\u0947\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklist2:"\u0938\u092e\u0930\u094d\u0925\u0928\u0932\u093e\u0908 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0926\u093e \u092a\u091b\u093f\u0932\u094d\u0932\u094b \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u0938\u091f, \u0938\u0939\u0940 \u0938\u092e\u092f \u0930 \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u0915\u094b \u0928\u093e\u092e \u0924\u092f\u093e\u0930 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklist3:"\u0915\u094d\u092f\u093e\u092e\u0947\u0930\u093e, \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u094b\u0928, \u0938\u0942\u091a\u0928\u093e \u0930 \u0938\u094d\u0925\u093e\u0928 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f, \u092a\u0939\u093f\u0932\u0947 \u092f\u0928\u094d\u0924\u094d\u0930 \u090f\u092a \u0905\u0928\u0941\u092e\u0924\u093f\u0939\u0930\u0942 \u091c\u093e\u0901\u091a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklist4:"\u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u092e\u0941\u0926\u094d\u0926\u093e\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f, \u090f\u092a\u092e\u093e \u0926\u0947\u0916\u093e\u0907\u090f\u0915\u094b \u092e\u093f\u0924\u093f, \u0930\u0915\u092e, \u0932\u0947\u0928\u0926\u0947\u0928 \u0938\u094d\u0925\u093f\u0924\u093f, \u0930 \u0935\u093e\u0932\u0947\u091f \u092c\u094d\u092f\u093e\u0932\u0947\u0928\u094d\u0938 \u0938\u092e\u093e\u0935\u0947\u0936 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",commonIssues:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u0939\u0930\u0942",aiChatNotReply:"AI \u091a\u094d\u092f\u093e\u091f\u0932\u0947 \u091c\u0935\u093e\u092b \u0926\u093f\u0907\u0930\u0939\u0947\u0915\u094b \u091b\u0948\u0928",aiChatNotReplyDesc:"\u0906\u092b\u094d\u0928\u094b \u0907\u0928\u094d\u091f\u0930\u0928\u0947\u091f \u091c\u0921\u093e\u0928 \u091c\u093e\u0901\u091a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u091b\u094b\u091f\u094b \u0938\u0928\u094d\u0926\u0947\u0936 \u092a\u0920\u093e\u0909\u0928\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u0921\u094d\u092f\u093e\u0938\u092c\u094b\u0930\u094d\u0921\u092c\u093e\u091f \u090f\u0906\u0908 \u091a\u094d\u092f\u093e\u091f \u092a\u0941\u0928: \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u092f\u0926\u093f \u092f\u094b \u0905\u091d\u0948 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b \u092d\u0928\u0947, \u0938\u092e\u0930\u094d\u0925\u0928\u0915\u094b \u0938\u093e\u0925 \u0938\u091f\u0940\u0915 \u0924\u094d\u0930\u0941\u091f\u093f \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u0938\u091f \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",counselorChatNotOpen:"\u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u091a\u094d\u092f\u093e\u091f \u0916\u0941\u0932\u093f\u0930\u0939\u0947\u0915\u094b \u091b\u0948\u0928",counselorChatNotOpenDesc:"\u0915\u093e\u0909\u0928\u094d\u0938\u093f\u0932\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u091b\u0928\u094c\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u0941\u0928\u0915\u094b \u0932\u093e\u0917\u093f \u092a\u0930\u094d\u0916\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0905\u0935\u0938\u094d\u0925\u093f\u0924 \u091a\u094d\u092f\u093e\u091f\u0939\u0930\u0942 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u091a\u094d\u092f\u093e\u091f \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u092e\u093e \u0926\u0947\u0916\u093e \u092a\u0930\u094d\u0926\u091b\u0964",callNotConnecting:"\u0915\u0932 \u091c\u0921\u093e\u0928 \u092d\u0907\u0930\u0939\u0947\u0915\u094b \u091b\u0948\u0928",callNotConnectingDesc:"\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0915\u093f \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u091a\u094d\u092f\u093e\u091f/\u0938\u0924\u094d\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0917\u0930\u0947\u0915\u094b \u091b, \u0926\u0941\u092c\u0948 \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0939\u0930\u0942 \u0905\u0928\u0932\u093e\u0907\u0928 \u091b\u0928\u094d, \u0930 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u094b\u0928/\u0915\u094d\u092f\u093e\u092e\u0947\u0930\u093e \u0905\u0928\u0941\u092e\u0924\u093f\u0939\u0930\u0942 \u0905\u0928\u0941\u092e\u0924\u093f \u091b\u0928\u094d\u0964",walletPaymentIssue:"\u0935\u093e\u0932\u0947\u091f \u0935\u093e \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u092e\u0941\u0926\u094d\u0926\u093e",walletPaymentIssueDesc:"\u092a\u091b\u093f\u0932\u094d\u0932\u094b \u0932\u0947\u0928\u0926\u0947\u0928\u0915\u094b \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0930\u094d\u0928 \u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0935\u093e\u0932\u0947\u091f \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0938\u0939\u093e\u092f\u0924\u093e\u0932\u093e\u0908 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0926\u093e \u092e\u093f\u0924\u093f, \u0930\u0915\u092e \u0930 \u0915\u093e\u0930\u094b\u092c\u093e\u0930\u0915\u094b \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u093e\u091d\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",languageWrongTitle:"\u092d\u093e\u0937\u093e \u0935\u093e \u0905\u0928\u0941\u0935\u093e\u0926 \u0917\u0932\u0924 \u0926\u0947\u0916\u093f\u0928\u094d\u091b",languageWrongDesc:"\u0921\u094d\u092f\u093e\u0938\u092c\u094b\u0930\u094d\u0921/\u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942\u092c\u093e\u091f \u092d\u093e\u0937\u093e \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0915\u0947\u0939\u0940 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0935\u093e \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u092a\u094d\u0930\u0926\u093e\u092f\u0915\u0932\u0947 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u0947\u0915\u094b \u092d\u093e\u0937\u093e\u092e\u093e \u0930\u0939\u0928 \u0938\u0915\u094d\u091b\u0928\u094d\u0964",needMoreHelp:"\u0925\u092a \u092e\u0926\u094d\u0926\u0924 \u091a\u093e\u0939\u093f\u0928\u094d\u091b?",needMoreHelpDesc:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932/\u0938\u0947\u091f\u093f\u0919\u094d\u0939\u0930\u0942\u092c\u093e\u091f \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u0905\u092a\u0921\u0947\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0935\u093e \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u0938\u091f\u0939\u0930\u0942, \u090f\u092a \u0938\u0902\u0938\u094d\u0915\u0930\u0923, \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0907\u092e\u0947\u0932/\u092b\u094b\u0928, \u0930 \u0938\u092e\u0938\u094d\u092f\u093e \u092d\u090f\u0915\u094b \u0938\u0939\u0940 \u0938\u092e\u092f\u0915\u094b \u0938\u093e\u0925 \u0907\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928\u0964 \u092d\u093e\u0930\u0924\u092e\u093e \u0938\u0902\u0915\u091f \u0938\u0939\u093e\u092f\u0924\u093e\u0915\u094b \u0932\u093e\u0917\u093f, \u096f\u0967\u096b\u0968\u096f\u096e\u096d\u096e\u0968\u0967 \u0935\u093e \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0947\u0935\u093e\u0939\u0930\u0942\u092e\u093e \u0915\u0932 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",myProfile:"\u092e\u0947\u0930\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",settings:"\u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942",emailSupport:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928"},privacyPage:{title:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f",centerTitle:"Humaeli \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0928\u094d\u0926\u094d\u0930",centerDesc:"\u092f\u094b \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0932\u0947 Humaeli \u0932\u0947 \u092f\u094b \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a \u092d\u093f\u0924\u094d\u0930 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, \u091a\u094d\u092f\u093e\u091f, \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f, \u0935\u093e\u0932\u0947\u091f, \u0915\u0932, \u0938\u094d\u0925\u093e\u0928, \u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e \u0915\u0938\u0930\u0940 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u091b \u092d\u0928\u0947\u0930 \u092c\u0924\u093e\u0909\u0901\u091b\u0964",otpProtected:"OTP \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924",otpProtectedDesc:"\u0907\u092e\u0947\u0932 \u0930 \u092b\u094b\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928",anonymousCare:"\u092c\u0947\u0928\u093e\u092e\u0940 \u0939\u0947\u0930\u091a\u093e\u0939 \u092a\u0939\u093f\u091a\u093e\u0928",anonCareDesc:"\u091c\u0939\u093e\u0901 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0932\u093e\u0908 \u0926\u0947\u0916\u093e\u0907\u092f\u094b",sensitiveAreas:"\u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0939\u0930\u0942",sensitiveAreasDesc:"\u091a\u094d\u092f\u093e\u091f, \u0915\u0932, \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f, \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",dataUsedTitle:"\u090f\u092a\u092e\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u090f\u0915\u094b \u0921\u093e\u091f\u093e",profileHealth:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0930 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0935\u093f\u0935\u0930\u0923",profileHealthDesc:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0928\u093e\u092e, \u092c\u0947\u0928\u093e\u092e\u0940 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0928\u093e\u092e, \u0909\u092e\u0947\u0930, \u0932\u093f\u0919\u094d\u0917, \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942, \u092b\u094b\u091f\u094b/\u0905\u0935\u0924\u093e\u0930, \u0920\u0947\u0917\u093e\u0928\u093e, \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u092e\u094d\u092a\u0930\u094d\u0915, \u0906\u0927\u093e\u0930\u092d\u0942\u0924 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942, \u0930 \u092c\u0940\u092e\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0939\u0930\u0942 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092c\u093f\u0930\u093e\u092e\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u093e\u092f\u092e \u0930\u093e\u0916\u094d\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",aiConversations:"\u090f\u0906\u0908 \u091a\u094d\u092f\u093e\u091f \u0930 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940",aiConversationsDesc:"\u0938\u0928\u094d\u0926\u0947\u0936\u0939\u0930\u0942, \u0926\u094d\u0930\u0941\u0924 \u091c\u0935\u093e\u092b\u0939\u0930\u0942, \u091a\u094d\u092f\u093e\u091f \u0938\u094d\u0925\u093f\u0924\u093f, \u0938\u0902\u0932\u0917\u094d\u0928\u0915\u0939\u0930\u0942, \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u094d\u092f\u093e\u091f \u0938\u0924\u094d\u0930\u0939\u0930\u0942, \u0930 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940\u0939\u0930\u0942 \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u0928, \u0907\u0924\u093f\u0939\u093e\u0938 \u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928, \u0930 \u092e\u0942\u0932\u094d\u092f\u093e\u0919\u094d\u0915\u0928 \u092a\u094d\u0930\u092e\u094d\u092a\u094d\u091f\u0939\u0930\u0942 \u0938\u092e\u0930\u094d\u0925\u0928 \u0917\u0930\u094d\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",appointments:"\u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u0930 \u0938\u0924\u094d\u0930\u0939\u0930\u0942",appointmentsDesc:"\u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u092e\u093f\u0924\u093f, \u0938\u092e\u092f, \u0915\u093e\u0930\u0923/\u0928\u094b\u091f\u0939\u0930\u0942, \u0938\u094d\u0925\u093f\u0924\u093f, \u0924\u094b\u0915\u093f\u090f\u0915\u094b \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930, \u0915\u0932 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e, \u0930 \u0938\u0924\u094d\u0930 \u0907\u0924\u093f\u0939\u093e\u0938\u0932\u0947 \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0939\u0930\u0942 \u0930 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0932\u093e\u0908 \u0939\u0947\u0930\u091a\u093e\u0939 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928 \u0917\u0930\u094d\u0928 \u092e\u0926\u094d\u0926\u0924 \u0917\u0930\u094d\u0926\u091b\u0964",wallet:"\u0935\u093e\u0932\u0947\u091f \u0930 \u0932\u0947\u0928\u0926\u0947\u0928",walletDesc:"\u0935\u093e\u0932\u0947\u091f \u092c\u094d\u092f\u093e\u0932\u0947\u0928\u094d\u0938, \u091f\u092a-\u0905\u092a\u0939\u0930\u0942, \u0932\u0947\u0928\u0926\u0947\u0928 \u0930\u0947\u0915\u0930\ufffd\ufffd\ufffd\u0921\u0939\u0930\u0942, \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u0939\u0930\u0942, \u0930 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u093f\u0924 \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0928\u094d\u0926\u0930\u094d\u092d \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u091f\u094d\u0930\u094d\u092f\u093e\u0915\u093f\u0919\u0915\u094b \u0932\u093e\u0917\u093f \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",location:"\u0938\u094d\u0925\u093e\u0928 \u0930 \u0909\u092a\u0915\u0930\u0923 \u0938\u0928\u094d\u0926\u0930\u094d\u092d",locationDesc:"\u0938\u0924\u094d\u0930\u0939\u0930\u0942 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0917\u0930\u094d\u0928, \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0932\u093e\u0908 \u0938\u092e\u0930\u094d\u0925\u0928 \u0917\u0930\u094d\u0928, \u0930 \u0938\u094d\u0925\u093e\u0928-\u0938\u091a\u0947\u0924 \u0939\u0947\u0930\u091a\u093e\u0939 \u0938\u0941\u0935\u093f\u0927\u093e\u0939\u0930\u0942 \u0938\u0941\u0927\u093e\u0930 \u0917\u0930\u094d\u0928 \u0938\u093e\u0907\u0928\u0905\u092a, \u0932\u0917\u0907\u0928 \u0935\u093e \u092e\u094d\u092f\u093e\u0928\u0941\u0905\u0932 \u0930\u093f\u092b\u094d\u0930\u0947\u0938\u092e\u093e \u0938\u094d\u0925\u093e\u0928 \u0915\u094d\u092f\u093e\u092a\u094d\u091a\u0930 \u0917\u0930\u094d\u0928 \u0938\u0915\u093f\u0928\u094d\u091b\u0964",security:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0930 \u0916\u093e\u0924\u093e \u092a\u0939\u0941\u0901\u091a",securityDesc:"\u0932\u0917\u0907\u0928 \u091f\u094b\u0915\u0928\u0939\u0930\u0942, \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0915\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u092f\u0915, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u094d\u0925\u093f\u0924\u093f, OTP \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923, \u092d\u0942\u092e\u093f\u0915\u093e, \u0930 \u0916\u093e\u0924\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0930 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0939\u0930\u0942 \u0905\u0932\u0917 \u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0916\u094d\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",whoCanSee:"\u0915\u0938\u0932\u0947 \u0915\u0947 \u0926\u0947\u0916\u094d\u0928 \u0938\u0915\u094d\u091b",visibleToYou:"\u0924\u092a\u093e\u0908\u0932\u093e\u0908 \u0926\u0947\u0916\u093f\u0928\u0947",visibleDesc:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0921\u094d\u092f\u093e\u0938\u092c\u094b\u0930\u094d\u0921\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, \u090f\u0906\u0908 \u091a\u094d\u092f\u093e\u091f\u0939\u0930\u0942, \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0905\u0928\u094d\u0924\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0939\u0930\u0942, \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f\u0939\u0930\u0942, \u0935\u093e\u0932\u0947\u091f, \u0915\u0932 \u0907\u0924\ufffd\ufffd\ufffd\u0939\u093e\u0938, \u092e\u0942\u0932\u094d\u092f\u093e\u0919\u094d\u0915\u0928 \u092a\u094d\u0930\u092e\u094d\u092a\u094d\u091f\u0939\u0930\u0942, \u0930 \u0938\u094d\u0925\u093e\u0928/\u0905\u092a\u0921\u0947\u091f \u0928\u093f\u092f\u0928\u094d\u0924\u094d\u0930\u0923\u0939\u0930\u0942 \u0926\u0947\u0916\u093e\u0909\u0901\u091b\u0964",sharedForCare:"\u0939\u0947\u0930\u091a\u093e\u0939 \u0915\u094b \u0932\u093e\u0917\u0940 \u0938\u093e\u091d\u093e",sharedDesc:"\u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0932\u0947 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0938\u0924\u094d\u0930\u0939\u0930\u0942, \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f\u0939\u0930\u0942, \u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940\u0939\u0930\u0942 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928 \u0917\u0930\u094d\u0928 \u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0916\u094d\u0928 \u0938\u0915\u094d\u091b\u0928\u094d\u0964 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0920\u093e\u0909\u0901\u092e\u093e \u092c\u0947\u0928\u093e\u092e\u0940 \u092a\u0939\u093f\u091a\u093e\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",protectedAccess:"\u092a\u0939\ufffd\ufffd\ufffd\u0901\u091a \u0928\u093f\u092f\u0928\u094d\u0924\u094d\u0930\u0923\u0939\u0930\u0942 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924",protectedDesc:"\u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0930 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0939\u0930\u0942 \u092d\u0942\u092e\u093f\u0915\u093e, \u0938\u0915\u094d\u0930\u093f\u092f \u0938\u0924\u094d\u0930\u0939\u0930\u0942, OTP \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923, \u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0943\u0924 API \u0905\u0928\u0941\u0930\u094b\u0927\u0939\u0930\u0942\u0926\u094d\u0935\u093e\u0930\u093e \u091b\u0941\u091f\u094d\u092f\u093e\u0907\u090f\u0915\u093e \u091b\u0928\u094d\u0964",checklist:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f",checklistItem1:"\u091c\u092c \u0924\u092a\u093e\u0908\u0902 \u0906\u092b\u094d\u0928\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0928\u093e\u092e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0917\u0930\u094d\u0928 \u091a\u093e\u0939\u0928\u0941\u0939\u0941\u0928\u094d\u0928 \u092d\u0928\u0947 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0905\u0928\u094d\u0924\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f \u0906\u092b\u094d\u0928\u094b \u092c\u0947\u0928\u093e\u092e\u0940 \u0928\u093e\u092e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklistItem2:"\u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0930 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u0938\u0939\u0940 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u092f\u0926\u093f \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0924\u093f\u0928\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u092d\u0930\u094d\u0928\u0947 \u091b\u0928\u094c\u091f \u0917\u0930\u094d\u0928\u0941\u092d\u092f\u094b \u092d\u0928\u0947\u0964",checklistItem3:"\u0915\u0932 \u0917\u0930\u094d\u0928\u0941 \u0905\u0918\u093f \u0938\u094d\u0925\u093e\u0928, \u0915\u094d\u092f\u093e\u092e\u0947\u0930\u093e \u0930 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u094b\u0928\u0915\u093e \u0932\u093e\u0917\u093f \u0909\u092a\u0915\u0930\u0923 \u0905\u0928\u0941\u092e\u0924\u093f\u0939\u0930\u0942 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklistItem4:"\u0932\u0917\u0907\u0928 \u092a\u094d\u0930\u092e\u094d\u092a\u094d\u091f \u091b\u093e\u0921\u093f\u090f\u0915\u094b \u0916\u0923\u094d\u0921\u092e\u093e \u0938\u0947\u091f\u093f\u0919\u094d/\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092c\u093e\u091f \u092e\u094d\u092f\u093e\u0928\u0941\u0905\u0932 \u0930\u0942\u092a\u092e\u093e \u0938\u094d\u0925\u093e\u0928 \u0905\u092a\u0921\u0947\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklistItem5:"\u091a\u094d\u092f\u093e\ufffd\ufffd\ufffd \u0938\u0928\u094d\u0926\u0947\u0936\u0939\u0930\u0942\u092e\u093e OTP, \u092a\u093e\u0938\u0935\u0930\u094d\u0921, \u0935\u093e \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0928\u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",checklistItem6:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0916\u093e\u0924\u093e\u092e\u093e \u092d\u0923\u094d\u0921\u093e\u0930\u0923 \u0917\u0930\u093f\u090f\u0915\u094b \u0921\u093e\u091f\u093e \u0905\u0926\u094d\u092f\u093e\u0935\u0927\u093f\u0915 \u0935\u093e \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0930\u094d\u0928 \u092e\u0947\u0930\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0930 \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",manageData:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0921\u093e\u091f\u093e \u092a\u094d\u0930\u092c\u0928\u094d\u0927 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",securitySettings:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942",aiQuickReplyLow:"\u0915\u092e",aiQuickReplyOkay:"\u0920\u0940\u0915 \u091b",aiQuickReplyGood:"\u0930\u093e\u092e\u094d\u0930\u094b",aiQuickReplyGreat:"\u092e\u0939\u093e\u0928",aiPhotoAttached:"\u092b\u094b\u091f\u094b \u0938\u0902\u0932\u0917\u094d\u0928",aiTryAgain:"\u092b\u0947\u0930\u093f \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",aiVoiceHint:"\u0924\u092a\u093e\u0908\u0902 \u0924\u092f\u093e\u0930 \u0939\u0941\u0901\u0926\u093e \u092c\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u2014 \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u092a\u091c \u0917\u0930\u0947\u092a\u091b\u093f \u092e \u091c\u0935\u093e\u092b \u0926\u093f\u0928\u0947\u091b\u0941\u0964",resetChatTitle:"\u0928\u092f\u093e\u0901 \u091a\u094d\u092f\u093e\u091f \u0938\u0941\u0930\u0941 \u0917\u0930\u094d\u0928\u0947?",resetChatMessage:"\u092f\u0938\u0932\u0947 \u0939\u093e\u0932\u0915\u094b AI \u091a\u094d\u092f\u093e\u091f\u0932\u093e\u0908 \u0916\u093e\u0932\u0940 \u0917\u0930\u094d\u091b \u0930 \u0938\u094d\u0935\u093e\u0917\u0924 \u092e\u0941\u0921 \u0935\u093f\u0915\u0932\u094d\u092a\u0939\u0930\u0942\u0938\u0901\u0917 \u092b\u0947\u0930\u093f \u0938\u0941\u0930\u0941 \u0939\u0941\u0928\u094d\u091b\u0964",startFresh:"\u0924\u093e\u091c\u093e \u0938\u0941\u0930\u0941 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",startingFresh:"\u0938\u0941\u0930\u0941 \u0917\u0930\u094d\u0926\u0948..."},phrases:{p1le0g3x:"\u0905\u091c\u094d\u091e\u093e\u0924",p3rvtpe:"\u0906\u091c",poh8cad:"\u0939\u093f\u091c\u094b",p1mrhzr7:"\u0906\u0917\u092e\u0928",pfebfdv:"\u092c\u0939\u093f\u0930\u094d\u0917\u092e\u0928",p17k42kg:"\u091b\u0941\u091f\u0947\u0915\u094b",pvw9wg8:"\u092a\u0942\u0930\u093e \u092d\u092f\u094b",p15m090m:"\u0905\u0938\u092b\u0932",p1q8utwa:"\u0935\u093f\u091a\u093e\u0930\u093e\u0927\u0940\u0928",pcqxqrc:"\u092e\u093f\u0928\u0947\u091f",p15oehty:"\u0938\u0947\u0915\u0947\u0928\u094d\u0921",p17tqvf1:"\u0932\u093e\u0907\u092d \u091a\u094d\u092f\u093e\u091f",pos6ydf:"\u0939\u093e\u092e\u094d\u0930\u094b \u0938\u092e\u0930\u094d\u0925\u0928 \u091f\u094b\u0932\u0940\u0938\u0901\u0917 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1jk4gbo:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0924\u092f\u093e \u092d\u093f\u0924\u094d\u0930 \u092d\u093f\u0924\u094d\u0930 \u0905\u0928\u0932\u093e\u0907\u0928",pztgw94:"\u0915\u0932 \u0938\u092e\u0930\u094d\u0925\u0928",pig8opb:"\u0938\u0940\u0927\u093e \u0915\u0941\u0930\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pla6vae:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928",p12y1fw5:"\u0906\u092b\u094d\u0928\u094b \u092a\u094d\u0930\u0936\u094d\u0928\u0939\u0930\u0942 \u092a\u0920\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",pi7el9x:"24 \u0918\u0923\u094d\u091f\u093e \u092d\u093f\u0924\u094d\u0930",peza8d7:"Humaelio",p1k70v3b:"\u0924\u0924\u094d\u0915\u093e\u0932 \u091c\u0935\u093e\u092b \u092a\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",pi7p4si:"24/7 \u0909\u092a\u0932\u092c\u094d\u0927 \u091b",ptmpaw1:"\u092e\u0948\u0932\u0947 \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u0915\u0938\u0930\u0940 \u092c\u0941\u0915 \u0917\u0930\u094d\u0928\u0947?",pq44ijf:"\u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u092c\u0941\u0915 \u0917\u0930\u094d\u0928, \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u091f\u094d\u092f\u093e\u092c\u092e\u093e \u0928\u0947\u092d\u093f\u0917\u0947\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0906\u092b\u094d\u0928\u094b \u092e\u0928\u092a\u0930\u094d\u0928\u0947 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u091a\u092f\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0906\u092b\u094d\u0928\u094b \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092a\u094d\u0930\u0915\u093e\u0930 \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u092e\u093f\u0924\u093f \u0930 \u0938\u092e\u092f \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0938\u092c\u0948 \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942\u0915\u094b \u0938\u093e\u0925 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u0941\u0928\u0947\u091b\u0964",pvi5gau:"\u092e \u0915\u0938\u0930\u0940 \u0930\u0926\u094d\u0926 \u0917\u0930\u094d\u0928 \u0935\u093e \u092a\u0941\u0928: \u0924\u093e\u0932\u093f\u0915\u093e \u092c\u0928\u093e\u0909\u0928 \u0938\u0915\u094d\u091b\u0941?",pfqgfyn:"\u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u0916\u0923\u094d\u0921\u092c\u093e\u091f \u0906\u092b\u094d\u0928\u094b \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f\u0939\u0930\u0942 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964 \u092a\u0941\u0928: \u0924\u093e\u0932\u093f\u0915\u093e \u092c\u0928\u093e\u0909\u0928 \u0935\u093e \u0930\u0926\u094d\u0926 \u0917\u0930\u094d\u0928 \u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u0906\u0917\u093e\u092e\u0940 \u092d\u0947\u091f\u0918\u093e\u091f\u092e\u093e \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0938\u0924\u094d\u0930 \u092d\u0928\u094d\u0926\u093e 24 \u0918\u0923\u094d\u091f\u093e \u0905\u0918\u093f \u0917\u0930\u093f\u090f\u0915\u093e \u0930\u0926\u094d\u0926\u0939\u0930\u0942 \u092b\u093f\u0930\u094d\u0924\u093e\u0915\u094b \u0932\u093e\u0917\u093f \u092f\u094b\u0917\u094d\u092f \u091b\u0928\u094d\u0964",p1h9bcwo:"\u0915\u0947 \u092e\u0947\u0930\u094b \u092e\u0947\u0921\u093f\u0915\u0932 \u0921\u093e\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091b?",ps9lc26:"\u0939\u094b, \u0924\u092a\u093e\u0907\u0901\u0915\u094b \u0938\u092c\u0948 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0921\u0947\u091f\u093e \u0905\u0928\u094d\u0924 \u0926\u0947\u0916\u093f \u0905\u0928\u094d\u0924 \u0908\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 \u0930 \u0909\u0926\u094d\u092f\u094b\u0917 \u092e\u093e\u0928\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0932 \u0938\u0902\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091b\u0964 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0938\u0939\u092e\u0924\u093f \u092c\u093f\u0928\u093e \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0921\u0947\u091f\u093e \u0924\u0947\u0938\u094d\u0930\u094b \u092a\u0915\u094d\u0937\u0939\u0930\u0942\u0938\u0901\u0917 \u0915\u0939\u093f\u0932\u094d\u092f\u0948 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0917\u0930\u093f\u090f\u0915\u094b \u091b\u0948\u0928\u0964",p1c63b9n:"\u092e\u0948\u0932\u0947 \u092e\u0947\u0930\u094b \u0935\u093e\u0932\u0947\u091f\u092e\u093e \u0930\u0915\u092e \u0915\u0938\u0930\u0940 \u0925\u092a\u094d\u0928\u0947?",pfulep3:"\u0935\u093e\u0932\u0947\u091f \u091f\u094d\u092f\u093e\u092c\u092e\u093e \u091c\u093e\u0928\u0941\u0939\u094b\u0938\u094d \u0930 \"\u092a\u0948\u0938\u093e \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d\" \u092e\u093e \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0906\u092b\u094d\u0928\u094b \u092e\u0928\u092a\u0930\u094d\u0928\u0947 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u0935\u093f\u0927\u093f \u091b\u0928\u094b\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u2014 \u0915\u093e\u0930\u094d\u0921, UPI, \u0935\u093e \u092c\u0948\u0902\u0915 \u0938\u094d\u0925\u093e\u0928\u093e\u0928\u094d\u0924\u0930\u0923 \u2014 \u0930 \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0925\u092a\u094d\u0928 \u091a\u093e\u0939\u0928\u0941\u092d\u090f\u0915\u094b \u0930\u0915\u092e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pex3sts:"\u092e\u0926\u094d\u0926\u0924 \u0930 \u0938\u092e\u0930\u094d\u0925\u0928",p1ofqfdp:"\u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u0939\u0930\u0942",p1m6uxly:"\u0936\u0947\u092d\u0930\u0928-\u0905\u092a",p9wx6ep:"\u0936\u0947\u092d\u0930\u0928-\u0921\u093e\u0909\u0928",pmkl5g0:"\u0924\u0924\u094d\u0915\u093e\u0932 \u092e\u0926\u094d\u0926\u0924 \u091a\u093e\u0939\u093f\u0928\u094d\u091b?",p1ucr8ie:"\u092f\u0926\u093f \u0924\u092a\u093e\u0907\u0901 \u092e\u0947\u0921\u093f\u0915\u0932 \u0906\u092a\u0924\u0915\u093e\u0932\u093f\u0928 \u0905\u0928\u0941\u092d\u0935 \u0917\u0930\u094d\u0926\u0948 \u0939\u0941\u0928\u0941\u0939\u0941\u0928\u094d\u091b \u092d\u0928\u0947, \u0915\u0943\u092a\u092f\u093e \u0924\u092a\u093e\u0907\u0901\u0915\u094b \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0947\u0935\u093e\u0939\u0930\u0942 \u0924\u0941\u0930\u0941\u0928\u094d\u0924\u0948 \u0915\u0932 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1k15svg:"\u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u092e\u094d\u092a\u0930\u094d\u0915",p1il8i8d:"\u0938\u0902\u0915\u091f \u0938\u0902\u0938\u093e\u0927\u0928\u0939\u0930\u0942",pgcsuld:"\u0938\u092e\u0938\u094d\u092f\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1x9xuzh:"\u090f\u092a\u092e\u093e \u092c\u0917 \u0935\u093e \u092a\u094d\u0930\u093e\u0935\u093f\u0927\u093f\u0915 \u0938\u092e\u0938\u094d\u092f\u093e\u0915\u094b \u0938\u093e\u092e\u0928\u093e \u0917\u0930\u094d\u0928\u0941\u092d\u092f\u094b?",p18t3p8y:"\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0941\u0926\u094d\u0926\u093e",p11jo8ku:"Humaeli \u0938\u0902\u0938\u094d\u0915\u0930\u0923",prnsj34:"\u092a\u091b\u093f\u0932\u094d\u0932\u094b \u0905\u092a\u0921\u0947\u091f:",p8lq2oq:"\u0905\u092a\u0921\u0947\u091f\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f \u091c\u093e\u0901\u091a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pg6nyxd:"\u0905\u0928\u094d\u0924-\u0926\u0947\u0916\u093f-\u0905\u0928\u094d\u0924 \u0907\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0938\u0928",pm4qf9j:"GDPR \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u0939\u0941\u0901\u091a",p13tbyt3:"\u092c\u0947\u0928\u093e\u092e\u0940 \u092a\u0930\u093e\u092e\u0930\u094d\u0936",p1474pj6:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093e\u0932\u0947\u091f \u0932\u0947\u0928\u0926\u0947\u0928",p12ddn6e:"\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",p178beh:"\u0928\u093e\u092e, \u0909\u092e\u0947\u0930 \u0930 \u0932\u093f\u0919\u094d\u0917",p1el3mqv:"\u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923",p1uqyawh:"\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0939\u0930\u0942",p1j5drmg:"\u0906\u092b\u094d\u0928\u094b \u0939\u0947\u0930\u091a\u093e\u0939 \u0905\u0928\u0941\u092d\u0935 \u0928\u093f\u091c\u0940\u0915\u0943\u0924",p1hshih:"\u0938\u0939\u0940 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0938\u0901\u0917 \u092e\u093f\u0932\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",p4lwpxb:"\u091a\u094d\u092f\u093e\u091f \u0930 \u0915\u0932\u0939\u0930\u0942",p16o5duv:"\u0938\u0928\u094d\u0926\u0947\u0936\u0939\u0930\u0942 \u0930 \u0926\u094d\u0930\u0941\u0924 \u091c\u0935\u093e\u092b\u0939\u0930\u0942",pjualou:"\u091a\u094d\u092f\u093e\u091f \u0938\u094d\u0925\u093f\u0924\u093f \u0930 \u0938\u0902\u0932\u0917\u094d\u0928\u0915\u0939\u0930\u0942",p8fcohj:"\u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u094d\u092f\u093e\u091f \u0938\u0924\u094d\u0930\u0939\u0930\u0942",pqugyus:"\u0928\u093f\u0930\u0928\u094d\u0924\u0930 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pxw259e:"\u0938\u0924\u094d\u0930\u0939\u0930\u0942\u092e\u093e \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0915\u094d\u0937\u092e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",ppapyhl:"\u0928\u093f\u092f\u0941\u0915\u094d\u0924\u093f\u0939\u0930\u0942",ppjebc6:"\u092c\u0941\u0915\u093f\u0919 \u092e\u093f\u0924\u093f \u0930 \u0938\u092e\u092f",prz84q3:"\u091b\u0928\u094b\u091f \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930",p6bzi8o:"\u0938\u0924\u094d\u0930 \u0928\u094b\u091f\u0939\u0930\u0942",pfby3q4:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0906\u0917\u093e\u092e\u0940 \u0938\u0924\u094d\u0930\u0939\u0930\u0942 \u092a\u094d\u0930\u092c\u0928\u094d\u0927 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1px010k:"\u0938\u092e\u092f\u092e\u0948 \u0930\u093f\u092e\u093e\u0907\u0928\u094d\u0921\u0930\u0939\u0930\u0942 \u092a\u0920\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",pl6oj3n:"\u0935\u093e\u0932\u0947\u091f \u0930 \u0932\u0947\u0928\u0926\u0947\u0928",pcisb5n:"\u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0930 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938",p11x8ws5:"\u092b\u093f\u0930\u094d\u0924\u093e \u0905\u092d\u093f\u0932\u0947\u0916\u0939\u0930\u0942",p1jezb8u:"\u0932\u0947\u0928\u0926\u0947\u0928 \u0930\u0938\u093f\u0926\u0939\u0930\u0942",p1kxmxol:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a\u092e\u093e \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e",p1soeejn:"\u0938\u0939\u0940 \u092c\u093f\u0932\u093f\u0919 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u093e\u092f\u092e \u0930\u093e\u0916\u094d\u0928\u0941\u0939\