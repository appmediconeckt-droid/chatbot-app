094d\u091c\u0928\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pbcc0k1:"\u092a\u0942\u0930\u093e \u0928\u093e\u092e",p1pprczj:"\u0907\u092e\u0947\u0932 \u0920\u0947\u0917\u093e\u0928\u093e",p37651i:"\u0909\u092e\u0947\u0930",p1m86zzz:"\u0909\u092e\u0947\u0930 \u0917\u0923\u0928\u093e \u0917\u0930\u093f\u0928\u0947\u091b",p1gnm2xr:"\u092e\u0947\u0921\u093f\u0915\u0932 \u092f\u094b\u0917\u094d\u092f\u0924\u093e",p1mcaxz5:"\u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e",p3v76l5:"\u0935\u0930\u094d\u0937\u0939\u0930\u0942",pyjnfb6:"\u0938\u0939\u0930",p6iivfk:"\u092e\u0947\u0930\u094b \u092c\u093e\u0930\u0947\u092e\u093e",p1nb6hqp:"\u0921\u093e\u0915\u094d\u091f\u0930 \u092c\u094d\u092f\u093e\u0915\u0907\u0928\u094d\u0921 \u091c\u0921\u093e\u0928 \u092d\u090f\u092a\u091b\u093f \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u093f\u0938\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0941\u0928\u0947\u091b",pky4h36:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u093f\u0930\u094d\u0938\u0928\u0941\u092d\u092f\u094b?",prejna:"\u0917\u0941\u0917\u0932 \u0938\u093e\u0907\u0928-\u0907\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b",pvu0wuw:"\u0916\u093e\u0924\u093e \u091b\u0948\u0928?",p6kesda:"\u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p39j8ek:"\u090f\u0915 \u092a\u091f\u0915\u0915\u094b \u092a\u093e\u0938\u0935\u0930\u094d\u0921*",pqjslim:"OTP \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0928\u0941\u092d\u090f\u0928?",p1seagg0:"\u092a\u0941\u0928: \u0917\u0930\u093f\u0901\u0926\u0948...",pvitosp:"\u092a\u0941\u0928: \u092a\u0920\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",p156tq0x:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u093f\u0938\u0947\u091f \u0917\u0930\u094d\u0928 \u0906\u092b\u094d\u0928\u094b \u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1es6jgh:"\u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1ncbamm:"\u0939\u0941\u092e\u0932\u0940 - \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f",p1mkbgjw:"\u092e\u093e\u0928\u0935 \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u092e\u094d\u092a\u0928\u094d\u0928",p67t5ik:"\u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u092e\u0930\u094d\u0925\u0928",p15kdwif:"\u0924\u092a\u093e\u0908\u0915\u094b \u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f\u0915\u094b \u0915\u0920\u093f\u0928 \u0938\u092e\u092f\u092e\u093e \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e, \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915, \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0935\u094d\u092f\u0935\u0938\u093e\u092f\u0940 \u0930 \u092e\u0928\u094b\u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u0939\u0930\u0942\u0938\u0901\u0917 \u091c\u0921\u093e\u0928 \u0939\u0941\u0928",puqjq8w:"\u0928\u091c\u093f\u0915\u0948\u0915\u093e \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0938\u0901\u0917 \u092e\u093f\u0932\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",pglw0op:"\u0906\u092b\u094d\u0928\u094b \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pdkk7ab:"\u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u092e\u0930\u094d\u0925\u0928",p6s9e29:"\u0928\u091c\u093f\u0915\u0915\u093e \u092c\u093f\u0930\u093e\u092e\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u0924\u092a\u093e\u0908\u0902\u0932\u093e\u0908 \u092b\u0947\u0932\u093e \u092a\u093e\u0930\u094d\u0928 \u092e\u0926\u094d\u0926\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1kc2xvx:"\u0938\u094d\u0925\u093e\u0928 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a\u092e\u093e \u0930\u094b\u0915\u093f\u090f\u0915\u094b \u0925\u093f\u092f\u094b\u0964 \u0938\u0947\u091f\u093f\u0919\u094d\u0939\u0930\u0942 \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u2192 \u092f\u094b \u090f\u092a\u0915\u094b \u0932\u093e\u0917\u093f \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0924\u094d\u092f\u0938\u092a\u091b\u093f \u092b\u0930\u094d\u0915\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pj1z8my:"\u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0901\u091a \u092c\u093f\u0928\u093e, \u0928\u091c\u093f\u0915\u0915\u093e \u092c\u093f\u0930\u093e\u092e\u0940\u0939\u0930\u0942\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092b\u0947\u0932\u093e \u092a\u093e\u0930\u094d\u0928 \u0938\u0915\u094d\u0926\u0948\u0928\u0928\u094d \u0930 \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0940\u092e\u093f\u0924 \u0939\u0941\u0928\u0947\u091b\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pe2sfkx:"\u0938\u094d\u0925\u093e\u0928 \u0905\u091d\u0948 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u091b\u0964 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0926\u0943\u0936\u094d\u092f\u0924\u093e \u0930 \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u0938\u094d\u0924\u093e \u0938\u0941\u0935\u093f\u0927\u093e\u0939\u0930\u0942 \u0930\u093e\u092e\u094d\u0930\u0930\u0940 \u0915\u093e\u092e \u0917\u0930\u094d\u0926\u0948\u0928\u0928\u094d\u0964",p1bc8b0q:"\u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0901\u091a \u092c\u093f\u0928\u093e \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u0928\u091c\u093f\u0915\u0915\u093e \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942, \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0905\u0932\u0930\u094d\u091f\u0939\u0930\u0942, \u0930 \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u092e\u0930\u094d\u0925\u0928 \u0917\u0941\u092e\u093e\u0909\u0928\u0941\u0939\u0941\u0928\u0947\u091b\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1kxnr6x:"\u0938\u094d\u0925\u093e\u0928 \u0905\u091d\u0948 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u091b\u0964 \u0928\u091c\u093f\u0915\u0948\u0915\u093e \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0930 \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u091c\u0938\u094d\u0924\u093e \u0938\u0941\u0935\u093f\u0927\u093e\u0939\u0930\u0942\u0932\u0947 \u0930\u093e\u092e\u094d\u0930\u0930\u0940 \u0915\u093e\u092e \u0917\u0930\u094d\u0928\u0947 \u091b\u0948\u0928\u0928\u094d\u0964",p1qfkxpw:"\u0938\u0947\u091f\u093f\u0919\u094d\u0939\u0930\u0942 \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p19izdw2:"\u0905\u0928\u0941\u0930\u094b\u0927 \u0917\u0930\u094d\u0926\u0948...",pudz60s:"\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0926\u0948...",p1nyz8sj:"\ud83d\udd04 \u092b\u0947\u0930\u093f \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p129dr11:"\ud83d\udccd \u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0901\u091a \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d",p13kffw5:"\u0938\u094d\u0925\u093e\u0928 \u092c\u093f\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pr2p72l:"\u0938\u094d\u0925\u093e\u0928 \u0938\u093f\u092b\u093e\u0930\u093f\u0938 \u0917\u0930\u094d\u0928\u0941\u092d\u092f\u094b",pi9375l:"\u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1xmhdqy:"\u0915\u0947\u0939\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0939\u0930\u0942 \u0938\u094d\u0925\u093e\u0928 \u092c\u093f\u0928\u093e \u0915\u093e\u092e \u0917\u0930\u094d\u0926\u0948\u0928\u0928\u094d\u0964 \u0939\u093e\u092e\u0940 \u0926\u0943\u0922\u0924\u093e\u0915\u093e \u0938\u093e\u0925 \u092f\u0938\u0932\u093e\u0908 \u0938\u0915\u094d\u0937\u092e \u0917\u0930\u094d\u0928 \u0938\u093f\u092b\u093e\u0930\u093f\u0938 \u0917\u0930\u094d\u091b\u094c\u0902\u0964",p1ismk4q:"\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0905\u0928\u0941\u092d\u0935\u0915\u094b \u0932\u093e\u0917\u093f, \u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0901\u091a \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u092f\u0938\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u093e\u0908 \u0924\u092a\u093e\u0908\u0902\u0932\u093e\u0908 \u0905\u091d \u0930\u093e\u092e\u094d\u0930\u094b \u0938\u0947\u0935\u093e \u0917\u0930\u094d\u0928 \u0930 \u0924\u092a\u093e\u0908\u0902\u0932\u093e\u0908 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0916\u094d\u0928 \u092e\u0926\u094d\u0926\u0924 \u0917\u0930\u094d\u091b\u0964",p1rsaitz:"\u0939\u093e\u092e\u0940\u0932\u093e\u0908 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0938\u094d\u0925\u093e\u0928 \u0915\u093f\u0928 \u091a\u093e\u0939\u093f\u0928\u094d\u091b",p1lwhuaj:"\ud83d\udd10 \u0924\u092a\u093e\u0908\u0902\u0932\u0947 \u090f\u092a \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0930\u0939\u0901\u0926\u093e \u092e\u093e\u0924\u094d\u0930 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u094d\u091b\u0964 \u092f\u094b \u0915\u0939\u093f\u0932\u094d\u092f\u0948 \u092c\u0947\u091a\u0947\u0915\u094b \u0935\u093e \u0924\u0947\u0938\u094d\u0930\u094b \u092a\u0915\u094d\u0937\u0939\u0930\u0942\u0938\u0901\u0917 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0917\u0930\u093f\u090f\u0915\u094b \u091b\u0948\u0928\u0964",pi5yj9e:"\u0938\u094d\u0915\u093f\u092a\u093f\u0919\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0905\u0928\u0941\u092d\u0935\u0932\u093e\u0908 \u0938\u0940\u092e\u093f\u0924 \u0917\u0930\u094d\u0928\u0947\u091b\u0964 \u0924\u092a\u093e\u0908\u0902 \u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u0938\u092e\u092f \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942\u092e\u093e \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964",p1h299pn:"\u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928 \u0938\u093e\u0907\u0928 \u0907\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",punxvbe:"\u092e\u0932\u093e\u0908 \u0938\u092e\u094d\u091d\u0928\u0941\u0939\u094b\u0938\u094d",p1djn4vs:"\u092e\u0947\u0932-\u0913\u092a\u0928-\u0906\u0909\u091f\u0932\u093e\u0907\u0928",p9joi0e:"\u092b\u094b\u0928-\u092a\u094b\u0930\u094d\u091f\u094d\u0930\u0947\u091f-\u0930\u0942\u092a\u0930\u0947\u0916\u093e",pcm1nee:"\u092f\u094b \u0924\u092a\u093e\u0908\u0902 \u0928\u0948 \u0939\u094b \u092d\u0928\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p39qlxn:"\u0938\u0924\u094d\u0930 \u0926\u094d\u0935\u0928\u094d\u0926\u094d\u0935 \u092a\u0924\u094d\u0924\u093e \u0932\u093e\u0917\u094d\u092f\u094b",p1nl6f5:"\u0939\u093e\u092e\u0940\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0926\u0930\u094d\u0924\u093e \u0917\u0930\u093f\u090f\u0915\u094b \u0907\u092e\u0947\u0932\u092e\u093e \u096c-\u0905\u0919\u094d\u0915\u0915\u094b \u0915\u094b\u0921 \u092a\u0920\u093e\u090f\u0915\u093e \u091b\u094c\u0902\u0964 \u0906\u092b\u094d\u0928\u094b \u0905\u0928\u094d\u092f \u092f\u0928\u094d\u0924\u094d\u0930\u0939\u0930\u0942 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0917\u0930\u094d\u0928 \u0930 \u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928 \u0924\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p8ykf5k:"\u0924\u092a\u093e\u0908\u0902 \u092a\u0939\u093f\u0932\u0947 \u0928\u0948 \u0905\u0930\u094d\u0915\u094b \u0909\u092a\u0915\u0930\u0923\u092e\u093e \u0932\u0917 \u0907\u0928 \u0939\u0941\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964 \u092f\u0938\u0932\u093e\u0908 \u091c\u093e\u0930\u0940 \u0930\u093e\u0916\u094d\u0928 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p18vcp24:"OTP \u092a\u0920\u093e\u0909\u0901\u0926\u0948...",p1ntvp8x:"\u0905\u0928\u094d\u092f \u092f\u0928\u094d\u0924\u094d\u0930\u0939\u0930\u0942 \u0932\u0917\u0906\u0909\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0930 OTP \u092a\u0920\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",pn5i6fn:"\u096c \u0905\u0902\u0915\u0915\u094b OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p12n3zp8:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0917\u0930\u094d\u0926\u0948...",pohmzat:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u093f\u0938\u0947\u091f \u0917\u0930\u094d\u0926\u0948...",p1e6s4y0:"\u0907\u092e\u0947\u0932 \u092e\u093e\u0930\u094d\u092b\u0924 \u0932\u0917\u0907\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1aafagh:"\u0906\u092b\u094d\u0928\u094b \u0916\u093e\u0924\u093e \u0938\u093f\u0930\u094d\u091c\u0928\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pasmu26:"\u0924\u092a\u093e\u0908\u0902 \u0915\u0938\u0930\u0940 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928 \u091a\u093e\u0939\u0928\u0941\u0939\u0941\u0928\u094d\u091b \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d Humaeli",pqh0i9l:"\u092a\u094b\u0930\u094d\u091f\u0932 \u091a\u092f\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pyjrj1w:"\u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e",p1rlv5t:"\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942 \u0916\u094b\u091c\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p19cu11q:"\u0906\u092b\u094d\u0928\u094b \u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u094d\u0930\u092c\u0928\u094d\u0927 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pbe3qyw:"\u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0939\u0947\u0930\u091a\u093e\u0939 \u092a\u094d\u0930\u0926\u093e\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1d9tqw:"END-TO-END \u0907\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921",p1696fig:"\u0915\u0941\u0930\u093e \u0917\u0930\u094d\u0928\u0915\u094b \u0932\u093e\u0917\u093f \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u093e\u0909\u0901",p14mamw2:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f\u0932\u093e\u0908 \u0938\u092e\u0930\u094d\u0925\u0928 \u0917\u0930\u094d\u0928 \u0921\u093f\u091c\u093e\u0907\u0928 \u0917\u0930\u093f\u090f\u0915\u094b \u090f\u0915 \u0928\u093f\u091c\u0940, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u092e\u093e \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0938\u0901\u0917 \u091c\u0921\u093e\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p16mi6u6:"\u0938\u0939\u0940 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pcyp7gf:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e, \u092d\u093e\u0937\u093e, \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e, \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092a\u094d\u0930\u0915\u093e\u0930, \u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0939\u0930\u0942\u092e\u093e \u0906\u0927\u093e\u0930\u093f\u0924 \u0905\u0928\u0941\u092d\u0935\u0940 \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942 \u092c\u094d\u0930\u093e\u0909\u091c \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1j7paqb:"\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u090f\u0906\u0908 \u0915\u0932\u094d\u092f\u093e\u0923 \u0938\u093e\u0925\u0940",p235k91:"\u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u0938\u092e\u092f \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0938\u0901\u0917 \u091c\u0921\u093e\u0928 \u0917\u0930\u094d\u0928\u0941 \u0905\u0918\u093f \u0924\u0924\u094d\u0915\u093e\u0932 \u092d\u093e\u0935\u0928\u093e\u0924\u094d\u092e\u0915 \u0938\u092e\u0930\u094d\u0925\u0928, \u0915\u0932\u094d\u092f\u093e\u0923 \u0938\u0941\u091d\u093e\u0935\u0939\u0930\u0942 \u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p12cl72e:"\u0928\u092e\u0938\u094d\u0924\u0947 \ud83d\udc4b \u0915\u0938\u094d\u0924\u094b \u091b \u0906\u091c\u0915\u094b \u0926\u093f\u0928 ?",pz0a21k:"\u092c\u0941\u0915, \u091a\u094d\u092f\u093e\u091f \u0930 \u0928\u093f\u0915\u094b",pahuuzy:"\u092d\u0947\u091f\u0918\u093e\u091f\u0915\u094b \u0938\u092e\u092f\u0924\u093e\u0932\u093f\u0915\u093e \u092c\u0928\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092d\u093f\u0921\u093f\u092f\u094b \u0938\u0924\u094d\u0930\u0939\u0930\u0942\u092e\u093e \u0938\u093e\u092e\u0947\u0932 \u0939\u0941\u0928\u0941\u0939\u094b\u0938\u094d, \u0938\u0932\u094d\u0932\u093e\u0939\u0915\u093e\u0930\u0939\u0930\u0942\u0938\u0901\u0917 \u0915\u0941\u0930\u093e\u0915\u093e\u0928\u0940 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0930 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0915\u0932\u094d\u092f\u093e\u0923 \u092f\u093e\u0924\u094d\u0930\u093e \u091f\u094d\u0930\u094d\u092f\u093e\u0915 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u2014\u0938\u092c\u0948 \u090f\u0915\u0948 \u0920\u093e\u0909\u0901\u092e\u093e\u0964",pefpvkx:"\u092a\u0941\u0938\u094d\u0924\u0915 \u0938\u0924\u094d\u0930\u0939\u0930\u0942",pvu2nj9:"\u092d\u093f\u0921\u093f\u092f\u094b \u0915\u0932\u0939\u0930\u0942",p1dfp17w:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091a\u094d\u092f\u093e\u091f",pz29fz2:"\u0905\u0928\u094d\u0924-\u0926\u0947\u0916\u093f-\u0905\u0928\u094d\u0924",prcdi82:"#cbd5e1",p8cqkqc:"#00652C",pyj27bj:"\u0915\u0941\u0928\u0948 \u092a\u0928\u093f",pyivru2:"\u0905\u091f\u094b",pdfz3q4:"\u092f\u0939\u093e\u0901 \u0928\u092f\u093e\u0901?",plg5b3z:"\u092a\u0939\u093f\u0932\u0947 \u0928\u0948 \u091c\u094b\u0921\u093f\u0928\u0941\u092d\u092f\u094b?",p86so6m:"\u092a\u0920\u093e\u0907\u090f\u0915\u094b \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pwma7ac:"\u0905\u0939\u093f\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1girtza:"\u092b\u093f\u0930\u094d\u0924\u093e \u091c\u093e\u0928\u0941\u0939\u094b\u0938\u094d",p16rk3ld:"\u0938\u0915\u094d\u0930\u093f\u092f \u0938\u0924\u094d\u0930 \u092a\u0924\u094d\u0924\u093e \u0932\u093e\u0917\u094d\u092f\u094b",p1e642qo:"\u0924\u092a\u093e\u0908\u0902 \u0905\u0930\u094d\u0915\u094b \u092f\u0928\u094d\u0924\u094d\u0930\u092e\u093e \u0932\u0917 \u0907\u0928 \u0939\u0941\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964 \u0915\u0947 \u0924\u092a\u093e\u0908\u0902 \u0905\u0928\u094d\u092f \u0938\u092c\u0948 \u092f\u0928\u094d\u0924\u094d\u0930\u0939\u0930\u0942\u092c\u093e\u091f \u0932\u0917 \u0906\u0909\u091f \u0917\u0930\u0947\u0930 \u092f\u0939\u093e