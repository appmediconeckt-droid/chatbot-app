0948\u0902 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902..."},helpPage:{title:"\u0938\u0939\u093e\u092f\u0924\u093e \u0938\u092e\u0930\u094d\u0925\u0928",centerTitle:"Humaeli \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930",centerDesc:"\u0907\u0938 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0938\u0939\u0940 Humaeli \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0930 \u091c\u093e\u090f\u0902, \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0930\u0947\u0902, \u0914\u0930 \u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0915\u092c \u0910\u092a \u0915\u0947 \u092c\u093e\u0939\u0930 \u0924\u0924\u094d\u0915\u093e\u0932 \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u093e \u0939\u0948\u0964",aiWellnessChat:"AI \u0915\u0932\u094d\u092f\u093e\u0923 \u091a\u0948\u091f",aiWellnessDesc:"\u092e\u093e\u0928\u0938\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0915\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u092a\u0942\u091b\u0947\u0902, \u0935\u0949\u092f\u0938 \u0907\u0928\u092a\u0941\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902, \u0924\u094d\u0935\u0930\u093f\u0924 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u0905\u092a\u0928\u0940 \u0939\u093e\u0932 \u0915\u0940 AI \u091a\u0948\u091f \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0964",aiWellnessAction:"AI \u091a\u0948\u091f \u0916\u094b\u0932\u0947\u0902",counselorSupport:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0938\u092e\u0930\u094d\u0925\u0928",counselorDesc:"\u0926\u0947\u0916\u092d\u093e\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093e\u092e, \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e, \u092d\u093e\u0937\u093e, \u0938\u094d\u0925\u093e\u0928, \u0930\u0947\u091f\u093f\u0902\u0917 \u0914\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0947 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u094b \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902\u0964",counselorAction:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0916\u094b\u091c\u0947\u0902",appointments:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f",appointmentsDesc:"\u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0914\u0930 \u092a\u093f\u091b\u0932\u0940 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0947\u0902, \u0914\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0924\u094d\u0930 \u092c\u0941\u0915 \u0915\u0930\u0947\u0902\u0964",appointmentsAction:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0926\u0947\u0916\u0947\u0902",walletPayments:"\u0935\u0949\u0932\u0947\u091f \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928",walletDesc:"\u092a\u0948\u0938\u093e \u091c\u094b\u0921\u093c\u0947\u0902, \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u0935\u0949\u0932\u0947\u091f \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902, \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",walletAction:"\u0935\u0949\u0932\u0947\u091f \u0916\u094b\u0932\u0947\u0902",beforeContact:"\u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947",checklist1:"\u0915\u093f\u0938\u0940 \u0932\u094b\u0921\u093f\u0902\u0917 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0910\u092a \u0915\u094b \u0930\u0940\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u0947\u0902\u0964",checklist2:"\u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0928\u0935\u0940\u0928\u0924\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f, \u0938\u091f\u0940\u0915 \u0938\u092e\u092f \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928\u093e\u092e \u0924\u0948\u092f\u093e\u0930 \u0930\u0916\u0947\u0902\u0964",checklist3:"\u0915\u0948\u092e\u0930\u093e, \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928, \u0938\u0942\u091a\u0928\u093e \u0914\u0930 \u0938\u094d\u0925\u093e\u0928 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0910\u092a \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",checklist4:"\u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f, \u0910\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u0917\u0908 \u0924\u093e\u0930\u0940\u0916, \u0930\u093e\u0936\u093f, \u0932\u0947\u0928\u0926\u0947\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902\u0964",commonIssues:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0902",aiChatNotReply:"AI \u091a\u0948\u091f \u091c\u0935\u093e\u092c \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948",aiChatNotReplyDesc:"\u0905\u092a\u0928\u0947 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902, \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 AI \u091a\u0948\u091f \u092b\u093f\u0930 \u0938\u0947 \u0916\u094b\u0932\u0947\u0902\u0964 \u092f\u0926\u093f \u092f\u0939 \u0935\u093f\u092b\u0932 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0938\u091f\u0940\u0915 \u0924\u094d\u0930\u0941\u091f\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964",counselorChatNotOpen:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u091a\u0948\u091f \u0928\u0939\u0940\u0902 \u0916\u0941\u0932 \u0930\u0939\u093e \u0939\u0948",counselorChatNotOpenDesc:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0916\u094b\u0932\u0947\u0902, \u090f\u0915 \u0909\u092a\u0932\u092c\u094d\u0927 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u094b\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964 \u092e\u094c\u091c\u0942\u0926\u093e \u091a\u0948\u091f \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u091a\u0948\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964",callNotConnecting:"\u0915\u0949\u0932 \u0915\u0928\u0947\u0915\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u094b \u0930\u0939\u093e \u0939\u0948",callNotConnectingDesc:"\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0928\u0947 \u0906\u092a\u0915\u0940 \u091a\u0948\u091f/\u0938\u0924\u094d\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948, \u0926\u094b\u0928\u094b\u0902 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0939\u0948\u0902, \u0914\u0930 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928/\u0915\u0948\u092e\u0930\u093e \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0902 \u0905\u0928\u0941\u092e\u0924\u093f \u0939\u0948\u0902\u0964",walletPaymentIssue:"\u0935\u0949\u0932\u0947\u091f \u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u092e\u0938\u094d\u092f\u093e",walletPaymentIssueDesc:"\u0928\u0935\u0940\u0928\u0924\u092e \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u0947 \u0914\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0949\u0932\u0947\u091f \u0916\u094b\u0932\u0947\u0902\u0964 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0924\u093e\u0930\u0940\u0916, \u0930\u093e\u0936\u093f \u0914\u0930 \u0932\u0947\u0928\u0926\u0947\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964",languageWrongTitle:"\u092d\u093e\u0937\u093e \u092f\u093e \u0905\u0928\u0941\u0935\u093e\u0926 \u0917\u0932\u0924 \u0932\u0917 \u0930\u0939\u093e \u0939\u0948",languageWrongDesc:"\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921/\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u092d\u093e\u0937\u093e \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964 \u0915\u0941\u091b \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u092f\u093e \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u0940 \u0917\u0908 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0930\u0939 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",needMoreHelp:"\u0905\u0927\u093f\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948?",needMoreHelpDesc:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932/\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902, \u092f\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f, \u0910\u092a \u0938\u0902\u0938\u094d\u0915\u0930\u0923, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0908\u092e\u0947\u0932/\u092b\u094b\u0928 \u0914\u0930 \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u091f\u0940\u0915 \u0938\u092e\u092f \u0915\u0947 \u0938\u093e\u0925 \u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0947\u0902\u0964",myProfile:"\u092e\u0947\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",settings:"\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938",emailSupport:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928"},privacyPage:{title:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f",centerTitle:"Humaeli \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930",centerDesc:"\u092f\u0939 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f Humaeli \u0907\u0938 \u092e\u094b\u092c\u093e\u0907\u0932 \u0910\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, \u091a\u0948\u091f, \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f, \u0935\u0949\u0932\u0947\u091f, \u0915\u0949\u0932, \u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",otpProtected:"OTP \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924",otpProtectedDesc:"\u0908\u092e\u0947\u0932 \u0914\u0930 \u092b\u094b\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928",anonymousCare:"\u0917\u0941\u092e\u0928\u093e\u092e \u0926\u0947\u0916\u092d\u093e\u0932 \u092a\u0939\u091a\u093e\u0928",anonCareDesc:"\u091c\u0939\u093e\u0902 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0939\u0948 \u0935\u0939\u093e\u0902 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u094b \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e",sensitiveAreas:"\u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0915\u094d\u0937\u0947\u0924\u094d\u0930",sensitiveAreasDesc:"\u091a\u0948\u091f, \u0915\u0949\u0932, \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f, \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",dataUsedTitle:"\u0910\u092a \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0921\u0947\u091f\u093e",profileHealth:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0914\u0930 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0935\u093f\u0935\u0930\u0923",profileHealthDesc:"\u0906\u092a\u0915\u093e \u0928\u093e\u092e, \u0917\u0941\u092e\u0928\u093e\u092e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0928\u093e\u092e, \u0906\u092f\u0941, \u0932\u093f\u0902\u0917, \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923 \u0906\u0926\u093f \u0906\u092a\u0915\u0940 \u0930\u094b\u0917\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",aiConversations:"AI \u091a\u0948\u091f \u0914\u0930 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924",aiConversationsDesc:"\u0938\u0902\u0926\u0947\u0936, \u0924\u094d\u0935\u0930\u093f\u0924 \u0909\u0924\u094d\u0924\u0930, \u091a\u0948\u091f \u0938\u094d\u0925\u093f\u0924\u093f \u0906\u0926\u093f \u092c\u093e\u0924\u091a\u0940\u0924 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",appointments:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0914\u0930 \u0938\u0924\u094d\u0930",appointmentsDesc:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0924\u093e\u0930\u0940\u0916, \u0938\u092e\u092f, \u0915\u093e\u0930\u0923/\u0928\u094b\u091f\u094d\u0938 \u0906\u0926\u093f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0914\u0930 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u094b \u0926\u0947\u0916\u092d\u093e\u0932 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",wallet:"\u0935\u0949\u0932\u0947\u091f \u0914\u0930 \u0932\u0947\u0928\u0926\u0947\u0928",walletDesc:"\u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938, \u091f\u0949\u092a-\u0905\u092a, \u0932\u0947\u0928\u0926\u0947\u0928 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092d\u0941\u0917\u0924\u093e\u0928 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",location:"\u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0902\u0926\u0930\u094d\u092d",locationDesc:"\u0938\u094d\u0925\u093e\u0928 \u0938\u093e\u0907\u0928\u0905\u092a, \u0932\u0949\u0917\u093f\u0928 \u092f\u093e \u092e\u0948\u0928\u0941\u0905\u0932 \u0930\u0940\u092b\u094d\u0930\u0947\u0936 \u092a\u0930 \u0915\u0948\u092a\u094d\u091a\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",security:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0916\u093e\u0924\u093e \u092a\u0939\u0941\u0902\u091a",securityDesc:"\u0932\u0949\u0917\u093f\u0928 \u091f\u094b\u0915\u0928, \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0924\u093e, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u094d\u0925\u093f\u0924\u093f \u0906\u0926\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",whoCanSee:"\u0915\u094c\u0928 \u0915\u094d\u092f\u093e \u0926\u0947\u0916 \u0938\u0915\u0924\u093e \u0939\u0948",visibleToYou:"\u0906\u092a\u0915\u094b \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u093e \u0939\u0948",visibleDesc:"\u0906\u092a\u0915\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, AI \u091a\u0948\u091f, \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0907\u0902\u091f\u0930\u0948\u0915\u094d\u0936\u0928 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964",sharedForCare:"\u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u091d\u093e",sharedDesc:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0938\u0924\u094d\u0930 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",protectedAccess:"\u092a\u0939\u0941\u0902\u091a \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924",protectedDesc:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0914\u0930 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092d\u0942\u092e\u093f\u0915\u093e \u0914\u0930 \u0938\u0924\u094d\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0932\u0917 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",checklist:"\u0906\u092a\u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u091c\u093e\u0902\u091a\u0938\u0942\u091a\u0940",checklistItem1:"\u091c\u092c \u0906\u092a \u0905\u092a\u0928\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0928\u093e\u092e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0924\u094b \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0926\u093e\u0924\u093e \u0907\u0902\u091f\u0930\u0948\u0915\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0917\u0941\u092e\u0928\u093e\u092e \u0928\u093e\u092e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964",checklistItem2:"\u092f\u0926\u093f \u0906\u092a \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u092a\u0930\u094d\u0915 \u0914\u0930 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923 \u092d\u0930\u0928\u0947 \u0915\u093e \u091a\u0941\u0928\u093e\u0935 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u091f\u0940\u0915 \u0930\u0916\u0947\u0902\u0964",checklistItem3:"\u0915\u0949\u0932 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0925\u093e\u0928, \u0915\u0948\u092e\u0930\u093e \u0914\u0930 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u0935\u093e\u0907\u0938 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964",checklistItem4:"\u092f\u0926\u093f \u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0930\u093e\u0902\u092a\u094d\u091f \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0924\u094b \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938/\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0947 \u0938\u094d\u0925\u093e\u0928 \u0915\u094b \u092e\u0948\u0928\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964",checklistItem5:"\u091a\u0948\u091f \u0938\u0902\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0905\u0902\u0926\u0930 OTP, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923 \u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902\u0964",checklistItem6:"\u0905\u092a\u0928\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0921\u0947\u091f\u093e \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u092f\u093e \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0914\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964",manageData:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902",securitySettings:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938",aiQuickReplyLow:"\u0928\u0940\u091a\u093e",aiQuickReplyOkay:"\u0920\u0940\u0915 \u0939\u0948",aiQuickReplyGood:"\u0905\u091a\u094d\u091b\u093e",aiQuickReplyGreat:"\u092c\u0922\u093c\u093f\u092f\u093e",aiPhotoAttached:"\u092b\u094b\u091f\u094b \u0938\u0902\u0932\u0917\u094d\u0928",aiTryAgain:"\u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",aiVoiceHint:"\u091c\u092c \u0906\u092a \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0902 \u0924\u092c \u092c\u094b\u0932\u0947\u0902 - \u0906\u092a\u0915\u0947 \u0930\u0941\u0915\u0924\u0947 \u0939\u0940 \u092e\u0948\u0902 \u0909\u0924\u094d\u0924\u0930 \u0926\u0942\u0902\u0917\u093e\u0964",resetChatTitle:"\u0928\u0908 \u091a\u0948\u091f \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902?",resetChatMessage:"\u092f\u0939 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 AI \u091a\u0948\u091f \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u094d\u0935\u093e\u0917\u0924 \u092e\u0942\u0921 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",startFresh:"\u0928\u090f \u0938\u093f\u0930\u0947 \u0938\u0947 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u0947\u0902",startingFresh:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d..."},phrases:{p1le0g3x:"\u0905\u091c\u094d\u091e\u093e\u0924",p3rvtpe:"\u0906\u091c",poh8cad:"\u0915\u0932",p1mrhzr7:"\u0906\u0935\u0915",pfebfdv:"\u0928\u093f\u0935\u0930\u094d\u0924\u092e\u093e\u0928",p17k42kg:"\u091b\u0942\u091f \u0917\u092f\u093e",pvw9wg8:"\u092a\u0942\u0930\u093e \u0939\u0941\u0906",p15m090m:"\u0905\u0938\u092b\u0932",p1q8utwa:"\u0932\u0902\u092c\u093f\u0924",pcqxqrc:"\u092e\u093f\u0928\u091f",p15oehty:"\u0938\u0947\u0915\u0902\u0921",p17tqvf1:"\u0932\u093e\u0907\u0935 \u091a\u0948\u091f",pos6ydf:"\u0939\u092e\u093e\u0930\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u091f\u0940\u092e \u0938\u0947 \u091a\u0948\u091f \u0915\u0930\u0947\u0902",p1jk4gbo:"\u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0940\u0924\u0930",pztgw94:"\u0938\u0939\u093e\u092f\u0924\u093e \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",pig8opb:"\u0938\u0940\u0927\u0947 \u092c\u093e\u0924 \u0915\u0930\u094b",pla6vae:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928",p12y1fw5:"\u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u092d\u0947\u091c\u0947\u0902",pi7el9x:"24 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0905\u0902\u0926\u0930",peza8d7:"\u0939\u0941\u092e\u0947\u0932\u093f\u0913",p1k70v3b:"\u0924\u0941\u0930\u0902\u0924 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902",pi7p4si:"24/7 \u0909\u092a\u0932\u092c\u094d\u0927",ptmpaw1:"\u092e\u0948\u0902 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0915\u0948\u0938\u0947 \u092c\u0941\u0915 \u0915\u0930\u0942\u0902?",pq44ijf:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092c\u0941\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0902\u0938\u0932\u094d\u091f\u0947\u0902\u091f\u094d\u0938 \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0901, \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902, \u0905\u092a\u0928\u093e \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u090f\u0915 \u0924\u093e\u0930\u0940\u0916 \u0914\u0930 \u0938\u092e\u092f \u091a\u0941\u0928\u0947\u0902\u0964 \u0906\u092a\u0915\u094b \u0938\u092d\u0940 \u0935\u093f\u0935\u0930\u0923\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0908\u092e\u0947\u0932 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e\u0964",pvi5gau:"\u092e\u0948\u0902 \u0915\u0948\u0938\u0947 \u0930\u0926\u094d\u0926 \u092f\u093e \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",pfqgfyn:"\u0906\u092a \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0905\u0928\u0941\u092d\u093e\u0917 \u0938\u0947 \u0905\u092a\u0928\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0917\u093e\u092e\u0940 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0938\u0924\u094d\u0930 \u0938\u0947 24 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u0930\u093f\u092b\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0924\u094d\u0930 \u0939\u0948\u0964",p1h9bcwo:"\u0915\u094d\u092f\u093e \u092e\u0947\u0930\u093e \u092e\u0947\u0921\u093f\u0915\u0932 \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948?",ps9lc26:"\u0939\u093e\u0902, \u0906\u092a\u0915\u093e \u0938\u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0914\u0930 \u092e\u0947\u0921\u093f\u0915\u0932 \u0921\u0947\u091f\u093e \u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 \u0914\u0930 \u0909\u0926\u094d\u092f\u094b\u0917-\u092e\u093e\u0928\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964 \u0906\u092a\u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u0915\u092d\u0940 \u092d\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",p1c63b9n:"\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0927\u0928\u0930\u093e\u0936\u093f \u0915\u0948\u0938\u0947 \u091c\u094b\u0921\u093c\u0942\u0901?",pfulep3:"\u0935\u0949\u0932\u0947\u091f \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902 \u0914\u0930 \"\u092a\u0948\u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902\" \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0927\u093f \u091a\u0941\u0928\u0947\u0902 - \u0915\u093e\u0930\u094d\u0921, \u092f\u0942\u092a\u0940\u0906\u0908, \u092f\u093e \u092c\u0948\u0902\u0915 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 - \u0914\u0930 \u0935\u0939 \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",pex3sts:"\u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928",p1ofqfdp:"\u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u092a\u094d\u0930\u0936\u094d\u0928",p1m6uxly:"\u0936\u0947\u0935\u0930\u0949\u0928-\u0905\u092a",p9wx6ep:"\u0936\u0947\u0935\u0930\u0949\u0928-\u0921\u093e\u0909\u0928",pmkl5g0:"\u0924\u0924\u094d\u0915\u093e\u0932 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948?",p1ucr8ie:"\u092f\u0926\u093f \u0906\u092a \u0915\u093f\u0938\u0940 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0940\u092f \u0906\u092a\u093e\u0924 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u0930\u0902\u0924 \u0905\u092a\u0928\u0940 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964",p1k15svg:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u092a\u0930\u094d\u0915",p1il8i8d:"\u0938\u0902\u0915\u091f \u0938\u0902\u0938\u093e\u0927\u0928",pgcsuld:"\u0915\u093f\u0938\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902",p1x9xuzh:"\u0910\u092a \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092c\u0917 \u092f\u093e \u0924\u0915\u0928\u0940\u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u093e?",p18t3p8y:"\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0941\u0926\u094d\u0926\u093e",p11jo8ku:"Humaeli \u0938\u0902\u0938\u094d\u0915\u0930\u0923",prnsj34:"\u0905\u0902\u0924\u093f\u092e \u0905\u0926\u094d\u092f\u0924\u0928:",p8lq2oq:"\u0905\u0926\u094d\u092f\u0924\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",pg6nyxd:"\u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928",pm4qf9j:"\u091c\u0940\u0921\u0940\u092a\u0940\u0906\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u0939\u0941\u0902\u091a",p13tbyt3:"\u0905\u0928\u093e\u092e \u092a\u0930\u093e\u092e\u0930\u094d\u0936",p1474pj6:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u0949\u0932\u0947\u091f \u0932\u0947\u0928\u0926\u0947\u0928",p12ddn6e:"\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932",p178beh:"\u0928\u093e\u092e, \u0909\u092e\u094d\u0930 \u0914\u0930 \u0932\u093f\u0902\u0917",p1el3mqv:"\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923",p1uqyawh:"\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0901",p1j5drmg:"\u0905\u092a\u0928\u0947 \u0926\u0947\u0916\u092d\u093e\u0932 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0915\u0930\u0947\u0902",p1hshih:"\u0906\u092a\u0915\u094b \u0938\u0939\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u0947 \u092e\u093f\u0932\u093e\u090f\u0901",p4lwpxb:"\u091a\u0948\u091f \u0914\u0930 \u0915\u0949\u0932",p16o5duv:"\u0938\u0902\u0926\u0947\u0936 \u0914\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u0909\u0924\u094d\u0924\u0930",pjualou:"\u091a\u0948\u091f \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u0905\u0928\u0941\u0932\u0917\u094d\u0928\u0915",p8fcohj:"\u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u0948\u091f \u0938\u0924\u094d\u0930",pqugyus:"\u0938\u0924\u0924 \u0935\u093e\u0930\u094d\u0924\u093e\u0932\u093e\u092a \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902",pxw259e:"\u0938\u0924\u094d\u0930 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",ppapyhl:"\u0928\u093f\u092f\u0941\u091