u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c16\u0c3e\u0c24\u0c3e \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",pe2sfkx:"\u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c35\u0c3f\u0c1c\u0c3f\u0c2c\u0c3f\u0c32\u0c3f\u0c1f\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c38\u0c46\u0c15\u0c4d\u0c2f\u0c42\u0c30\u0c3f\u0c1f\u0c40 \u0c35\u0c02\u0c1f\u0c3f \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u0c32\u0c41 \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c41.",p1bc8b0q:"\u0c38\u0c4d\u0c25\u0c3e\u0c28 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c16\u0c3e\u0c24\u0c3e \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c15\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c15\u0c4b\u0c32\u0c4d\u0c2a\u0c4b\u0c24\u0c3e\u0c30\u0c41. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",p1kxnr6x:"\u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c35\u0c02\u0c1f\u0c3f \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c41.",p1qfkxpw:"\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f",p19izdw2:"\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f...",pudz60s:"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c4b\u0c02\u0c26\u0c3f\u2026",p1nyz8sj:"\ud83d\udd04 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p129dr11:"\ud83d\udccd \u0c38\u0c4d\u0c25\u0c3e\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p13kffw5:"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",pr2p72l:"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c38\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c38\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",pi9375l:"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p1xmhdqy:"\u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c41. \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c2e\u0c47\u0c2e\u0c41 \u0c17\u0c1f\u0c4d\u0c1f\u0c3f\u0c17\u0c3e \u0c38\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c38\u0c41 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2e\u0c41.",p1ismk4q:"\u0c09\u0c24\u0c4d\u0c24\u0c2e \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c02 \u0c15\u0c4b\u0c38\u0c02, \u0c38\u0c4d\u0c25\u0c3e\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c07\u0c26\u0c3f \u0c2e\u0c40\u0c15\u0c41 \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c48\u0c28 \u0c38\u0c47\u0c35\u0c32\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c38\u0c41\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c2e\u0c3e\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",p1rsaitz:"\u0c2e\u0c3e\u0c15\u0c41 \u0c2e\u0c40 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c0e\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02",p1lwhuaj:"\ud83d\udd10 \u0c2e\u0c40\u0c30\u0c41 \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c2e\u0c40 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c07\u0c26\u0c3f \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c42 \u0c35\u0c3f\u0c15\u0c4d\u0c30\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c42\u0c21\u0c35 \u0c2a\u0c15\u0c4d\u0c37\u0c3e\u0c32\u0c24\u0c4b \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41.",pi5yj9e:"\u0c26\u0c3e\u0c1f\u0c35\u0c47\u0c2f\u0c21\u0c02 \u0c2e\u0c40 \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c32\u0c4b \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c48\u0c28\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",p1h299pn:"\u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c48\u0c28\u0c4d \u0c07\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",punxvbe:"\u0c28\u0c28\u0c4d\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c41\u0c02\u0c1a\u0c41\u0c15\u0c4b",p1djn4vs:"\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d-\u0c13\u0c2a\u0c46\u0c28\u0c4d-\u0c14\u0c1f\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d",p9joi0e:"\u0c2b\u0c4b\u0c28\u0c4d-\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d\u0c30\u0c46\u0c2f\u0c3f\u0c1f\u0c4d-\u0c14\u0c1f\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d",pcm1nee:"\u0c07\u0c26\u0c3f \u0c2e\u0c40\u0c30\u0c47\u0c28\u0c28\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p39qlxn:"\u0c38\u0c46\u0c37\u0c28\u0c4d \u0c35\u0c48\u0c30\u0c41\u0c27\u0c4d\u0c2f\u0c02 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",p1nl6f5:"\u0c2e\u0c47\u0c2e\u0c41 \u0c2e\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c15\u0c3f 6-\u0c05\u0c02\u0c15\u0c46\u0c32 \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c3f \u0c2a\u0c02\u0c2a\u0c3e\u0c2e\u0c41. \u0c2e\u0c40 \u0c07\u0c24\u0c30 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c48\u0c28\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f, \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c3f\u0c17\u0c41\u0c35\u0c28 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",p8ykf5k:"\u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c2e\u0c30\u0c4a\u0c15 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c02\u0c32\u0c4b \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c38\u0c3e\u0c30\u0c41. \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c48\u0c28\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",p18vcp24:"OTP\u0c28\u0c3f \u0c2a\u0c02\u0c2a\u0c41\u0c24\u0c4b\u0c02\u0c26\u0c3f...",p1ntvp8x:"\u0c07\u0c24\u0c30 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f & OTP\u0c28\u0c3f \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f",pn5i6fn:"6-\u0c05\u0c02\u0c15\u0c46\u0c32 OTP\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",p12n3zp8:"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f...",pohmzat:"\u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f...",p1e6s4y0:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c24\u0c4b \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",p1aafagh:"\u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",pasmu26:"\u0c2e\u0c40\u0c30\u0c41 Humaeli \u0c0e\u0c32\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c4b \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",pqh0i9l:"\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",pyjrj1w:"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41",p1rlv5t:"\u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c38\u0c28\u0c40\u0c2f \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u