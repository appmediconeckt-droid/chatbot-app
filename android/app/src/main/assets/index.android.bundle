ca6\u0cbf\u0cb8\u0cbf",p1es6jgh:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",p1ncbamm:"\u0cb9\u0cc1\u0cae\u0cc7\u0cb2\u0cbf - \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0ca8\u0cb8\u0cbf\u0c95 \u0cb8\u0ccd\u0cb5\u0cbe\u0cb8\u0ccd\u0ca5\u0ccd\u0caf",p1mkbgjw:"\u0cae\u0cbe\u0ca8\u0cb5 \u0cb8\u0cac\u0cb2\u0cc0\u0c95\u0cb0\u0ca3",p67t5ik:"\u0cae\u0cbe\u0ca8\u0cb8\u0cbf\u0c95 \u0cb8\u0ccd\u0cb5\u0cbe\u0cb8\u0ccd\u0ca5\u0ccd\u0caf \u0cac\u0cc6\u0c82\u0cac\u0cb2",p15kdwif:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0ca8\u0cb8\u0cbf\u0c95 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0c95\u0cb7\u0ccd\u0c9f\u0ca6 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1, \u0cae\u0ca8\u0cb6\u0ccd\u0cb6\u0cbe\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0c9c\u0ccd\u0c9e\u0cb0\u0cc1, \u0cae\u0cbe\u0ca8\u0cb8\u0cbf\u0c95 \u0cb8\u0ccd\u0cb5\u0cbe\u0cb8\u0ccd\u0ca5\u0ccd\u0caf \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0ca8\u0ccb\u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb8\u0cbe\u0ca7\u0cbf\u0cb8\u0cb2\u0cc1",puqjq8w:"\u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf",pglw0op:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cbf\u0cb8\u0cbf",pdkk7ab:"\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2",p6s9e29:"\u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb0\u0ccb\u0c97\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cbf",p1kc2xvx:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf \u2192 \u0c88 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf, \u0ca8\u0c82\u0ca4\u0cb0 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf.",pj1z8my:"\u0cb8\u0ccd\u0ca5\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6, \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb0\u0ccb\u0c97\u0cbf\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0ca6\u0cbf\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3-\u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0c96\u0cbe\u0ca4\u0cc6\u0caf \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cc6\u0caf\u0cc1 \u0cb8\u0cc0\u0cae\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf.",pe2sfkx:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cbf\u0cb0\u0ccd\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0c97\u0ccb\u0c9a\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6\u0caf\u0c82\u0ca4\u0cb9 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",p1bc8b0q:"\u0cb8\u0ccd\u0ca5\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1, \u0c96\u0cbe\u0ca4\u0cc6\u0caf \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf.",p1kxnr6x:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cbf\u0cb0\u0ccd\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0ca6\u0c82\u0ca4\u0cb9 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",p1qfkxpw:"\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf",p19izdw2:"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...",pudz60s:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...",p1nyz8sj:"\ud83d\udd04 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf",p129dr11:"\ud83d\udccd \u0cb8\u0ccd\u0ca5\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf",p13kffw5:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf",pr2p72l:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",pi9375l:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",p1xmhdqy:"\u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbe\u0cb5\u0cc1 \u0cac\u0cb2\u0cb5\u0cbe\u0c97\u0cbf \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6.",p1ismk4q:"\u0c89\u0ca4\u0ccd\u0ca4\u0cae \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf, \u0cb8\u0ccd\u0ca5\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf. \u0c87\u0ca6\u0cc1 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c89\u0ca4\u0ccd\u0ca4\u0cae\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cae\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",p1rsaitz:"\u0ca8\u0cae\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3 \u0c8f\u0c95\u0cc6 \u0cac\u0cc7\u0c95\u0cc1",p1lwhuaj:"\ud83d\udd10 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cac\u0cb3\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cbf\u0c97\u0cc2 \u0cae\u0cbe\u0cb0\u0cbe\u0c9f\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cc2\u0cb0\u0ca8\u0cc7 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",pi5yj9e:"\u0cb8\u0ccd\u0c95\u0cbf\u0caa\u0ccd\u0caa\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbf\u0ca4\u0cbf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cbe\u0c97 \u0cac\u0cc7\u0c95\u0cbe\u0ca6\u0cb0\u0cc2 \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",p1h299pn:"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cc6\u0caf\u0cb2\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",punxvbe:"\u0ca8\u0ca8\u0ccd\u0ca8\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc6\u0ca8\u0caa\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",p1djn4vs:"\u0cae\u0cc7\u0cb2\u0ccd-\u0cae\u0cc1\u0c95\u0ccd\u0ca4-\u0c94\u0c9f\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd",p9joi0e:"\u0cab\u0ccb\u0ca8\u0ccd-\u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0-\u0c94\u0c9f\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd",pcm1nee:"\u0c87\u0ca6\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",p39qlxn:"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cb8\u0c82\u0c98\u0cb0\u0ccd\u0cb7 \u0caa\u0ca4\u0ccd\u0ca4\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",p1nl6f5:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0ca8\u0cbe\u0cb5\u0cc1 6-\u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0ca4\u0cb0 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c94\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cb2\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.",p8ykf5k:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0c87\u0ca8\u0ccd\u0ca8\u0cca\u0c82\u0ca6\u0cc1 \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cbe\u0c97\u0ccd \u0c87\u0ca8\u0ccd \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cbf\u0cb0\u0cbf. \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c94\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",p18vcp24:"OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...",p1ntvp8x:"\u0c87\u0ca4\u0cb0 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c97\u0ccd\u200c\u0c94\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",pn5i6fn:"6-\u0c85\u0c82\u0c95\u0cbf\u0caf OTP \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",p12n3zp8:"\