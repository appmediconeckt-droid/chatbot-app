\u091f",p1v69wvt:"\u092d\u0942\u092e\u093f\u0915\u093e \u090f\u0935\u0902 \u0906\u0908\u0921\u0940 \u0938\u094c\u0902\u092a\u0940 \u0917\u0908\u0964",p1izml5e:"\u0906\u092a\u0915\u0940 \u0938\u094d\u091f\u093e\u092b \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e \u092e\u0947\u0902 \u091c\u094b\u0921\u093c \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e. \u0938\u094d\u091f\u093e\u092b \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092e\u0947\u0902 \u0905\u092d\u0940 \u0924\u0915 \u0905\u092a\u0928\u093e \u0932\u0949\u0917\u093f\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",pqjusmk:"\u0907\u0928\u0932\u093e\u0907\u0928",p197c56t:"\u092e\u093f\u092e\u0940/\u0926\u093f\u0928/\u0935\u0930\u094d\u0937",p1yhjlf1:"\u0915\u092e \u0938\u0947 \u0915\u092e 8 \u0905\u0915\u094d\u0937\u0930",p1iz9fbs:"\u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0928\u0902\u092c\u0930",p7sq7gj:"\u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u092a\u093e\u0924\u094d\u0930",p32rfac:"\u0906\u092a\u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u092e \u0938\u0947 \u0915\u092e 8 \u0905\u0915\u094d\u0937\u0930 \u0932\u0902\u092c\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u0907\u0938\u092e\u0947\u0902 \u0938\u0902\u0916\u094d\u092f\u093e\u0913\u0902, \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u0914\u0930 \u0935\u093f\u0936\u0947\u0937 \u0935\u0930\u094d\u0923\u094b\u0902 \u0915\u093e \u0938\u0902\u092f\u094b\u091c\u0928 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",p1knyiaj:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",pue1erm:"\u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0928\u093e\u090f\u0902",p1x4uueu:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u090f\u0901",pafa2cf:"#0\u0921