e6'\u05d0\u05d8 \u05d7\u05d9",pos6ydf:"\u05e6'\u05d0\u05d8 \u05e2\u05dd \u05e6\u05d5\u05d5\u05ea \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05e9\u05dc\u05e0\u05d5",p1jk4gbo:"\u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05d1\u05e4\u05e0\u05d9\u05dd",pztgw94:"\u05d4\u05ea\u05e7\u05e9\u05e8 \u05dc\u05ea\u05de\u05d9\u05db\u05d4",pig8opb:"\u05d3\u05d1\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea",pla6vae:"\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05d3\u05d5\u05d0\"\u05dc",p12y1fw5:"\u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05e9\u05dc\u05da",pi7el9x:"\u05ea\u05d5\u05da 24 \u05e9\u05e2\u05d5\u05ea",peza8d7:"Humaelio",p1k70v3b:"\u05e7\u05d1\u05dc \u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05d5\u05ea",pi7p4si:"\u05d6\u05de\u05d9\u05df 24/7",ptmpaw1:"\u05d0\u05d9\u05da \u05d0\u05e0\u05d9 \u05de\u05d6\u05de\u05d9\u05e0\u05d4 \u05ea\u05d5\u05e8?",pq44ijf:"\u05db\u05d3\u05d9 \u05dc\u05d4\u05d6\u05de\u05d9\u05df \u05e4\u05d2\u05d9\u05e9\u05d4, \u05e0\u05d5\u05d5\u05d8 \u05dc\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd, \u05d1\u05d7\u05e8 \u05d0\u05ea \u05d4\u05d9\u05d5\u05e2\u05e5 \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05e2\u05dc\u05d9\u05da, \u05d1\u05d7\u05e8 \u05d0\u05ea \u05e1\u05d5\u05d2 \u05d4\u05d9\u05d9\u05e2\u05d5\u05e5 \u05e9\u05dc\u05da \u05d5\u05d1\u05d7\u05e8 \u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4. \u05ea\u05e7\u05d1\u05dc \u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e2\u05dd \u05db\u05dc \u05d4\u05e4\u05e8\u05d8\u05d9\u05dd.",pvi5gau:"\u05d0\u05d9\u05da \u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05d1\u05d8\u05dc \u05d0\u05d5 \u05dc\u05e9\u05e0\u05d5\u05ea \u05de\u05d5\u05e2\u05d3?",pfqgfyn:"\u05d0\u05ea\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05e0\u05d4\u05dc \u05d0\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05da \u05de\u05e7\u05d8\u05e2 \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea. \u05d4\u05e7\u05e9 \u05e2\u05dc \u05db\u05dc \u05e4\u05d2\u05d9\u05e9\u05d4 \u05e7\u05e8\u05d5\u05d1\u05d4 \u05db\u05d3\u05d9 \u05dc\u05ea\u05d6\u05de\u05df \u05de\u05d7\u05d3\u05e9 \u05d0\u05d5 \u05dc\u05d1\u05d8\u05dc. \u05d1\u05d9\u05d8\u05d5\u05dc\u05d9\u05dd \u05e9\u05e0\u05e2\u05e9\u05d5 24 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4 \u05d6\u05db\u05d0\u05d9\u05dd \u05dc\u05d4\u05d7\u05d6\u05e8\u05d9\u05dd.",p1h9bcwo:"\u05d4\u05d0\u05dd \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e9\u05dc\u05d9 \u05de\u05d0\u05d5\u05d1\u05d8\u05d7\u05d9\u05dd?",ps9lc26:"\u05db\u05df, \u05db\u05dc \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d5\u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e9\u05dc\u05da \u05de\u05d5\u05d2\u05e0\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4\u05e6\u05e4\u05e0\u05d4 \u05de\u05e7\u05e6\u05d4 \u05dc\u05e7\u05e6\u05d4 \u05d5\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc\u05d9 \u05d0\u05d1\u05d8\u05d7\u05d4 \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05d9\u05dd \u05d1\u05ea\u05e2\u05e9\u05d9\u05d9\u05d4. \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da \u05dc\u05e2\u05d5\u05dc\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05e2\u05dd \u05e6\u05d3\u05d3\u05d9\u05dd \u05e9\u05dc\u05d9\u05e9\u05d9\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e1\u05db\u05de\u05ea\u05da.",p1c63b9n:"\u05db\u05d9\u05e6\u05d3 \u05d0\u05d5\u05db\u05dc \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05db\u05e1\u05e4\u05d9\u05dd \u05dc\u05d0\u05e8\u05e0\u05e7 \u05e9\u05dc\u05d9?",pfulep3:"\u05e2\u05d1\u05d5\u05e8 \u05dc\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea \u05d0\u05e8\u05e0\u05e7 \u05d5\u05d4\u05e7\u05e9 \u05e2\u05dc \"\u05d4\u05d5\u05e1\u05e3 \u05db\u05e1\u05e3\". \u05d1\u05d7\u05e8 \u05d0\u05ea \u05e9\u05d9\u05d8\u05ea \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05e4\u05ea \u05e2\u05dc\u05d9\u05da - \u05db\u05e8\u05d8\u05d9\u05e1, UPI \u05d0\u05d5 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05d1\u05e0\u05e7\u05d0\u05d9\u05ea - \u05d5\u05d4\u05d6\u05df \u05d0\u05ea \u05d4\u05e1\u05db\u05d5\u05dd \u05e9\u05d1\u05e8\u05e6\u05d5\u05e0\u05da \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3.",pex3sts:"\u05e2\u05d6\u05e8\u05d4 \u05d5\u05ea\u05de\u05d9\u05db\u05d4",p1ofqfdp:"\u05e9\u05d0\u05dc\u05d5\u05ea \u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d5\u05ea",p1m6uxly:"\u05e9\u05d1\u05e8\u05d5\u05df-\u05d0\u05e4",p9wx6ep:"\u05e9\u05d1\u05e8\u05d5\u05df \u05dc\u05de\u05d8\u05d4",pmkl5g0:"\u05d6\u05e7\u05d5\u05e7 \u05dc\u05e2\u05d6\u05e8\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea?",p1ucr8ie:"\u05d0\u05dd \u05d0\u05ea\u05d4 \u05d7\u05d5\u05d5\u05d4 \u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9, \u05d0\u05e0\u05d0 \u05d4\u05ea\u05e7\u05e9\u05e8 \u05de\u05d9\u05d3 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d4\u05d7\u05d9\u05e8\u05d5\u05dd \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd \u05e9\u05dc\u05da.",p1k15svg:"\u05e7\u05e9\u05e8 \u05d7\u05d9\u05e8\u05d5\u05dd",p1il8i8d:"\u05de\u05e9\u05d0\u05d1\u05d9 \u05de\u05e9\u05d1\u05e8",pgcsuld:"\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d1\u05e2\u05d9\u05d4",p1x9xuzh:"\u05e0\u05ea\u05e7\u05dc\u05ea \u05d1\u05d1\u05d0\u05d2 \u05d0\u05d5 \u05d1\u05d1\u05e2\u05d9\u05d4 \u05d8\u05db\u05e0\u05d9\u05ea \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4?",p18t3p8y:"\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d1\u05e2\u05d9\u05d4",p11jo8ku:"Humaeli \u05d2\u05e8\u05e1\u05d4",prnsj34:"\u05e2\u05d5\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4:",p8lq2oq:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e2\u05d3\u05db\u05d5\u05e0\u05d9\u05dd",pg6nyxd:"\u05d4\u05e6\u05e4\u05e0\u05d4 \u05de\u05e7\u05e6\u05d4 \u05dc\u05e7\u05e6\u05d4",pm4qf9j:"\u05d2\u05d9\u05e9\u05d4 \u05de\u05d0\u05d5\u05e9\u05e8\u05ea GDPR",p13tbyt3:"\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9",p1474pj6:"\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea \u05de\u05d0\u05d5\u05d1\u05d8\u05d7\u05d5\u05ea \u05d1\u05d0\u05e8\u05e0\u05e7",p12ddn6e:"\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d0\u05d9\u05e9\u05d9",p178beh:"\u05e9\u05dd, \u05d2\u05d9\u05dc \u05d5\u05de\u05d9\u05df",p1el3mqv:"\u05e4\u05e8\u05d8\u05d9 \u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8",p1uqyawh:"\u05d4\u05e2\u05d3\u05e4\u05d5\u05ea \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea",p1j5drmg:"\u05d4\u05ea\u05d0\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea \u05d0\u05ea \u05d7\u05d5\u05d5\u05d9\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05dc\u05da",p1hshih:"\u05d4\u05ea\u05d0\u05dd \u05dc\u05da \u05d0\u05ea \u05d4\u05d9\u05d5\u05e2\u05e5 \u05d4\u05de\u05ea\u05d0\u05d9\u05dd",p4lwpxb:"\u05e6'\u05d0\u05d8\u05d9\u05dd \u05d5\u05e9\u05d9\u05d7\u05d5\u05ea",p16o5duv:"\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d5\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d5\u05ea",pjualou:"\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e6'\u05d0\u05d8 \u05d5\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd",p8fcohj:"\u05de\u05e4\u05d2\u05e9\u05d9 \u05e6'\u05d0\u05d8 \u05de\u05e7\u05d5\u05d1\u05dc\u05d9\u05dd",pqugyus:"\u05e1\u05e4\u05e7 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05d9\u05d7\u05d5\u05ea \u05e8\u05e6\u05d9\u05e4\u05d4",pxw259e:"\u05d0\u05e4\u05e9\u05e8 \u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05d9\u05d5\u05e2\u05e5 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea",ppapyhl:"\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea",ppjebc6:"\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4 \u05dc\u05d4\u05d6\u05de\u05e0\u05d4",prz84q3:"\u05d9\u05d5\u05e2\u05e5 \u05e0\u05d1\u05d7\u05e8",p6bzi8o:"\u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05d5\u05e9\u05d1",pfby3q4:"\u05e0\u05d4\u05dc \u05d0\u05ea \u05d4\u05d4\u05e4\u05e2\u05dc\u05d5\u05ea \u05d4\u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05e9\u05dc\u05da",p1px010k:"\u05e9\u05dc\u05d7 \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05d1\u05d6\u05de\u05df",pl6oj3n:"\u05d0\u05e8\u05e0\u05e7 \u05d5\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea",pcisb5n:"\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d8\u05e2\u05d9\u05e0\u05d4 \u05d5\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd",p11x8ws5:"\u05e8\u05d9\u05e9\u05d5\u05de\u05d9 \u05d4\u05d7\u05d6\u05e8",p1jezb8u:"\u05e7\u05d1\u05dc\u05d5\u05ea \u05e2\u05dc \u05e2\u05e1\u05e7\u05d4",p1kxmxol:"\u05e2\u05d1\u05d3 \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u05d1\u05e6\u05d5\u05e8\u05d4 \u05de\u05d0\u05d5\u05d1\u05d8\u05d7\u05ea",p1soeejn:"\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d7\u05d9\u05d5\u05d1\u05d9\u05dd \u05de\u05d3\u05d5\u05d9\u05e7\u05ea",p3fb3fk:"\u05d2\u05d9\u05e9\u05d4 \u05dc\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da",paxx0ja:"\u05d1\u05e7\u05e9 \u05e2\u05d5\u05ea\u05e7 \u05e9\u05dc \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05e9Humaeli \u05de\u05d7\u05d6\u05d9\u05e7 \u05e2\u05dc\u05d9\u05da.",py8xd5m:"\u05ea\u05e7\u05df \u05d0\u05ea \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da",pg1ugci:"\u05e2\u05d3\u05db\u05df \u05e4\u05e8\u05d8\u05d9\u05dd \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd \u05d0\u05d5 \u05de\u05d9\u05d5\u05e9\u05e0\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc\u05da \u05d1\u05db\u05dc \u05e2\u05ea.",p13743po:"\u05de\u05d7\u05e7 \u05d0\u05ea \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05dc\u05da",p12l9hlj:"\u05d1\u05e7\u05e9 \u05de\u05d7\u05d9\u05e7\u05d4 \u05e9\u05dc \u05d7\u05e9\u05d1\u05d5\u05e0\u05da \u05d5\u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d0\u05dc\u05d9\u05d5.",pqqlbs9:"\u05dc\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05d4\u05e1\u05db\u05de\u05d4",p7r950p:"\u05d4\u05e4\u05e1\u05e7 \u05d0\u05ea \u05d4\u05e2\u05d9\u05d1\u05