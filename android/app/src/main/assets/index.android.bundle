f\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",searchCounselorPlaceholder:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0ca4\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf",sessionReasonPlaceholder:"\u0c88 \u0c85\u0ca7\u0cbf\u0cb5\u0cc7\u0cb6\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8f\u0ca8\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9a\u0cb0\u0ccd\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf..."},helpPage:{title:"\u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc6\u0c82\u0cac\u0cb2",centerTitle:"\u0cae\u0cc6\u0ca1\u0cbf\u0c95\u0cbe\u0ca8\u0cc6\u0c95\u0ccd\u0c9f\u0ccd \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0",centerDesc:"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 Humaeli \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cb2\u0cc1, \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8 \u0cb9\u0cca\u0cb0\u0c97\u0cc6 \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5\u0cbe\u0c97 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c88 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf.",aiWellnessChat:"AI \u0c95\u0ccd\u0cb7\u0cc7\u0cae \u0c9a\u0cbe\u0c9f\u0ccd",aiWellnessDesc:"\u0cae\u0cbe\u0ca8\u0cb8\u0cbf\u0c95 \u0cb8\u0ccd\u0cb5\u0cbe\u0cb8\u0ccd\u0ca5\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc7\u0cb3\u0cbf, \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0c87\u0ca8\u0ccd\u200c\u0caa\u0cc1\u0c9f\u0ccd \u0cac\u0cb3\u0cb8\u0cbf, \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 AI \u0c9a\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf.",aiWellnessAction:"AI \u0c9a\u0cbe\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf",counselorSupport:"\u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cac\u0cc6\u0c82\u0cac\u0cb2",counselorDesc:"\u0c86\u0cb0\u0cc8\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0ca4\u0cc6, \u0cad\u0cbe\u0cb7\u0cc6, \u0cb8\u0ccd\u0ca5\u0cb3, \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ccd\u0cb0\u0ccc\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",counselorAction:"\u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf",appointments:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0cc1",appointmentsDesc:"\u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf, \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cbf\u0cb0\u0cbf\u0cb8\u0cbf.",appointmentsAction:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf",walletPayments:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3\u0cc1",walletDesc:"\u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf, \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf, \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.",walletAction:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf",beforeContact:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1",checklist1:"\u0cb2\u0ccb\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",checklist2:"\u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd\u200c\u0cb6\u0cbe\u0c9f\u0ccd, \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb8\u0cae\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cb0\u0ca6\u0cc6\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.",checklist3:"\u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cb0\u0cbe, \u0cae\u0cc8\u0c95\u0ccd\u0cb0\u0cca\u0cab\u0ccb\u0ca8\u0ccd, \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf, \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",checklist4:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf, \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0cae\u0cca\u0ca4\u0ccd\u0ca4, \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0ca8 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.",commonIssues:"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1",aiChatNotReply:"AI \u0c9a\u0cbe\u0c9f\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2",aiChatNotReplyDesc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf, \u0c95\u0cbf\u0cb0\u0cc1 \u0cb8\u0c82\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 AI \u0c9a\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc1\u0ca8\u0c83 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf. \u0c85\u0ca6\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0ca6\u0ccb\u0cb7 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd\u200c\u0cb6\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.",counselorChatNotOpen:"\u0c95\u0ccc\u0ca8\u0ccd\u0cb8\u0cbf\u0cb2\u0cb0\u0ccd \u0c9a\u0cbe\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2",counselorChatNotOpenDesc:"\u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf, \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf. \u0c85\u0cb8\u0ccd\u0ca4\u0cbf\u0ca4\u0ccd\u0cb5\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u200b\u200b\u0c9a\u0cbe\u0c9f\u0ccd \u0caa\u0cb0\u0ca6\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c97\u0ccb\u0c9a\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.",callNotConnecting:"\u0c95\u0cb0\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2",callNotConnectingDesc:"\u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9a\u0cbe\u0c9f\u0ccd/\u0cb8\u0cc6\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf, \u0c87\u0cac\u0ccd\u0cac\u0cb0\u0cc2 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc8\u0c95\u0ccd\u0cb0\u0cca\u0cab\u0ccb\u0ca8\u0ccd/\u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cc6\u0cb0\u0cbe \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",walletPaymentIssue:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6",walletPaymentIssueDesc:"\u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf. \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0ca8 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.",languageWrongTitle:"\u0cad\u0cbe\u0cb7\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca8\u0cc1\u0cb5\u0cbe\u0ca6\u0cb5\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",languageWrongDesc:"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd/\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cad\u0cbe\u0cb7\u0cbe \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf. \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c89\u0cb3\u0cbf\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",needMoreHelp:"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc7?",needMoreHelpDesc:"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd/\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd\u200c\u0cb6\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf, \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0c87\u0cae\u0cc7\u0cb2\u0ccd/\u0cab\u0ccb\u0ca8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0cb8\u0c82\u0cad\u0cb5\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb8\u0cae\u0caf\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cac\u0cc6\u0c82\u0cac\u0cb2. \u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cbf\u0c95\u0ccd\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf, 9152987821 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf.",myProfile:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd",settings:"\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1",emailSupport:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cac\u0cc6\u0c82\u0cac\u0cb2"},privacyPage:{title:"\u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0ca8\u0cc0\u0ca4\u0cbf",centerTitle:"\u0cae\u0cc6\u0ca1\u0cbf\u0c95\u0cbe\u0ca8\u0cc6\u0c95\u0ccd\u0c9f\u0ccd \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0",centerDesc:"Humaeli \u0c88 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd, \u0c9a\u0cbe\u0c9f\u0ccd, \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd, \u0cb5\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd, \u0c95\u0cb0\u0cc6, \u0cb8\u0ccd\u0ca5\u0cb3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cac\u0cb3\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c88 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",otpProtected:"OTP \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",otpProtectedDesc:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cab\u0ccb\u0ca8\u0ccd \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0cc1",anonymousCare:"\u0c85\u0ca8\u0cbe\u0cae\u0ca7\u0cc7\u0caf \u0c86\u0cb0\u0cc8\u0c95\u0cc6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1",anonCareDesc:"\u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0ca4 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",sensitiveAreas:"\u0cb8\u0cc2\u0c95\u0ccd\u0cb7\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cc1",sensitiveAreasDesc:"\u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0c95\u0cb0\u0cc6\u0c97\u0cb3\u0cc1, \u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0cc1, \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd",dataUsedTitle:"\u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0ca6 \u0ca1\u0cc7\u0c9f\u0cbe",profileHealth:"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",profileHealthDesc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0c85\u0ca8\u0cbe\u0cae\u0ca7\u0cc7\u0caf \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cc1, \u0cb2\u0cbf\u0c82\u0c97, \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1, \u0cab\u0ccb\u0c9f\u0ccb/\u0c85\u0cb5\u0ca4\u0cbe\u0cb0\u0ccd, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8, \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95, \u0cae\u0cc2\u0cb2 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cae\u0cbe \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb0\u0ccb\u0c97\u0cbf\u0caf \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",aiConversations:"AI \u0c9a\u0cbe\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6\u0c97\u0cb3\u0cc1",aiConversationsDesc:"\u0cb8\u0c82\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cc1, \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1, \u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, \u0cb2\u0c97\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1, \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \ufffd\ufffd\u0cbe\u0c9f\u0ccd \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cc1, \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c82\u0caa\u0ccd\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",appointments:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0cc1",appointmentsDesc:"\u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0cb8\u0cae\u0caf, \u0c95\u0cbe\u0cb0\u0ca3/\u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf\u0c97\u0cb3\u0cc1, \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cc1, \u0c95\u0cb0\u0cc6 \u0cae\u0cc6\u0c9f\u0cbe\u0ca1\u0cc7\u0c9f\u0cbe \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0c86\u0cb0\u0cc8\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",wallet:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1",walletDesc:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd, \u0c9f\u0cbe\u0caa\u0ccd-\u0c85\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1, \u0cb0\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0ca6 \u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",location:"\u0cb8\u0ccd\u0ca5\u0cb3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad",locationDesc:"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1, \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3-\u0c85\u0cb0\u0cbf\u0cb5\u0cbf\u0ca8 \u0c86\u0cb0\u0cc8\u0c95\u0cc6 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd\u200c\u0c85\u0caa\u0ccd, \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cb8\u0ccd\u0ca4\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4 \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc6\u0cb0\u0cc6\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",security:"\u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6",securityDesc:"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c9f\u0ccb\u0c95\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0caa\u0cc2\u0cb0\u0cc8\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1, \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6, \u0caa\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc7\u0c95\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",whoCanSee:"\u0caf\u0cbe\u0cb0\u0cc1 \u0c8f\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",visibleToYou:"\u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c97\u0ccb\u0c9a\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",visibleDesc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd, AI \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cb8\u0c82\u0cb5\u0cbe\u0ca6\u0c97\u0cb3\u0cc1, \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0cb5\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd, \u0c95\u0cb0\u0cc6 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8, \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c82\u0caa\u0ccd\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3/\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",sharedForCare:"\u0c86\u0cb0\u0cc8\u0c95\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cb9\u0c82\u0c9a\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",sharedDesc:"\u0cb8\u0cae\u0cbe\u0cb2\u0ccb\u0c9a\u0c95\u0cb0\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0cc1, \u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\ufffd\ufffd\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0ca4 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca8\u0cbe\u0cae\u0ca7\u0cc7\u0caf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",protectedAccess:"\u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",protectedDesc:"\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0ca4\u0ccd\u0cb0, \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0cc1, OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 API \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc7\u0c95\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",checklist:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe\u0caa\u0c9f\u0ccd\u0c9f\u0cbf",checklistItem1:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0caf\u0cb8\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0c97 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cb8\u0c82\u0cb5\u0cb9\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca8\u0cbe\u0cae\u0ca7\u0cc7\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf.",checklistItem2:"\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cad\u0cb0\u0ccd\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u0c85\u0cb5\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c87\u0cb0\u0cbf\u0cb8\u0cbf.",checklistItem3:"\u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3, \u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cb0\u0cbe \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc8\u0c95\u0ccd\u0cb0\u0cca\u0cab\u0ccb\u0ca8\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",checklistItem4:"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c82\u0caa\u0ccd\u0c9f\u0ccd \u0cb8\u0ccd\u0c95\u0cbf\u0caa\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1/\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cb8\u0ccd\u0ca4\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.",checklistItem5:"\u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0c82\u0ca6\u0cc7\u0cb6\u0c97\u0cb3 \u0c92\u0cb3\u0c97\u0cc6 OTP \u0c97\u0cb3\u0cc1, \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cc2\u0c95\u0ccd\u0cb7\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0ca1\u0cbf.",checklistItem6:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf.",manageData:"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf",securitySettings:"\u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u0c97\u0cb3\u0cc1",aiQuickReplyLow:"\u0c95\u0ca1\u0cbf\u0cae\u0cc6",aiQuickReplyOkay:"\u0cb8\u0cb0\u0cbf",aiQuickReplyGood:"\u0c92\u0cb3\u0ccd\u0cb3\u0cc6\u0caf\u0ca6\u0cc1",aiQuickReplyGreat:"\u0c95\u0cc1\u0cb5\u0cc6\u0c82\u0caa\u0cc1",aiPhotoAttached:"\u0cab\u0ccb\u0c9f\u0ccb \u0cb2\u0c97\u0ca4\u0ccd\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",aiTryAgain:"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf",aiVoiceHint:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cb0\u0cbe\u0ca6\u0cbe\u0c97 \u0cae\u0cbe\u0ca4\u0ca8\u0cbe\u0ca1\u0cbf \u2014 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0cb0\u0cbe\u0cae\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.",resetChatTitle:"\u0cb9\u0cca\u0cb8 \u0c9a\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc7?",resetChatMessage:"\u0c87\u0ca6\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 AI \u0c9a\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0cb0\u0cb5\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4 \u0cae\u0cc2\u0ca1\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",startFresh:"\u0cb9\u0cca\u0cb8\u0ca6\u0cbe\u0c97\u0cbf \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf",startingFresh:"\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6..."},phrases:{p1le0g3x:"\u0c85\u0c9c\u0ccd\u0c9e\u0cbe\u0ca4",p3rvtpe:"\u0c87\u0c82\u0ca6\u0cc1",poh8cad:"\u0ca8\u0cbf\u0ca8\u0ccd\u0ca8\u0cc6",p1mrhzr7:"\u0c92\u0cb3\u0cac\u0cb0\u0cc1\u0cb5",pfebfdv:"\u0cb9\u0cca\u0cb0\u0cb9\u0ccb\u0c97\u0cc1\u0cb5",p17k42kg:"\u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc6",pvw9wg8:"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6",p15m090m:"\u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",p1q8utwa:"\u0cac\u0cbe\u0c95\u0cbf\u0caf\u0cbf\u0ca6\u0cc6",pcqxqrc:"\u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cc1",p15oehty:"\u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cc1",p17tqvf1:"\u0cb2\u0cc8\u0cb5\u0ccd \u0c9a\u0cbe\u0c9f\u0ccd",pos6ydf:"\u0ca8\u0cae\u0ccd\u0cae \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0ca4\u0c82\u0ca1\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c9a\u0cbe\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",p1jk4gbo:"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0c92\u0cb3\u0c97\u0cc6 \u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd",pztgw94:"\u0c95\u0cb0\u0cc6 \u0cac\u0cc6\u0c82\u0cac\u0cb2",pig8opb:"\u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca4\u0ca8\u0cbe\u0ca1\u0cbf",pla6vae:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cac\u0cc6\u0c82\u0cac\u0cb2",p12y1fw5:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",pi7el9x:"24 \u0c97\u0c82\u0c9f\u0cc6\u0c97\u0cb3 \u0c92\u0cb3\u0c97\u0cc6",peza8d7:"\u0cb9\u0cc1\u0cae\u0cc7\u0cb2\u0cbf\u0caf\u0cca",p1k70v3b:"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf",pi7p4si:"24/7 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6",ptmpaw1:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cac\u0cc1\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1?",pq44ijf:"\u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cbf\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1, \u0c95\u0ca8\u0ccd\u0cb8\u0cb2\u0ccd\u0c9f\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3 \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd\u200c\u0c97\u0cc6 \u0ca8\u0ccd\u0caf\u0cbe\u0cb5\u0cbf\u0c97\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cae\u0cbe\u0cb2\u0ccb\u0c9a\u0ca8\u0cc6\u0caf \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf.",pvi5gau:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",pfqgfyn:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0caf\u0cbe\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0c85\u0ca7\u0cbf\u0cb5\u0cc7\u0cb6\u0ca8\u0c95\u0ccd\u0c95\u0cc6 24 \u0c97\u0c82\u0c9f\u0cc6\u0c97\u0cb3 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0cb9\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.",p1h9bcwo:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0ca1\u0cc7\u0c9f\u0cbe \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7?",ps9lc26:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0c82\u0ca1\u0ccd-\u0c9f\u0cc1-\u0c8e\u0c82\u0ca1\u0ccd \u0c8e\u0ca8\u0ccd\u200c\u0c95\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u0cb6\u0ca8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0c82\u0ca1\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cbf-\u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0ca1\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0cc6\u0c95\u0ccd\u0caf\u0cc1\u0cb0\u0cbf\u0c9f\u0cbf \u0caa\u0ccd\u0cb0\u0ccb\u0c9f\u0ccb\u0c95\u0cbe\u0cb2\u0ccd\u200c\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0c82\u0ca6\u0cbf\u0c97\u0cc2 \u0cae\u0cc2\u0cb0\u0ca8\u0cc7 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",p1c63b9n:"\u0ca8\u0ca8\u0ccd\u0ca8 Wallet \u0c97\u0cc6 \u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1?",pfulep3:"Wallet \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \"\u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf\" \u0c9f\u0ccd\u0caf\u0cbe\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf \u2014 \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd, UPI, \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6 \u2014 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.",pex3sts:"\u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2",p1ofqfdp:"\u0c9c\u0ca8\u0caa\u0ccd\u0cb0\u0cbf\u0caf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1",p1m6uxly:"\u0c9a\u0cc6\u0cb5\u0ccd\u0cb0\u0cbe\u0ca8\u0ccd-\u0c85\u0caa\u0ccd",p9wx6ep:"\u0c9a\u0cc6\u0cb5\u0ccd\u0cb0\u0cbe\u0ca8\u0ccd-\u0ca1\u0ccc\u0ca8\u0ccd",pmkl5g0:"\u0ca4\u0c95\u0ccd\u0cb7\u0ca3\u0ca6 \u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc7?",p1ucr8ie:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf.",p1k15svg:"\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95",p1il8i8d:"\u0cac\u0cbf\u0c95\u0ccd\u0c95\u0c9f\u0ccd\u0c9f\u0cbf\u0ca8 \u0cb8\u0c82\u0caa\u0ca8\u0ccd\u0cae\u0cc2\u0cb2\u0c97\u0cb3\u0cc1",pgcsuld:"\u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf \u0cae\u0cbe\u0ca1\u0cbf",p1x9xuzh:"\u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0ccb\u0cb7 \u0c85\u0ca5\u0cb5\u0cbe \u0ca4\u0cbe\u0c82\u0ca4\u0ccd\u0cb0\u0cbf\u0c95 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0ca6\u0cc1\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe?",p18t3p8y:"\u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf \u0cae\u0cbe\u0ca1\u0cbf",p11jo8ku:"Humaeli \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf",prnsj34:"\u0c95\u0cca\u0ca8\u0cc6\u0caf\u0ca6\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6:",p8lq2oq:"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",pg6nyxd:"\u0c8e\u0c82\u0ca1\u0ccd-\u0c9f\u0cc1-\u0c8e\u0c82\u0ca1\u0ccd \u0c8e\u0ca8\u0ccd\u200c\u0c95\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u0cb6\u0ca8\u0ccd",pm4qf9j:"GDPR \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0cc0\u0c95\u0cc3\u0ca4 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6",p13tbyt3:"\u0c85\u0ca8\u0cbe\u0cae\u0ca7\u0cc7\u0caf \u0cb8\u0cae\u0cbe\u0cb2\u0ccb\u0c9a\u0ca8\u0cc6",p1474pj6:"\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cb5\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1",p12ddn6e:"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd",p178beh:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb2\u0cbf\u0c82\u0c97",p1el3mqv:"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",p1uqyawh:"\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0cc1",p1j5drmg:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0cc8\u0c95\u0cc6 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",p1hshih:"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf",p4lwpxb:"\u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0cb0\u0cc6\u0c97\u0cb3\u0cc1",p16o5duv:"\u0cb8\u0c82\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1",pjualou:"\u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb2\u0c97\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1",p8fcohj:"\u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",pqugyus:"\u0ca8\u0cbf\u0cb0\u0c82\u0ca4\u0cb0 \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf",pxw259e:"\u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0\u0cb0 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",ppapyhl:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0c97\u0cb3\u0cc1",ppjebc6:"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf",prz84q3:"\u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cbe\u0ca6 \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cbe\u0cb0",p6bzi8o:"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf\u0c97\u0cb3\u0cc1",pfby3q4:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf",p1px010k:"\u0cb8\u0cae\u0caf\u0ccb\u0c9a\u0cbf\u0ca4 \u0c9c\u0ccd\u0c9e\u0cbe\u0caa\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",pl6oj3n:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1",pcisb5n:"\u0cb0\u0cc0\u0c9a\u0cbe\u0cb0\u0ccd\u0c9c\u0ccd \u0cae\u0ca4