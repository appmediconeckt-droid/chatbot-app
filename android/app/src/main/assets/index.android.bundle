d4d \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d",aiWellnessDesc:"\u0d2e\u0d3e\u0d28\u0d38\u0d3f\u0d15\u0d3e\u0d30\u0d4b\u0d17\u0d4d\u0d2f \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d35\u0d4b\u0d2f\u0d4d\u200c\u0d38\u0d4d \u0d07\u0d7b\u0d2a\u0d41\u0d1f\u0d4d\u0d1f\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d31\u0d41\u0d2a\u0d1f\u0d3f\u0d15\u0d7e \u0d28\u0d47\u0d1f\u0d41\u0d15, \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d2e\u0d40\u0d2a\u0d15\u0d3e\u0d32 AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15.",aiWellnessAction:"AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15",counselorSupport:"\u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23",counselorDesc:"\u0d2a\u0d30\u0d3f\u0d1a\u0d30\u0d23\u0d02 \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d2a\u0d47\u0d30\u0d4d, \u0d38\u0d4d\u0d2a\u0d46\u0d37\u0d4d\u0d2f\u0d32\u0d48\u0d38\u0d47\u0d37\u0d7b, \u0d2d\u0d3e\u0d37, \u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02, \u0d31\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d4d, \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d02 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c\u0d2e\u0d3e\u0d30\u0d46 \u0d2c\u0d4d\u0d30\u0d57\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",counselorAction:"\u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d31\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d15",appointments:"\u0d28\u0d3f\u0d2f\u0d2e\u0d28\u0d19\u0d4d\u0d19\u0d7e",appointmentsDesc:"\u0d35\u0d30\u0d3e\u0d28\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c\u0d2e\u0d3e\u0d30\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d46\u0d37\ufffd\ufffd\u0d41\u0d15\u0d7e \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",appointmentsAction:"\u0d28\u0d3f\u0d2f\u0d2e\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d3e\u0d23\u0d41\u0d15",walletPayments:"\u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d33\u0d41\u0d02",walletDesc:"\u0d2a\u0d23\u0d02 \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d7e \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15.",walletAction:"\u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15",beforeContact:"\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\ufffd\ufffd\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d",checklist1:"\u0d12\u0d30\u0d41 \u0d32\u0d4b\u0d21\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d02 \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d07\u0d7b\u0d4d\u0d31\u0d7c\u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d23\u0d15\u0d4d\u0d37\u0d7b \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.",checklist2:"\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d38\u0d4d\u200c\u0d15\u0d4d\u0d30\u0d40\u0d7b\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d, \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d2f\u0d02, \u0d38\u0d4d\u200c\u0d15\u0d4d\u0d30\u0d40\u0d7b \u0d28\u0d3e\u0d2e\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d24\u0d2f\u0d4d\u0d2f\u0d3e\u0d31\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",checklist3:"\u0d15\u0d4d\u0d2f\u0d3e\u0d2e\u0d31, \u0d2e\u0d48\u0d15\u0d4d\u0d30\u0d4b\u0d2b\u0d4b\u0d7a, \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d, \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d, \u0d06\u0d26\u0d4d\u0d2f\u0d02 \u0d09\u0d2a\u0d15\u0d30\u0d23 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d05\u0d28\u0d41\u0d2e\u0d24\u0d3f\u0d15\u0d7e \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",checklist4:"\u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u200c\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d, \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d15\u0d3e\u0d23\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d24\u0d40\u0d2f\u0d24\u0d3f, \u0d24\u0d41\u0d15, \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d4d \u0d28\u0d3f\u0d32, \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d32\u0d7b\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d15.",commonIssues:"\u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d19\u0d4d\u0d19\u0d7e",aiChatNotReply:"AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d2e\u0d31\u0d41\u0d2a\u0d1f\u0d3f \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32",aiChatNotReplyDesc:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d07\u0d7b\u0d4d\u0d31\u0d7c\u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d23\u0d15\u0d4d\u0d37\u0d7b \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d12\u0d30\u0d41 \u0d1a\u0d46\u0d31\u0d3f\u0d2f \u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d02 \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d36\u0d4d\u0d30\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d07\u0d24\u0d4d \u0d07\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d41\u0d02 \u0d2a\u0d30\u0d3e\u0d1c\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d2a\u0d3f\u0d36\u0d15\u0d4d \u0d38\u0d4d\u0d15\u0d4d\u0d30\u0d40\u0d7b\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d41\u0d15.",counselorChatNotOpen:"\u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32",counselorChatNotOpenDesc:"\u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d31\u0d46 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d15\u0d3e\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d15\u0d57\ufffd\ufffd\u0d38\u0d3f\u0d32\u0d7c \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d15\u0d4d\u0d30\u0d40\u0d28\u0d3f\u0d7d \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d41\u0d02.",callNotConnecting:"\u0d15\u0d4b\u0d7e \u0d15\u0d23\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32",callNotConnectingDesc:"\u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d/\u0d38\u0d46\u0d37\u0d7b \u0d05\u0d02\u0d17\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d30\u0d23\u0d4d\u0d1f\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d02 \u0d13\u0d7a\u0d32\u0d48\u0d28\u0d3f\u0d32\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d2e\u0d48\u0d15\u0d4d\u0d30\u0d4b\u0d2b\u0d4b\u0d7a/\u0d15\u0d4d\u0d2f\u0d3e\u0d2e\u0d31 \u0d05\u0d28\u0d41\u0d2e\u0d24\u0d3f\u0d15\u0d7e \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15.",walletPaymentIssue:"\u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d02",walletPaymentIssueDesc:"\u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\ufffd\ufffd\ufffd \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d4d \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d24\u0d40\u0d2f\u0d24\u0d3f, \u0d24\u0d41\u0d15, \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d4d \u0d28\u0d3f\u0d32 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d41\u0d15.",languageWrongTitle:"\u0d2d\u0d3e\u0d37\u0d2f\u0d4b \u0d35\u0d3f\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d2e\u0d4b \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d2f\u0d3f \u0d24\u0d4b\u0d28\u0d4d\u0d28\u0d41\u0d28\u0d4d\u0d28\u0d41",languageWrongDesc:"\u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d4d/\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d2d\u0d3e\u0d37\u0d3e \u0d38\u0d46\u0d32\u0d15\u0d4d\u0d1f\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d1a\u0d3f\u0d32 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d46\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\ufffd\ufffd\u0d7e \u0d26\u0d3e\u0d24\u0d3e\u0d35\u0d4d \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d2d\u0d3e\u0d37\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d41\u0d02.",needMoreHelp:"\u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d38\u0d39\u0d3e\u0d2f\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",needMoreHelpDesc:"\u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d/\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d38\u0d4d\u200c\u0d15\u0d4d\u0d30\u0d40\u0d7b\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e, \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d2a\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d, \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d43 \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d/\u0d2b\u0d4b\u0d7a, \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u200c\u0d28\u0d02 \u0d38\u0d02\u0d2d\u0d35\u0d3f\u0d1a\u0d4d\u0d1a \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d2f\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d4a\u0d2a\u0d4d\u0d2a\u0d02 \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23. \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d38\u0d28\u0d4d\u0d27\u0d3f \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d4d, 9152987821 \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d32\ufffd\ufffd \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d05\u0d1f\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d30 \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d4b \u0d35\u0d3f\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",myProfile:"\u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d",settings:"\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e",emailSupport:"\u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23"},privacyPage:{title:"\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d02",centerTitle:"Humaeli \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02",centerDesc:"\u0d08 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d Humaeli \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d, \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d, \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d, \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d, \u0d15\u0d4b\u0d7e, \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b, \u0d38\u0d41\u0d30\u0d15\u0d4d\ufffd\ufffd\u0d3e \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d46\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d08 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d35\u0d3f\u0d36\u0d26\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",otpProtected:"OTP \u0d2a\u0d30\u0d3f\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d02",otpProtectedDesc:"\u0d07-\u0d2e\u0d46\u0d2f\u0d3f\u0d32\u0d41\u0d02 \u0d2b\u0d4b\u0d23\u0d41\u0d02 \u0d2e\u0d3e\u0d31\u0d41\u0d28\u0d4d\u0d28\u0d41",anonymousCare:"\u0d05\u0d1c\u0d4d\u0d1e\u0d3e\u0d24 \u0d2a\u0d30\u0d3f\u0d1a\u0d30\u0d23 \u0d10\u0d21\u0d7b\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f",anonCareDesc:"\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d1f\u0d24\u0d4d\u0d24\u0d4d \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c\u0d2e\u0d3e\u0d30\u0d46 \u0d15\u0d3e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",sensitiveAreas:"\u0d38\u0d46\u0d7b\u0d38\u0d3f\u0d31\u0d4d\u0d31\u0d40\u0d35\u0d4d \u0d0f\u0d30\u0d3f\u0d2f\u0d15\u0d7e",sensitiveAreasDesc:"\u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d15\u0d4b\u0d33\u0d41\u0d15\u0d7e, \u0d15\u0d42\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u200c\u0d1a\u0d15\u0d7e, \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d",dataUsedTitle:"\u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a \u0d21\u0d3e\u0d31\u0d4d\u0d31",profileHealth:"\u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d41\u0d02 \u0d06\u0d30\u0d4b\u0d17\u0d4d\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02",profileHealthDesc:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d4d, \u0d05\u0d1c\u0d4d\u0d1e\u0d3e\u0d24 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d28 \u0d28\u0d3e\u0d2e\u0d02, \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d02, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e, \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b/\u0d05\u0d35\u0d24\u0d3e\u0d7c, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02, \u0d05\u0d1f\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d30 \u0d15\u0d4b\u0d7a\u0d1f\u0d3e\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d4d, \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d2e\u0d46\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e, \u0d07\u0d7b\u0d37\u0d41\u0d31\u0d7b\u0d38\u0d4d \u0d2b\u0d40\u0d7d\u0d21\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d30\u0d4b\u0d17\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",aiConversations:"AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d, \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d38\u0d02\u0d2d\u0d3e\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d7e",aiConversationsDesc:"\u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e, \u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d31\u0d41\u0d2a\u0d1f\u0d3f\u0d15\u0d7e, \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d3f\u0d32, \u0d05\u0d31\u0d4d\u0d31\u0d3e\u0d1a\u0d4d\u0d1a\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d37\u0d28\u0d41\u0d15\u0d7e, \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d38\u0d02\u0d2d\u0d3e\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d31\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d4d\u0d30\u0d4b\u0d02\u0d2a\u0d4d\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",appointments:"\u0d28\u0d3f\u0d2f\u0d2e\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d38\u0d46\u0d37\u0d28\u0d41\u0d15\u0d33\u0d41\u0d02",appointmentsDesc:"\u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d24\u0d40\u0d2f\u0d24\u0d3f, \u0d38\u0d2e\u0d2f\u0d02, \u0d15\u0d3e\u0d30\u0d23\u0d02/\u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d, \u0d28\u0d3f\u0d2f\u0d41\u0d15\u0d4d\u0d24 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c, \u0d15\u0d4b\u0d7e \u0d2e\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d21\u0d3e\u0d31\u0d4d\u0d31, \u0d38\u0d46\u0d37\u0d7b \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46\u0d2f\u0d41\u0d02 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c\u0d2e\u0d3e\u0d30\u0d46\u0d2f\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d1a\u0d30\u0d23\u0d02 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",wallet:"\u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d41\u0d02 \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d33\u0d41\u0d02",walletDesc:"\u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d32\u0d7b\u0d38\u0d4d, \u0d1f\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d-\u0d05\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d4d \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d41\u0d15\u0d7e, \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d21\u0d4d \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e, \u0d05\u0d28\u0d41\u0d2c\u0d28\u0d4d\u0d27 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d2d\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",location:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d15\u0d30\u0d23 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d2d\u0d35\u0d41\u0d02",locationDesc:"\u0d38\u0d46\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\ufffd\ufffd\ufffd\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d2f\u0d46 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b-\u0d05\u0d35\u0d2f\u0d7c \u0d15\u0d46\u0d2f\u0d7c \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d2e\u0d46\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d38\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u0d2a\u0d4d, \u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d3e\u0d28\u0d41\u0d35\u0d7d \u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3f\u0d7d \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d15\u0d4d\u0d2f\u0d3e\u0d2a\u0d4d\u200c\u0d1a\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02.",security:"\u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d2f\u0d41\u0d02 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d\u0d38\u0d41\u0d02",securityDesc:"\u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d1f\u0d4b\u0d15\u0d4d\u0d15\u0d23\u0d41\u0d15\u0d7e, \u0d13\u0d24\u0d4d\u0d24\u0d4d \u0d2a\u0d4d\u0d30\u0d4a\u0d35\u0d48\u0d21\u0d7c, \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d, OTP \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28, \u0d31\u0d4b\u0d7e, \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d46\u0d2f\u0d41\u0d02 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d0f\u0d30\u0d3f\u0d2f\u0d15\u0d33\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d47\u0d7c\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\ufffd\ufffd\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",whoCanSee:"\u0d06\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02",visibleToYou:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d",visibleDesc:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d, AI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d07\u0d1f\u0d2a\u0d46\u0d1f\u0d32\u0d41\u0d15\u0d7e, \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d, \u0d15\u0d4b\u0d7e \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d31\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d4d\u0d30\u0d4b\u0d02\u0d2a\u0d4d\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b/\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d15\u0d3e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",sharedForCare:"\u0d2a\u0d30\u0d3f\u0d1a\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f\u0d41",sharedDesc:"\u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 \u0d38\u0d46\u0d37\u0d28\u0d41\u0d15\u0d7e, \u0d15\u0d42\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u200c\u0d1a\u0d15\u0d7e, \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d38\u0d02\u0d2d\u0d3e\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c\u0d2e\u0d3e\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d1f\u0d24\u0d4d\u0d24\u0d4d \u0d05\u0d1c\u0d4d\u0d1e\u0d3e\u0d24 \u0d10\u0d21\u0d7b\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",protectedAccess:"\u0d06\u0d15\u0d4d\u0d38\u0d38\u0d4d \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d3e\u0d7d \u0d2a\u0d30\u0d3f\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",protectedDesc:"\u0d31\u0d4b\u0d7e, \u0d06\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d40\u0d35\u0d4d \u0d38\u0d46\u0d37\u0d28\u0d41\u0d15\u0d7e, OTP \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28, \u0d06\u0d27\u0d3f\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d2e\u0d3e\u0d2f API \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d7b\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d31\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d0f\u0d30\u0d3f\u0d2f\u0d15\u0d33\u0d46 \u0d35\u0d47\u0d7c\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",checklist:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d\u200c\u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d",checklistItem1:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d47\u0d30\u0d4d \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d24\u0d3e\u0d7d\u0d2a\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d4b\u0d7e \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c \u0d07\u0d1f\u0d2a\u0d46\u0d1f\u0d32\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d1c\u0d4d\u0d1e\u0d3e\u0d24 \u0d28\u0d3e\u0d2e\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",checklistItem2:"\u0d05\u0d1f\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d30 \u0d15\u0d4b\u0d7a\u0d1f\u0d3e\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d4d, \u0d2e\u0d46\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d42\ufffd\ufffd\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d35 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",checklistItem3:"\u0d15\u0d4b\u0d33\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b, \u0d15\u0d4d\u0d2f\u0d3e\u0d2e\u0d31, \u0d2e\u0d48\u0d15\u0d4d\u0d30\u0d4b\u0d2b\u0d4b\u0d7a \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d15\u0d30\u0d23 \u0d05\u0d28\u0d41\u0d2e\u0d24\u0d3f\u0d15\u0d7e \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",checklistItem4:"\u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d2a\u0d4d\u0d30\u0d4b\u0d02\u0d2a\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e/\u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d28\u0d47\u0d30\u0d3f\u0d1f\u0d4d\u0d1f\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",checklistItem5:"\u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d28\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d OTP-\u0d15\u0d7e, \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d41\u0d15\u0d7e \u0d05\u0d32\u0d4d\u0d32\ufffd\ufffd\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d38\u0d46\u0d7b\u0d38\u0d3f\u0d31\u0d4d\u0d31\u0d40\u0d35\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d30\u0d41\u0d24\u0d4d.",checklistItem6:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d3f\u0d7d \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d41\u0d02 \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",manageData:"\u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",securitySettings:"\u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d15\u0d4d\u0d30\u0