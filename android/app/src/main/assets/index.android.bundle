0\u0942 \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1gpc6bq:"\u092a\u0939\u093f\u0932\u0947 \u0928\u0948 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0917\u0930\u093f\u090f\u0915\u094b \u091b",phktjc1:"\u091b\u093f\u091f\u094b \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pobyv8w:"\u0935\u093f\u0928\u094d\u0921\u094b\u0932\u093e\u0908 \u092f\u0938\u0915\u094b \u0906\u092b\u094d\u0928\u0948 \u0926\u093e\u092f\u0930\u093e\u0915\u094b \u0930\u0942\u092a\u092e\u093e \u0925\u092a\u094d\u0928 \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \xb7 \u092f\u0938\u0932\u093e\u0908 \u0939\u091f\u093e\u0909\u0928 \u092b\u0947\u0930\u093f \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pq2yzs0:"\u0928\u092f\u093e\u0901 \u0938\u092e\u092f \u0926\u093e\u092f\u0930\u093e",p3t046y:"\u0926\u093e\u092f\u0930\u093e",py3pzol:"\u0905\u0930\u094d\u0915\u094b \u0938\u092e\u092f \u0926\u093e\u092f\u0930\u093e \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pyjl545:"\u0938\u0915\u093f\u092f\u094b",pwbz9t1:"\u0939\u092a\u094d\u0924\u093e\u0915\u094b \u0926\u093f\u0928",pyirr4h:"\u092e\u093f\u0924\u093f",p10y91bp:"\u092e\u093f\u0924\u093f\u0939\u0930\u0942\u092e\u093e \u0938\u092c\u0948 \u0926\u093e\u092f\u0930\u093e\u0939\u0930\u0942 \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1m4df8h:"\u0939\u092a\u094d\u0924\u093e\u0915\u093e \u0926\u093f\u0928\u0939\u0930\u0942\u092e\u093e \u0938\u092c\u0948 \u0926\u093e\u092f\u0930\u093e\u0939\u0930\u0942 \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p6ihe55:"\u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0926\u093e\u092f\u0930\u093e\u0939\u0930\u0942 \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pvoxjrn:"\u092f\u0938 \u092e\u093f\u0924\u093f\u0915\u094b \u0932\u093e\u0917\u093f \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e\u0964",p3582sj:"\u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u0915\u093e\u0930\u0923",piss19p:"\u091c\u0938\u094d\u0924\u0948, \u0906\u092a\u0924\u0915\u093e\u0932\u0940\u0928, \u092c\u093f\u0926\u093e, \u0938\u092e\u094d\u092e\u0947\u0932\u0928, \u0905\u0938\u094d\u092a\u0924\u093e\u0932 \u0921\u094d\u092f\u0941\u091f\u0940...",pm4sdft:"\u092b\u0947\u0930\u093f \u0909\u092a\u0932\u092c\u094d\u0927 \u091a\u093f\u0928\u094d\u0939 \u0932\u0917\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",p1fq7d8b:"\u092f\u0938 \u092e\u093f\u0924\u093f\u0915\u094b \u0932\u093e\u0917\u093f \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u091a\u093f\u0928\u094d\u0939 \u0932\u0917\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",p36zutm:"\u092f\u094b \u0913\u092d\u0930\u0930\u093e\u0907\u0921 \u092e\u093e \u092e\u093e\u0924\u094d\u0930 \u0932\u093e\u0917\u0942 \u0939\u0941\u0928\u094d\u091b",pz8v7p9:"\u0964 \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0905\u0928\u094d\u092f \u092e\u093f\u0932\u094d\u0926\u094b \u0926\u093f\u0928\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u094d\u091b\u0964",p1f1mr6f:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094d\u0932\u091f\u0939\u0930\u0942",pgq4xk3:"\u0915\u0941\u0928\u0948 \u092e\u093f\u0924\u093f-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0938\u094d\u0932\u091f\u0939\u0930\u0942 \u091b\u0948\u0928\u0928\u094d\u0964 \u092f\u094b \u092e\u093f\u0924\u093f \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u092d\u090f\u0938\u092e\u094d\u092e \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0938\u094d\u0932\u091f\u0939\u0930\u0942 \u0905\u091d\u0948 \u092a\u0928\u093f \u0932\u093e\u0917\u0942 \u0939\u0941\u0928 \u0938\u0915\u094d\u091b\u0928\u094d\u0964",p7grppl:"\u092f\u094b \u092e\u093f\u0924\u093f\u0915\u094b \u0932\u093e\u0917\u093f \u0938\u094d\u0932\u091f \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1c0orqa:"\u092f\u094b \u092e\u093f\u0924\u093f \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u092d\u0928\u0940 \u091a\u093f\u0928\u094d\u0939 \u0932\u0917\u093e\u0907\u090f\u0915\u094b \u091b\u0964 \u092f\u0938\u0932\u093e\u0908 \u092a\u0941\u0928: \u0909\u092a\u0932\u092c\u094d\u0927 \u0917\u0930\u093e\u0909\u0928\u0915\u094b \u0932\u093e\u0917\u093f \u0905\u092a\u0935\u093e\u0926 / \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u091f\u094d\u092f\u093e\u092c \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pub8y2o:"\u0938\u094d\u0932\u091f \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pf7qw91:"#98A2B3",pptqbmh:"\u0938\u0947\u091f \u0917\u0930\u094d\u0928 \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1mr3qhl:"\u0938\u0941\u0930\u0941 \u0930 \u0905\u0928\u094d\u0924\u094d\u092f \u0938\u092e\u092f \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0935\u093e \u0926\u094d\u0930\u0941\u0924 \u092a\u094d\u0930\u093f\u0938\u0947\u091f \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pql9o6w:"\u26a0 \u0905\u0928\u094d\u0924\u094d\u092f \u0938\u092e\u092f \u0938\u0941\u0930\u0941 \u0938\u092e\u092f \u092a\u091b\u093f \u0939\u0941\u0928\u0941\u092a\u0930\u094d\u091b\u0964",pyjcgox:"\u0938\u094d\u0932\u091f",p1ukkknd:"\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e \u0938\u0941\u0935\u093f\u0927\u093e",ppn2w2a:"\u0935\u093f\u092d\u093e\u0917\u0939\u0930\u0942",p1oja0lh:"\u092c\u093f\u0930\u093e\u092e\u0940\u0939\u0930\u0942",pyjma0l:"\u0913\u091b\u094d\u092f\u093e\u0928",p190fyyv:"\u0915\u094d\u0932\u093f\u0928\u093f\u0915",pzqdpnr:"\u0905\u092c \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p130gt5m:"\u0915\u0941\u0928\u0948 \u092e\u0942\u0932\u094d\u092f\u093e\u0919\u094d\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u091b\u0948\u0928",p18