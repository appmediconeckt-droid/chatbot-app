43e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441",pdkk7ab:"\u0415\u043a\u0441\u0442\u0440\u0435\u043d\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430",p6s9e29:"\u0414\u043e\u043f\u043e\u043c\u043e\u0436\u0456\u0442\u044c \u043f\u0430\u0446\u0456\u0454\u043d\u0442\u0430\u043c \u043f\u043e\u0431\u043b\u0438\u0437\u0443 \u0432\u0430\u0441 \u0437\u043d\u0430\u0439\u0442\u0438",p1kc2xvx:"\u041c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u0443\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u041c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438, \u0430 \u043f\u043e\u0442\u0456\u043c \u043f\u043e\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f.",pj1z8my:"\u0411\u0435\u0437 \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0430\u0446\u0456\u0454\u043d\u0442\u0438, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u044f\u0442\u044c\u0441\u044f \u043f\u043e\u0431\u043b\u0438\u0437\u0443, \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0435 \u0437\u043d\u0430\u0439\u0442\u0438 \u0432\u0430\u0448 \u043f\u0440\u043e\u0444\u0456\u043b\u044c, \u0430 \u0437\u0430\u0445\u0438\u0441\u0442 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0431\u0443\u0434\u0435 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0434\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435.",pe2sfkx:"\u0420\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0441\u0435 \u0449\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e. \u0422\u0430\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457, \u044f\u043a \u0432\u0438\u0434\u0438\u043c\u0456\u0441\u0442\u044c \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u0442\u0430 \u0437\u0430\u0445\u0438\u0441\u0442 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f, \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438\u043c\u0443\u0442\u044c \u043d\u0430\u043b\u0435\u0436\u043d\u0438\u043c \u0447\u0438\u043d\u043e\u043c.",p1bc8b0q:"\u0411\u0435\u0437 \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0432\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u0456\u0432 \u043f\u043e\u0431\u043b\u0438\u0437\u0443, \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0442\u0430 \u0435\u043a\u0441\u0442\u0440\u0435\u043d\u0443 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0443. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0434\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435.",p1kxnr6x:"\u0420\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0441\u0435 \u0449\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e. \u0422\u0430\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457, \u044f\u043a \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u0438 \u043f\u043e\u0431\u043b\u0438\u0437\u0443 \u0442\u0430 \u0435\u043a\u0441\u0442\u0440\u0435\u043d\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430, \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438\u043c\u0443\u0442\u044c \u043d\u0430\u043b\u0435\u0436\u043d\u0438\u043c \u0447\u0438\u043d\u043e\u043c.",p1qfkxpw:"\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f",p19izdw2:"\u0417\u0430\u043f\u0438\u0442...",pudz60s:"\u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f\u2026",p1nyz8sj:"\ud83d\udd04 \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443",p129dr11:"\ud83d\udccd \u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f",p13kffw5:"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0431\u0435\u0437 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f",pr2p72l:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0435 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f",pi9375l:"\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f",p1xmhdqy:"\u0414\u0435\u044f\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438\u043c\u0443\u0442\u044c \u0431\u0435\u0437 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f. \u041c\u0438 \u043d\u0430\u043f\u043e\u043b\u0435\u0433\u043b\u0438\u0432\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0439\u043e\u0433\u043e.",p1ismk4q:"\u0414\u043b\u044f \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u043e\u0433\u043e \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u0434\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f. \u0426\u0435 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043d\u0430\u043c \u043a\u0440\u0430\u0449\u0435 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0441 \u0456 \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438 \u0432\u0430\u0441.",p1rsaitz:"\u0427\u043e\u043c\u0443 \u043d\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0430\u0448\u0435 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f",p1lwhuaj:"\ud83d\udd10 \u0412\u0430\u0448\u0435 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438. \u0412\u0456\u043d \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0440\u043e\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0456 \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0442\u0440\u0435\u0442\u0456\u043c \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c.",pi5yj9e:"\u041f\u0440\u043e\u043f\u0443\u0441\u043a \u043e\u0431\u043c\u0435\u0436\u0438\u0442\u044c \u0432\u0430\u0448 \u0434\u043e\u0441\u0432\u0456\u0434. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0443\u0434\u044c-\u043a\u043e\u043b\u0438 \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u