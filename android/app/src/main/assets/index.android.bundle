5ea",appointmentsDesc:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d5\u05d4\u05e7\u05d5\u05d3\u05de\u05d5\u05ea, \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d5\u05ea \u05d5\u05d4\u05d6\u05de\u05df \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05e2\u05dd \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05d6\u05de\u05d9\u05e0\u05d9\u05dd.",appointmentsAction:"\u05e6\u05e4\u05d5 \u05d1\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea",walletPayments:"\u05d0\u05e8\u05e0\u05e7 \u05d5\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd",walletDesc:"\u05d4\u05d5\u05e1\u05e3 \u05db\u05e1\u05e3, \u05e1\u05e7\u05d5\u05e8 \u05e2\u05e1\u05e7\u05d0\u05d5\u05ea, \u05d4\u05d5\u05e8\u05d3 \u05d3\u05d5\u05d7\u05d5\u05ea \u05d0\u05e8\u05e0\u05e7 \u05d5\u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8 \u05e2\u05dd \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd.",walletAction:"\u05d0\u05e8\u05e0\u05e7 \u05e4\u05ea\u05d5\u05d7",beforeContact:"\u05dc\u05e4\u05e0\u05d9 \u05e9\u05ea\u05e4\u05e0\u05d4 \u05dc\u05ea\u05de\u05d9\u05db\u05d4",checklist1:"\u05d0\u05e9\u05e8 \u05d0\u05ea \u05d7\u05d9\u05d1\u05d5\u05e8 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05e9\u05dc\u05da \u05d5\u05e8\u05e2\u05e0\u05df \u05d0\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d1\u05e2\u05d9\u05d9\u05ea \u05d8\u05e2\u05d9\u05e0\u05d4.",checklist2:"\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05e6\u05d9\u05dc\u05d5\u05dd \u05d4\u05de\u05e1\u05da \u05d4\u05e2\u05d3\u05db\u05e0\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d4\u05e9\u05e2\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d5\u05e9\u05dd \u05d4\u05de\u05e1\u05da \u05de\u05d5\u05db\u05df \u05d1\u05e2\u05ea \u200b\u200b\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05e2\u05dd \u05d4\u05ea\u05de\u05d9\u05db\u05d4.",checklist3:"\u05dc\u05d1\u05e2\u05d9\u05d5\u05ea \u05de\u05e6\u05dc\u05de\u05d4, \u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df, \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05d5\u05de\u05d9\u05e7\u05d5\u05dd, \u05d1\u05d3\u05d5\u05e7 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8.",checklist4:"\u05e2\u05d1\u05d5\u05e8 \u05d1\u05e2\u05d9\u05d5\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd, \u05db\u05dc\u05d5\u05dc \u05ea\u05d0\u05e8\u05d9\u05da, \u05e1\u05db\u05d5\u05dd, \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e2\u05e1\u05e7\u05d4 \u05d5\u05d9\u05ea\u05e8\u05ea \u05d0\u05e8\u05e0\u05e7 \u05d4\u05de\u05d5\u05e6\u05d2\u05d9\u05dd \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4.",commonIssues:"\u05d1\u05e2\u05d9\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea",aiChatNotReply:"\u05e6'\u05d0\u05d8 AI \u05dc\u05d0 \u05e2\u05d5\u05e0\u05d4",aiChatNotReplyDesc:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d7\u05d9\u05d1\u05d5\u05e8 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05e9\u05dc\u05da, \u05e0\u05e1\u05d4 \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05d5\u05e4\u05ea\u05d7 \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05e6'\u05d0\u05d8 \u05d4\u05d1\u05d9\u05e0\u05d4 \u05d4\u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea \u05de\u05dc\u05d5\u05d7 \u05d4\u05de\u05d7\u05d5\u05d5\u05e0\u05d9\u05dd. \u05d0\u05dd \u05d6\u05d4 \u05e2\u05d3\u05d9\u05d9\u05df \u05e0\u05db\u05e9\u05dc, \u05e9\u05ea\u05e3 \u05d0\u05ea \u05e6\u05d9\u05dc\u05d5\u05dd \u05d4\u05de\u05e1\u05da \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d4\u05e9\u05d2\u05d9\u05d0\u05d4 \u05e2\u05dd \u05d4\u05ea\u05de\u05d9\u05db\u05d4.",counselorChatNotOpen:"\u05e6'\u05d0\u05d8 \u05d4\u05d9\u05d5\u05e2\u05e5 \u05dc\u05d0 \u05e0\u05e4\u05ea\u05d7",counselorChatNotOpenDesc:"\u05e4\u05ea\u05d7 \u05d0\u05ea \u05ea\u05de\u05d9\u05db\u05ea \u05d4\u05d9\u05d5\u05e2\u05e5, \u05d1\u05d7\u05e8 \u05d9\u05d5\u05e2\u05e5 \u05d6\u05de\u05d9\u05df \u05d5\u05d4\u05de\u05ea\u05df \u05e2\u05d3 \u05e9\u05d4\u05d1\u05e7\u05e9\u05d4 \u05ea\u05ea\u05e7\u05d1\u05dc. \u05e6'\u05d0\u05d8\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05de\u05e1\u05da \u05d4\u05e6'\u05d0\u05d8 \u05e9\u05dc \u05d4\u05d9\u05d5\u05e2\u05e5.",callNotConnecting:"\u05d4\u05e9\u05d9\u05d7\u05d4 \u05dc\u05d0 \u05de\u05ea\u05d7\u05d1\u05e8\u05ea",callNotConnectingDesc:"\u05d5\u05d3\u05d0 \u05e9\u05d4\u05d9\u05d5\u05e2\u05e5 \u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05e6'\u05d0\u05d8/\u05d4\u05de\u05e4\u05d2\u05e9 \u05e9\u05dc\u05da, \u05e9\u05e0\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05de\u05d7\u05d5\u05d1\u05e8\u05d9\u05dd, \u05d5\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df/\u05de\u05e6\u05dc\u05de\u05d4 \u05de\u05d5\u05ea\u05e8\u05d5\u05ea.",walletPaymentIssue:"\u05d1\u05e2\u05d9\u05d9\u05ea \u05d0\u05e8\u05e0\u05e7 \u05d0\u05d5 \u05ea\u05e9\u05dc\u05d5\u05dd",walletPaymentIssueDesc:"\u05e4\u05ea\u05d7 \u05d0\u05ea \u05d0\u05e8\u05e0\u05e7 \u05db\u05d3\u05d9 \u05dc\u05e1\u05e7\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d5\u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d3\u05d5\u05d7. \u05e9\u05ea\u05e3 \u05d0\u05ea \u05d4\u05ea\u05d0\u05e8\u05d9\u05da, \u05d4\u05e1\u05db\u05d5\u05dd \u05d5\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d1\u05e2\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05e2\u05dd \u05d4\u05ea\u05de\u05d9\u05db\u05d4.",languageWrongTitle:"\u05d4\u05e9\u05e4\u05d4 \u05d0\u05d5 \u05d4\u05ea\u05e8\u05d2\u05d5\u05dd \u05e0\u05e8\u05d0\u05d9\u05dd \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd",languageWrongDesc:"\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d1\u05d5\u05e8\u05e8 \u05d4\u05e9\u05e4\u05d4 \u05de\u05dc\u05d5\u05d7 \u05d4\u05de\u05d7\u05d5\u05d5\u05e0\u05d9\u05dd/\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea. \u05d7\u05dc\u05e7 \u05de\u05d4\u05d9\u05d5\u05e2\u05e5 \u05d0\u05d5 \u05d4\ufffd\ufffd\u05e8\u05d8\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05d1\u05e9\u05e4\u05d4 \u05e9\u05d4\u05d5\u05d6\u05e0\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e1\u05e4\u05e7.",needMoreHelp:"\u05d6\u05e7\u05d5\u05e7 \u05dc\u05e2\u05d6\u05e8\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea?",needMoreHelpDesc:"\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05de\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc/\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea, \u05d0\u05d5 \u05ea\u05de\u05d9\u05db\u05ea \u05d3\u05d5\u05d0\"\u05dc \u05e2\u05dd \u05e6\u05d9\u05dc\u05d5\u05de\u05d9 \u05de\u05e1\u05da, \u05d2\u05e8\u05e1\u05ea \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4, \u05d3\u05d5\u05d0\"\u05dc/\u05d8\u05dc\u05e4\u05d5\u05df \u05de\u05e9\u05ea\u05de\u05e9 \u05d5\u05d4\u05e9\u05e2\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05e9\u05d4\u05d1\u05e2\u05d9\u05d4 \u05e7\u05e8\u05ea\u05d4. \u05dc\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05de\u05e9\u05d1\u05e8 \u05d1\u05d4\u05d5\u05d3\u05d5, \u05d4\u05ea\u05e7\u05e9\u05e8 \u05dc\u05de\u05e1\u05e4\u05e8 9152987821 \u05d0\u05d5 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd.",myProfile:"\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc\u05d9",settings:"\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea",emailSupport:"\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05d3\u05d5\u05d0\"\u05dc"},privacyPage:{title:"\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea",centerTitle:"\u05de\u05e8\u05db\u05d6 \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e9\u05dc Humaeli",centerDesc:"\u05de\u05e8\u05db\u05d6 \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d6\u05d4 \u05de\u05e1\u05d1\u05d9\u05e8 \u05db\u05d9\u05e6\u05d3 Humaeli \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d1\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc, \u05d1\u05e6'\u05d0\u05d8, \u05d1\u05e4\u05d2\u05d9\u05e9\u05d4, \u05d1\u05d0\u05e8\u05e0\u05e7, \u05d1\u05e9\u05d9\u05d7\u05d4, \u05d1\u05de\u05d9\u05e7\u05d5\u05dd \u05d5\u05d1\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05d0\u05d1\u05d8\u05d7\u05d4 \u05e9\u05dc\u05da \u05d1\u05ea\u05d5\u05da \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d6\u05d5 \u05dc\u05e0\u05d9\u05d9\u05d3.",otpProtected:"\u05de\u05d5\u05d2\u05df OTP",otpProtectedDesc:"\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d5\u05d1\u05d8\u05dc\u05e4\u05d5\u05df",anonymousCare:"\u05d6\u05d4\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9",anonCareDesc:"\u05d4\u05d5\u05e6\u05d2 \u05dc\u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05d4\u05d9\u05db\u05df \u05e9\u05d4\u05dd \u05e0\u05ea\u05de\u05db\u05d9\u05dd",sensitiveAreas:"\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05e8\u05d2\u05d9\u05e9\u05d9\u05dd",sensitiveAreasDesc:"\u05e6'\u05d0\u05d8\u05d9\u05dd, \u05e9\u05d9\u05d7\u05d5\u05ea, \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea, \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc",dataUsedTitle:"\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4",profileHealth:"\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d5\u05e4\u05e8\u05d8\u05d9 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea",profileHealthDesc:"\u05e9\u05de\u05da, \u05e9\u05dd \u05ea\u05e6\u05d5\u05d2\u05d4 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9, \u05d2\u05d9\u05dc, \u05de\u05d9\u05df, \u05e4\u05e8\u05d8\u05d9 \u05e7\u05e9\u05e8, \u05ea\u05de\u05d5\u05e0\u05d4/\u05d0\u05d5\u05d5\u05d8\u05e8, \u05db\u05ea\u05d5\u05d1\u05ea, \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05dc\u05e9\u05e2\u05ea \u05d7\u05d9\u05e8\u05d5\u05dd, \u05e4\u05e8\u05d8\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05d5\u05e9\u05d3\u05d5\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7 \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e9\u05dc\u05da.",aiConversations:"\u05e6'\u05d0\u05d8 \u05d1\u05d9\u05e0\u05d4 \u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea \u05d5\u05e9\u05d9\u05d7\u05d5\u05ea \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd",aiConversationsDesc:"\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea, \u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d5\u05ea, \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e6'\u05d0\u05d8, \u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd, \u05de\u05e4\u05d2\u05e9\u05d9 \u05e6'\u05d0\u05d8 \u05de\u05e7\u05d5\u05d1\u05dc\u05d9\u05dd \u05d5\u05e4\u05e8\u05d8\u05d9 \u05d9\u05d5\u05e2\u05e5 \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05dc\u05de\u05ea\u05df \u05e9\u05d9\u05d7\u05d5\u05ea, \u05d4\u05de\u05e9\u05da \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d5\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d3\u05d9\u05e8\u05d5\u05d2.",appointments:"\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05d5\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea",appointmentsDesc:"\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05d2\u05d9\u05e9\u05d4, \u05e9\u05e2\u05d4, \u05e1\u05d9\u05d1\u05d4/\u05d4\u05e2\u05e8\u05d5\u05ea, \u05e1\u05d8\u05d8\u05d5\u05e1, \u05d9\u05d5\u05e2\u05e5 \u05e9\u05d4\u05d5\u05e7\u05e6\u05d4, \u05de\u05d8\u05d0 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e9\u05d9\u05d7\u05d5\u05ea \u05d5\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e4\u05e2\u05dc\u05d5\u05ea \u05e2\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d5\u05dc\u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05dc\u05e0\u05d4\u05dc \u05d0\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc.",wallet:"\u05d0\u05e8\u05e0\u05e7 \u05d5\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea",walletDesc:"\u05d9\u05ea\u05e8\u05ea \u05d0\u05e8\u05e0\u05e7, \u05d4\u05d8\u05e2\u05d9\u05e0\u05d4, \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e2\u05e1\u05e7\u05d0\u05d5\u05ea, \u05d3\u05d5\u05d7\u05d5\u05ea \u05e9\u05e0\u05d5\u05e6\u05e8\u05d5 \u05d5\u05d4\u05e7\u05e9\u05e8 \u05ea\u05de\u05d9\u05db\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05dc\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd.",location:"\u05de\u05d9\u05e7\u05d5\u05dd \u05d5\u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05db\u05e9\u05d9\u05e8",locationDesc:"\u05e0\u05d9\u05ea\u05df \u05dc\u05dc\u05db\u05d5\u05d3 \u05d0\u05ea \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05d4\u05e8\u05e9\u05de\u05d4, \u05d1\u05db\u05e0\u05d9\u05e1\u05d4 \u05d0\u05d5 \u05d1\u05e8\u05e2\u05e0\u05d5\u05df \u05d9\u05d3\u05e0\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d0\u05de\u05ea \u05d4\u05e4\u05e2\u05dc\u05d5\u05ea, \u05dc\u05ea\u05de\u05d5\u05da \u05d1\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05d5\u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05dc\u05de\u05d9\u05e7\u05d5\u05dd.",security:"\u05d0\u05d1\u05d8\u05d7\u05d4 \u05d5\u05d2\u05d9\u05e9\u05d4 \u05dc\u05d7\u05e9\u05d1\u05d5\u05df",securityDesc:"\u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9 \u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea, \u05e1\u05e4\u05e7 \u05d0\u05d9\u05e9\u05d5\u05e8, \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e1\u05d9\u05e1\u05de\u05d4, \u05d0\u05d9\u05de\u05d5\u05ea OTP, \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d5\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d7\u05e9\u05d1\u05d5\u05df \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d3\u05d4 \u05d5\u05de\u05d5\u05d2\u05e0\u05ea \u05d1\u05d9\u05df \u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d5\u05d4\u05d9\u05d5\u05e2\u05e5.",whoCanSee:"\u05de\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05de\u05d4",visibleToYou:"\u05d2\u05dc\u05d5\u05d9 \u05dc\u05da",visibleDesc:"\u05dc\u05d5\u05d7 \u05d4\u05de\u05d7\u05d5\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da \u05de\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc\u05da, \u05e6'\u05d0\u05d8\u05d9\u05dd \u05e9\u05dc AI, \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05e2\u05dd \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd, \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea, \u05d0\u05e8\u05e0\u05e7, \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05d9\u05d7\u05d5\u05ea, \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d3\u05d9\u05e8\u05d5\u05d2 \u05d5\u05d1\u05e7\u05e8\u05d5\u05ea \u05de\u05d9\u05e7\u05d5\u05dd/\u05e2\u05d3\u05db\u05d5\u05df.",sharedForCare:"\u05de\u05e9\u05d5\u05ea\u05e3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc",sharedDesc:"\u05d4\u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05d3\u05e8\u05d5\u05e9 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05de\u05e7\u05d5\u05d1\u05dc\u05d5\u05ea, \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05d5\u05e9\u05d9\u05d7\u05d5\u05ea \u05ea\u05de\u05d9\u05db\u05d4. \u05d6\u05d4\u05d5\u05ea \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05ea \u05de\u05e9\u05de\u05e9\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d0 \u05e0\u05ea\u05de\u05db\u05ea.",protectedAccess:"\u05de\u05d5\u05d2\u05df \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d1\u05e7\u05e8\u05d5\u05ea \u05d2\u05d9\u05e9\u05d4",protectedDesc:"\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d5\u05d4\u05d9\u05d5\u05e2\u05e5 \u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05dc\u05e4\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3, \u05d4\u05e4\u05e2\u05dc\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea, \u05d0\u05d9\u05de\u05d5\u05ea OTP \u05d5\u05d1\u05e7\u05e9\u05d5\u05ea API \u05de\u05d0\u05d5\u05de\u05ea\u05d5\u05ea.",checklist:"\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05dc\u05da \u05dc\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea",checklistItem1:"\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e9\u05dd \u05d4\u05d0\u05dc\u05de\u05d5\u05e0\u05d9 \u05e9\u05dc\u05da \u05dc\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05e2\u05dd \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05e0\u05da \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d4\u05e9\u05dd \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05e9\u05dc\u05da \u05d9\u05d5\u05e6\u05d2.",checklistItem2:"\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05e7\u05e9\u05e8 \u05d5\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05de\u05d3\u05d5\u05d9\u05e7\u05d9\u05dd \u05d0\u05dd \u05ea\u05d1\u05d7\u05e8 \u05dc\u05de\u05dc\u05d0 \u05d0\u05d5\u05ea\u05dd.",checklistItem3:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05de\u05d9\u05e7\u05d5\u05dd, \u05de\u05e6\u05dc\u05de\u05d4 \u05d5\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05d7\u05d5\u05ea.",checklistItem4:"\u05e2\u05d3\u05db\u05df \u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9 \u05de\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea/\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d0\u05dd \u05d3\u05d9\u05dc\u05d2\u05d4 \u05e2\u05dc \u05d1\u05e7\u05e9\u05ea \u05d4\u05db\u05e0\u05d9\u05e1\u05d4.",checklistItem5:"\u05d0\u05dc \u05ea\u05e9\u05ea\u05e3 OTP, \u05e1\u05d9\u05e1\u05de\u05d0\u05d5\u05ea \u05d0\u05d5 \u05e4\u05e8\u05d8\u05d9 \u05d7\u05e9\u05d1\u05d5\u05df \u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e6'\u05d0\u05d8.",checklistItem6:"\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d5\u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e9