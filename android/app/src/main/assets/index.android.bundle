u062f \u06a9\u0631\u062f.",pvi5gau:"\u0686\u06af\u0648\u0646\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646\u0645 \u0644\u063a\u0648 \u06cc\u0627 \u0632\u0645\u0627\u0646 \u0628\u0646\u062f\u06cc \u0645\u062c\u062f\u062f \u06a9\u0646\u0645\u061f",pfqgfyn:"\u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a \u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u0627\u0632 \u0642\u0633\u0645\u062a \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a \u0647\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0646\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u06cc\u0632\u06cc \u0645\u062c\u062f\u062f \u06cc\u0627 \u0644\u063a\u0648\u060c \u0631\u0648\u06cc \u0647\u0631 \u0642\u0631\u0627\u0631 \u0628\u0639\u062f\u06cc \u0636\u0631\u0628\u0647 \u0628\u0632\u0646\u06cc\u062f. \u0644\u063a\u0648 24 \u0633\u0627\u0639\u062a \u0642\u0628\u0644 \u0627\u0632 \u062c\u0644\u0633\u0647 \u0648\u0627\u062c\u062f \u0634\u0631\u0627\u06cc\u0637 \u0628\u0627\u0632\u067e\u0631\u062f\u0627\u062e\u062a \u0627\u0633\u062a.",p1h9bcwo:"\u0622\u06cc\u0627 \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u0645\u0646 \u0627\u0645\u0646 \u0627\u0633\u062a\u061f",ps9lc26:"\u0628\u0644\u0647\u060c \u062a\u0645\u0627\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0648 \u067e\u0632\u0634\u06a9\u06cc \u0634\u0645\u0627 \u0628\u0627 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0633\u0631\u062a\u0627\u0633\u0631 \u0648 \u067e\u0631\u0648\u062a\u06a9\u0644 \u0647\u0627\u06cc \u0627\u0645\u0646\u06cc\u062a\u06cc \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f \u0635\u0646\u0639\u062a\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u0645\u06cc \u0634\u0648\u062f. \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0634\u0645\u0627 \u0647\u0631\u06af\u0632 \u0628\u062f\u0648\u0646 \u0631\u0636\u0627\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06af\u0630\u0627\u0634\u062a\u0647 \u0646\u0645\u06cc \u0634\u0648\u062f.",p1c63b9n:"\u0686\u06af\u0648\u0646\u0647 \u0648\u062c\u0648\u0647\u06cc \u0631\u0627 \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u062e\u0648\u062f \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u0645\u061f",pfulep3:"\u0628\u0647 \u062a\u0628 Wallet \u0628\u0631\u0648\u06cc\u062f \u0648 \u0631\u0648\u06cc \xab\u0627\u0641\u0632\u0648\u062f\u0646 \u067e\u0648\u0644\xbb \u0636\u0631\u0628\u0647 \u0628\u0632\u0646\u06cc\u062f. \u0631\u0648\u0634 \u067e\u0631\u062f\u0627\u062e\u062a \u062a\u0631\u062c\u06cc\u062d\u06cc \u062e\u0648\u062f - \u06a9\u0627\u0631\u062a\u060c UPI \u06cc\u0627 \u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u0627\u0646\u06a9\u06cc - \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f \u0648 \u0645\u0628\u0644\u063a\u06cc \u0631\u0627 \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f.",pex3sts:"\u06a9\u0645\u06a9 \u0648 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc",p1ofqfdp:"\u0633\u0648\u0627\u0644\u0627\u062a \u0631\u0627\u06cc\u062c",p1m6uxly:"\u0634\u0648\u0631\u0648\u0646 \u0622\u067e",p9wx6ep:"\u0634\u0648\u0631\u0648\u0646 \u067e\u0627\u06cc\u06cc\u0646",pmkl5g0:"\u0628\u0647 \u06a9\u0645\u06a9 \u0641\u0648\u0631\u06cc \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u06cc\u062f\u061f",p1ucr8ie:"\u0627\u06af\u0631 \u0628\u0627 \u06cc\u06a9 \u0627\u0648\u0631\u0698\u0627\u0646\u0633 \u067e\u0632\u0634\u06a9\u06cc \u0645\u0648\u0627\u062c\u0647 \u0647\u0633\u062a\u06cc\u062f\u060c \u0644\u0637\u0641\u0627\u064b \u0641\u0648\u0631\u0627\u064b \u0628\u0627 \u0627\u0648\u0631\u0698\u0627\u0646\u0633 \u0645\u062d\u0644\u06cc \u062e\u0648\u062f \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f.",p1k15svg:"\u062a\u0645\u0627\u0633 \u0627\u0636\u0637\u0631\u0627\u0631\u06cc",p1il8i8d:"\u0645\u0646\u0627\u0628\u0639 \u0628\u062d\u0631\u0627\u0646",pgcsuld:"\u06af\u0632\u0627\u0631\u0634 \u06cc\u06a9 \u0645\u0634\u06a9\u0644",p1x9xuzh:"\u0628\u0627 \u0645\u0634\u06a9\u0644 \u06cc\u0627 \u0645\u0634\u06a9\u0644 \u0641\u0646\u06cc \u062f\u0631 \u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0648\u0627\u062c\u0647 \u0634\u062f\u06cc\u062f\u061f",p18t3p8y:"\u06af\u0632\u0627\u0631\u0634 \u0645\u0633\u0626\u0644\u0647",p11jo8ku:"Humaeli \u0646\u0633\u062e\u0647",prnsj34:"\u0622\u062e\u0631\u06cc\u0646 \u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u0627\u0646\u06cc:",p8lq2oq:"\u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u0627\u0646\u06cc \u0647\u0627 \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f",pg6nyxd:"\u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0627\u0646\u062a\u0647\u0627 \u0628\u0647 \u0627\u0646\u062a\u0647\u0627",pm4qf9j:"\u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u0627\u06cc \u06af\u0648\u0627\u0647\u06cc GDPR",p13tbyt3:"\u0645\u0634\u0627\u0648\u0631\u0647 \u0646\u0627\u0634\u0646\u0627\u0633",p1474pj6:"\u062a\u0631\u0627\u06a9\u0646\u0634 \u0647\u0627\u06cc \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0627\u0645\u0646",p12ddn6e:"\u0646\u0645\u0627\u06cc\u0647 \u0634\u062e\u0635\u06cc",p178beh:"\u0646\u0627\u0645\u060c \u0633\u0646 \u0648 \u062c\u0646\u0633\u06cc\u062a",p1el3mqv:"\u062c\u0632\u0626\u06cc\u0627\u062a \u062a\u0645\u0627\u0633",p1uqyawh:"\u062a\u0631\u062c\u06cc\u062d\u0627\u062a \u0628\u0647\u062f\u0627\u0634\u062a\u06cc",p1j5drmg:"\u062a\u062c\u0631\u0628\u0647 \u0645\u0631\u0627\u0642\u0628\u062a \u062e\u0648\u062f \u0631\u0627 \u0634\u062e\u0635\u06cc \u06a9\u0646\u06cc\u062f",p1hshih:"\u0634\u0645\u0627 \u0631\u0627 \u0628\u0627 \u0645\u0634\u0627\u0648\u0631 \u0645\u0646\u0627\u0633\u0628 \u0647\u0645\u0627\u0647\u0646\u06af \u06a9\u0646\u06cc\u062f",p4lwpxb:"\u0686\u062a \u0648 \u062a\u0645\u0627\u0633",p16o5duv:"\u067e\u06cc\u0627\u0645 \u0647\u0627 \u0648 \u067e\u0627\u0633\u062e \u0647\u0627\u06cc \u0633\u0631\u06cc\u0639",pjualou:"\u0648\u0636\u0639\u06cc\u062a \u0686\u062a \u0648 \u067e\u06cc\u0648\u0633\u062a \u0647\u0627",p8fcohj:"\u062c\u0644\u0633\u0627\u062a \u0686\u062a \u067e\u0630\u06cc\u0631\u0641\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a",pqugyus:"\u0627\u0631\u0627\u0626\u0647 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0645\u06a9\u0627\u0644\u0645\u0647 \u0645\u062f\u0627\u0648\u0645",pxw259e:"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u0634\u0627\u0648\u0631 \u0631\u0627 \u062f\u0631 \u0637\u0648\u0644 \u062c\u0644\u0633\u0627\u062a \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f",ppapyhl:"\u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a \u0647\u0627",ppjebc6:"\u062a\u0627\u0631\u06cc\u062e \u0648 \u0633\u0627\u0639\u062a \u0631\u0632\u0631\u0648",prz84q3:"\u0645\u0634\u0627\u0648\u0631 \u0645\u0646\u062a\u062e\u0628",p6bzi8o:"\u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0647\u0627\u06cc \u062c\u0644\u0633\u0647",pfby3q4:"\u062c\u0644\u0633\u0627\u062a \u0622\u06cc\u0646\u062f\u0647 \u062e\u0648\u062f \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0646\u06cc\u062f",p1px010k:"\u0627\u0631\u0633\u0627\u0644 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0628\u0647 \u0645\u0648\u0642\u0639",pl6oj3n:"\u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0648 \u0645\u0639\u0627\u0645\u0644\u0627\u062a",pcisb5n:"\u0633\u0627\u0628\u0642\u0647 \u0634\u0627\u0631\u0698 \u0648 \u067e\u0631\u062f\u0627\u062e\u062a",p11x8ws5:"\u0633\u0648\u0627\u0628\u0642 \u0628\u0627\u0632\u067e\u0631\u062f\u0627\u062e\u062a",p1jezb8u:"\u0631\u0633\u06cc\u062f\u0647\u0627\u06cc \u062a\u0631\u0627\u06a9\u0646\u0634",p1kxmxol:"\u067e\u0631\u062f\u0627\u062e\u062a \u0647\u0627 \u0631\u0627 \u0627\u06cc\u0645\u0646 \u067e\u0631\u062f\u0627\u0632\u0634 \u06a9\u0646\u06cc\u062f",p1soeejn:"\u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0635\u0648\u0631\u062a\u062d\u063