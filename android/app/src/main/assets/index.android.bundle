\u0da7 \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad.",bookingFailed:"\u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a \u0dc0\u0dd2\u0dba",failedToBook:"\u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0dba.",accepted:"\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca\u0dad\u0dcf",searchCounselorPlaceholder:"\u0db1\u0db8, \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0dc4\u0ddd \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc3\u0ddc\u0dba\u0db1\u0dca\u0db1",sessionReasonPlaceholder:"\u0db8\u0dd9\u0db8 \u0dc3\u0dd0\u0dc3\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0d94\u0db6\u0da7 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0daf\u0dda \u0db6\u0dd9\u0daf\u0dcf \u0d9c\u0db1\u0dca\u0db1..."},helpPage:{title:"\u0d8b\u0daf\u0dc0\u0dca \u0d8b\u0db4\u0d9a\u0dcf\u0dbb",centerTitle:"Humaeli \u0d86\u0db0\u0dcf\u0dbb\u0d9a \u0db8\u0db0\u0dca\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba",centerDesc:"\u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 Humaeli \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c\u0dba\u0da7 \u0db4\u0dd0\u0db1\u0dd3\u0db8\u0da7, \u0db4\u0ddc\u0daf\u0dd4 \u0d9c\u0dd0\u0da7\u0dc5\u0dd4 \u0daf\u0ddd\u0dc1 \u0db1\u0dd2\u0dbb\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0dba\u0dd9\u0daf\u0dd4\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dad \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0d8b\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dca\u0dad\u0dda \u0d9a\u0dc0\u0daf\u0dcf\u0daf\u0dd0\u0dba\u0dd2 \u0dad\u0dda\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0dd9\u0db8 \u0dc3\u0dc4\u0dcf\u0dba \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1.",aiWellnessChat:"AI \u0dc3\u0dd4\u0dc0\u0dad\u0dcf \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca",aiWellnessDesc:"\u0db8\u0dcf\u0db1\u0dc3\u0dd2\u0d9a \u0dc3\u0dd4\u0dc0\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u0db1\u0dca\u0db1, \u0dc4\u0dac \u0d86\u0daf\u0dcf\u0db1\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d89\u0d9a\u0dca\u0db8\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db4\u0dd4\u0dc0\u0dbb\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d94\u0db6\u0dda \u0db8\u0dd1\u0dad \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0d9a\u0dbb\u0d9c\u0dd9\u0db1 \u0dba\u0db1\u0dca\u0db1.",aiWellnessAction:"AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1",counselorSupport:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc3\u0dc4\u0dcf\u0dba",counselorDesc:"\u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dbb \u0db1\u0db8, \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3\u0d9a\u0dbb\u0dab\u0dba, \u0db7\u0dcf\u0dc2\u0dcf\u0dc0, \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba, \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0db6\u0dd0\u0db3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db6\u0dca\u200d\u0dbb\u0dc0\u0dd4\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.",counselorAction:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd9\u0d9a\u0dd4 \u0dc3\u0ddc\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1",appointments:"\u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca",appointmentsDesc:"\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc3\u0dc4 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0dc3\u0dd0\u0dc3\u0dd2 \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1.",appointmentsAction:"\u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0db6\u0dbd\u0db1\u0dca\u0db1",walletPayments:"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba \u0dc3\u0dc4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca",walletDesc:"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0db6\u0dcf\u0d9c\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0dba \u0d85\u0db8\u0dad\u0db1\u0dca\u0db1.",walletAction:"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1",beforeContact:"\u0d94\u0db6 \u0dc3\u0dc4\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dbb",checklist1:"\u0db4\u0dd0\u0da7\u0dc0\u0dd3\u0db8\u0dda \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dbb \u0d94\u0db6\u0d9c\u0dda \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0da2\u0dcf\u0dbd \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0\u0dba \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb \u0dba\u0dd9\u0daf\u0dd4\u0db8 \u0db1\u0dd0\u0dc0\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.",checklist2:"\u0dc3\u0dc4\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd2\u0da7 \u0db1\u0dc0\u0dad\u0db8 \u0dad\u0dd2\u0dbb \u0dbb\u0dd4\u0dc0, \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad \u0dc0\u0dda\u0dbd\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dad\u0dd2\u0dbb \u0db1\u0db8 \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0db8\u0dca\u0dc0 \u0dad\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1.",checklist3:"\u0d9a\u0dd0\u0db8\u0dbb\u0dcf\u0dc0, \u0db8\u0dba\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dc6\u0ddd\u0db1\u0dba, \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0daf\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0d9c\u0dd0\u0da7\u0dc5\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf, \u0db4\u0dc5\u0db8\u0dd4\u0dc0 \u0d8b\u0db4\u0dcf\u0d82\u0d9c \u0dba\u0dd9\u0daf\u0dd4\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dbb \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1.",checklist4:"\u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0d9c\u0dd0\u0da7\u0dc5\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf, \u0dba\u0dd9\u0daf\u0dd4\u0db8\u0dda \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0daf\u0dd2\u0db1\u0dba, \u0db8\u0dd4\u0daf\u0dbd, \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0dc4 \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2 \u0dc1\u0dda\u0dc2\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.",commonIssues:"\u0db4\u0ddc\u0daf\u0dd4 \u0d9c\u0dd0\u0da7\u0dc5\u0dd4",aiChatNotReply:"AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0db1\u0ddc\u0daf\u0dda",aiChatNotReplyDesc:"\u0d94\u0db6\u0d9c\u0dda \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0da2\u0dcf\u0dbd \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0\u0dba \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d9a\u0dd9\u0da7\u0dd2 \u0db4\u0dab\u0dd2\u0dc0\u0dd2\u0da9\u0dba\u0d9a\u0dca \u0dba\u0dd0\u0dc0\u0dd3\u0db8\u0da7 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db4\u0dd4\u0dc0\u0dbb\u0dd4\u0dc0\u0dd9\u0db1\u0dca AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0d91\u0dba \u0dad\u0dc0\u0db8\u0dad\u0dca \u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a \u0dc0\u0dd4\u0dc0\u0dc4\u0ddc\u0dad\u0dca, \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0daf\u0ddd\u0dc2 \u0dad\u0dd2\u0dbb \u0dbb\u0dd4\u0dc0 \u0dc3\u0dc4\u0dba \u0dc3\u0db8\u0d9f \u0db6\u0dd9\u0daf\u0dcf \u0d9c\u0db1\u0dca\u0db1.",counselorChatNotOpen:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0db1\u0ddc\u0dc0\u0dda",counselorChatNotOpenDesc:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc3\u0dc4\u0dcf\u0dba \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd9\u0d9a\u0dd4 \u0dad\u0ddd\u0dbb\u0dcf, \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dbb\u0dd0\u0db3\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0db1. \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dad\u0dd2\u0dbb\u0dba\u0dda \u0daf\u0dd2\u0dc3\u0dca\u0dc0\u0dda.",callNotConnecting:"\u0d87\u0db8\u0dad\u0dd4\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0db1\u0ddc\u0dc0\u0dda",callNotConnectingDesc:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dcf \u0d94\u0db6\u0d9c\u0dda \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca/\u0dc3\u0dd0\u0dc3\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1, \u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a\u0dba\u0db1\u0dca \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf\u0db8 \u0dc3\u0db6\u0dd0\u0db3\u0dd2\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0db8\u0dba\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dc6\u0ddd\u0db1/\u0d9a\u0dd0\u0db8\u0dbb\u0dcf \u0d85\u0dc0\u0dc3\u0dbb\u0dc0\u0dbd\u0da7 \u0d85\u0dc0\u0dc3\u0dbb \u0d87\u0dad.",walletPaymentIssue:"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba \u0dc4\u0ddd \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dda \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0",walletPaymentIssueDesc:"\u0db1\u0dc0\u0dad\u0db8 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4\u0dc0 \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 Wallet \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dc3\u0dc4\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd2\u0da7 \u0daf\u0dd2\u0db1\u0dba, \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0dc4 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db6\u0dd9\u0daf\u0dcf \u0d9c\u0db1\u0dca\u0db1.",languageWrongTitle:"\u0db7\u0dcf\u0dc2\u0dcf\u0dc0 \u0dc4\u0ddd \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dbd\u0dd9\u0dc3 \u0db4\u0dd9\u0db1\u0dda",languageWrongDesc:"\u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db4\u0dd4\u0dc0\u0dbb\u0dd4\u0dc0/\u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db7\u0dcf\u0dc2\u0dcf \u0dad\u0dda\u0dbb\u0dd3\u0db8 \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dc3\u0db8\u0dc4\u0dbb \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0db1\u0dca \u0dc4\u0ddd \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0db4\u0dba\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db7\u0dcf\u0dc2\u0dcf\u0dc0\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dd4 \u0d87\u0dad.",needMoreHelp:"\u0dad\u0dc0\u0dad\u0dca \u0d8b\u0daf\u0dc0\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0daf?",needMoreHelpDesc:"\u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9/\u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca \u0dc0\u0dd9\u0dad\u0dd2\u0db1\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0dc4\u0ddd \u0dad\u0dd2\u0dbb\u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0d8a\u0db8\u0dda\u0dbd\u0dca \u0dc3\u0dc4\u0dcf\u0dba, \u0dba\u0dd9\ufffd\ufffd\u0dd4\u0db8\u0dca \u0d85\u0db1\u0dd4\u0dc0\u0dcf\u0daf\u0dba, \u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a \u0d8a\u0db8\u0dda\u0dbd\u0dca/\u0daf\u0dd4\u0dbb\u0d9a\u0dae\u0db1\u0dba \u0dc3\u0dc4 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad \u0dc0\u0dda\u0dbd\u0dcf\u0dc0. \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0dc3\u0dc4\u0dba \u0dc3\u0db3\u0dc4\u0dcf, 9152987821 \u0dc4\u0ddd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0dda\u0dc0\u0dcf \u0d85\u0db8\u0dad\u0db1\u0dca\u0db1.",myProfile:"\u0db8\u0d9c\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9",settings:"\u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca",emailSupport:"\u0d8a\u0db8\u0dda\u0dbd\u0dca \u0dc3\u0dc4\u0dcf\u0dba"},privacyPage:{title:"\u0dbb\u0dc4\u0dc3\u0dca\u200d\u0dba\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba",centerTitle:"Humaeli \u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a\u0dad\u0dca\u0dc0 \u0db8\u0db0\u0dca\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba",centerDesc:"Humaeli \u0db8\u0dd9\u0db8 \u0da2\u0d82\u0d9c\u0db8 \u0dba\u0dd9\u0daf\u0dd4\u0db8 \u0dad\u0dd4\u0dc5 \u0d94\u0db6\u0d9c\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9, \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca, \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba, \u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca, \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0dc4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0daf\u0dad\u0dca\u0dad \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0db8\u0dd9\u0db8 \u0dbb\u0dc4\u0dc3\u0dca\u200d\u0dba\u0dad\u0dcf \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0d9a\u0dbb\u0dba\u0dd2.",otpProtected:"OTP \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0dd2",otpProtectedDesc:"\u0d8a\u0db8\u0dda\u0dbd\u0dca \u0dc3\u0dc4 \u0daf\u0dd4\u0dbb\u0d9a\u0dae\u0db1 \u0dc0\u0dd9\u0db1\u0dc3\u0dca\u0d9a\u0db8\u0dca",anonymousCare:"\u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf\u0db8\u0dd2\u0d9a \u0dc3\u0dad\u0dca\u0d9a\u0dcf\u0dbb \u0d85\u0db1\u0db1\u0dca\u200d\u0dba\u0dad\u0dcf\u0dc0\u0dba",anonCareDesc:"\u0dc3\u0dc4\u0dcf\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda",sensitiveAreas:"\u0dc3\u0d82\u0dc0\u0dda\u0daf\u0dd3 \u0db4\u0dca\u0dbb\u0daf\u0dda\u0dc1",sensitiveAreasDesc:"\u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca, \u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca, \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca, \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9",dataUsedTitle:"\u0dba\u0dd9\u0daf\u0dd4\u0db8\u0dda \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0daf\u0dad\u0dca\u0dad",profileHealth:"\u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0dc3\u0dc4 \u0dc3\u0dde\u0d9b\u0dca\u0dba \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb",profileHealthDesc:"\u0d94\u0db6\u0dda \u0db1\u0db8, \u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf\u0db8\u0dd2\u0d9a \u0dc3\u0d82\u0daf\u0dbb\u0dca\u0dc1\u0d9a \u0db1\u0db8, \u0dc0\u0dba\u0dc3, \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0db4\u0dd4\u0dbb\u0dd4\u0dc2 \u0db7\u0dcf\u0dc0\u0dba, \u0dc3\u0db8\u0dca\u0db6\ufffd\ufffd\u0dca\u0db0\u0dad\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb, \u0da1\u0dcf\u0dba\u0dcf\u0dbb\u0dd6\u0db4\u0dba/\u0d87\u0dc0\u0da7\u0dcf\u0dbb\u0dca, \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba, \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf, \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4, \u0dc3\u0dc4 \u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0d94\u0db6\u0dda \u0dbb\u0ddd\u0d9c\u0dd2\u0dba\u0dcf\u0d9c\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd9\u0dbb\u0dda.",aiConversations:"AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc3\u0dc4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc3\u0d82\u0dc0\u0dcf\u0daf",aiConversationsDesc:"\u0db4\u0dab\u0dd2\u0dc0\u0dd2\u0da9, \u0d89\u0d9a\u0dca\u0db8\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4, \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u200d\u0dc0\u0dba, \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0dca, \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc3\u0dd0\u0dc3\u0dd2, \u0dc3\u0dc4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0d82\u0dc0\u0dcf\u0daf \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0da7, \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d9c\u0dd9\u0db1 \u0dba\u0dcf\u0db8\u0da7, \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dda\u0dbb\u0d9a\u0dc0\u0dbd\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0dc0\u0dd3\u0db8\u0da7 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd9\u0dbb\u0dda.",appointments:"\u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0dc3\u0dd0\u0dc3\u0dd2",appointmentsDesc:"\u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0daf\u0dd2\u0db1\u0dba, \u0dc0\u0dda\u0dbd\u0dcf\u0dc0, \u0dc4\u0dda\u0dad\u0dd4\u0dc0/\u0dc3\u0da7\u0dc4\u0db1\u0dca, \u0dad\u0dad\u0dca\u0dad\u0dca\u200d\u0dc0\u0dba, \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dcf, \u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0daf\u0dad\u0dca\u0dad, \u0dc3\u0dc4 \u0dc3\u0dd0\u0dc3\u0dd2 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba \u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0dc3\u0dc4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d8b\u0daf\u0dc0\u0dd4 \u0d9a\u0dbb\u0dba\u0dd2.",wallet:"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba \u0dc3\u0dc4 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4",walletDesc:"\u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2 \u0dc1\u0dda\u0dc2\u0dba, \u0d89\u0dc4\u0dc5-\u0d85\u0db4\u0dca, \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf, \u0da2\u0db1\u0db1\u0dba \u0d9a\u0dc5 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf, \u0dc3\u0dc4 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0db0\u0dcf\u0dbb\u0d9a \u0dc3\u0db1\u0dca\u0daf\u0dbb\u0dca\u0db7\u0dba \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0dbd\u0dd4\u0dc4\u0dd4\u0db6\u0dd0\u0db3\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0dc0\u0dda.",location:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0dc4 \u0d8b\u0db4\u0dcf\u0d82\u0d9c \u0dc3\u0db1\u0dca\u0daf\u0dbb\u0dca\u0db7\u0dba",locationDesc:"\u0dc3\u0dd0\u0dc3\u0dd2 \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7, \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0\u0da7 \u0dc3\u0dc4\u0dba \u0dc0\u0dd3\u0db8\u0da7, \u0dc3\u0dc4 \u0dc3\u0dca\u0dae\u0dcf\u0db1-\u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dc3\u0dad\u0dca\u0d9a\u0dcf\u0dbb \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3, \u0db4\u0dd4\u0dbb\u0db1\u0dba \u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc4\u0ddd \u0d85\u0dad\u0dd2\u0db1\u0dca \u0db1\u0dd0\u0dc0\u0dd4\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba \u0d9a\u0dbb \u0d9c\u0dad \u0dc4\u0dd0\u0d9a.",security:"\u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc3\u0dc4 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0db4\u0dca\u0dbb\u0dc0\u0dda\u0dc1\u0dba",securityDesc:"\u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a \u0dc3\u0dc4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad\u0dc0 \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0da7\u0ddd\u0d9a\u0db1, \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4, \u0db8\u0dd4\u0dbb\u0db4\u0daf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba, OTP \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba, \u0db7\u0dd6\u0db8\u0dd2\u0d9a\u0dcf\u0dc0 \u0dc3\u0dc4 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd9\u0dbb\u0dda.",whoCanSee:"\u0d9a\u0dcf\u0da7\u0daf \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dda",visibleToYou:"\u0d94\u0db6\u0da7 \u0daf\u0dd8\u0dc1\u0dca\u200d\u0dba\u0db8\u0dcf\u0db1\u0dba\u0dd2",visibleDesc:"\u0d94\u0db6\u0d9c\u0dda \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db4\u0dd4\u0dc0\u0dbb\u0dd4\u0dc0 \u0d94\u0db6\u0d9c\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9, AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca, \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf, \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba, \u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba, \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca, \u0dc3\u0dc4 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba/\u0dba\u0dcf\u0dc0\u0dad\u0dca\ufffd\ufffd\ufffd\u0dcf\u0dbd\u0dd3\u0db1 \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0dba\u0dd2.",sharedForCare:"\u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dd9\u0daf\u0dcf \u0d87\u0dad",sharedDesc:"\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0dc3\u0dd0\u0dc3\u0dd2, \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0dc3\u0dc4\u0dba \u0dc3\u0d82\u0dc0\u0dcf\u0daf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0daf\u0dd0\u0d9a\u0dd2\u0dba \u0dc4\u0dd0\u0d9a. \u0dc3\u0dc4\u0dcf\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0db1 \u0dad\u0dd0\u0db1\u0dca\u0dc0\u0dbd \u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf\u0db8\u0dd2\u0d9a \u0d85\u0db1\u0db1\u0dca\u200d\u0dba\u0dad\u0dcf\u0dc0\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0dc0\u0dda.",protectedAccess:"\u0db4\u0dca\u0dbb\u0dc0\u0dda\u0dc1 \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0d87\u0dad",protectedDesc:"\u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a \u0dc3\u0dc4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0db7\u0dd6\u0db8\u0dd2\u0d9a\u0dcf\u0dc0, \u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dc3\u0dd0\u0dc3\u0dd2, OTP \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0dc4 \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd2\u0dad API \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda.",checklist:"\u0d94\u0db6\u0d9c\u0dda \u0dbb\u0dc4\u0dc3\u0dca\u200d\u0dba\u0dad\u0dcf \u0db4\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dc3\u0dd4\u0db8\u0dca \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dc0",checklistItem1:"\u0d94\u0db6\u0da7 \u0d94\u0db6\u0dda \u0dc3\u0dd0\u0db6\u0dd1 \u0db1\u0db8 \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd2\u0da7 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0d94\u0db6\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf\u0db8\u0dd2\u0d9a \u0db1\u0db8 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1.",checklistItem2:"\u0d94\u0db6 \u0d92\u0dc0\u0dcf \u0db4\u0dd2\u0dbb\u0dc0\u0dd3\u0db8\u0da7 \u0dad\u0ddd\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dda \u0db1\u0db8\u0dca \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf \u0dc3\u0dc4 \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2\u0dc0 \u0dad\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1.",checklistItem3:"\u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca \u0dc0\u0dbd\u0da7 \u0db4\u0dd9\u0dbb \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba, \u0d9a\u0dd0\u0db8\u0dbb\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db8\u0dba\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dc6\u0ddd\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d8b\u0db4\u0dcf\u0d82\u0d9c \u0d85\u0dc0\u0dc3\u0dbb \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1.",checklistItem4:"\u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dda\u0dbb\u0d9a\u0dba \u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd4\u0db1\u0dda \u0db1\u0db8\u0dca, \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca/\u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0dc0\u0dd9\u0dad\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d85\u0dad\u0dd2\u0db1\u0dca \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1.",checklistItem5:"\u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0db4\u0dab\u0dd2\u0dc0\u0dd2\u0da9 \u0dad\u0dd4\u0dc5 OTP, \u0db8\u0dd4\u0dbb\u0db4\u0daf, \u0dc4\u0ddd \u0dc3\u0d82\u0dc0\u0dda\u0daf\u0dd3 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0db6\u0dd9\u0daf\u0dcf \u0db1\u0ddc\u0d9c\u0db1\u0dca\u0db1.",checklistItem6:"\u0d94\u0db6\u0d9c\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dda \u0d9c\u0db6\u0da9\u0dcf \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0daf\u0dad\u0dca\u0dad \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0ddd \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db8\u0d9c\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0dc3\u0dc4 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1.",manageData:"\u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0daf\u0dad\u0dca\u0dad \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1",securitySettings:"\u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0db8\u0dca",aiQuickReplyLow:"\u0d85\u0da9\u0dd4\u0dba\u0dd2",aiQuickReplyOkay:"\u0dc4\u0dbb\u0dd2",aiQuickReplyGood:"\u0dc4\u0ddc\u0db3\u0dba\u0dd2",aiQuickReplyGreat:"\u0db1\u0dd2\u0dba\u0db8\u0dba\u0dd2",aiPhotoAttached:"\u0da1\u0dcf\u0dba\u0dcf\u0dbb\u0dd6\u0db4\u0dba \u0d85\u0db8\u0dd4\u0dab\u0dcf \u0d87\u0dad",aiTryAgain:"\u0db1\u0dd0\u0dc0\u0dad \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0db1",aiVoiceHint:"\u0d94\u0db6 \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0db8\u0dca \u0dc0\u0dd6 \u0dc0\u0dd2\u0da7 \u0d9a\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 - \u0d94\u0db6 \u0dc0\u0dd2\u0dbb\u0dcf\u0db8\u0dba\u0d9a\u0dca \u0d9c\u0dad\u0dca \u0db4\u0dc3\u0dd4 \u0db8\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd9\u0db1\u0dca\u0db1\u0dd9\u0db8\u0dd2.",resetChatTitle:"\u0db1\u0dd0\u0dc0\u0dd4\u0db8\u0dca \u0d9a\u0dad\u0dcf\u0db6\u0dc4\u0d9a\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0daf?",resetChatMessage:"\u0db8\u0dd9\u0dba \u0dc0\u0dad\u0dca\u0db8\u0db1\u0dca AI \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0db8\u0db1\u0ddd\u0db7\u0dcf\u0dc0\u0dba \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4 \u0dc3\u0db8\u0d9f \u0db1\u0dd0\u0dc0\u0dad \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dda.",startFresh:"\u0db1\u0dd0\u0dc0\u0dd4\u0db8\u0dca\u0dc0 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1",startingFresh:"\u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca..."},phrases:{p1le0g3x:"\u0db1\u0ddc\u0daf\u0db1\u0dca\u0db1\u0dcf",p3rvtpe:"\u0d85\u0daf",poh8cad:"\u0d8a\u0dba\u0dda",p1mrhzr7:"\u0d91\u0db1",pfebfdv:"\u0db4\u0dd2\u0da7\u0dad\u0da7 \u0dba\u0db1",p17k42kg:"\u0db8\u0d9c\u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dcf",pvw9wg8:"\u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dc5\u0dcf",p15m090m:"\u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a\u0dba\u0dd2",p1q8utwa:"\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca",pcqxqrc:"\u0db8\u0dd2\u0db1\u0dd2\u0dad\u0dca\u0dad\u0dd4",p15oehty:"\u0dad\u0dad\u0dca\u0db4\u0dbb",p17tqvf1:"\u0dc3\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca",pos6ydf:"\u0d85\u0db4\u0d9c\u0dda \u0dc3\u0dc4\u0dcf\u0dba \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0dc3\u0db8\u0d9f \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1jk4gbo:"\u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u0dba\u0dba\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0da2\u0dcf\u0dbd\u0dba \u0dad\u0dd4\u0dc5",pztgw94:"\u0dc3\u0dc4\u0dcf\u0dba \u0d85\u0db8\u0dad\u0db1\u0dca\u0db1",pig8opb:"\u0d9a\u0dd9\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0d9a\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1",pla6vae:"\u0d8a\u0db8\u0dda\u0dbd\u0dca \u0dc3\u0dc4\u0dcf\u0dba",p12y1fw5:"\u0d94\u0db6\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1 \u0d91\u0dc0\u0db1\u0dca\u0db1",pi7el9x:"\u0db4\u0dd0\u0dba 24\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad",peza8d7:"Humaelio",p1k70v3b:"\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1",pi7p4si:"24/7 \u0db4\u0dc0\u0dad\u0dd3",ptmpaw1:"\u0db8\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dd9\u0dc3\u0dda\u0daf?",pq44ijf:"\u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7, \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0db4\u0da7\u0dd2\u0dad\u0dca\u0dad \u0dc0\u0dd9\u0dad \u0dc3\u0d82\u0da0\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d94\u0db6 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1, \u0d94\u0db6\u0dda \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0db1 \u0dc0\u0dbb\u0dca\u0d9c\u0dba \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u0daf\u0dd2\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0dc0\u0dda\u0dbd\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1. \u0d94\u0db6\u0da7 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dc4\u0dd2\u0dad \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0dad\u0dca \u0dad\u0dd0\u0db4\u0dd1\u0dbd\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd9\u0db1\u0dd4 \u0d87\u0dad.",pvi5gau:"\u0db8\u0db8 \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dda \u0dc4\u0ddd \u0db1\u0dd0\u0dc0\u0dad \u0d9a\u0dcf\u0dbd\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dd9\u0dc3\u0dda\u0daf?",pfqgfyn:"\u0d94\u0db6\u0da7 \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0d85\u0d82\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d94\u0db6\u0d9c\u0dda \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a. \u0db1\u0dd0\u0dc0\u0dad \u0d9a\u0dcf\u0dbd\u0dc3\u0da7\u0dc4\u0db1\u0dca\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0ddd \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d91\u0db1 \u0d95\u0db1\u0dd1\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0da7\u0dca\u0da7\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dc3\u0dd0\u0dc3\u0dd2\u0dc0\u0dcf\u0dbb\u0dba\u0da7 \u0db4\u0dd0\u0dba 24\u0d9a\u0da7 \u0db4\u0dd9\u0dbb \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d86\u0db4\u0dc3\u0dd4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dbd\u0db6\u0dba\u0dd2.",p1h9bcwo:"\u0db8\u0d9c\u0dda \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0daf\u0dad\u0dca\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0daf?",ps9lc26:"\u0d94\u0dc0\u0dca, \u0d94\u0db6\u0d9c\u0dda \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0daf\u0dad\u0dca\u0dad \u0d85\u0db1\u0dca\u0dad\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0d82\u0d9a\u0dda\u0dad\u0db1\u0dba \u0dc3\u0dc4 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad-\u0dc3\u0db8\u0dca\u0db8\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0db4\u0dca\u200d\u0dbb\u0ddc\u0da7\u0ddd\u0d9a\u0ddd\u0dbd \u0dc3\u0db8\u0d9f \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0d87\u0dad. \u0d94\u0db6\u0dda \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0ddc\u0dbb\u0dc0 \u0d94\u0db6\u0dda \u0daf\u0dad\u0dca\u0dad \u0d9a\u0dd2\u0dc3\u0dd2 \u0dc0\u0dd2\u0da7\u0dd9\u0d9a \u0dad\u0dd9\u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dc0\u0dba\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0db6\u0dd9\u0daf\u0dcf \u0db1\u0ddc\u0d9c\u0db1\u0dd3.",p1c63b9n:"\u0db8\u0d9c\u0dda \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba\u0da7 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dd9\u0dc3\u0dda\u0daf?",pfulep3:"Wallet \u0db4\u0da7\u0dd2\u0dad\u0dca\u0dad \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0dc3\u0dca \"\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1\" \u0dad\u0da7\u0dca\u0da7\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0d94\u0db6\u0d9c\u0dda \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dda \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1 - \u0d9a\u0dcf\u0da9\u0dca\u0db4\u0dad, UPI, \u0dc4\u0ddd \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dc4\u0dd4\u0dc0\u0db8\u0dcf\u0dbb\u0dd4\u0dc0 - \u0dc3\u0dc4 \u0d94\u0db6\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db8\u0dd4\u0daf\u0dbd \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.",pex3sts:"\u0d8b\u0daf\u0dc0\u0dca \u0dc3\u0dc4 \u0dc3\u0dc4\u0dcf\u0dba",p1ofqfdp:"\u0da2\u0db1\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1",p1m6uxly:"chevron-up",p9wx6ep:"chevron-down",pmkl5g0:"\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d8b\u0daf\u0dc0\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0daf?",p1ucr8ie:"\u0d94\u0db6 \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a\u0dca \u0d85\u0dad\u0dca\u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dca\u0db1\u0dda \u0db1\u0db8\u0dca, \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb \u0dc0\u0dc4\u0dcf\u0db8 \u0d94\u0db6\u0dda \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0dda\u0dc0\u0dcf \u0d85\u0db8\u0dad\u0db1\u0dca\u0db1.",p1k15svg:"\u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf",p1il8i8d:"\u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca",pgcsuld:"\u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1x9xuzh:"\u0dba\u0dd9\u0daf\u0dd4\u0db8\u0dda \u0daf\u0ddd\u0dc2\u0dba\u0d9a\u0dca \u0dc4\u0ddd \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda\u0daf?",p18t3p8y:"\u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",p11jo8ku:"Humaeli \u0d85\u0db1\u0dd4\u0dc0\u0dcf\u0daf\u0dba",prnsj34:"\u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dbb\u0da7 \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dc5\u0dda:",p8lq2oq:"\u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1",pg6nyxd:"\u0d85\u0db1\u0dca\u0dad\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0d9c\u0da7 \u0dc3\u0d82\u0d9a\u0dda\u0dad\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",pm4qf9j:"GDPR \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dba",p13tbyt3:"\u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf\u0db8\u0dd2\u0d9a \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0db1\u0dba",p1474pj6:"\u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4",p12ddn6e:"\u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9",p178beh:"\u0db1\u0db8, \u0dc0\u0dba\u0dc3 \u0dc3\u0dc4 \u0dbd\u0dd2\u0d82\u0d9c\u0db7\u0dda\u0daf\u0dba",p1el3mqv:"\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb",p1uqyawh:"\u0dc3\u0dde\u0d9b\u0dca\u0dba \u0db8\u0db1\u0dcf\u0db4",p1j5drmg:"\u0d94\u0db6\u0dda \u0dc3\u0dad\u0dca\u0d9a\u0dcf\u0dbb \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0db8 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1hshih:"\u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd9\u0d9a\u0dd4 \u0dc3\u0db8\u0d9f \u0d94\u0db6\u0dc0 \u0d9c\u0dbd\u0db4\u0db1\u0dca\u0db1",p4lwpxb:"\u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc3\u0dc4 \u0d87\u0db8\u0dad\u0dd4\u0db8\u0dca",p16o5duv:"\u0db4\u0dab\u0dd2\u0dc0\u0dd2\u0da9 \u0dc3\u0dc4 \u0d89\u0d9a\u0dca\u0db8\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4",pjualou:"\u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0dc4 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0dca",p8fcohj:"\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0d9a\u0dad\u0dcf\u0db6\u0dc3\u0dca \u0dc3\u0dd0\u0dc3\u0dd2",pqugyus:"\u0d85\u0d9b\u0dab\u0dca\u0da9 \u0dc3\u0d82\u0dc0\u0dcf\u0daf \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1",pxw259e:"\u0dc3\u0dd0\u0dc3\u0dd2 \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc3\u0dc4\u0dcf\u0dba \u0dc3\u0db6\u0dbd \u0d9a\u0dbb\u0db1\u0dca\u0db1",ppapyhl:"\u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca",ppjebc6:"\u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0daf\u0dd2\u0db1\u0dba \u0dc3\u0dc4 \u0dc0\u0dda\u0dbd\u0dcf\u0dc0",prz84q3:"\u0dad\u0ddd\u0dbb\u0dcf\u0d9c\u0dad\u0dca \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a",p6bzi8o:"\u0dc3\u0dd0\u0dc3\u0dd2 \u0dc3\u0da7\u0dc4\u0db1\u0dca",pfby3q4:"\u0d94\u0db6\u0d9c\u0dda \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc3\u0dd0\u0dc3\u0dd2 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1px010k:"\u0d9a\u0dcf\u0dbd\u0ddd\u0da0\u0dd2\u0dad \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dba\u0dc0\u0db1\u0dca\u0db1",pl6oj3n:"\u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba \u0dc3\u0dc4 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4",pcisb5n:"\u0db1\u0dd0\u0dc0\u0dad \u0d86\u0dbb\u0ddd\u0db4\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba",p11x8ws5:"\u0d86\u0db4\u0dc3\u0dd4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf",p1jezb8u:"\u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dbb\u0dd2\u0dc3\u0dd2\u0da7\u0dca\u0db4\u0dad\u0dca",p1kxmxol:"\u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1soeejn:"\u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1",p3fb3fk:"\u0d94\u0db6\u0d9c\u0dda \u0daf\u0dad\u0dca\u0dad \u0dc0\u0dd9\u0dad \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd9\u0db1\u0dca\u0db1",paxx0ja:"\u0d94\u0db6 \u0d9c\u0dd0\u0db1 Humaeli \u0dc3\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd2 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0daf\u0dad\u0dca\u0dad\u0dc0\u0dbd \u0db4\u0dd2\u0da7\u0db4\u0dad\u0d9a\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0db1.",py8xd5m:"\u0d94\u0db6\u0d9c\u0dda \u0daf\u0dad\u0dca\u0dad \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1",pg1ugci:"\u0d95\u0db1\u0dd1\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u0d94\u0db6\u0dda \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9\u0dd9\u0db1\u0dca \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc4\u0ddd \u0dba\u0dbd\u0dca \u0db4\u0dd0\u0db1 \u0d9c\u0dd2\u0dba \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1.",p13743po:"\u0d94\u0db6\u0d9c\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0db8 \u0db8\u0d9a\u0db1\u0dca\u0db1",p12l9hlj:"\u0d94\u0db6\u0d9c\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0db8 \u0dc3\u0dc4 \u0d86\u0dc1\u0dca\u200d