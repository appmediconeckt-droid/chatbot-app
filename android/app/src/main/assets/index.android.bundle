7e \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15 \u2192 \u0d08 \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d35\u0d30\u0d3f\u0d15.",pj1z8my:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d \u0d07\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d30\u0d4b\u0d17\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d3f\u0d32\u0d4d\u0d32, \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37 \u0d2a\u0d30\u0d3f\u0d2e\u0d3f\u0d24\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02. \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d42.",pe2sfkx:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d07\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d41\u0d02 \u0d24\u0d1f\u0d1e\u0d4d\u0d1e\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2a\u0d30\u0d24\u0d2f\u0d41\u0d02 \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d05\u0d27\u0d3f\u0d37\u0d4d\u200c\u0d20\u0d3f\u0d24 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d2f\u0d41\u0d02 \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32.",p1bc8b0q:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d \u0d07\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d7a\u0d38\u0d7e\u0d1f\u0d4d\u0d1f\u0d7b\u0d31\u0d41\u0d15\u0d7e, \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d05\u0d32\u0d47\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e, \u0d05\u0d1f\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d30 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d37\u0d4d\u200c\u0d1f\u0d2e\u0d3e\u0d15\u0d41\u0d02. \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d42.",p1kxnr6x:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d07\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d41\u0d02 \u0d24\u0d1f\u0d1e\u0d4d\u0d1e\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d7a\u0d38\u0d7e\u0d1f\u0d4d\u0d1f\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d0e\u0d2e\u0d7c\u0d1c\u0d7b\u0d38\u0d3f \u0d38\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32.",p1qfkxpw:"\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15",p19izdw2:"\u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41...",pudz60s:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41...",p1nyz8sj:"\ud83d\udd04 \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d36\u0d4d\u0d30\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",p129dr11:"\ud83d\udccd \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d06\u0d15\u0d4d\u0d38\u0d38\u0d4d \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",p13kffw5:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d46 \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15",pr2p72l:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d36\u0d41\u0d2a\u0d3e\u0d7c\u0d36 \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d41",pi9375l:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15",p1xmhdqy:"\u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d46 \u0d1a\u0d3f\u0d32 \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32. \u0d07\u0d24\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d1e\u0d19\u0d4d\u0d19\u0d7e \u0d36\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d36\u0d41\u0d2a\u0d3e\u0d7c\u0d36 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",p1ismk4q:"\u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f, \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d06\u0d15\u0d4d\u0d38\u0d38\u0d4d \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a \u0d30\u0d40\u0d24\u0d3f\u0d2f\u0d3f\u0d7d \u0d38\u0d47\u0d35\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d0