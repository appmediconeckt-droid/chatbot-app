nselorChatNotOpenDesc:"\u0627\u0641\u062a\u062d \"\u062f\u0639\u0645 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631\"\u060c \u0648\u0627\u062e\u062a\u0631 \u0645\u0633\u062a\u0634\u0627\u0631\u064b\u0627 \u0645\u062a\u0627\u062d\u064b\u0627\u060c \u0648\u0627\u0646\u062a\u0638\u0631 \u062d\u062a\u0649 \u064a\u062a\u0645 \u0642\u0628\u0648\u0644 \u0627\u0644\u0637\u0644\u0628. \u062a\u0638\u0647\u0631 \u0627\u0644\u062f\u0631\u062f\u0634\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0634\u0627\u0634\u0629 \u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631.",callNotConnecting:"\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u063a\u064a\u0631 \u0645\u062a\u0635\u0644\u0629",callNotConnectingDesc:"\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0642\u062f \u0642\u0628\u0644 \u0627\u0644\u062f\u0631\u062f\u0634\u0629/\u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643\u060c \u0648\u0623\u0646 \u0643\u0644\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u062a\u0635\u0644\u0627\u0646 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\u060c \u0648\u0623\u0646 \u0623\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646/\u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0645\u0633\u0645\u0648\u062d \u0628\u0647\u0627.",walletPaymentIssue:"\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0623\u0648 \u0627\u0644\u062f\u0641\u0639",walletPaymentIssueDesc:"\u0627\u0641\u062a\u062d \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0622\u062e\u0631 \u0645\u0639\u0627\u0645\u0644\u0629 \u0648\u062a\u0646\u0632\u064a\u0644 \u062a\u0642\u0631\u064a\u0631. \u0642\u0645 \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0627\u0644\u0645\u0628\u0644\u063a \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0639\u0646\u062f \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u062f\u0639\u0645.",languageWrongTitle:"\u0627\u0644\u0644\u063a\u0629 \u0623\u0648 \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u062a\u0628\u062f\u0648 \u062e\u0627\u0637\u0626\u0629",languageWrongDesc:"\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u062d\u062f\u062f \u0627\u0644\u0644\u063a\u0629 \u0645\u0646 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a/\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a. \u0642\u062f \u062a\u0638\u0644 \u0628\u0639\u0636 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0623\u0648 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0628\u064a\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u062a\u064a \u0623\u062f\u062e\u0644\u0647\u0627 \u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629.",needMoreHelp:"\u0647\u0644 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629\u061f",needMoreHelpDesc:"\u0642\u0645 \u0628\u062a\u062d\u062f\u064a\u062b \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062d\u0633\u0627\u0628 \u0645\u0646 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a/\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0623\u0648 \u0627\u0644\u062f\u0639\u0645 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0645\u0639 \u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0648\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a/\u0627\u0644\u0647\u0627\u062a\u0641 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0648\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062f\u062f \u0644\u062d\u062f\u0648\u062b \u0627\u0644\u0645\u0634\u0643\u0644\u0629. \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u062f\u0639\u0645 \u0627\u0644\u0623\u0632\u0645\u0627\u062a \u0641\u064a \u0627\u0644\u0647\u0646\u062f\u060c \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 9152987821 \u0623\u0648 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u062d\u0644\u064a\u0629.",myProfile:"\u0645\u0644\u0641\u064a \u0627\u0644\u0634\u062e\u0635\u064a",settings:"\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",emailSupport:"\u062f\u0639\u0645 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"},privacyPage:{title:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629",centerTitle:"\u0645\u0631\u0643\u0632 \u062e\u0635\u0648\u0635\u064a\u0629 Humaeli",centerDesc:"\u064a\u0634\u0631\u062d \u0645\u0631\u0643\u0632 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0627 \u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645 Humaeli \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062e\u0635\u064a \u0648\u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0648\u0627\u0644\u0645\u0648\u0639\u062f \u0648\u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0648\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u062f\u0627\u062e\u0644 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u0647\u0630\u0627.",otpProtected:"OTP \u0645\u062d\u0645\u064a",otpProtectedDesc:"\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0627\u0644\u0647\u0627\u062a\u0641",anonymousCare:"\u0647\u0648\u064a\u0629 \u0631\u0639\u0627\u064a\u0629 \u0645\u062c\u0647\u0648\u0644\u0629",anonCareDesc:"\u062a\u0638\u0647\u0631 \u0644\u0644\u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u062d\u064a\u062b \u064a\u062a\u0645 \u062f\u0639\u0645\u0647\u0627",sensitiveAreas:"\u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u062d\u0633\u0627\u0633\u0629",sensitiveAreasDesc:"\u0627\u0644\u062f\u0631\u062f\u0634\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0648\u0627\u0644\u0645\u0648\ufffd\ufffd\u0639\u064a\u062f \u0648\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",dataUsedTitle:"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642",profileHealth:"\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0648\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0635\u062d\u064a\u0629",profileHealthDesc:"\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0633\u0645\u0643 \u0648\u0627\u0633\u0645 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u062c\u0647\u0648\u0644 \u0648\u0627\u0644\u0639\u0645\u0631 \u0648\u0627\u0644\u062c\u0646\u0633 \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0648\u0627\u0644\u0635\u0648\u0631\u0629/\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0631\u0645\u0632\u064a\u0629 \u0648\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u062c\u0647\u0629 \u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0648\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0648\u062d\u0642\u0648\u0644 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0645\u0631\u064a\u0636 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.",aiConversations:"\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631",aiConversationsDesc:"\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0648\u0627\u0644\u0631\u062f\u0648\u062f \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0648\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a \u0648\u062c\u0644\u0633\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0642\u0628\u0648\u0644\u0629 \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0644\u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0648\u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u0633\u062c\u0644 \u0648\u062f\u0639\u0645 \u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0642\u064a\u064a\u0645.",appointments:"\u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0648\u0627\u0644\u062c\u0644\u0633\u0627\u062a",appointmentsDesc:"\u064a\u0633\u0627\u0639\u062f \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0639\u064a\u064a\u0646 \u0648\u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u0633\u0628\u0628/\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u0627\u0644\u062d\u0627\u0644\u0629 \u0648\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0645\u0639\u064a\u0646 \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0648\u0633\u062c\u0644 \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u0639\u0644\u0649 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0631\u0639\u0627\u064a\u0629.",wallet:"\