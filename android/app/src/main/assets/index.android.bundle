verify:"I-verify",verifying:"Bine-verify\u2026",resend:"Muling ipadala",sendingOtp:"Ipinapadala\u2026",addressLine1:"Linya 1",addressLine2:"Linya 2",city:"lungsod",state:"Estado",pincode:"Pincode",country:"Bansa",relation:"Relasyon",medicalInformation:"Medikal na Impormasyon",heightCm:"Taas (cm)",weightKg:"Timbang (kg)",allergiesLabel:"Allergy (pinaghihiwalay ng kuwit)",insuranceInformation:"Impormasyon sa Seguro",provider:"Provider",insuranceType:"Uri ng Insurance",saveChanges:"I-save ang Mga Pagbabago",saving:"Nagse-save...",shareLocation:"Ibahagi ang aking kasalukuyang lokasyon",update:"Update",updating:"Pag-update...",issueDate:"Petsa ng Isyu",expiryDate:"Petsa ng Pag-expire"},wallet:{walletOverview:"Pangkalahatang-ideya ng Wallet",professionalPaymentDashboard:"Propesyonal na dashboard ng pagbabayad para sa iyong healthcare account.",availableBalance:"Magagamit na Balanse",addFunds:"Magdagdag ng mga Pondo",viewHistory:"Tingnan ang Kasaysayan",credits:"Mga kredito",spent:"Ginastos",completed:"Nakumpleto",spendingSummary:"Buod ng Paggastos",noSpendingRecorded:"Walang naitala na paggastos ngayong buwan.",totalSpentThisMonth:"Kabuuang nagastos ngayong buwan",addMoney:"Magdagdag ng Pera",fastSecureWalletTopup:"Mabilis at secure na wallet top-up",paymentMethod:"Paraan ng Pagbabayad",transactionHistory:"Kasaysayan ng Transaksyon",noTransactionsFound:"Walang nakitang mga transaksyon.",refresh:"I-refresh",needPaymentHelp:"Kailangan ng tulong sa pagbabayad?",supportTeamAvailable:"Available ang support team 24x7 para sa mga isyu sa wallet at pagbabayad.",support:"Suporta",confirmAndAddFunds:"Kumpirmahin at Magdagdag ng mga Pondo",invalidAmount:"Di-wastong Halaga",pleaseEnterValidAmount:"Mangyaring magpasok ng wastong halaga.",success:"Tagumpay",fundsAddedSuccessfully:"Matagumpay na naidagdag ang mga pondo.",paymentFailed:"Nabigo ang Pagbabayad",verificationFailed:"Nabigo ang pag-verify. Pakisubukang muli.",paymentError:"Error sa Pagbabayad",couldNotInitiatePayment:"Hindi makapagsimula ng pagbabayad.",walletFailedToLoad:"Nabigong i-load ang data ng wallet.",upi:"UPI",card:"Card",netbanking:"NetBanking",walletPayment:"Wallet"},appointment:{counselorDirectory:"Direktoryo ng Consultant",trustedExperts:"Mga pinagkakatiwalaang eksperto para sa kumpidensyal na suporta sa mental wellness",sort:"Pagbukud-bukurin:",name:"Pangalan",rating:"Rating",experience:"karanasan",appointmentDate:"Petsa at Oras ng Appointment",date:"Petsa",time:"Oras",clinicalNotes:"Mga Tala sa Klinikal / Dahilan",cancel:"Kanselahin",confirm:"Kumpirmahin",booking:"Nagbu-book...",counselorUnavailable:"Hindi Available ang Consultant",notAvailableNow:"ay kasalukuyang hindi magagamit. Pakisubukan mamaya.",schedule:"Iskedyul",chatNow:"Makipag-chat Ngayon",youAlreadyHaveChat:"Mayroon ka nang tinanggap na chat sa consultant na ito.",tapChatNowToContinue:"I-tap ang Chat Now para ipagpatuloy ang iyong pag-uusap.",sessionRequestWillBeSent:"Ang iyong kahilingan sa session ay ipapadala sa consultant.",youCanChatOnceAccepts:"Maaari kang makipag-chat kapag tinanggap ng consultant ang iyong kahilingan.",chatting:"Nakikipag-chat ka nang hindi nagpapakilala bilang:",sessionRequestSent:"Ipinadala ang Kahilingan",sessionRequestMessage:"Ipinadala ang kahilingan sa session. Maaari mong buksan ang chat kapag tinanggap ng consultant.",counselorNotSelected:"Error",counselorNotSelectedMessage:"Hindi napili ang consultant",invalidDate:"Di-wastong Petsa",pleaseChooseValidDateTime:"Mangyaring pumili ng wastong petsa at oras ng appointment.",invalidTime:"Di-wastong Oras",pleaseChooseFutureDateTime:"Mangyaring pumili ng petsa at oras sa hinaharap para sa appointment.",clinicalNotesRequired:"Kinakailangan ang Mga Tala sa Klinikal",pleaseAddReasonForBooking:"Mangyaring idagdag ang iyong dahilan sa pag-book ng appointment na ito.",bookedSuccessfully:"Matagumpay na Na-book",appointmentRequestSent:"Ipinadala ang kahilingan sa appointment. Ang consultant ay naabisuhan.",bookingFailed:"Nabigo ang booking",failedToBook:"Nabigong mag-book ng appointment.",accepted:"Tinanggap",searchCounselorPlaceholder:"Maghanap sa consultant ayon sa pangalan, espesyalisasyon, o lokasyon",sessionReasonPlaceholder:"Ibahagi ang nais mong talakayin sa sesyon na ito..."},helpPage:{title:"Tulong sa Suporta",centerTitle:"Humaeli support center",centerDesc:"Gamitin ang support center na ito upang lumipat sa tamang feature ng Humaeli, i-troubleshoot ang mga karaniwang isyu, at maunawaan kung kailan makikipag-ugnayan sa agarang tulong sa labas ng app.",aiWellnessChat:"AI wellness chat",aiWellnessDesc:"Magtanong ng mga tanong tungkol sa mental-wellness, gumamit ng voice input, makakuha ng mabilis na mga tugon, at ipagpatuloy ang iyong kamakailang AI chat mula sa dashboard.",aiWellnessAction:"Buksan ang AI chat",counselorSupport:"Suporta ng tagapayo",counselorDesc:"Mag-browse ng mga tagapayo ayon sa pangalan, espesyalisasyon, wika, lokasyon, rating, at online na katayuan bago simulan ang pangangalaga.",counselorAction:"Maghanap ng tagapayo",appointments:"Mga appointment",appointmentsDesc:"Suriin ang mga paparating at nakaraang appointment, tingnan ang status ng kahilingan, at mag-book ng mga session sa mga available na tagapayo.",appointmentsAction:"Tingnan ang mga appointment",walletPayments:"Wallet at mga pagbabayad",walletDesc:"Magdagdag ng pera, suriin ang mga transaksyon, mag-download ng mga ulat ng wallet, at makipag-ugnayan sa suporta para sa mga tanong sa pagbabayad.",walletAction:"Buksan ang wallet",beforeContact:"Bago ka makipag-ugnayan sa suporta",checklist1:"Kumpirmahin ang iyong koneksyon sa internet at i-refresh ang app bago mag-ulat ng isyu sa paglo-load.",checklist2:"Panatilihing handa ang pinakabagong screenshot, eksaktong oras, at pangalan ng screen kapag nakikipag-ugnayan sa suporta.",checklist3:"Para sa mga isyu sa camera, mikropono, notification, at lokasyon, tingnan muna ang mga pahintulot ng device app.",checklist4:"Para sa mga isyu sa pagbabayad, isama ang petsa, halaga, status ng transaksyon, at balanse ng wallet na ipinapakita sa app.",commonIssues:"Mga karaniwang isyu",aiChatNotReply:"Ang AI chat ay hindi tumutugon",aiChatNotReplyDesc:"Suriin ang iyong koneksyon sa internet, subukang magpadala ng maikling mensahe, at muling buksan ang AI chat mula sa dashboard. Kung nabigo pa rin ito, ibahagi ang eksaktong screenshot ng error sa suporta.",counselorChatNotOpen:"Ang chat ng tagapayo ay hindi nagbubukas",counselorChatNotOpenDesc:"Buksan ang Suporta sa Tagapayo, pumili ng magagamit na tagapayo, at hintaying tanggapin ang kahilingan. Lumalabas ang mga kasalukuyang chat sa screen ng chat ng tagapayo.",callNotConnecting:"Hindi kumokonekta ang tawag",callNotConnectingDesc:"Tiyaking tinanggap ng tagapayo ang iyong chat/session, parehong online ang mga user, at pinapayagan ang mga pahintulot sa mikropono/camera.",walletPaymentIssue:"Wallet o isyu sa pagbabayad",walletPaymentIssueDesc:"Buksan ang Wallet upang suriin ang pinakabagong transaksyon at mag-download ng ulat. Ibahagi ang petsa, halaga, at katayuan ng transaksyon kapag nakikipag-ugnayan sa suporta.",languageWrongTitle:"Mukhang mali ang wika o pagsasalin",languageWrongDesc:"Gamitin ang tagapili ng wika mula sa dashboard/setting. Ang ilang tagapayo o mga medikal na detalye ay maaaring manatili sa wikang ipinasok ng provider.",needMoreHelp:"Kailangan ng karagdagang tulong?",needMoreHelpDesc:"I-update ang mga detalye ng account mula sa Profile/Mga Setting, o suporta sa email gamit ang mga screenshot, bersyon ng app, email/telepono ng user, at ang eksaktong oras na nangyari ang isyu. Para sa suporta sa krisis sa India, tumawag sa 9152987821 o mga lokal na serbisyong pang-emergency.",myProfile:"Aking Profile",settings:"Mga setting",emailSupport:"Suporta sa email"},privacyPage:{title:"Patakaran sa Privacy",centerTitle:"Humaeli privacy center",centerDesc:"Ipinapaliwanag ng privacy center na ito kung paano ginagamit ng Humaeli ang iyong profile, chat, appointment, wallet, tawag, lokasyon, at data ng seguridad sa loob ng mobile app na ito.",otpProtected:"Protektado ang OTP",otpProtectedDesc:"Mga pagbabago sa email at telepono",anonymousCare:"Anonymous na pagkakakilanlan sa pangangalaga",anonCareDesc:"Ipinapakita sa mga tagapayo kung saan sinusuportahan",sensitiveAreas:"Mga sensitibong lugar",sensitiveAreasDesc:"Mga chat, tawag, appointment, profile",dataUsedTitle:"Data na ginamit sa app",profileHealth:"Mga detalye ng profile at kalusugan",profileHealthDesc:"Ang iyong pangalan, anonymous na display name, edad, kasarian, mga detalye ng contact, larawan/avatar, address, emergency contact, pangunahing mga detalye ng medikal, at mga field ng insurance ay ginagamit upang mapanatili ang iyong profile ng pasyente.",aiConversations:"AI chat at mga pag-uusap ng tagapayo",aiConversationsDesc:"Ang mga mensahe, mabilis na tugon, status ng chat, mga attachment, tinatanggap na mga session ng chat, at mga detalye ng tagapayo ay ginagamit upang magbigay ng mga pag-uusap, magpatuloy sa kasaysayan, at suportahan ang mga prompt ng rating.",appointments:"Mga appointment at session",appointmentsDesc:"Ang petsa ng appointment, oras, dahilan/tala, status, nakatalagang tagapayo, metadata ng tawag, at history ng session ay tumutulong sa mga user at tagapayo na pamahalaan ang pangangalaga.",wallet:"Wallet at mga transaksyon",walletDesc:"Ang balanse sa wallet, mga top-up, mga talaan ng transaksyon, mga nabuong ulat, at nauugnay na konteksto ng suporta ay ginagamit para sa pagsubaybay sa pagbabayad.",location:"Konteksto ng lokasyon at device",locationDesc:"Maaaring makuha ang lokasyon sa pag-signup, pag-log in, o manual na pag-refresh para i-verify ang mga session, suportahan ang kaligtasan ng account, at pagbutihin ang mga feature sa pangangalaga na alam ang lokasyon.",security:"Seguridad at pag-access sa account",securityDesc:"Ang mga token sa pag-log in, auth provider, katayuan ng password, pag-verify ng OTP, tungkulin, at status ng account ay ginagamit upang panatilihing hiwalay at protektado ang mga lugar ng user at tagapayo.",whoCanSee:"Sino ang makakakita kung ano",visibleToYou:"Nakikita mo",visibleDesc:"Ipinapakita ng iyong dashboard ang iyong profile, mga pakikipag-chat sa AI, mga pakikipag-ugnayan ng tagapayo, mga appointment, wallet, history ng tawag, mga prompt ng rating, at mga kontrol sa lokasyon/pag-update.",sharedForCare:"Ibinahagi para sa pangangalaga",sharedDesc:"Maaaring makita ng mga tagapayo ang impormasyong kailangan para pamahalaan ang mga tinatanggap na sesyon, appointment, at suportang pag-uusap. Ginagamit ang anonymous na pagkakakilanlan kung saan sinusuportahan.",protectedAccess:"Pinoprotektahan ng mga kontrol sa pag-access",protectedDesc:"Ang mga lugar ng user at tagapayo ay pinaghihiwalay ng tungkulin, mga aktibong session, pag-verify ng OTP, at mga na-authenticate na kahilingan sa API.",checklist:"Ang iyong checklist sa privacy",checklistItem1:"Gamitin ang iyong hindi kilalang pangalan para sa mga pakikipag-ugnayan ng tagapayo kapag ayaw mong ipakita ang iyong tunay na pangalan.",checklistItem2:"Panatilihing tumpak ang mga detalye ng contact sa emergency at medikal na profile kung pipiliin mong punan ang mga ito.",checklistItem3:"Suriin ang mga pahintulot ng device para sa lokasyon, camera, at mikropono bago ang mga tawag.",checklistItem4:"Manu-manong i-update ang lokasyon mula sa Mga Setting/Profile kung nilaktawan ang prompt sa pag-login.",checklistItem5:"Huwag ibahagi ang mga OTP, password, o sensitibong detalye ng account sa loob ng mga mensahe sa chat.",checklistItem6:"Gamitin ang Aking Profile at Mga Setting upang i-update o suriin ang data na nakaimbak sa iyong account.",manageData:"Pamahalaan ang data ng profile",securitySettings:"Mga setting ng seguridad",aiQuickReplyLow:"Mababa",aiQuickReplyOkay:"Okay",aiQuickReplyGood:"Mabuti",aiQuickReplyGreat:"Mahusay",aiPhotoAttached:"Naka-attach na larawan",aiTryAgain:"Subukan Muli",aiVoiceHint:"Magsalita kapag handa ka na \u2014 sasagot ako kapag nag-pause ka.",resetChatTitle:"Magsimula ng bagong chat?",resetChatMessage:"Iki-clear nito ang kasalukuyang AI chat at magsisimula muli sa mga pagpipilian sa welcome mood.",startFresh:"Magsimula ng Bago",startingFresh:"Nagsisimula..."},phrases:{p1le0g3x:"Hindi alam",p3rvtpe:"Ngayong araw",poh8cad:"Kahapon",p1mrhzr7:"Papasok",pfebfdv:"Papalabas",p17k42kg:"Nakaligtaan",pvw9wg8:"Nakumpleto",p15m090m:"Nabigo",p1q8utwa:"Nakabinbin",pcqxqrc:"minuto",p15oehty:"segundo",p17tqvf1:"Live Chat",pos6ydf:"Makipag-chat sa aming team ng suporta",p1jk4gbo:"Kadalasan online sa loob",pztgw94:"Tumawag sa Suporta",pig8opb:"Direktang makipag-usap",pla6vae:"Suporta sa Email",p12y1fw5:"Ipadala ang iyong mga katanungan",pi7el9x:"Sa loob ng 24 na oras",peza8d7:"Humaelio",p1k70v3b:"Kumuha ng mga agarang sagot",pi7p4si:"24/7 Available",ptmpaw1:"Paano ako makakapag-book ng appointment?",pq44ijf:"Upang mag-book ng appointment, mag-navigate sa tab na Mga Consultant, piliin ang iyong gustong consultant, piliin ang uri ng iyong konsultasyon, at pumili ng petsa at oras. Makakatanggap ka ng email ng kumpirmasyon kasama ang lahat ng mga detalye.",pvi5gau:"Paano ako makakakansela o makakapag-iskedyul?",pfqgfyn:"Maaari mong pamahalaan ang iyong mga appointment mula sa seksyong Mga Appointment. I-tap ang anumang paparating na appointment para mag-reschedule o magkansela. Ang mga pagkansela na ginawa 24 na oras bago ang session ay kwalipikado para sa mga refund.",p1h9bcwo:"Secure ba ang aking medikal na data?",ps9lc26:"Oo, ang lahat ng iyong personal at medikal na data ay protektado ng end-to-end na pag-encrypt at pamantayan sa industriya na mga protocol ng seguridad. Ang iyong data ay hindi kailanman ibinabahagi sa mga third party nang wala ang iyong pahintulot.",p1c63b9n:"Paano ako magdaragdag ng mga pondo sa aking Wallet?",pfulep3:"Pumunta sa tab na Wallet at i-tap ang \"Magdagdag ng Pera\". Piliin ang iyong gustong paraan ng pagbabayad \u2014 card, UPI, o bank transfer \u2014 at ilagay ang halagang gusto mong idagdag.",pex3sts:"Tulong at Suporta",p1ofqfdp:"Mga Popular na Tanong",p1m6uxly:"chevron-up",p9wx6ep:"chevron-down",pmkl5g0:"Kailangan ng Agarang Tulong?",p1ucr8ie:"Kung nakakaranas ka ng medikal na emerhensiya, mangyaring tawagan kaagad ang iyong mga lokal na serbisyong pang-emergency.",p1k15svg:"Emergency Contact",p1il8i8d:"Mga Mapagkukunan ng Krisis",pgcsuld:"Mag-ulat ng Problema",p1x9xuzh:"Nakatagpo ng bug o teknikal na isyu sa app?",p18t3p8y:"Iulat ang Isyu",p11jo8ku:"Humaeli Bersyon",prnsj34:"Huling na-update:",p8lq2oq:"Tingnan ang Mga Update",pg6nyxd:"End-to-end na pag-encrypt",pm4qf9j:"GDPR certified access",p13tbyt3:"Anonymous na konsultasyon",p1474pj6:"Secure na mga transaksyon sa wallet",p12ddn6e:"Personal na Profile",p178beh:"Pangalan, edad at kasarian",p1el3mqv:"Mga detalye ng contact",p1uqyawh:"Mga kagustuhan sa kalusugan",p1j5drmg:"I-personalize ang iyong karanasan sa pangangalaga",p1hshih:"Itugma ka sa tamang consultant",p4lwpxb:"Mga Chat at Tawag",p16o5duv:"Mga mensahe at mabilis na tugon",pjualou:"Katayuan ng chat at mga attachment",p8fcohj:"Mga tinatanggap na chat session",pqugyus:"Magbigay ng tuluy-tuloy na kasaysayan ng pag-uusap",pxw259e:"Paganahin ang suporta sa consultant sa panahon ng mga session",ppapyhl:"Mga appointment",ppjebc6:"Petsa at oras ng booking",prz84q3:"Napiling consultant",p6bzi8o:"Mga tala ng session",pfby3q4:"Pamahalaan ang iyong mga paparating na session",p1px010k:"Magpadala ng mga napapanahong paalala",pl6oj3n:"Wallet at Mga Transaksyon",pcisb5n:"Recharge at kasaysayan ng pagbabayad",p11x8ws5:"Mga talaan ng refund",p1jezb8u:"Mga resibo ng transaksyon",p1kxmxol:"Iproseso ang mga pagbabayad nang ligtas",p1soeejn:"Panatilihin ang tumpak na kasaysayan ng pagsingil",p3fb3fk:"I-access ang iyong data",paxx0ja:"Humingi ng kopya ng personal na data na hawak ni Humaeli tungkol sa iyo.",py8xd5m:"Itama ang iyong data",pg1ugci:"I-update ang mga mali o hindi napapanahong detalye mula sa iyong profile anumang oras.",p13743po:"Tanggalin ang iyong ac