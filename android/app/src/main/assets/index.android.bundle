c\u09b2\u09c8\u0964",aiWellnessChat:"AI \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be \u0986\u09a1\u09cd\u09a1\u09be",aiWellnessDesc:"\u09ae\u09be\u09a8\u09b8\u09bf\u0995-\u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be\u09f0 \u09aa\u09cd\u09f0\u09b6\u09cd\u09a8 \u09b8\u09c1\u09a7\u09bf\u09ac, \u09ad\u09af\u09bc\u09c7\u099a \u0987\u09a8\u09aa\u09c1\u099f \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u0995, \u09a6\u09cd\u09f0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09f0 \u09aa\u09be\u0993\u0995, \u0986\u09f0\u09c1 \u09a1\u09c7\u099a\u09ac'\u09f0\u09cd\u09a1\u09f0 \u09aa\u09f0\u09be \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b6\u09c7\u09b9\u09a4\u09c0\u09af\u09bc\u09be AI \u0986\u09a1\u09cd\u09a1\u09be \u0985\u09ac\u09cd\u09af\u09be\u09b9\u09a4 \u09f0\u09be\u0996\u0995\u0964",aiWellnessAction:"AI \u0986\u09a1\u09cd\u09a1\u09be \u0996\u09cb\u09b2\u0995",counselorSupport:"\u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8",counselorDesc:"\u09af\u09a4\u09cd\u09a8 \u0986\u09f0\u09ae\u09cd\u09ad \u0995\u09f0\u09be\u09f0 \u0986\u0997\u09a4\u09c7 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b8\u0995\u09b2\u0995 \u09a8\u09be\u09ae, \u09ac\u09bf\u09b6\u09c7\u09b7\u099c\u09cd\u099e\u09a4\u09be, \u09ad\u09be\u09b7\u09be, \u09b8\u09cd\u09a5\u09be\u09a8, \u09f0\u09c7\u099f\u09bf\u0982, \u0986\u09f0\u09c1 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u0985\u09a8\u09c1\u09b8\u09f0\u09bf \u09ac\u09cd\u09f0\u09be\u0989\u099c \u0995\u09f0\u0995\u0964",counselorAction:"\u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09ac\u09bf\u099a\u09be\u09f0\u09bf \u0989\u09b2\u09bf\u09af\u09bc\u09be\u0993\u0995",appointments:"\u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4\u09bf",appointmentsDesc:"\u0986\u0997\u09a8\u09cd\u09a4\u09c1\u0995 \u0986\u09f0\u09c1 \u0985\u09a4\u09c0\u09a4\u09f0 \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09f0\u0995, \u0985\u09a8\u09c1\u09f0\u09cb\u09a7\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995, \u0986\u09f0\u09c1 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09ac\u09c1\u0995 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9\u0964",appointmentsAction:"\u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f\u09b8\u09ae\u09c2\u09b9 \u099a\u09be\u0993\u0995",walletPayments:"\u09f1\u09be\u09b2\u09c7\u099f \u0986\u09f0\u09c1 \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f",walletDesc:"\u09a7\u09a8 \u09af\u09cb\u0997 \u0995\u09f0\u0995, \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09f0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09f0\u0995, \u09f1\u09be\u09b2\u09c7\u099f \u09aa\u09cd\u09f0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09f0\u0995, \u0986\u09f0\u09c1 \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f \u09aa\u09cd\u09f0\u09b6\u09cd\u09a8\u09f0 \u09ac\u09be\u09ac\u09c7 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09f0\u0995\u0964",walletAction:"\u0996\u09cb\u09b2\u09be \u09ae\u09be\u09a8\u09bf\u09ac\u09c7\u0997",beforeContact:"\u0986\u09aa\u09c1\u09a8\u09bf \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09f0\u09be\u09f0 \u0986\u0997\u09a4\u09c7",checklist1:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0987\u09a3\u09cd\u099f\u09be\u09f0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09f0\u0995 \u0986\u09f0\u09c1 \u09b2\u09cb\u09a1\u09bf\u0982 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09f0 \u09f0\u09bf\u09aa\u09f0\u09cd\u099f \u09a6\u09bf\u09af\u09bc\u09be\u09f0 \u0986\u0997\u09a4\u09c7 \u098f\u09aa\u099f\u09cb \u09b8\u09a4\u09c7\u099c \u0995\u09f0\u0995\u0964",checklist2:"\u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09f0\u09be\u09f0 \u09b8\u09ae\u09af\u09bc\u09a4 \u09b6\u09c7\u09b9\u09a4\u09c0\u09af\u09bc\u09be \u09aa\u09f0\u09cd\u09a6\u09be\u09b6\u099f, \u09b8\u09a0\u09bf\u0995 \u09b8\u09ae\u09af\u09bc, \u0986\u09f0\u09c1 \u09aa\u09f0\u09cd\u09a6\u09be\u09f0 \ufffd\ufffd\ufffd\u09be\u09ae \u09aa\u09cd\u09f0\u09b8\u09cd\u09a4\u09c1\u09a4 \u09f0\u09be\u0996\u0995\u0964",checklist3:"\u0995\u09c7\u09ae\u09c7\u09f0\u09be, \u09ae\u09be\u0987\u0995\u09cd\u09f0'\u09ab\u09cb\u09a8, \u099c\u09be\u09a8\u09a8\u09c0, \u0986\u09f0\u09c1 \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8\u09f0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09f0 \u09ac\u09be\u09ac\u09c7, \u09aa\u09cd\u09f0\u09a5\u09ae\u09c7 \u09a1\u09bf\u09ad\u09be\u0987\u099a \u098f\u09aa\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995\u0964",checklist4:"\u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f\u09f0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09f0 \u09ac\u09be\u09ac\u09c7, \u098f\u09aa\u09a4 \u09a6\u09c7\u0996\u09c1\u0993\u09f1\u09be \u09a4\u09be\u09f0\u09bf\u0996, \u09aa\u09f0\u09bf\u09ae\u09be\u09a3, \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be, \u0986\u09f0\u09c1 \u09f1\u09be\u09b2\u09c7\u099f\u09f0 \u09ac\u09c7\u09b2\u09c7\u099e\u09cd\u099a \u0985\u09a8\u09cd\u09a4\u09f0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u0995\u09f0\u0995\u0964",commonIssues:"\u09b8\u09be\u09a7\u09be\u09f0\u09a3 \u09ac\u09bf\u09b7\u09af\u09bc",aiChatNotReply:"AI chat \u09af\u09bc\u09c7 \u09f0\u09bf\u09aa\u09cd\u09b2\u09be\u0987 \u09a6\u09bf\u09af\u09bc\u09be \u09a8\u09be\u0987",aiChatNotReplyDesc:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0987\u09a3\u09cd\u099f\u09be\u09f0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995, \u098f\u099f\u09be \u099a\u09c1\u099f\u09bf \u09ac\u09be\u09f0\u09cd\u09a4\u09be \u09aa\u09cd\u09f0\u09c7\u09f0\u09a3 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09f0\u0995, \u0986\u09f0\u09c1 \u09a1\u09c7\u099a\u09ac'\u09f0\u09cd\u09a1\u09f0 \u09aa\u09f0\u09be AI \u0986\u09a1\u09cd\u09a1\u09be \u09aa\u09c1\u09a8\u09f0 \u0996\u09cb\u09b2\u0995\u0964 \u09af\u09a6\u09bf \u0987 \u098f\u09a4\u09bf\u09af\u09bc\u09be\u0993 \u09ac\u09bf\u09ab\u09b2 \u09b9\u09af\u09bc, \u09b8\u09a0\u09bf\u0995 \u09ad\u09c1\u09b2 \u09aa\u09f0\u09cd\u09a6\u09be\u09b6\u09cd\u09ac\u099f \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09f0\u09c0 \u0995\u09f0\u0995\u0964",counselorChatNotOpen:"\u0995\u09be\u0989\u09a8\u09cd\u09b8\u09c7\u09b2\u09be\u09f0\u09f0 \u0986\u09a1\u09cd\u09a1\u09be \u0996\u09cb\u09b2\u09be \u09a8\u09be\u0987",counselorChatNotOpenDesc:"\u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0996\u09cb\u09b2\u0995, \u098f\u099c\u09a8 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09ac\u09be\u099b\u0995, \u0986\u09f0\u09c1 \u0985\u09a8\u09c1\u09f0\u09cb\u09a7 \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09be\u09b2\u09c8 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995\u0964 \u09ac\u09f0\u09cd\u09a4\u09ae\u09be\u09a8\u09f0 \u0986\u09a1\u09cd\u09a1\u09be\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u0986\u09a1\u09cd\u09a1\u09be \u09aa\u09f0\u09cd\u09a6\u09be\u09a4 \u09a6\u09c7\u0996\u09be \u09a6\u09bf\u09af\u09bc\u09c7\u0964",callNotConnecting:"\u0995\u09b2 \u09b8\u0982\u09af\u09cb\u0997 \u09b9\u09cb\u09f1\u09be \u09a8\u09be\u0987",callNotConnectingDesc:"\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09f0\u0995 \u09af\u09c7 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u0987 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0986\u09a1\u09cd\u09a1\u09be/\u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8 \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09bf\u099b\u09c7, \u09a6\u09c1\u09af\u09bc\u09cb\u099c\u09a8 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u099b\u09c7, \u0986\u09f0\u09c1 \u09ae\u09be\u0987\u0995\u09cd\u09f0'\u09ab\u09cb\u09a8/\u0995\u09c7\u09ae\u09c7\u09f0\u09be\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u0986\u099b\u09c7\u0964",walletPaymentIssue:"\u09f1\u09be\u09b2\u09c7\u099f \u09ac\u09be \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f\u09f0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be",walletPaymentIssueDesc:"\u09b6\u09c7\u09b9\u09a4\u09c0\u09af\u09bc\u09be \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09f0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u0986\u09f0\u09c1 \u098f\u099f\u09be \u09aa\u09cd\u09f0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09f1\u09be\u09b2\u09c7\u099f \u0996\u09cb\u09b2\u0995\u0964 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09f0\u09be\u09f0 \u09b8\u09ae\u09af\u09bc\u09a4 \u09a4\u09be\u09f0\u09bf\u0996, \u09aa\u09f0\u09bf\u09ae\u09be\u09a3, \u0986\u09f0\u09c1 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09f0\u09c0 \u0995\u09f0\u0995\u0964",languageWrongTitle:"\u09ad\u09be\u09b7\u09be \u09ac\u09be \u0985\u09a8\u09c1\u09ac\u09be\u09a6 \u09ad\u09c1\u09b2 \u09a6\u09c7\u0996\u09be \u0997\u09c8\u099b\u09c7",languageWrongDesc:"\u09a1\u09c7\u099a\u09ac'\u09f0\u09cd\u09a1/\u099b\u09c7\u099f\u09bf\u0982\u099b\u09f0 \u09aa\u09f0\u09be \u09ad\u09be\u09b7\u09be \u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u0995 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u0995\u0964 \u0995\u09bf\u099b\u09c1\u09ae\u09be\u09a8 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09ac\u09be \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8\u0995\u09be\u09f0\u09c0\u09af\u09bc\u09c7 \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6 \u0995\u09f0\u09be \u09ad\u09be\u09b7\u09be\u09a4 \u09a5\u09be\u0995\u09bf\u09ac \u09aa\u09be\u09f0\u09c7\u0964",needMoreHelp:"\u0985\u09a7\u09bf\u0995 \u09b8\u09b9\u09be\u09af\u09bc\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8?",needMoreHelpDesc:"\u09aa\u09cd\u09f0'\u09ab\u09be\u0987\u09b2/\u099b\u09c7\u099f\u09bf\u0982\u099b\u09f0 \u09aa\u09f0\u09be \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3 \u0986\u09aa\u09a1\u09c7\u0987\u099f \u0995\u09f0\u0995, \u09ac\u09be \u0987\u09ae\u09c7\u0987\u09b2 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09b8\u09cd\u0995\u09cd\u09f0\u09c0\u09a3\u09b6\u09cd\u09ac\u099f, \u098f\u09aa \u09b8\u0982\u09b8\u09cd\u0995\u09f0\u09a3, \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0 \u0987\u09ae\u09c7\u0987\u09b2/\u09ab\u09cb\u09a8, \u0986\u09f0\u09c1 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u099f\u09cb \u0998\u099f\u09be\u09f0 \u09b8\u09a0\u09bf\u0995 \u09b8\u09ae\u09af\u09bc\u09f0 \u09b8\u09c8\u09a4\u09c7\u0964 \u09ad\u09be\u09f0\u09a4\u09a4 \u09b8\u0982\u0995\u099f\u0995\u09be\u09b2\u09c0\u09a8 \u09b8\u09b9\u09be\u09af\u09bc\u09f0 \u09ac\u09be\u09ac\u09c7 \u09ef\u09e7\u09eb\u09e8\u09ef\u09ee\u09ed\u09ee\u09e8\u09e7 \u09ac\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u09b8\u09c7\u09f1\u09be\u09a4 \u09ab\u09cb\u09a8 \u0995\u09f0\u0995\u0964",myProfile:"\u09ae\u09cb\u09f0 \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2",settings:"\u099b\u09c7\u099f\u09bf\u0982\u099b",emailSupport:"\u0987\u09ae\u09c7\u0987\u09b2 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8"},privacyPage:{title:"\u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf",centerTitle:"Humaeli \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09f0",centerDesc:"\u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09f0\u099f\u09cb\u09f1\u09c7 \u09ac\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be \u0995\u09f0\u09c7 \u09af\u09c7 Humaeli-\u098f \u098f\u0987 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u098f\u09aa\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2, \u099a\u09c7\u099f, \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f, \u09f1\u09be\u09b2\u09c7\u099f, \u0995\u09b2, \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8, \u0986\u09f0\u09c1 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09a1\u09be\u099f\u09be \u0995\u09c7\u09a8\u09c7\u0995\u09c8 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09c7\u0964",otpProtected:"OTP \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4",otpProtectedDesc:"\u0987\u09ae\u09c7\u0987\u09b2 \u0986\u09f0\u09c1 \u09ab\u09cb\u09a8 \u09b8\u09b2\u09a8\u09bf \u09b9\u09af\u09bc",anonymousCare:"\u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09af\u09a4\u09cd\u09a8\u09f0 \u09aa\u09f0\u09bf\u099a\u09af\u09bc",anonCareDesc:"\u09af'\u09a4 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0995\u09f0\u09be \u09b9\u09af\u09bc \u09a4\u09be\u09a4 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b8\u0995\u09b2\u0995 \u09a6\u09c7\u0996\u09c1\u0993\u09f1\u09be \u09b9\u09af\u09bc",sensitiveAreas:"\u09b8\u09cd\u09aa\u09f0\u09cd\u09b6\u0995\u09be\u09a4\u09f0 \u0985\u099e\u09cd\u099a\u09b2",sensitiveAreasDesc:"\u0986\u09a1\u09cd\u09a1\u09be, \u0995\u09b2, \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f, \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2",dataUsedTitle:"\u098f\u09aa\u099f\u09cb\u09a4 \u09ac\u09cd\u09af\u09f1\u09b9\u09c3\u09a4 \u09a4\u09a5\u09cd\u09af",profileHealth:"\u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2 \u0986\u09f0\u09c1 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3",profileHealthDesc:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a8\u09be\u09ae, \u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09aa\u09cd\u09f0\u09a6\u09f0\u09cd\u09b6\u09a8\u09f0 \u09a8\u09be\u09ae, \u09ac\u09af\u09bc\u09b8, \u09b2\u09bf\u0982\u0997, \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3, \u09ab\u099f\u09cb/\u0985\u09f1\u09a4\u09be\u09f0, \u09a0\u09bf\u0995\u09a8\u09be, \u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997, \u09ae\u09cc\u09b2\u09bf\u0995 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3, \u0986\u09f0\u09c1 \u09ac\u09c0\u09ae\u09be \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09f0\u09b8\u09ae\u09c2\u09b9 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09f0\u09cb\u0997\u09c0\u09f0 \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2 \u09ac\u099c\u09be\u0987 \u09f0\u09be\u0996\u09bf\u09ac\u09b2\u09c8 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",aiConversations:"\u098f\u0986\u0987 \u0986\u09a1\u09cd\u09a1\u09be \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u0995\u09a5\u09be-\u09ac\u09a4\u09f0\u09be",aiConversationsDesc:"\u09ac\u09be\u09f0\u09cd\u09a4\u09be\u09b8\u09ae\u09c2\u09b9, \u09a6\u09cd\u09f0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09f0\u09b8\u09ae\u09c2\u09b9, \u0986\u09a1\u09cd\u09a1\u09be\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be, \u09b8\u0982\u09b2\u0997\u09cd\u09a8\u09b8\u09ae\u09c2\u09b9, \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09be \u0986\u09a1\u09cd\u09a1\u09be \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9, \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3\u09b8\u09ae\u09c2\u09b9 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8\u09b8\u09ae\ufffd\ufffd\ufffd\u09b9 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8, \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u0985\u09ac\u09cd\u09af\u09be\u09b9\u09a4 \u09f0\u09be\u0996\u09bf\u09ac\u09b2\u09c8, \u0986\u09f0\u09c1 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u09f0\u09c7\u099f\u09bf\u0982 \u09aa\u09cd\u09f0\u09ae\u09aa\u09cd\u099f\u09b8\u09ae\u09c2\u09b9 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",appointments:"\u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4\u09bf \u0986\u09f0\u09c1 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8",appointmentsDesc:"\u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f\u09f0 \u09a4\u09be\u09f0\u09bf\u0996, \u09b8\u09ae\u09af\u09bc, \u0995\u09be\u09f0\u09a3/\u099f\u09cb\u0995\u09be, \u0985\u09f1\u09b8\u09cd\u09a5\u09be, \u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be, \u0995\u09b2 \u09ae\u09c7\u099f\u09be\u09a1\u09be\u099f\u09be, \u0986\u09f0\u09c1 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09f0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8\u09c7 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0 \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u0995 \u09af\u09a4\u09cd\u09a8 \u09aa\u09f0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09f0\u09be\u09a4 \u09b8\u09b9\u09be\u09af\u09bc \u0995\u09f0\u09c7\u0964",wallet:"\u09f1\u09be\u09b2\u09c7\u099f \u0986\u09f0\u09c1 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8",walletDesc:"\u09f1\u09be\u09b2\u09c7\u099f \u09ac\u09c7\u09b2\u09c7\u099e\u09cd\u099a, \u099f\u09aa-\u0986\u09aa, \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09f0\u09c7\u0995\u09f0\u09cd\u09a1, \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09f0\u09be \u09aa\u09cd\u09f0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8, \u0986\u09f0\u09c1 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09c0\u09af\u09bc \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u09aa\u09cd\u09f0\u09b8\u0982\u0997 \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f \u0985\u09a8\u09c1\u09b8\u09f0\u09a3\u09f0 \u09ac\u09be\u09ac\u09c7 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",location:"\u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8 \u0986\u09f0\u09c1 \u09a1\u09bf\u09ad\u09be\u0987\u099a \u09aa\u09cd\u09f0\u09b8\u0982\u0997",locationDesc:"\u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u09bf\u09ac\u09b2\u09c7, \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0995\u09f0\u09bf\u09ac\u09b2\u09c7, \u0986\u09f0\u09c1 \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8-\u09b8\u099a\u09c7\u09a4\u09a8 \u09af\u09a4\u09cd\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u09b8\u09ae\u09c2\u09b9 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09f0\u09bf\u09ac\u09b2\u09c7 \u099a\u09be\u0987\u09a8\u0986\u09aa, \u09b2\u0997\u0987\u09a8, \u09ac\u09be \u09b9\u09b8\u09cd\u09a4\u099a\u09be\u09b2\u09bf\u09a4 \u09b8\u09a4\u09c7\u099c \u0995\u09f0\u09be\u09f0 \u09b8\u09ae\u09af\u09bc\u09a4 \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8 \u09a7\u09f0\u09bf\u09ac \u09aa\u09be\u09f0\u09bf\u0964",security:"\u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u0986\u09f0\u09c1 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u09f0 \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6",securityDesc:"\u09b2\u0997\u0987\u09a8 \u099f\u09cb\u0995\u09c7\u09a8, \u09aa\u09cd\u09f0\u09ae\u09be\u09a3\u09c0\u0995\u09f0\u09a3 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8\u0995\u09be\u09f0\u09c0, \u09aa\u09be\u099b\u09f1\u09be\u09f0\u09cd\u09a1\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be, OTP \u09b8\u09a4\u09cd\u09af\u09be\u09aa\u09a8, \u09ad\u09c2\u09ae\u09bf\u0995\u09be, \u0986\u09f0\u09c1 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0 \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u0985\u099e\u09cd\u099a\u09b2\u09b8\u09ae\u09c2\u09b9 \u09aa\u09c3\u09a5\u0995 \u0986\u09f0\u09c1 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4 \u09f0\u09be\u0996\u09bf\u09ac\u09b2\u09c8 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",whoCanSee:"\u0995\u09cb\u09a8\u09c7 \u0995\u09bf \u099a\u09be\u09ac \u09aa\u09be\u09f0\u09c7",visibleToYou:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ac\u09be\u09ac\u09c7 \u09a6\u09c3\u09b6\u09cd\u09af\u09ae\u09be\u09a8",visibleDesc:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a1\u09c7\u099a\u09ac'\u09f0\u09cd\u09a1\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09cd\u09f0'\u09ab\u09be\u0987\u09b2, AI \u099a\u09c7\u099f, \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09aa\u09be\u09f0\u09b8\u09cd\u09aa\u09f0\u09bf\u0995 \u0995\u09cd\u09f0\u09bf\u09af\u09bc\u09be, \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f, \u09f1\u09be\u09b2\u09c7\u099f, \u0995\u09b2 \u0987\u09a4\u09bf\u09b9\u09be\u09b8, \u09f0\u09c7\u099f\u09bf\u0982 \u09aa\u09cd\u09f0\u09ae\u09aa\u09cd\u099f, \u0986\u09f0\u09c1 \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8/\u0986\u09aa\u09a1\u09c7\u099f \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09f0\u09a3\u09b8\u09ae\u09c2\u09b9 \u09a6\u09c7\u0996\u09c1\u09f1\u09be\u09af\u09bc\u0964",sharedForCare:"\u09af\u09a4\u09cd\u09a8\u09f0 \u09ac\u09be\u09ac\u09c7 \u09b6\u09cd\u09ac\u09c7\u09af\u09bc\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09c8\u099b\u09c7",sharedDesc:"\u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b8\u0995\u09b2\u09c7 \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09be \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8, \u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4\u09bf \u0986\u09f0\u09c1 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8 \u09aa\u09f0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09a4\u09a5\u09cd\u09af \u099a\u09be\u09ac \u09aa\u09be\u09f0\u09c7\u0964 \u09b8\u09ae\u09f0\u09cd\u09a5\u09bf\u09a4 \u09a0\u09be\u0987\u09a4 \u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09aa\u09f0\u09bf\u099a\u09af\u09bc \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",protectedAccess:"\u0985\u09ad\u09bf\u0997\u09ae \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09f0\u09a3\u09f0 \u09a6\u09cd\u09ac\u09be\u09f0\u09be \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4",protectedDesc:"\u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0 \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u0985\u099e\u09cd\u099a\u09b2\u09b8\u09ae\u09c2\u09b9 \u09ad\u09c2\u09ae\u09bf\u0995\u09be, \u09b8\u0995\u09cd\u09f0\u09bf\u09af\u09bc \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8, OTP \u09b8\u09a4\u09cd\u09af\u09be\u09aa\u09a8, \u0986\u09f0\u09c1 \u09aa\u09cd\u09f0\u09ae\u09be\u09a3\u09c0\u0995\u09c3\u09a4 API \u0985\u09a8\u09c1\u09f0\u09cb\u09a7\u09b8\u09ae\u09c2\u09b9\u09f0 \u09a6\u09cd\u09ac\u09be\u09f0\u09be \u09aa\u09c3\u09a5\u0995 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964",checklist:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u09a4\u09be\u09b2\u09bf\u0995\u09be",checklistItem1:"\u09af\u09c7\u09a4\u09bf\u09af\u09bc\u09be \u0986\u09aa\u09c1\u09a8\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09cd\u09f0\u0995\u09c3\u09a4 \u09a8\u09be\u09ae \u09aa\u09cd\u09f0\u09a6\u09f0\u09cd\u09b6\u09bf\u09a4 \u09b9\u09cb\u09f1\u09be\u099f\u09cb \u09a8\u09bf\u09ac\u09bf\u099a\u09be\u09f0\u09c7 \u09a4\u09c7\u09a4\u09bf\u09af\u09bc\u09be \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09aa\u09be\u09f0\u09b8\u09cd\u09aa\u09f0\u09bf\u0995 \u0995\u09cd\u09f0\u09bf\u09af\u09bc\u09be\u09f0 \u09ac\u09be\u09ac\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09a8\u09be\u09ae \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u0995\u0964",checklistItem2:"\u09af\u09a6\u09bf \u0986\u09aa\u09c1\u09a8\u09bf \u09b8\u09c7\u0987\u09ac\u09cb\u09f0 \u09aa\u09c2\u09f0\u09a3 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09ac\u09be\u099b\u09bf \u09b2\u09af\u09bc \u09a4\u09c7\u09a8\u09cd\u09a4\u09c7 \u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0986\u09f0\u09c1 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3 \u09b8\u09a0\u09bf\u0995 \u09f0\u09be\u0996\u0995\u0964",checklistItem3:"\u0995\u09b2\u09f0 \u0986\u0997\u09a4\u09c7 \u0985\u09f1\u09b8\u09cd\u09a5\ufffd\ufffd\ufffd\u09a8, \u0995\u09c7\u09ae\u09c7\u09f0\u09be, \u0986\u09f0\u09c1 \u09ae\u09be\u0987\u0995\u09cd\u09f0'\u09ab\u09cb\u09a8\u09f0 \u09ac\u09be\u09ac\u09c7 \u09a1\u09bf\u09ad\u09be\u0987\u099a \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09f0\u0995\u0964",checklistItem4:"\u09b8\u0982\u09b9\u09a4\u09bf\u09b8\u09ae\u09c2\u09b9/\u0986\u09b2\u09c7\u0996\u09cd\u09af\u09a8\u09b8\u09ae\u09c2\u09b9\u09f0 \u09aa\u09f0\u09be \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09a8 \u09b9\u09b8\u09cd\u09a4\u099a\u09be\u09b2\u09bf\u09a4\u09ad\u09be\u09f1\u09c7 \u0986\u09aa\u09a1\u09c7\u0987\u099f \u0995\u09f0\u0995 \u09af\u09a6\u09bf \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6 \u09aa\u09cd\u09f0\u09ae\u09aa\u09cd\u099f \u098f\u09f0\u09bf \u09a6\u09bf\u09af\u09bc\u09be \u09b9\u09c8\u099b\u09bf\u09b2\u0964",checklistItem5:"\u099a\u09c7\u099f \u09ac\u09be\u09f0\u09cd\u09a4\u09be\u09b8\u09ae\u09c2\u09b9\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 OTPs, \u09aa\u09be\u099b\u09f1\u09f0\u09cd\u09a1\u09b8\u09ae\u09c2\u09b9, \u09ac\u09be \u09b8\u09cd\u09aa\u09f0\u09cd\u09b6\u0995\u09be\u09a4\u09f0 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u09f0 \u09ac\u09bf\u09f1\u09f0\u09a3\u09b8\u09ae\u09c2\u09b9 \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09f0\u09c0 \u09a8\u0995\u09f0\u09bf\u09ac\u0964",checklistItem6:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f\u09a4 \u09b8\u0982\u09f0\u0995\u09cd\u09b7\u09a3 \u0995\u09f0\u09be \u09a4\u09a5\u09cd\u09af \u0986\u09aa\u09a1\u09c7\u0987\u099f \u09ac\u09be \u09aa\u09f0\u09cd\u09af\u09be\ufffd\ufffd\u09cb\u099a\u09a8\u09be \u0995\u09f0\u09bf\u09ac\u09b2\u09c7 \u09ae\u09cb\u09f0 \u0986\u09b2\u09c7\u0996\u09cd\u09af\u09a8 \u0986\u09f0\u09c1 \u09b8\u0982\u09b9\u09a4\u09bf\u09b8\u09ae\u09c2\u09b9 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u0995\u0964",manageData:"\u0986\u09b2\u09c7\u0996\u09cd\u09af\u09a8 \u09a4\u09a5\u09cd\u09af \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be \u0995\u09f0\u0995",securitySettings:"\u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u099b\u09c7\u099f\u09bf\u0982\u099b",aiQuickReplyLow:"\u0995\u09ae",aiQuickReplyOkay:"\u09a0\u09bf\u0995 \u0986\u099b\u09c7",aiQuickReplyGood:"\u09ad\u09be\u09b2",aiQuickReplyGreat:"\u0997\u09cd\u09f0\u09c7\u099f",aiPhotoAttached:"\u09ab\u099f\u09cb \u09b8\u0982\u09b2\u0997\u09cd\u09a8 \u0995\u09f0\u09be \u09b9\u09c8\u099b\u09c7",aiTryAgain:"\u0986\u0995\u09cc \u098f\u09ac\u09be\u09f0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09f0\u0995",aiVoiceHint:"\u09b8\u09be\u099c\u09c1 \u09b9\u2019\u09b2\u09c7 \u0995\u09a5\u09be \u0995\u0993\u0995 \u2014 \u098f\u09ac\u09be\u09f0 \u09a5\u09ae\u0995\u09bf \u09f0\u2019\u09b2\u09c7 \u09ae\u0987 \u0989\u09a4\u09cd\u09a4\u09f0 \u09a6\u09bf\u09ae\u0964",resetChatTitle:"\u09b8\u09a4\u09c7\u099c \u0986\u09a1\u09cd\u09a1\u09be \u0986\u09f0\u09ae\u09cd\u09ad \u0995\u09f0\u0995?",resetChatMessage:"\u0987 \u09ac\u09f0\u09cd\u09a4\u09ae\u09be\u09a8\u09f0 AI \u0986\u09a1\u09cd\u09a1\u09be\u099f\u09cb \u09aa\u09f0\u09bf\u09b7\u09cd\u0995\u09be\u09f0 \u0995\u09f0\u09c7 \u0986\u09f0\u09c1 \u0986\u09a6\u09f0\u09a3\u09c0\u09af\u09bc \u0986\u09ae\u09c7\u099c \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u09b8\u09ae\u09c2\u09b9\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09aa\u09c1\u09a8\u09f0 \u0986\u09f0\u09ae\u09cd\u09ad \u09b9\u09af\u09bc\u0964",startFresh:"\u09b8\u09a4\u09c7\u099c \u0986\u09f0\u09ae\u09cd\u09ad \u0995\u09f0\u0995",startingFresh:"\u0986\u09f0\u09ae\u09cd\u09ad..."},phrases:{p1le0g3x:"\u0985\u099c\u09cd\u099e\u09be\u09a4",p3rvtpe:"\u0986\u099c\u09bf",poh8cad:"\u0995\u09be\u09b2\u09bf",p1mrhzr7:"\u0987\u09a8\u0995\u09be\u09ae\u09bf\u0982",pfebfdv:"\u0986\u0989\u099f\u0997\u09cb\u09af\u09bc\u09bf\u0982",p17k42kg:"\u09ae\u09bf\u099b\u09a1",pvw9wg8:"\u09b8\u09ae\u09cd\u09aa\u09c2\u09f0\u09cd\u09a3 \u09b9\u2019\u09b2",p15m090m:"\u09ac\u09bf\u09ab\u09b2 \u09b9'\u09b2",p1q8utwa:"\u09ac\u09be\u0995\u09c0 \u0986\u099b\u09c7",pcqxqrc:"\u09ae\u09bf\u09a8\u09bf\u099f",p15oehty:"\u099a\u09c7\u0995\u09c7\u09a3\u09cd\u09a1",p17tqvf1:"\u09b2\u09be\u0987\u09ad \u099a\u09c7\u099f",pos6ydf:"\u0986\u09ae\u09be\u09f0 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u09a6\u09b2\u09f0 \u09b8\u09c8\u09a4\u09c7 \u0986\u09a1\u09cd\u09a1\u09be \u09ae\u09be\u09f0\u09bf\u09ac",p1jk4gbo:"\u09b8\u09be\u09a7\u09be\u09f0\u09a3\u09a4\u09c7 \u09ad\u09bf\u09a4\u09f0\u09a4 \u0985\u09a8\u09b2\u09be\u0987\u09a8",pztgw94:"\u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u0995\u09b2 \u0995\u09f0\u0995",pig8opb:"\u09aa\u09cb\u09a8\u09aa\u099f\u09c0\u09af\u09bc\u09be\u0995\u09c8 \u0995\u09a5\u09be \u09aa\u09be\u09a4\u09bf\u09ac",pla6vae:"\u0987\u09ae\u09c7\u0987\u09b2 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8",p12y1fw5:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09cd\u09f0\u09b6\u09cd\u09a8 \u09aa\u09cd\u09f0\u09c7\u09f0\u09a3 \u0995\u09f0\u0995",pi7el9x:"\u09e8\u09ea \u0998\u09a3\u09cd\u099f\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4",peza8d7:"\u09b9\u09c1\u09ae\u09be\u0987\u09b2\u09bf\u0985'",p1k70v3b:"\u09a4\u09ce\u0995\u09cd\u09b7\u09a3\u09be\u09a4 \u0989\u09a4\u09cd\u09a4\u09f0 \u09aa\u09be\u0993\u0995",pi7p4si:"\u09e8\u09ea/\u09ed \u0989\u09aa\u09b2\u09ac\u09cd\u09a7",ptmpaw1:"\u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f \u0995\u09c7\u09a8\u09c7\u0995\u09c8 \u09ac\u09c1\u0995\u09bf\u0982 \u0995\u09f0\u09bf\u09ae?",pq44ijf:"\u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f \u09ac\u09c1\u0995\u09bf\u0982 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8, \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u099f\u09c7\u09ac\u09b2\u09c8 \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u099f \u0995\u09f0\u0995, \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u099b\u09a8\u09cd\u09a6\u09f0 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09a8\u09bf\u09f0\u09cd\u09ac\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09f0\u0995, \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09f0 \u09a7\u09f0\u09a3 \u09ac\u09be\u099b\u0995, \u0986\u09f0\u09c1 \u098f\u099f\u09be \u09a4\u09be\u09f0\u09bf\u0996 \u0986\u09f0\u09c1 \u09b8\u09ae\u09af\u09bc \u09ac\u09be\u099b\u0995\u0964 \u0986\u09aa\u09c1\u09a8\u09bf \u09b8\u0995\u09b2\u09cb \u09ac\u09bf\u09f1\u09f0\u09a3\u09f0 \u09b8\u09c8\u09a4\u09c7 \u098f\u099f\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u0995\u09f0\u09a3 \u0987\u09ae\u09c7\u0987\u09b2 \u09b2\u09be\u09ad \u0995\u09f0\u09bf\u09ac\u0964",pvi5gau:"\u09ae\u0987 \u0995\u09c7\u09a8\u09c7\u0995\u09c8 \u09ac\u09be\u09a4\u09bf\u09b2 \u09ac\u09be \u09aa\u09c1\u09a8\u09f0 \u09b8\u09ae\u09af\u09bc \u09a8\u09bf\u09f0\u09cd\u09a7\u09be\u09f0\u09a3 \u0995\u09f0\u09bf\u09ac \u09aa\u09be\u09f0\u09cb?",pfqgfyn:"\u0986\u09aa\u09c1\u09a8\u09bf \u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4\u09bf \u0985\u0982\u09b6\u09f0 \u09aa\u09f0\u09be \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09f0\u09bf\u09ac \u09aa\u09be\u09f0\u09c7\u0964 \u09aa\u09c1\u09a8\u09f0 \u09a8\u09bf\u09f0\u09cd\u09a7\u09be\u09f0\u09a3 \u09ac\u09be \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u0986\u0997\u09a8\u09cd\u09a4\u09c1\u0995 \u098f\u09aa\u0987\u09a3\u09cd\u099f\u09ae\u09c7\u09a3\u09cd\u099f \u099f\u09c7\u09aa \u0995\u09f0\u0995\u0964 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09f0 \u09e8\u09ea \u0998\u09a3\u09cd\u099f\u09be \u0986\u0997\u09a4\u09c7 \u0995\u09f0\u09be \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09f0\u09bf\u09b2\u09c7 \u09a7\u09a8 \u0998\u09c2\u09f0\u09be\u0987 \u09aa\u09cb\u09f1\u09be\u09f0 \u09af\u09cb\u0997\u09cd\u09af\u0964",p1h9bcwo:"\u09ae\u09cb\u09f0 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09a4\u09a5\u09cd\u09af \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4 \u09a8\u09c7\u0995\u09bf?",ps9lc26:"\u09b9\u09af\u09bc, \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b8\u0995\u09b2\u09cb \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u0986\u09f0\u09c1 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09a4\u09a5\u09cd\u09af \u09b6\u09c7\u09b7\u09f0 \u09aa\u09f0\u09be \u09b6\u09c7\u09b7\u09b2\u09c8 \u098f\u09a8\u0995\u09cd\u09f0\u09bf\u09aa\u099a\u09a8 \u0986\u09f0\u09c1 \u0989\u09a6\u09cd\u09af\u09cb\u0997-\u09ae\u09be\u09a8\u0995 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09aa\u09cd\u09f0\u099f\u09cb\u0995\u09b2\u09b8\u09ae\u09c2\u09b9\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4\u0964 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b8\u09a8\u09cd\u09ae\u09a4\u09bf \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a4\u09a5\u09cd\u09af \u0995\u09c7\u09a4\u09bf\u09af\u09bc\u09be\u0993 \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09ad\u09be\u0997-\u09ac\u09a4\u09f0\u09be \u0995\u09f0\u09be \u09a8\u09b9\u09af\u09bc\u0964",p1c63b9n:"\u09ae\u09cb\u09f0 \u09f1\u09be\u09b2\u09c7\u099f\u09a4 \u0995\u09c7\u09a8\u09c7\u0995\u09c8 \u09a7\u09a8 \u09af\u09cb\u0997 \u0995\u09f0\u09bf\u09ac \u09aa\u09be\u09f0\u09bf?",pfulep3:"\u09f1\u09be\u09b2\u09c7\u099f \u099f\u09c7\u09ac\u09b2\u09c8 \u09af\u09be\u0993\u0995 \u0986\u09f0\u09c1 \"\u099f\u0995\u09be \u09af\u09cb\u0997 \u0995\u09f0\u0995\" \u099f\u09c7\u09aa \u0995\u09f0\u0995\u0964 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u099b\u09a8\u09cd\u09a6\u09f0 \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09ac\u09be\u099b\u0995 \u2014 \u0995\u09be\u09f0\u09cd\u09a1, \u0987\u0989\u09aa\u09bf\u0986\u0987, \u09ac\u09be \u09ac\u09c7\u0982\u0995 \u099f\u09cd\u09f0\u09c7\u09a8\u09cd\u09b8\u09ab\u09be\u09f0 \u2014 \u0986\u09f0\u09c1 \u0986\u09aa\u09c1\u09a8\u09bf \u09af\u09cb\u0997 \u0995\u09f0\u09bf\u09ac \u09ac\u09bf\u099a\u09f0\u09be \u09a7\u09a8\u09f0\u09be\u09b6\u09bf \u09b8\u09c1\u09ae\u09c1\u09f1\u09be\u0993\u0995\u0964",pex3sts:"\u09b8\u09b9\u09be\u09af\u09bc \u0986\u09f0\u09c1 \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8",p1ofqfdp:"\u099c\u09a8\u09aa\u09cd\u09f0\u09bf\u09af\u09bc \u09aa\u09cd\u09f0\u09b6\u09cd\u09a8",p1m6uxly:"\u099a\u09c7\u09ad\u09cd\u09f0\u09a8-\u0986\u09aa",p9wx6ep:"\u099a\u09c7\u09ad\u09cd\u09f0\u09a8-\u09a1\u09be\u0989\u09a8",pmkl5g0:"\u09a4\u09be\u09ce\u0995\u09cd\u09b7\u09a3\u09bf\u0995 \u09b8\u09b9\u09be\u09af\u09bc\u09f0 \u09aa\u09cd\u09f0\u09af\u09bc\u09cb\u099c\u09a8?",p1ucr8ie:"\u09af\u09a6\u09bf \u0986\u09aa\u09c1\u09a8\u09bf \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be\u099c\u09a8\u09bf\u09a4 \u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u0985\u09f1\u09b8\u09cd\u09a5\u09be\u09f0 \u09b8\u09a8\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09c8\u099b\u09c7, \u09a4\u09c7\u09a8\u09cd\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09a4\u09ce\u0995\u09cd\u09b7\u09a3\u09be\u09a4 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u09b8\u09c7\u09f1\u09be\u09b2\u09c8 \u09ab\u09cb\u09a8 \u0995\u09f0\u0995\u0964",p1k15svg:"\u099c\u09f0\u09c1\u09f0\u09c0\u0995\u09be\u09b2\u09c0\u09a8 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997",p1il8i8d:"\u09b8\u0982\u0995\u099f \u09b8\u09ae\u09cd\u09aa\u09a6",pgcsuld:"\u098f\u099f\u09be \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09f0 \u09f0\u09bf\u09aa\u09f0\u09cd\u099f \u0995\u09f0\u0995",p1x9xuzh:"\u098f\u09aa\u099f\u09cb\u09a4 \u0995\u09cb\u09a8\u09cb \u09ac\u09be\u0997 \u09ac\u09be \u0995\u09be\u09f0\u09bf\u0995\u09f0\u09c0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09f0 \u09b8\u09a8\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09c8\u099b\u09c7\u09a8\u09c7?",p18t3p8y:"\u09f0\u09bf\u09aa\u09f0\u09cd\u099f \u0987\u099b\u09cd\u09af\u09c1",p11jo8ku:"Humaeli \u09b8\u0982\u09b8\u09cd\u0995\u09f0\u09a3",prnsj34:"\u09b6\u09c7\u09b7\u09ac\u09be\u09f0\u09f0 \u09ac\u09be\u09ac\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09f0\u09be \u09b9\u09c8\u099b\u09c7:",p8lq2oq:"\u0986\u09aa\u09a1\u09c7\u0987\u099f\u09b8\u09ae\u09c2\u09b9\u09f0 \u09ac\u09be\u09ac\u09c7 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u0995",pg6nyxd:"\u09b6\u09c7\u09b7\u09f0 \u09aa\u09f0\u09be \u09b6\u09c7\u09b7\u09b2\u09c8 \u098f\u09a8\u0995\u09cd\u09f0\u09bf\u09aa\u099a\u09a8",pm4qf9j:"GDPR \u09aa\u09cd\u09f0\u09ae\u09be\u09a3\u09c0\u0995\u09c3\u09a4 \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6",p13tbyt3:"\u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6",p1474pj6:"\u09a8\u09bf\u09f0\u09be\u09aa\u09a6 \u09f1\u09be\u09b2\u09c7\u099f \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8",p12ddn6e:"\u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2",p178beh:"\u09a8\u09be\u09ae, \u09ac\u09af\u09bc\u09b8 \u0986\u09f0\u09c1 \u09b2\u09bf\u0982\u0997",p1el3mqv:"\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09f0 \u09b8\u09ac\u09bf\u09b6\u09c7\u09b7",p1uqyawh:"\u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09f0 \u09aa\u099b\u09a8\u09cd\u09a6",p1j5drmg:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09af\u09a4\u09cd\u09a8\u09f0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4\u0995\u09f0\u09a3 \u0995\u09f0\u0995",p1hshih:"\u09b8\u09a0\u09bf\u0995 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u0995 \u09ae\u09bf\u09b2\u09be\u0987 \u09a6\u09bf\u09af\u09bc\u0995",p4lwpxb:"\u099a\u09c7\u099f \u0986\u09f0\u09c1 \u0995\u09b2",p16o5duv:"\u09ac\u09be\u09f0\u09cd\u09a4\u09be \u0986\u09f0\u09c1 \u09a6\u09cd\u09f0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09f0",pjualou:"\u0986\u09a1\u09cd\u09a1\u09be\u09f0 \u0985\u09f1\u09b8\u09cd\u09a5\u09be \u0986\u09f0\u09c1 \u09b8\u0982\u09b2\u0997\u09cd\u09a8\u09b8\u09ae\u09c2\u09b9",p8fcohj:"\u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09be \u0986\u09a1\u09cd\u09a1\u09be \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8",pqugyus:"\u0985\u09ac\u09bf\u09f0\u09a4 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8\u09f0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u0995",pxw259e:"\u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09f0 \u09b8\u09ae\u09af\u09bc\u09a4 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09b8\u09ae\u09f0\u09cd\u09a5\u09a8 \u09b8\u09be\u09ae\u09f0\u09cd\u09a5\u09ac\u09be\u09a8 \u0995\u09f0\u0995",ppapyhl:"\u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4\u09bf",ppjebc6:"\u09ac\u09c1\u0995\u09bf\u0999\u09f0 \u09a4\u09be\u09f0\u09bf\u0996 \u0986\u09f0\u09c1 \u09b8\u09ae\u09af\u09bc",prz84q3:"\u09a8\u09bf\u09f0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be",p6bzi8o:"\u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09f0 \u099f\u09cb\u0995\u09be",pfby3q4:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u0986\u0997\u09a8\u09cd\u09a4\u09c1\u0995 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9 \u09aa\u09f0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09f0\u0995",p1px010k:"\u09b8\u09ae\u09af\u09bc\u09ae\u09a4\u09c7 \u09b8\u09cb\u0981\u09f1\u09f0\u09be\u0987 \u09aa\u09a0\u09be\u0993\u0995",pl6oj3n:"\u09f1\u09be\u09b2\u09c7\u099f \u0986\u09f0\u09c1 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8",pcisb5n:"\u09f0\u09bf\u099a\u09be\u09f0\u09cd\u099c \u0986\u09f0\u09c1 \u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f\u09f0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8",p11x8ws5:"\u09f0\u09bf\u09ab\u09be\u09a3\u09cd\u09a1 \u09f0\u09c7\u0995\u09f0\u09cd\u09a1",p1jezb8u:"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09f0 \u09f0\u099a\u09bf\u09a6",p1kxmxol:"\u09aa\u09c7\u09ae\u09c7\u09a3\u09cd\u099f\u09b8\u09ae\u09c2\u09b9 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4\u09ad\u09be\u09f1\u09c7 \u09aa\u09cd\u09f0\u0995\u09cd\u09f0\u09bf\u09af\u09bc\u09be\u0995\u09f0\u09a3 \u0995\u09f0\u0995",p1soeejn:"\u09b8\u09a0\u09bf\u0995 \u09ac\u09bf\u09b2\u09bf\u0982 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09ac\u099c\u09be\u0987 \u09f0\u09be\u0996\u0995",p3fb3fk:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a4\u09a5\u09cd\u09af \u0985\u09ad\u09bf\u0997\u09ae \u0995\u09f0\u0995",paxx0ja:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 Humaeli \u09f0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af\u09f0 \u0995\u09aa\u09bf \u09ac\u09bf\u099a\u09be\u09f0\u09bf\u09ac\u0964",py8xd5m:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09a4\u09a5\u09cd\u09af \u09b6\u09c1\u09a7\u09f0\u09be\u0987 \u09b2\u0993\u0995",pg1ugci:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09aa\u09cd\u09f0\u09ab\u09be\u0987\u09b2\u09f0 \u09aa\u09f0\u09be \u09ad\u09c1\u09b2 \u09ac\u09be \u09aa\u09c1\u09f0\u09a3\u09bf \u09ac\u09bf\u09f1\u09f0\u09a3 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc\u09a4\u09c7 \u0986\u09aa\u09a1\u09c7\u0987\u099f \u0995\u09f0\u0995\u0964",p13743po:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f \u09ae\u099a\u09bf \u09aa\u09c7\u09b2\u09be\u0993\u0995",p12l9hlj:"\u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u098f\u0995\u09be\u0989\u09a3\u09cd\u099f \u0986\u09f0\u09c1 \u09b8\u0982\u09b6\u09cd\u09b2\u09bf\u09b7\u09cd\u099f \u09ac