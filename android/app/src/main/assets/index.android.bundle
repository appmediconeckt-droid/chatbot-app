05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2c\u0c41\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c38\u0c4d \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c15\u0c41 \u0c28\u0c3e\u0c35\u0c3f\u0c17\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f, \u0c2e\u0c40\u0c15\u0c41 \u0c07\u0c37\u0c4d\u0c1f\u0c2e\u0c48\u0c28 \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f, \u0c2e\u0c40 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c47\u0c26\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c23 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c41.",pvi5gau:"\u0c28\u0c47\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c30\u0c40\u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?",pfqgfyn:"\u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32 \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2e\u0c40 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c30\u0c40\u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f. \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c15\u0c41 24 \u0c17\u0c02\u0c1f\u0c32 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c30\u0c26\u0c4d\u0c26\u0c41\u0c32\u0c41 \u0c30\u0c40\u0c2b\u0c02\u0c21\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c05\u0c30\u0c4d\u0c39\u0c41\u0c32\u0c41.",p1h9bcwo:"\u0c28\u0c3e \u0c35\u0c48\u0c26\u0c4d\u0c2f \u0c21\u0c47\u0c1f\u0c3e \u0c38\u0c41\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c26\u0c3e?",ps9lc26:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2e\u0c40 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c48\u0c26\u0c4d\u0c2f \u0c21\u0c47\u0c1f\u0c3e \u0c05\u0c02\u0c24\u0c3e \u0c0e\u0c02\u0c21\u0c4d-\u0c1f\u0c41-\u0c0e\u0c02\u0c21\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c37\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c02\u0c21\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c40-\u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c46\u0c15\u0c4d\u0c2f\u0c42\u0c30\u0c3f\u0c1f\u0c40 \u0c2a\u0c4d\u0c30\u0c4b\u0c1f\u0c4b\u0c15\u0c3e\u0c32\u0c4d\u200c\u0c32\u0c24\u0c4b \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2e\u0c40 \u0c21\u0c47\u0c1f\u0c3e \u0c2e\u0c42\u0c21\u0c35 \u0c2a\u0c15\u0c4d\u0c37\u0c3e\u0c32\u0c24\u0c4b \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c42 \u0c37\u0c47\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41.",p1c63b9n:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d\u200c\u0c15\u0c3f \u0c28\u0c3f\u0c27\u0c41\u0c32\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",pfulep3:"Wallet \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c3f, \"\u0c21\u0c2c\u0c4d\u0c2c\u0c41\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c41\" \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c15\u0c41 \u0c07\u0c37\u0c4d\u0c1f\u0c2e\u0c48\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u2014 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, UPI \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u2014 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40\u0c30\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",pex3sts:"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41",p1ofqfdp:"\u0c1c\u0c28\u0c3e\u0c26\u0c30\u0c23 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41",p1m6uxly:"\u0c1a\u0c46\u0c35\u0c4d\u0c30\u0c3e\u0c28\u0c4d-\u0c05\u0c2a\u0c4d",p9wx6ep:"\u0c1a\u0c46\u0c35\u0c4d\u0c30\u0c3e\u0c28\u0c4d-\u0c21\u0c4c\u0c28\u0c4d",pmkl5g0:"\u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e?",p1ucr8ie:"\u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c46\u0c21\u0c3f\u0c15\u0c32\u0c4d \u0c0e\u0c2e\u0c30\u0c4d\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40\u0c28\u0c3f \u0c0e\u0c26\u0c41\u0c30\u0c4d\u0c15\u0c4a\u0c02\u0c1f\u0c41\u0c02\u0c1f\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c35\u0c46\u0c02\u0c1f\u0c28\u0c47 \u0c2e\u0c40 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c38\u0c47\u0c35\u0c32\u0c15\u0c41 \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",p1k15svg:"\u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41",p1il8i8d:"\u0c38\u0c02\u0c15\u0c4d\u0c37\u0c4b\u0c2d \u0c35\u0c28\u0c30\u0c41\u0c32\u0c41",pgcsuld:"\u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p1x9xuzh:"\u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c2c\u0c17\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c3e\u0c02\u0c15\u0c47\u0c24\u0c3f\u0c15 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c0e\u0c26\u0c41\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e?",p18t3p8y:"\u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",p11jo8ku:"Humaeli \u0c35\u0c46\u0c30\u0c4d\u0c37\u0c28\u0c4d",prnsj34:"\u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c17\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f:",p8lq2oq:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",pg6nyxd:"\u0c0e\u0c02\u0c21\u0c4d-\u0c1f\u0c41-\u0c0e\u0c02\u0c21\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c37\u0c28\u0c4d",pm4qf9j:"GDPR \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d",p13tbyt3:"\u0c05\u0c1c\u0c4d\u0c1e\u0c3e\u0c24 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c41",p1474pj6:"\u0c38\u0c41\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24 \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32\u0c41",p12ddn6e:"\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d",p178beh:"\u0c2a\u0c47\u0c30\u0c41, \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3f\u0c02\u0c17\u0c02",p1el3mqv:"\u0c38\u0c02\u0c2a\u0c