u0902 \u0915\u093f \u0915\u094c\u0928 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0932\u0917\u0924\u093e \u0939\u0948\u0964",p1ligovc:"\u0928\u093f\u091c\u0940",p17bt1m8:"\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f",p1a334hr:"\u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926",p11sy06:"\u090f\u0915 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u0947\u0902",p1ixdjxz:"\u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902",p1ns5701:"\u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u0947\u0902...",p1yvu9zk:"\u0939\u093e\u0932 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924",pwchxnm:"\u091a\u0948\u091f \u0939\u091f\u093e\u090f\u0901",p8z5j4b:"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938 \u091a\u0948\u091f \u0915\u094b \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",p22tyg:"\u092f\u0939 \u0906\u092a\u0915\u0947 \u0926\u0943\u0936\u094d\u092f \u0938\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0924\u093e \u0939\u0948. \u0928\u090f \u0938\u0902\u0926\u0947\u0936 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0917\u0947.",p14ysx9g:"\u0906\u0916\u093f\u0930\u0940 \u0938\u0902\u0926\u0947\u0936",p10xzpwg:"\u0905\u092a\u0928\u0947 \u0921\u0947\u091f\u093e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0947\u0902",p18q7bjm:"\u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0905\u092a\u0928\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0948\u0938\u0947 \u0926\u0947\u0916\u0947\u0902",po7e42i:"\u0905\u092a\u0928\u093e \u0921\u0947\u091f\u093e \u0920\u0940\u0915 \u0915\u0930\u0947\u0902",po8rj6t:"\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902",piaxnod:"\u0916\u093e\u0924\u093e \u0939\u091f\u093e\u090f\u0901",pgdy5y4:"\u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0915\u0948\u0938\u0947 \u0939\u091f\u093e\u090f\u0902",p9t8y0e:"\u0936\u093f\u0915\u093e\u092f\u0924 \u0909\u0920\u093e\u090f\u0901",p1om18ny:"\u0915\u093f\u0938\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902 \u092f\u093e Humaeli \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902",p1ih5m0b:"\u0935\u093e\u092a\u0938\u0940",pio6wsx:"\u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0948\u0938\u0947 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902",p1ch3j6g:"\u0936\u0947\u0935\u0930\u0949\u0928-\u092b\u093c\u0949\u0930\u0935\u0930\u094d\u0921",p1ik11pv:"\u0907\u0938 \u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e. \u0906\u092a\u0915\u093e \u0938\u093e\u0930\u093e \u0921\u0947\u091f\u093e \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e.",p2sz7zo:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0942\u091a\u0928\u093e\u090f\u0902",p6uwjmz:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0905\u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902. \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902\u0964",paaukf8:"\u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",p1767en8:"\u0921\u0949\u0915\u094d\u091f\u0930",pz3uvj6:"\u0938\u0932\u093e\u0939\u0915\u093e\u0930",p1dd8d4l:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902",p6kq7jc:"\u091c\u092c \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0939\u094b \u0924\u094b \u092e\u0941\u091d\u0947 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902",pa0r5vf:"\u0938\u0942\u091a\u0928\u093e\u090f\u0902",p1h0t9h2:"\u0938\u0942\u091a\u0928\u093e\u090f\u0902-\u0930\u0942\u092a\u0930\u0947\u0916\u093e",p42jbpz:"\u0921\u0949\u0915\u094d\u091f\u0930\u094b\u0902",p1av2qiu:"\u092a\u093e\u0938 \u092e\u0947\u0902",poad1ph:"\u0906\u0938-\u092a\u093e\u0938 \u0915\u094b\u0908 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",pynbw50:"\u0906\u092a\u0915\u093e \u092a\u0924\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948",p1rc095z:"\u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0914\u0930 \u0921\u0949\u0915\u094d\u091f\u0930\u094b\u0902 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947 \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0947\u0902 \u092f\u093e \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0947\u0902\u0964",py13efi:"\u0938\u092d\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902",p5fo9od:"\u0935\u0949\u0932\u0947\u091f \u0930\u093f\u092b\u0902\u0921 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0947\u0902",p1f69fpb:"\u0905\u092a\u094d\u0930\u092f\u0941\u0915\u094d\u0924 \u0935\u0949\u0932\u0947\u091f \u0927\u0928\u0930\u093e\u0936\u093f \u0915\u094b \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092d\u0947\u091c\u0947\u0902\u0964 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u0923 \u092e\u0947\u0902 48 \u0918\u0902\u091f\u0947 \u0924\u0915 \u0915\u093e \u0938\u092e\u092f \u0932\u0917 \u0938\u0915\u0924\u093e \u0939\u0948.",p1q7zz6b:"\xb7 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",pol0i1z:"\u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u0930\u093e\u0936\u093f",p122pd6u:"\u0909\u092a\u0932\u092c\u094d\u0927:",pnfx3og:"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0915\u093e \u0935\u093f\u0935\u0930\u0923",plsi9q4:"\u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0907\u0938 \u092c\u0948\u0902\u0915 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",pybbru7:"\u0905\u0915\u094d\u0937\u0930",p35zhfc:"\u0936\u092c\u094d\u0926",p4t3o38:"\u090f\u0915 \u092c\u093e\u0930 \u0938\u092c\u092e\u093f\u091f \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915 \u0915\u0947 \u092a\u093e\u0938 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0930\u093f\u092b\u0902\u0921 48 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930 \u0926\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",p13hmyj3:"\u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0927\u0940\u0928 \u0939\u0948",pg09i32:"\u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902",p1b8x5rx:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0905\u0928\u0941\u0930\u094b\u0927",p1ur4x1n:"\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0917\u093e",p3g79wl:"\u0928\u0941\u0938\u094d\u0916\u093e",phdf9nl:"\u0905\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u092f",pmdcn92:"\u0915\u0943\u092a\u092f\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u0914\u0930 \u0938\u092e\u092f \u091a\u0941\u0928\u0947\u0902\u0964",p1qgtrsa:"\u092e\u0947\u0930\u093e \u091f\u094b\u0915\u0928",p1qmr9xa:"\u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092d\u093e\u0937\u093e \u091a\u0941\u0928\u0947\u0902",pi4acqh:"\u0916\u094b\u091c \u092d\u093e\u0937\u093e",p19kmbf7:"\u0915\u094b\u0908 \u092d\u093e\u0937\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940",p1ubrw3v:"\u0905\u092a\u0928\u093e \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",p17i3uwk:"__\u0939\u0941\u092e\u0948\u0932\u0940_12_0__",p11w1r8f:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u0939\u0941\u0901\u091a \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948",pcvoojo:"\u0905\u0928\u0932\u0949\u0915 Humaeli",p1i4kbre:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0905\u0928\u0932\u0949\u0915 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948...",pq7wyy4:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u092a\u0930\u094d\u0915",p1d38t85:"\u0905\u0928\u0932\u0949\u0915",p1cdrrox:"\u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u092a\u093f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902",p5iqttw:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",pyjmdam:"\u0935\u093e\u092a\u0938",p13cyvef:"\u0905\u092d\u0940 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f?",pp3ccct:"\u0924\u0941\u0930\u0902\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902 - \u0905\u0928\u0932\u0949\u0915 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",pg43fcb:"\u0938\u0902\u0915\u091f \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928",pe35won:"\u091f\u0947\u0932\u0940-\u092e\u093e\u0928\u0938 \xb7",pp9u4ue:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928",p2sc9b1:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092d\u0942\u0932 \u0917\u090f",p76voo8:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0913\u091f\u0940\u092a\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",pd03ywl:"\u0908\u092e\u0947\u0932 \u092a\u0924\u093e*",p8j8ry0:"\u0905\u092a\u0928\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",p5xb4hz:"\u0930\u0940\u0938\u0947\u091f \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u0947\u0902",p1euz9g3:"\u0905\u092a\u0928\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e\u0926 \u0930\u0916\u0947\u0902?",p1t4d3di:"\u0932\u0949\u0917\u0907\u0928 \u092a\u093