2\u06c1 \u062a\u0631\u06cc\u0646 \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u0627 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u0646\u06d2 \u0627\u0648\u0631 \u0631\u067e\u0648\u0631\u0679 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 Wallet \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4 \u0633\u067e\u0648\u0631\u0679 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u062a\u0627\u0631\u06cc\u062e\u060c \u0631\u0642\u0645 \u0627\u0648\u0631 \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0627 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",languageWrongTitle:"\u0632\u0628\u0627\u0646 \u06cc\u0627 \u062a\u0631\u062c\u0645\u06c1 \u063a\u0644\u0637 \u0644\u06af\u062a\u0627 \u06c1\u06d2\u06d4",languageWrongDesc:"\u0688\u06cc\u0634 \u0628\u0648\u0631\u0688/\u0633\u06cc\u0679\u0646\u06af\u0632 \u0633\u06d2 \u0644\u06cc\u0646\u06af\u0648\u06cc\u062c \u0633\u0644\u06cc\u06a9\u0679\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4 \u06a9\u0686\u06be \u0645\u0634\u06cc\u0631 \u06cc\u0627 \u0637\u0628\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0646\u0646\u062f\u06c1 \u06a9\u06cc \u062f\u0631\u062c \u06a9\u0631\u062f\u06c1 \u0632\u0628\u0627\u0646 \u0645\u06cc\u06ba \u0631\u06c1 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4",needMoreHelp:"\u0645\u0632\u06cc\u062f \u0645\u062f\u062f \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f",needMoreHelpDesc:"\u067e\u0631\u0648\u0641\u0627\u0626\u0644/\u0633\u06cc\u0679\u0646\u06af\u0632 \u0633\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0634\u0627\u0679\u0633\u060c \u0627\u06cc\u067e \u0648\u0631\u0698\u0646\u060c \u0635\u0627\u0