\u0a9c\u0ac1\u0a93",walletPayments:"\u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a85\u0aa8\u0ac7 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0",walletDesc:"\u0aaa\u0ac8\u0ab8\u0abe \u0a89\u0aae\u0ac7\u0ab0\u0acb, \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0acb, \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0acd\u0ab8 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb.",walletAction:"\u0a93\u0aaa\u0aa8 \u0ab5\u0acb\u0ab2\u0ac7\u0a9f",beforeContact:"\u0aa4\u0aae\u0ac7 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb \u0aa4\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0a82",checklist1:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aa8\u0ac7\u0a9f \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0ab6\u0aa8\u0aa8\u0ac0 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \ufffd\ufffd\u0acb\u0aa1\u0abf\u0a82\u0a97 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aa8\u0ac7 \u0aa4\u0abe\u0a9c\u0ac1\u0a82 \u0a95\u0ab0\u0acb.",checklist2:"\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8\u0ab6\u0ac9\u0a9f, \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0ab8\u0aae\u0aaf \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8 \u0aa8\u0abe\u0aae \u0aa4\u0ac8\u0aaf\u0abe\u0ab0 \u0ab0\u0abe\u0a96\u0acb.",checklist3:"\u0a95\u0ac5\u0aae\u0ac7\u0ab0\u0abe, \u0aae\u0abe\u0a87\u0a95\u0acd\u0ab0\u0acb\u0aab\u0acb\u0aa8, \u0aa8\u0acb\u0a9f\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0aa8\u0ac0 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7, \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0aa1\u0abf\u0ab5\u0abe\u0a87\u0ab8 \u0a8d\u0aaa\u0aa8\u0ac0 \u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93 \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",checklist4:"\u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0\u0aa8\u0ac0 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7, \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0aa4\u0abe\u0ab0\u0ac0\u0a96, \u0ab0\u0a95\u0aae, \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0a85\u0aa8\u0ac7 \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0aac\u0ac7\u0ab2\u0ac7\ufffd\ufffd\u0acd\u0ab8\u0aa8\u0acb \u0ab8\u0aae\u0abe\u0ab5\u0ac7\u0ab6 \u0a95\u0ab0\u0acb.",commonIssues:"\u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aae\u0ac1\u0aa6\u0acd\u0aa6\u0abe\u0a93",aiChatNotReply:"AI \u0a9a\u0ac7\u0a9f \u0a9c\u0ab5\u0abe\u0aac \u0a86\u0aaa\u0ac0 \u0ab0\u0ab9\u0ac0 \u0aa8\u0aa5\u0ac0",aiChatNotReplyDesc:"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aa8\u0ac7\u0a9f \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0aa4\u0aaa\u0abe\u0ab8\u0acb, \u0a9f\u0ac2\u0a82\u0a95\u0acb \u0ab8\u0a82\u0aa6\u0ac7\u0ab6 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1 \u0aaa\u0ab0\u0aa5\u0ac0 AI \u0a9a\u0ac7\u0a9f \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a96\u0acb\u0ab2\u0acb. \u0a9c\u0acb \u0aa4\u0ac7 \u0ab9\u0a9c\u0ac0 \u0aaa\u0aa3 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0a9c\u0abe\u0aaf, \u0aa4\u0acb \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0abe\u0aa5\u0ac7 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aad\u0ac2\u0ab2\u0aa8\u0acb \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8\u0ab6\u0acb\u0a9f \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb.",counselorChatNotOpen:"\u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0a9a\u0ac7\u0a9f \u0a96\u0ac1\u0ab2\u0ac0 \u0ab0\u0ab9\u0ac0 \u0aa8\u0aa5\u0ac0",counselorChatNotOpenDesc:"\u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a96\u0acb\u0ab2\u0acb, \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab0\u0abe\u0ab9 \u0a9c\u0ac1\u0a93. \u0ab9\u0abe\u0ab2\u0aa8\u0ac0 \u0a9a\u0ac7\u0a9f\u0acd\u0ab8 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0a9a\u0ac7\u0a9f \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8\u0aae\u0abe\u0a82 \u0aa6\u0ac7\u0a96\u0abe\u0aaf \u0a9b\u0ac7.",callNotConnecting:"\u0a95\u0ac9\u0ab2 \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f \u0aa5\u0a88 \u0ab0\u0ab9\u0acd\u0aaf\u0acb \u0aa8\u0aa5\u0ac0",callNotConnectingDesc:"\u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a9a\u0ac7\u0a9f/\u0ab8\u0aa4\u0acd\u0ab0 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7, \u0aac\u0a82\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0a91\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0a87\u0a95\u0acd\u0ab0\u0acb\u0aab\u0acb\u0aa8/\u0a95\u0ac7\u0aae\u0ac7\u0ab0\u0abe\u0aa8\u0ac0 \u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93\u0aa8\u0ac7 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7.",walletPaymentIssue:"\u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a85\u0aa5\u0ab5\u0abe \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe",walletPaymentIssueDesc:"\u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a96\u0acb\u0ab2\u0acb. \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aa4\u0abe\u0ab0\u0ac0\u0a96, \u0ab0\u0a95\u0aae \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb.",languageWrongTitle:"\u0aad\u0abe\u0ab7\u0abe \u0a95\u0ac7 \u0a85\u0aa8\u0ac1\u0ab5\u0abe\u0aa6 \u0a96\u0acb\u0a9f\u0acb \u0ab2\u0abe\u0a97\u0ac7 \u0a9b\u0ac7",languageWrongDesc:"\u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1/\u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aad\u0abe\u0ab7\u0abe \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0a95\u0abe\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb. \u0a95\u0ac7\u0a9f\u0ab2\u0ac0\u0a95 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa4\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",needMoreHelp:"\u0ab5\u0aa7\u0ac1 \u0aae\u0aa6\u0aa6\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",needMoreHelpDesc:"\u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2/\u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8\u0ab6\u0ac9\u0a9f\u0acd\u0ab8, \u0a8d\u0aaa \u0ab5\u0ab0\u0acd\u0a9d\u0aa8, \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0a87\u0aae\u0ac7\u0a87\u0ab2/\u0aab\u0acb\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a95\u0aaf\u0abe \u0ab8\u0aae\u0aaf\u0ac7 \u0a86\u0ab5\u0ac0 \u0aa4\u0ac7 \u0ab8\u0abe\u0aa5\u0ac7 \u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f. \u0aad\u0abe\u0ab0\u0aa4\u0aae\u0abe\u0a82 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0ab9\u0abe\u0aaf \u0aae\u0abe\u0a9f\u0ac7, 9152987821 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abf\u0a95 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aaa\u0ab0 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb.",myProfile:"\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2",settings:"\u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8",emailSupport:"\u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0a86\u0aa7\u0abe\u0ab0"},privacyPage:{title:"\u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aa8\u0ac0\u0aa4\u0abf",centerTitle:"Humaeli \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0",centerDesc:"\u0a86 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab8\u0aae\u0a9c\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 Humaeli \u0a86 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2, \u0a9a\u0ac7\u0a9f, \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f, \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f, \u0a95\u0ac9\u0ab2, \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",otpProtected:"OTP \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4",otpProtectedDesc:"\u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0a85\u0aa8\u0ac7 \u0aab\u0acb\u0aa8 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0acb",anonymousCare:"\u0a85\u0aa8\u0abe\u0aae\u0ac0 \u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0a93\u0ab3\u0a96",anonCareDesc:"\u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0abf\u0aa4 \u0ab9\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ab2\u0abe\u0ab9\u0a95\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0aac\u0aa4\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7",sensitiveAreas:"\u0ab8\u0a82\u0ab5\u0ac7\u0aa6\u0aa8\u0ab6\u0ac0\u0ab2 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0acb",sensitiveAreasDesc:"\u0a9a\u0ac7\u0a9f\u0acd\u0ab8, \u0a95\u0acb\u0ab2\u0acd\u0ab8, \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8, \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2",dataUsedTitle:"\u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aae\u0abe\u0a82 \u0ab5\u0aaa\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aa1\u0ac7\u0a9f\u0abe",profileHealth:"\u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0a85\u0aa8\u0ac7 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab5\u0abf\u0a97\u0aa4\u0acb",profileHealthDesc:"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aa8\u0abe\u0aae, \u0a85\u0aa8\u0abe\u0aae\u0ac0 \u0aa1\u0abf\u0ab8\u0acd\u0aaa\u0acd\u0ab2\u0ac7 \u0aa8\u0abe\u0aae, \u0a89\u0a82\u0aae\u0ab0, \u0ab2\u0abf\u0a82\u0a97, \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb, \u0aab\u0acb\u0a9f\u0acb/\u0a85\u0ab5\u0aa4\u0abe\u0ab0, \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82, \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95, \u0aae\u0ac2\u0ab3\u0aad\u0ac2\u0aa4 \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0ac0\u0aae\u0abe \u0a95\u0acd\u0ab7\u0ac7\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aa6\u0ab0\u0acd\u0aa6\u0ac0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0a9c\u0abe\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",aiConversations:"AI \u0a9a\u0ac7\u0a9f \u0a85\u0aa8\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4",aiConversationsDesc:"\u0ab8\u0a82\u0aa6\u0ac7\u0ab6\u0abe\u0a93, \u0a9d\u0aa1\u0aaa\u0ac0 \u0a9c\u0ab5\u0abe\u0aac\u0acb, \u0a9a\u0ac7\u0a9f \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf, \u0a9c\u0acb\u0aa1\u0abe\u0aa3\u0acb, \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4 \u0a9a\u0ac7\u0a9f \u0ab8\u0aa4\u0acd\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0ab5\ufffd\ufffd\u0ab0\u0acd\u0aa4\u0abe\u0ab2\u0abe\u0aaa \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe, \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8 \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab0\u0ac7\u0a9f\u0abf\u0a82\u0a97 \u0aaa\u0acd\u0ab0\u0acb\u0aae\u0acd\u0aaa\u0acd\u0a9f\u0acd\u0ab8\u0aa8\u0ac7 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",appointments:"\u0aa8\u0abf\u0aae\u0aa3\u0ac2\u0a82\u0a95\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0aa4\u0acd\u0ab0\u0acb",appointmentsDesc:"\u0aa8\u0abf\u0aae\u0aa3\u0ac2\u0a95\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96, \u0ab8\u0aae\u0aaf, \u0a95\u0abe\u0ab0\u0aa3/\u0aa8\u0acb\u0a82\u0aa7, \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf, \u0ab8\u0acb\u0a82\u0aaa\u0abe\u0aaf\u0ac7\u0ab2 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0, \u0a95\u0ac9\u0ab2 \u0aae\u0ac7\u0a9f\u0abe\u0aa1\u0ac7\u0a9f\u0abe \u0a85\u0aa8\u0ac7 \u0ab8\u0aa4\u0acd\u0ab0 \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab2\u0abe\u0ab9\u0a95\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0ab8\u0a82\u0aad\u0abe\u0ab3\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",wallet:"\u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb",walletDesc:"\u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a9f\u0acd\u0ab0\u0ac7\u0a95\u0abf\u0a82\u0a97 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0aac\u0ac7\u0ab2\u0ac7\u0aa8\u0acd\u0ab8, \u0a9f\u0acb\u0aaa-\u0a85\u0aaa\u0acd\u0ab8, \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0a9d\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0acd\u0ab8, \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f\u0ac7\u0aa1 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",location:"\u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0a89\u0aaa\u0a95\u0ab0\u0aa3 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad",locationDesc:"\u0ab8\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0ac7 \u0a9a\u0a95\u0abe\u0ab8\u0ab5\u0abe, \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe\u0aa8\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8 \u0a86\u0aaa\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0aa5\u0abe\u0aa8-\u0a9c\u0abe\u0a97\u0ac3\u0aa4 \u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0abe\u0a87\u0aa8\u0a85\u0aaa, \u0ab2\u0acb\u0a97\u0abf\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0ac7\u0aa8\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0ab0\u0abf\u0aab\u0acd\u0ab0\u0ac7\u0ab6 \u0aaa\u0ab0 \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0a95\u0ac7\u0aaa\u0acd\u0a9a\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",security:"\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a85\u0aa8\u0ac7 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0a8f\u0a95\u0acd\u0ab8\u0ac7\u0ab8",securityDesc:"\u0ab2\u0acb\u0a97\u0abf\u0aa8 \u0a9f\u0acb\u0a95\u0aa8\u0acd\u0ab8, \u0a93\u0aa5 \u0aaa\u0acd\u0ab0\u0acb\u0ab5\u0abe\u0a88\u0aa1\u0ab0, \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8, OTP \u0ab5\u0ac7\u0ab0\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8, \u0ab0\u0acb\u0ab2 \u0a85\u0aa8\u0ac7 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aaf\u0ac1\u0a9d\u0ab0 \u0a85\u0aa8\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0a85\u0ab2\u0a97 \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",whoCanSee:"\u0a95\u0acb\u0aa3 \u0ab6\u0ac1\u0a82 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7",visibleToYou:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa6\u0ac3\u0ab6\u0acd\u0aaf\u0aae\u0abe\u0aa8",visibleDesc:"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\ufffd\ufffd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2, AI \u0a9a\u0ac7\u0a9f\u0acd\u0ab8, \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0\u0aa8\u0ac0 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93, \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8, \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f, \u0a95\u0ac9\u0ab2 \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8, \u0ab0\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8 \u0ab8\u0a82\u0a95\u0ac7\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0aa5\u0abe\u0aa8/\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3\u0acb \u0aac\u0aa4\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.",sharedForCare:"\u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82",sharedDesc:"\u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4 \u0ab8\u0aa4\u0acd\u0ab0\u0acb, \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0abf\u0aa4 \u0ab9\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0a85\u0aa8\u0abe\u0aae\u0ac0 \u0a93\u0ab3\u0a96\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",protectedAccess:"\u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4",protectedDesc:"\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0aad\u0ac2\u0aae\u0abf\u0a95\u0abe, \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0ab8\u0aa4\u0acd\u0ab0\u0acb, OTP \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0abf\u0aa4 API \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0a93 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0ab2\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.",checklist:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0a9a\u0ac7\u0a95\u0ab2\u0abf\u0ab8\u0acd\u0a9f",checklistItem1:"\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab5\u0abe\u0ab8\u0acd\u0aa4\u0ab5\u0abf\u0a95 \u0aa8\u0abe\u0aae \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0aa4\u0abe \u0aa8 \u0ab9\u0acb\u0ab5 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0ac7\u0ab2\u0ab0\u0aa8\u0ac0 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a85\u0aa8\u0abe\u0aae\u0ac0 \u0aa8\u0abe\u0aae\u0aa8\u0acb \ufffd\ufffd\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb.",checklistItem2:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0aad\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0aa4\u0acb \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a85\u0aa8\u0ac7 \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0a9a\u0acb\u0a9f \u0ab0\u0abe\u0a96\u0acb.",checklistItem3:"\u0a95\u0ac9\u0ab2 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0a82 \u0ab8\u0acd\u0aa5\u0abe\u0aa8, \u0a95\u0ac5\u0aae\u0ac7\u0ab0\u0abe \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0a87\u0a95\u0acd\u0ab0\u0acb\u0aab\u0acb\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aaa\u0a95\u0ab0\u0aa3 \u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0acb.",checklistItem4:"\u0a9c\u0acb \u0ab2\u0acb\u0a97\u0abf\u0aa8 \u0aaa\u0acd\u0ab0\u0acb\u0aae\u0acd\u0aaa\u0acd\u0a9f \u0a9b\u0acb\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0ab9\u0acb\u0aaf \u0aa4\u0acb \u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8/\u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0a9c\u0abe\u0aa4\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb.",checklistItem5:"\u0a9a\u0ac7\u0a9f \u0ab8\u0a82\u0aa6\u0ac7\u0ab6\u0abe\u0aae\u0abe\u0a82 OTP, \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0a82\u0ab5\u0ac7\u0aa6\u0aa8\u0ab6\u0ac0\u0ab2 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab6\u0acb \u0aa8\u0ab9\u0ac0\u0a82.",checklistItem6:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0aae\u0abe\u0a82 \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0a85\u0aa8\u0ac7 \u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb.",manageData:"\u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0aa1\u0ac7\u0a9f\u0abe \u0aae\u0ac7\u0aa8\u0ac7\u0a9c \u0a95\u0ab0\u0acb",securitySettings:"\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8",aiQuickReplyLow:"\u0aa8\u0ac0\u0a9a\u0ac1\u0a82",aiQuickReplyOkay:"\u0aa0\u0ac0\u0a95 \u0a9b\u0ac7",aiQuickReplyGood:"\u0ab8\u0abe\u0ab0\u0ac1\u0a82",aiQuickReplyGreat:"\u0aae\u0ab9\u0abe\u0aa8",aiPhotoAttached:"\u0aab\u0acb\u0a9f\u0acb \u0a9c\u0acb\u0aa1\u0acd\u0aaf\u0acb",aiTryAgain:"\u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb",aiVoiceHint:"\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0ac8\u0aaf\u0abe\u0ab0 \u0ab9\u0acb\u0ab5 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aac\u0acb\u0ab2\u0acb \u2014 \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0aa4\u0aae\u0ac7 \u0aa5\u0acb\u0aad\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0ab9\u0ac1\u0a82 \u0a9c\u0ab5\u0abe\u0aac \u0a86\u0aaa\u0ac0\u0ab6.",resetChatTitle:"\u0aa8\u0ab5\u0ac0 \u0a9a\u0ac7\u0a9f \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ac0\u0a8f?",resetChatMessage:"\u0a86 \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 AI \u0a9a\u0ac7\u0a9f\u0aa8\u0ac7 \u0ab8\u0abe\u0aab \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0ab5\u0abe\u0a97\u0aa4 \u0aae\u0ac2\u0aa1 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0aab\u0ab0\u0ac0 \u0ab6\u0ab0\u0ac2 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",startFresh:"\u0ab8\u0acd\u0a9f\u0abe\u0ab0\u0acd\u0a9f \u0aab\u0acd\u0ab0\u0ac7\u0ab6",startingFresh:"\u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7..."},phrases:{p1le0g3x:"\u0a85\u0a9c\u0acd\u0a9e\u0abe\u0aa4",p3rvtpe:"\u0a86\u0a9c\u0ac7",poh8cad:"\u0a97\u0a88\u0a95\u0abe\u0ab2\u0ac7",p1mrhzr7:"\u0a87\u0aa8\u0a95\u0aae\u0abf\u0a82\u0a97",pfebfdv:"\u0a86\u0a89\u0a9f\u0a97\u0acb\u0a87\u0a82\u0a97",p17k42kg:"\u0a9a\u0ac2\u0a95\u0ac0 \u0a97\u0aaf\u0abe",pvw9wg8:"\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0aaf\u0ac1\u0a82",p15m090m:"\u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3",p1q8utwa:"\u0aac\u0abe\u0a95\u0ac0 \u0a9b\u0ac7",pcqxqrc:"\u0aae\u0abf\u0aa8\u0abf\u0a9f",p15oehty:"\u0ab8\u0ac7\u0a95\u0aa8\u0acd\u0aa1",p17tqvf1:"\u0ab2\u0abe\u0a88\u0ab5 \u0a9a\u0ac7\u0a9f",pos6ydf:"\u0a85\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a9f\u0ac0\u0aae \u0ab8\u0abe\u0aa5\u0ac7 \u0a9a\u0ac7\u0a9f \u0a95\u0ab0\u0acb",p1jk4gbo:"\u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0a82\u0aa6\u0ab0 \u0a91\u0aa8\u0ab2\u0abe\u0a87\u0aa8",pztgw94:"\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0aaa\u0ab0 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb",pig8opb:"\u0ab8\u0ac0\u0aa7\u0ac0 \u0ab5\u0abe\u0aa4 \u0a95\u0ab0\u0acb",pla6vae:"\u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0a86\u0aa7\u0abe\u0ab0",p12y1fw5:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0aae\u0acb\u0a95\u0ab2\u0acb",pi7el9x:"24 \u0a95\u0ab2\u0abe\u0a95\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0",peza8d7:"\u0ab9\u0ac1\u0aae\u0ac7\u0ab2\u0ac0\u0aaf\u0acb",p1k70v3b:"\u0aa4\u0acd\u0ab5\u0ab0\u0abf\u0aa4 \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0aae\u0ac7\u0ab3\u0ab5\u0acb",pi7p4si:"24/7 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7",ptmpaw1:"\u0ab9\u0ac1\u0a82 \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aac\u0ac1\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",pq44ijf:"\u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aac\u0ac1\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0aa8\u0acd\u0ab8\u0ab2\u0acd\u0a9f\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a9f\u0ac7\u0aac \u0aaa\u0ab0 \u0aa8\u0ac7\u0ab5\u0abf\u0a97\u0ac7\u0a9f \u0a95\u0ab0\u0acb, \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aae\u0aa8\u0aaa\u0ab8\u0a82\u0aa6 \u0ab8\u0ab2\u0abe\u0ab9\u0a95\u0abe\u0ab0\u0aa8\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb, \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0ab0\u0abe\u0aae\u0ab0\u0acd\u0ab6\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0aaf \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb. \u0aa4\u0aae\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0aae \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0a8f\u0a95 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf\u0a95\u0ab0\u0aa3 \u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0aa5\u0ab6\u0ac7.",pvi5gau:"\u0ab9\u0ac1\u0a82 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab0\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82 \u0a85\u0aa5\u0ab5\u0abe \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab6\u0ac7\u0aa1\u0acd\u0aaf\u0ac2\u0ab2 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",pfqgfyn:"\u0aa4\u0aae\u0ac7 \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0ab5\u0abf\u0aad\u0abe\u0a97\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab6\u0ac7\u0aa1\u0acd\u0aaf\u0ac2\u0ab2 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0a97\u0abe\u0aae\u0ac0 \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aaa\u0ab0 \u0a9f\u0ac5\u0aaa \u0a95\u0ab0\u0acb. \u0ab8\u0aa4\u0acd\u0ab0\u0aa8\u0abe 24 \u0a95\u0ab2\u0abe\u0a95 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2 \u0ab0\u0aa6\u0acd\u0aa6\u0ac0\u0a95\u0ab0\u0aa3 \u0ab0\u0abf\u0aab\u0a82\u0aa1 \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7.",p1h9bcwo:"\u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0acb \u0aae\u0ac7\u0aa1\u0abf\u0a95\u0ab2 \u0aa1\u0ac7\u0a9f\u0abe \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a9b\u0ac7?",ps9lc26:"\u0ab9\u0abe, \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aa4\u0aae\u0abe\u0aae \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0a85\u0aa8\u0ac7 \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0aa1\u0ac7\u0a9f\u0abe \u0a8f\u0aa8\u0acd\u0aa1-\u0a9f\u0ac1-\u0a8f\u0aa8\u0acd\u0aa1 \u0a8f\u0aa8\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaa\u0acd\u0ab6\u0aa8 \u0a85\u0aa8\u0ac7 \u0a89\u0aa6\u0acd\u0aaf\u0acb\u0a97-\u0aae\u0abe\u0aa8\u0a95 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0aaa\u0acd\u0ab0\u0acb\u0a9f\u0acb\u0a95\u0acb\u0ab2\u0acd\u0ab8 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a9b\u0ac7. \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0ab5\u0abf\u0aa8\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aa1\u0ac7\u0a9f\u0abe \u0a95\u0acd\u0aaf\u0abe\u0ab0\u0ac7\u0aaf \u0aa4\u0ac3\u0aa4\u0ac0\u0aaf \u0aaa\u0a95\u0acd\u0ab7\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0acb \u0aa8\u0aa5\u0ac0.",p1c63b9n:"\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0ab5\u0acb\u0ab2\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0aab\u0a82\u0aa1 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a89\u0aae\u0ac7\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",pfulep3:"\u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a9f\u0ac5\u0aac \u0aaa\u0ab0 \u0a9c\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \"\u0aaa\u0ac8\u0ab8\u0abe \u0a89\u0aae\u0ac7\u0ab0\u0acb\" \u0aaa\u0ab0 \u0a9f\u0ac5\u0aaa \u0a95\u0ab0\u0acb. \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0aa8\u0ac0 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf \u2014 \u0a95\u0abe\u0ab0\u0acd\u0aa1, UPI \u0a85\u0aa5\u0ab5\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u2014 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0ac7 \u0a89\u0aae\u0ac7\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb \u0aa4\u0ac7 \u0ab0\u0a95\u0aae \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb.",pex3sts:"\u0aae\u0aa6\u0aa6 \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0",p1ofqfdp:"\u0ab2\u0acb\u0a95\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb",p1m6uxly:"\u0ab6\u0ac7\u0ab5\u0ab0\u0acb\u0aa8-\u0a85\u0aaa",p9wx6ep:"\u0ab6\u0ac7\u0ab5\u0ab0\u0acb\u0aa8-\u0aa1\u0abe\u0a89\u0aa8",pmkl5g0:"\u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0aae\u0aa6\u0aa6\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",p1ucr8ie:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0\u0aa8\u0acb \u0a85\u0aa8\u0ac1\u0aad\u0ab5 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe\u0a82 \u0a9b\u0acb, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abf\u0a95 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0ac7 \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb.",p1k15svg:"\u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95",p1il8i8d:"\u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0a82\u0ab8\u0abe\u0aa7\u0aa8\u0acb",pgcsuld:"\u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0acb",p1x9xuzh:"\u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88 \u0aac\u0a97 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0a95\u0aa8\u0ac0\u0a95\u0ac0 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a86\u0ab5\u0ac0?",p18t3p8y:"\u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0acb",p11jo8ku:"Humaeli \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ab0\u0aa3",prnsj34:"\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82:",p8lq2oq:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0acd\u0ab8 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8\u0acb",pg6nyxd:"\u0a8f\u0aa8\u0acd\u0aa1-\u0a9f\u0ac1-\u0a8f\u0aa8\u0acd\u0aa1 \u0a8f\u0aa8\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaa\u0acd\u0ab6\u0aa8",pm4qf9j:"GDPR \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0abf\u0aa4 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8",p13tbyt3:"\u0a85\u0aa8\u0abe\u0aae\u0ac0 \u0aaa\u0ab0\u0abe\u0aae\u0ab0\u0acd\u0ab6",p1474pj6:"\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb",p12ddn6e:"\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2",p178beh:"\u0aa8\u0abe\u0aae, \u0a89\u0a82\u0aae\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab2\u0abf\u0a82\u0a97",p1el3mqv:"\u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb",p1uqyawh:"\u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0a93",p1j5drmg:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0a85\u0aa8\u0ac1\u0aad\u0ab5\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0a95\u0ab0\u0acb",p1hshih:"\u0aa4\u0aae\u0aa8\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0ab2\u0abe\u0ab9\u0a95\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0a9a \u0a95\u0ab0\u0acb",p4lwpxb:"\u0a9a\u0ac7\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0a95\u0acb\u0ab2\u0acd\u0ab8",p16o5duv:"\u0ab8\u0a82\u0aa6\u0ac7\u0ab6\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0a9d\u0aa1\u0aaa\u0ac0 \