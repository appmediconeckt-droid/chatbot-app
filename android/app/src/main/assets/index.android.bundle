0940\u0902 \u092e\u093f\u0932\u093e?",p1seagg0:"\u092a\u0941\u0928\u0903 \u092d\u0947\u091c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",pvitosp:"\u092a\u0941\u0928\u0903 \u092d\u0947\u091c\u0947\u0902",p156tq0x:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0908\u092e\u0947\u0932 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",p1es6jgh:"\u0908\u092e\u0947\u0932 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",p1ncbamm:"\u0939\u0941\u092e\u0948\u0932\u0940 - \u0906\u092a\u0915\u093e \u092e\u093e\u0928\u0938\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923",p1mkbgjw:"\u092e\u093e\u0928\u0935 \u0938\u0936\u0915\u094d\u0924",p67t5ik:"\u092e\u093e\u0928\u0938\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0938\u0939\u093e\u092f\u0924\u093e",p15kdwif:"\u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u0947 \u0905\u092a\u0928\u0947 \u0915\u0920\u093f\u0928 \u0938\u092e\u092f \u092e\u0947\u0902 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902, \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915\u094b\u0902, \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u094b\u0902 \u0914\u0930 \u092e\u0928\u094b\u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u094b\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947\u0902",puqjq8w:"\u0906\u092a\u0915\u094b \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0938\u0947 \u092e\u093f\u0932\u093e\u090f\u0901",pglw0op:"\u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902",pdkk7ab:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0939\u093e\u092f\u0924\u093e",p6s9e29:"\u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u092e\u0930\u0940\u091c\u093c\u094b\u0902 \u0915\u094b \u0906\u092a\u0915\u094b \u0922\u0942\u0902\u0922\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902",p1kc2xvx:"\u0938\u094d\u0925\u093e\u0928 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e. \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0947\u0902 \u2192 \u0907\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u0935\u093e\u092a\u0938 \u0906\u090f\u0902\u0964",pj1z8my:"\u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0947 \u092c\u093f\u0928\u093e, \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u092e\u0930\u0940\u091c\u093c \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u0922\u0942\u0902\u0922 \u092a\u093e\u090f\u0902\u0917\u0947 \u0914\u0930 \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0940\u092e\u093f\u0924 \u0939\u094b\u0917\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902.",pe2sfkx:"\u0938\u094d\u0925\u093e\u0928 \u0905\u092d\u0940 \u092d\u0940 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0939\u0948. \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0926\u0943\u0936\u094d\u092f\u0924\u093e \u0914\u0930 \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u0948\u0938\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0920\u0940\u0915 \u0938\u0947 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0940\u0964",p1bc8b0q:"\u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0947 \u092c\u093f\u0928\u093e \u0906\u092a \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902, \u0916\u093e\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0905\u0932\u0930\u094d\u091f \u0914\u0930 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0947 \u091a\u0942\u0915 \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902.",p1kxnr6x:"\u0938\u094d\u0925\u093e\u0928 \u0905\u092d\u0940 \u092d\u0940 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0939\u0948. \u0928\u091c\u0926\u0940\u0915\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0914\u0930 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u091c\u0948\u0938\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0920\u0940\u0915 \u0938\u0947 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0940\u0964",p1qfkxpw:"\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0947\u0902",p19izdw2:"\u0928\u093f\u0935\u0947\u0926\u0928 \u0939\u0948...",pudz60s:"\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...",p1nyz8sj:"\ud83d\udd04 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",p129dr11:"\ud83d\udccd \u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902",p13kffw5:"\u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",pr2p72l:"\u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924",pi9375l:"\u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",p1xmhdqy:"\u0915\u0941\u091b \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0902 \u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0940. \u0939\u092e \u0907\u0938\u0947 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0940 \u092a\u0941\u0930\u091c\u094b\u0930 \u0905\u0928\u0941\u0936\u0902\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",p1ismk4q:"\u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u0932\u093f\u090f, \u0938\u094d\u0925\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964 \u0907\u0938\u0938\u0947 \u0939\u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u0938\u0947\u0935\u093e \u0926\u0947\u0928\u0947 \u0914\u0930 \u0906\u092a\u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964",p1rsaitz:"\u0939\u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0915\u094d\u092f\u094b\u0902 \u0939\u0948",p1lwhuaj:"\ud83d\udd10 \u0906\u092a\u0915\u0947 \u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0924\u092d\u0940 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u092c \u0906\u092a \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0902\u0964 \u0907\u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0947\u091a\u093e \u092f\u093e \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",pi5yj9e:"\u0938\u094d\u0915\u093f\u092a\u093f\u0902\u0917 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0938\u0940\u092e\u093f\u0924 \u0915\u0930 \u0926\u0947\u0917\u0940\u0964 \u0906\u092a \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902.",p1h299pn:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0947\u0902",punxvbe:"\u092e\u0941\u091d\u0947 \u092f\u093e\u0926 \u0915\u0930\u094b",p1djn4vs:"\u092e\u0947\u0932-\u0913\u092a\u0928-\u0930\u0942\u092a\u0930\u0947\u0916\u093e",p9joi0e:"\u092b\u093c\u094b\u0928-\u091a\u093f\u0924\u094d\u0930-\u0930\u0942\u092a\u0930\u0947\u0916\u093e",pcm1nee:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092f\u0939 \u0906\u092a \u0939\u0940 \u0939\u0948\u0902",p39qlxn:"\u0938\u0924\u094d\u0930 \u0935\u093f\u0930\u094b\u0927 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e",p1nl6f5:"\u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0915\u0930\u0928\u0947 \u0914\u0930 \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0928\u0940\u091a\u0947 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",p8ykf5k:"\u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0939\u0948\u0902\u0964 \u0907\u0938\u0947 \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0915\u0930\u0947\u0902\u0964",p18vcp24:"\u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",p1ntvp8x:"\u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u0947\u0902",pn5i6fn:"6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",p12n3zp8:"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",pohmzat:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",p1e6s4y0:"\u0908\u092e\u0947\u0932 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902",p1aafagh:"\u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902",pasmu26:"\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u0906\u092a Humaeli \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0948\u0938\u0947 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902",pqh0i9l:"\u092a\u094b\u0930\u094d\u091f\u0932 \u091a\u0941\u0928\u0947\u0902",pyjrj1w:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e",p1rlv5t:"\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u0947\u0902",p19cu11q:"\u0905\u092a\u0928\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902",pbe3qyw:"\u092a\u0947\u0936\u0947\u0935\u0930 \u0926\u0947\u0916\u092d\u093e\u0932 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902",p1d9tqw:"\u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921",p1696fig:"\u092c\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094d\u0925\u093e\u0928",p14mamw2:"\u0906\u092a\u0915\u0947 \u092e\u093e\u0928\u0938\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u093f\u090f \u0917\u090f \u090f\u0915 \u0928\u093f\u091c\u0940, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947\u0902\u0964",p16mi6u6:"\u0938\u0939\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0916\u094b\u091c\u0947\u0902",pcyp7gf:"\u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e, \u092d\u093e\u0937\u093e, \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e, \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092a\u094d\u0930\u0915\u093e\u0930 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0905\u0928\u0941\u092d\u0935\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0915\u094b \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902\u0964",p1j7paqb:"\u0906\u092a\u0915\u093e \u090f\u0906\u0908 \u0935\u0947\u0932\u0928\u0947\u0938 \u0938\u093e\u0925\u0940",p235k91:"\u0915\u093f\u0938\u0940 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u0947 \u091c\u0941\u0921\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0924\u0941\u0930\u0902\u0924 \u092d\u093e\u0935\u0928\u093e\u0924\u094d\u092e\u0915 \u0938\u092e\u0930\u094d\u0925\u0928, \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0902\u092c\u0902\u0927\u0940 \u0938\u0941\u091d\u093e\u0935 \u0914\u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964",p12cl72e:"\u0928\u092e\u0938\u094d\u0924\u0947 \ud83d\udc4b \u0906\u091c \u0906\u092a \u0915\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902?",pz0a21k:"\u092c\u0941\u0915 \u0915\u0930\u0947\u0902, \u091a\u0948\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u092a\u091a\u093e\u0930 \u0915\u0930\u0947\u0902",pahuuzy:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0947\u0902, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u0940\u0921\u093f\u092f\u094b \u0938\u0924\u094d\u0930 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0902, \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0948\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0915\u0932\u094d\u092f\u093e\u0923 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902 - \u0938\u092c \u0915\u0941\u091b \u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930\u0964",pefpvkx:"\u092a\u0941\u0938\u094d\u0924\u0915 \u0938\u0924\u094d\u0930",pvu2nj9:"\u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932",p1dfp17w:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091a\u0948\u091f",pz29fz2:"\u0905\u0902\u0924 \u0938\u0947 \u0905\u0902\u0924 \u0924\u0915",prcdi82:"#cbd5e1",p8cqkqc:"#00652\u0938\u0940",pyj27bj:"\u0915\u094b\u0908 \u0928\u0939\u0940\u0902",pyivru2:"\u0911\u091f\u094b",pdfz3q4:"\u092f\u0939\u093e\u0901 \u0928\u092f\u0947 \u0939\u0948\u0902?",plg5b3z:"\u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b \u091a\u0941\u0915\u0947 \u0939\u0948\u0902?",p86so6m:"\u092d\u0947\u091c\u0947 \u0917\u090f \u0915\u094b\u0921 \u0915\u094b \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",pwma7ac:"\u0905\u092d\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",p1girtza:"\u0935\u093e\u092a\u0938 \u091c\u093e\u0913",p16rk3ld:"\u0938\u0915\u094d\u0930\u093f\u092f \u0938\u0924\u094d\u0930 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e",p1e642qo:"\u0906\u092a \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0939\u0948\u0902. \u0915\u094d\u092f\u093e \u0906\u092a \u0905\u0928\u094d\u092f \u0938\u092d\u0940 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0932\u0949\u0917 \u0906\u0909\u091f \u0915\u0930\u0915\u0947 \u092f\u0939\u093e\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?",piwem5c:"\u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u0932\u0949\u0917 \u0906\u0909\u091f \u0915\u0930\u0947\u0902",p1279ro7:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902",pa7nvn9:"#10\u092c\u0940981",plz121n:"\u0905\u0928\u0941\u092d\u0935",p375zml:"\u0938\u093e\u0932",ph29zus:"\u092a\u0930\u093e\u092e\u0930\u094d\u0936",pg673oj:"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0926\u0947\u0916\u0947\u0902",p1db5cid:"\u0935\u0940\u0921\u093f\u092f\u094b \u092a\u0930\u093e\u092e\u0930\u094d\u0936",p1yu9pu:"\u0906\u0935\u093e\u091c \u092a\u0930\u093e\u092e\u0930\u094d\u0936",p191keun:"\u0935\u0949\u0915-\u0907\u0928 \u0935\u093f\u091c\u093f\u091f",piytekc:"\u0907\u0928-\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0935\u093f\u091c\u093f\u091f",p1e54nbv:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0938\u093e\u0925",pkt8by3:"\u092c\u094d\u0930\u0947\u0915 \u092a\u0930",p1j5edg3:"\u0930\u094b\u0915\u093e \u0917\u092f\u093e",p1g2ipl4:"\u0938\u0915\u094d\u0930\u093f\u092f \u092a\u0930\u093e\u092e\u0930\u094d\u0936",p1k28yv8:"\u0936\u0941\u0930\u0942 \u0939\u0941\u0906",plbyqxb:"\u09