9ae\u09a4\u09bf \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09c1\u09a8\u0964",checklistItem4:"\u09b2\u0997\u0987\u09a8 \u09aa\u09cd\u09b0\u09ae\u09cd\u09aa\u099f \u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u0997\u09c7\u09b2\u09c7 \u09b8\u09c7\u099f\u09bf\u0982\u09b8/\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a5\u09c7\u0995\u09c7 \u09ae\u09cd\u09af\u09be\u09a8\u09c1\u09af\u09bc\u09be\u09b2\u09bf \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8\u0964",checklistItem5:"\u099a\u09cd\u09af\u09be\u099f \u09ae\u09c7\u09b8\u09c7\u099c\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0993\u099f\u09bf\u09aa\u09bf, \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09ac\u09be \u09b8\u0982\u09ac\u09c7\u09a6\u09a8\u09b6\u09c0\u09b2 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964",checklistItem6:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u099e\u09cd\u099a\u09bf\u09a4 \u09a1\u09c7\u099f\u09be \u0986\u09aa\u09a1\u09c7\u099f \u09ac\u09be \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u098f\u09ac\u0982 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u09f7",manageData:"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a1\u09c7\u099f\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8",securitySettings:"\u09a8\u09bf\u09b0\u09be\ufffd\ufffd\u09a4\u09cd\u09a4\u09be \u09b8\u09c7\u099f\u09bf\u0982\u09b8",aiQuickReplyLow:"\u0995\u09ae",aiQuickReplyOkay:"\u09a0\u09bf\u0995 \u0986\u099b\u09c7",aiQuickReplyGood:"\u09ad\u09be\u09b2",aiQuickReplyGreat:"\u09a6\u09be\u09b0\u09c1\u09a3",aiPhotoAttached:"\u099b\u09ac\u09bf \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4",aiTryAgain:"\u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8",aiVoiceHint:"\u0986\u09aa\u09a8\u09bf \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4 \u09b9\u09b2\u09c7 \u0995\u09a5\u09be \u09ac\u09b2\u09c1\u09a8 \u2014 \u0986\u09aa\u09a8\u09bf \u09ac\u09bf\u09b0\u09a4\u09bf \u09a6\u09bf\u09b2\u09c7 \u0986\u09ae\u09bf \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09c7\u09ac\u0964",resetChatTitle:"\u098f\u0995\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u099a\u09cd\u09af\u09be\u099f \u09b6\u09c1\u09b0\u09c1?",resetChatMessage:"\u098f\u099f\u09bf \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 AI \u099a\u09cd\u09af\u09be\u099f \u09aa\u09b0\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u09b8\u09cd\u09ac\u09be\u0997\u09a4 \u09ae\u09c1\u09a1 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u0997\u09c1\u09b2\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09ac\u09be\u09b0 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc\u0964",startFresh:"\u09a8\u09a4\u09c1\u09a8 \u0995\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8",startingFresh:"\u09b6\u09c1\u09b0\u09c1 \u09b9\u099a\u09cd\u099b\u09c7..."},phrases:{p1le0g3x:"\u0985\u099c\u09be\u09a8\u09be",p3rvtpe:"\u0986\u099c",poh8cad:"\u0997\u09a4\u0995\u09be\u09b2",p1mrhzr7:"\u0987\u09a8\u0995\u09be\u09ae\u09bf\u0982",pfebfdv:"\u09ac\u09b9\u09bf\u09b0\u09cd\u09ae\u09c1\u0996\u09c0",p17k42kg:"\u09ae\u09bf\u09b8",pvw9wg8:"\u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8",p15m090m:"\u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc\u09c7\u099b\u09c7",p1q8utwa:"\u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf",pcqxqrc:"\u09ae\u09bf\u09a8\u09bf\u099f",p15oehty:"\u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1",p17tqvf1:"\u09b2\u09be\u0987\u09ad \u099a\u09cd\u09af\u09be\u099f",pos6ydf:"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09a6\u09b2\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u099a\u09cd\u09af\u09be\u099f",p1jk4gbo:"\u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u0985\u09a8\u09b2\u09be\u0987\u09a8",pztgw94:"\u0995\u09b2 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8",pig8opb:"\u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0995\u09a5\u09be \u09ac\u09b2\u09c1\u09a8",pla6vae:"\u0987\u09ae\u09c7\u09b2 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8",p12y1fw5:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09aa\u09be\u09a0\u09be\u09a8",pi7el9x:"24 \u0998\u09a8\u09cd\u099f\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7",peza8d7:"\u09b9\u09c1\u09ae\u09be\u0987\u09b2\u09bf\u0993",p1k70v3b:"\u09a4\u09be\u09a4\u09cd\u0995\u09cd\u09b7\u09a3\u09bf\u0995 \u0989\u09a4\u09cd\u09a4\u09b0 \u09aa\u09be\u09a8",pi7p4si:"24/7 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7",ptmpaw1:"\u0986\u09ae\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09c1\u0995 \u0995\u09b0\u09ac?",pq44ijf:"\u098f\u0995\u099f\u09bf \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09c1\u0995 \u0995\u09b0\u09a4\u09c7, \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u099f \u0995\u09b0\u09c1\u09a8, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09c7\u09b0 \u09a7\u09b0\u09a8 \u099a\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u098f\u0995\u099f\u09bf \u09a4\u09be\u09b0\u09bf\u0996 \u098f\u09ac\u0982 \u09b8\u09ae\u09af\u09bc \u099a\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8\u09f7 \u0986\u09aa\u09a8\u09bf \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b8\u09b9 \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u0995\u09b0\u09a3 \u0987\u09ae\u09c7\u09b2 \u09aa\u09be\u09ac\u09c7\u09a8\u0964",pvi5gau:"\u0986\u09ae\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u09ac\u09be\u09a4\u09bf\u09b2 \u09ac\u09be \u09aa\u09c1\u09a8\u0983\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?",pfqgfyn:"\u0986\u09aa\u09a8\u09bf \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09bf\u09ad\u09be\u0997 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09aa\u09c1\u09a8\u0983\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u09ac\u09be \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09a4\u09c7 \u0986\u09b8\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f\u09c7 \u099f\u09cd\u09af\u09be\u09aa \u0995\u09b0\u09c1\u09a8\u0964 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8\u09c7\u09b0 24 \u0998\u09a8\u09cd\u099f\u09be \u0986\u0997\u09c7 \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09be \u0985\u09b0\u09cd\u09a5 \u09ab\u09c7\u09b0\u09a4\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09cb\u0997\u09cd\u09af\u0964",p1h9bcwo:"\u0986\u09ae\u09be\u09b0 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09a4\u09a5\u09cd\u09af \u09a8\u09bf\u09b0\u09be\u09aa\u09a6?",ps9lc26:"\u09b9\u09cd\u09af\u09be\u0981, \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u098f\u09ac\u0982 \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09a1\u09c7\u099f\u09be \u098f\u09a8\u09cd\u09a1-\u099f\u09c1-\u098f\u09a8\u09cd\u09a1 \u098f\u09a8\u0995\u09cd\u09b0\u09bf\u09aa\u09b6\u09a8 \u098f\u09ac\u0982 \u0987\u09a8\u09cd\u09a1\u09be\u09b8\u09cd\u099f\u09cd\u09b0\u09bf-\u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09b8\u09bf\u0995\u09bf\u0989\u09b0\u09bf\u099f\u09bf \u09aa\u09cd\u09b0\u09cb\u099f\u09cb\u0995\u09b2 \u09a6\u09bf\u09af\u09bc\u09c7 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u099b\u09be\u09a1\u09bc\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09a8\u09be\u0964",p1c63b9n:"\u0986\u09ae\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0986\u09ae\u09be\u09b0 \u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f\u09c7 \u09a4\u09b9\u09ac\u09bf\u09b2 \u09af\u09cb\u0997 \u0995\u09b0\u09ac?",pfulep3:"Wallet \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u09af\u09be\u09a8 \u098f\u09ac\u0982 \"\u0985\u09cd\u09af\u09be\u09a1 \u09ae\u09be\u09a8\u09bf\" \u098f \u0986\u09b2\u09a4\u09cb \u099a\u09be\u09aa\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8 \u2014 \u0995\u09be\u09b0\u09cd\u09a1, UPI \u09ac\u09be \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0 \u2014 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09bf \u09af\u09c7 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8 \u09a4\u09be \u09b2\u09bf\u0996\u09c1\u09a8\u0964",pex3sts:"\u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u098f\u09ac\u0982 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8",p1ofqfdp:"\u099c\u09a8\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8",p1m6uxly:"\u09b6\u09c7\u09ad\u09b0\u09a8 \u0986\u09aa",p9wx6ep:"\u09b6\u09c7\u09ad\u09b0\u09a8-\u09a1\u09be\u0989\u09a8",pmkl5g0:"\u0985\u09ac\u09bf\u09b2\u09ae\u09cd\u09ac\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8?",p1ucr8ie:"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u098f\u0995\u099f\u09bf \u09ae\u09c7\u09a1\u09bf\u0995\u09c7\u09b2 \u099c\u09b0\u09c1\u09b0\u09c0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09a8, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09ac\u09bf\u09b2\u09ae\u09cd\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u099c\u09b0\u09c1\u09b0\u09bf \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u0995\u09b2 \u0995\u09b0\u09c1\u09a8\u0964",p1k15svg:"\u099c\u09b0\u09c1\u09b0\u09c0 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997",p1il8i8d:"\u0995\u09cd\u09b0\u09be\u0987\u09b8\u09bf\u09b8 \u09b0\u09bf\u09b8\u09cb\u09b0\u09cd\u09b8",pgcsuld:"\u098f\u0995\u099f\u09bf \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09c1\u09a8",p1x9xuzh:"\u0985\u09cd\u09af\u09be\u09aa\u09c7 \u0995\u09cb\u09a8\u09cb \u09ac\u09be\u0997 \u09ac\u09be \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u09a8?",p18t3p8y:"\u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u0987\u09b8\u09cd\u09af\u09c1",p11jo8ku:"Humaeli \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3",prnsj34:"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u0986\u09aa\u09a1\u09c7\u099f:",p8lq2oq:"\u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8",pg6nyxd:"\u098f\u09a8\u09cd\u09a1-\u099f\u09c1-\u098f\u09a8\u09cd\u09a1 \u098f\u09a8\u0995\u09cd\u09b0\u09bf\u09aa\u09b6\u09a8",pm4qf9j:"\u099c\u09bf\u09a1\u09bf\u09aa\u09bf\u0986\u09b0 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09af\u09bc\u09bf\u09a4 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8",p13tbyt3:"\u09ac\u09c7\u09a8\u09be\u09ae\u09c0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6",p1474pj6:"\u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8",p12ddn6e:"\u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2",p178beh:"\u09a8\u09be\u09ae, \u09ac\u09af\u09bc\u09b8 \u098f\u09ac\u0982 \u09b2\u09bf\u0999\u09cd\u0997",p1el3mqv:"\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3",p1uqyawh:"\u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09aa\u099b\u09a8\u09cd\u09a6",p1j5drmg:"\u0986\u09aa\u09a8\u09be\u09b0 \u09af\u09a4\u09cd\u09a8 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4\u0995\u09c3\u09a4",p1hshih:"\u09b8\u09a0\u09bf\u0995 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09c7\u09b2\u09c7",p4lwpxb:"\u099a\u09cd\u09af\u09be\u099f \u098f\u09ac\u0982 \u0995\u09b2",p16o5duv:"\u09ac\u09be\u09b0\u09cd\u09a4\u09be \u098f\u09ac\u0982 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09b0",pjualou:"\u099a\u09cd\u09af\u09be\u099f \u0985\u09ac\u09b8\u09cd\u09a5\u09be \u098f\u09ac\u0982 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4\u09bf",p8fcohj:"\u0997\u09c3\u09b9\u09c0\u09a4 \u099a\u09cd\u09af\u09be\u099f \u09b8\u09c7\u09b6\u09a8",pqugyus:"\u0995\u09cd\u09b0\u09ae\u09be\u0997\u09a4 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8\u09c7\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u09a8",pxw259e:"\u09b8\u09c7\u09b6\u09a8 \u099a\u09b2\u09be\u0995\u09be\u09b2\u09c0\u09a8 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09c1\u09a8",ppapyhl:"\u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f",ppjebc6:"\u09ac\u09c1\u0995\u09bf\u0982 \u09a4\u09be\u09b0\u09bf\u0996 \u098f\u09ac\u0982 \u09b8\u09ae\u09af\u09bc",prz84q3:"\u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be",p6bzi8o:"\u09b8\u09c7\u09b6\u09a8 \u09a8\u09cb\u099f",pfby3q4:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09b8\u09a8\u09cd\u09a8 \u09b8\u09c7\u09b6\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8",p1px010k:"\u09b8\u09ae\u09af\u09bc\u09ae\u09a4 \u0985\u09a8\u09c1\u09b8\u09cd\u09ae\u09be\u09b0\u0995 \u09aa\u09be\u09a0\u09be\u09a8",pl6oj3n:"\u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u0993 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8",pcisb5n:"\u09b0\u09bf\u099a\u09be\u09b0\u09cd\u099c \u098f\u09ac\u0982 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0987\u09a4\u09bf\u09b9\u09be\u09b8",p11x8ws5:"\u09ab\u09c7\u09b0\u09a4 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1",p1jezb8u:"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09b0\u09b8\u09bf\u09a6",p1kxmxol:"\u09a8\u09bf\u09b0\u09be\u09aa\u09a6\u09c7 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be",p1soeejn:"\u09b8\u09a0\u09bf\u0995 \u09ac\u09bf\u09b2\u09bf\u0982 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09c1\u09a8",p3fb3fk:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09c1\u09a8",paxx0ja:"\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af Humaeli \u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c7 \u09a4\u09be\u09b0 \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u099a\u09c7\u09af\u09bc\u09c7 \u09a8\u09bf\u09a8\u0964",py8xd5m:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09a0\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",pg1ugci:"\u09af\u09c7 \u0995\u09cb\u09a8 \u09b8\u09ae\u09af\u09bc \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a5\u09c7\u0995\u09c7 \u09ad\u09c1\u09b2 \u09ac\u09be \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09ac\u09bf\u09ac\u09b0\u09a3 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8\u0964",p13743po:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09c1\u099b\u09c1\u09a8",p12l9hlj:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u09b8\u0982\u09b6\u09cd\u09b2\u09bf\u09b7\u09cd\u099f \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a1\u09c7\u099f\u09be \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09c1\u09a8\u0964",pqqlbs9:"\u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8",p7r950p:"\u09ae\u09c2\u09b2 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u09a8\u09be \u09b9\u09be\u09b0\u09bf\u09af\u09bc\u09c7 \u0990\u099a\u09cd\u099b\u09bf\u0995 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b0\u09a3 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\u0964",ph7kh1q:"\u098f\u0995\u099f\u09bf \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u0989\u09a4\u09cd\u09a5\u09be\u09aa\u09a8",pikxi8f:"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8",pr4om3a:"\u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8",pwprq2e:"\u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09b8\u09c7\u099f\u09bf\u0982\u09b8",p16wv544:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u098f\u09ac\u0982 \u0993\u099f\u