\u0dca \u0d85\u0dc0\u0dc4\u0dd2\u0dbb \u0d9a\u0dbb \u0d87\u0dad. \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0db4\u0dd0\u0dad\u0dd2\u0d9a\u0da9 \u0daf\u0dd8\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc0\u0dd6 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c \u0db1\u0dd2\u0dc3\u0dd2 \u0dbd\u0dd9\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0db1\u0ddc\u0d9a\u0dbb\u0db1\u0dd4 \u0d87\u0dad.",p1bc8b0q:"\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dba \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0d94\u0db6\u0da7 \u0d85\u0dc0\u0da7 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca, \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0dc4\u0dcf\u0dba \u0db8\u0d9c \u0dc4\u0dd0\u0dbb\u0dd9\u0db1\u0dd4 \u0d87\u0dad. \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb \u0d91\u0dba\u0da7 \u0d89\u0da9 \u0daf\u0dd9\u0db1\u0dca\u0db1.",p1kxnr6x:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dad\u0dc0\u0db8\u0dad\u0dca \u0d85\u0dc0\u0dc4\u0dd2\u0dbb \u0d9a\u0dbb \u0d87\u0dad. \u0d85\u0dc0\u0da7 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0dc4 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dc3\u0dc4\u0dcf\u0dba \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c \u0db1\u0dd2\u0dc3\u0dd2 \u0dbd\u0dd9\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0db1\u0ddc\u0d9a\u0dbb\u0db1\u0dd4 \u0d87\u0dad.",p1qfkxpw:"\u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0db8\u0dca",p19izdw2:"\u0d89\u0dbd\u0dca\u0dbd\u0db8\u0dd2\u0db1\u0dca...",pudz60s:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca...",p1nyz8sj:"\ud83d\udd04 \u0db1\u0dd0\u0dc0\u0dad \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0db1",p129dr11:"\ud83d\udccd \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dba\u0da7 \u0d89\u0da9 \u0daf\u0dd9\u0db1\u0dca\u0db1",p13kffw5:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0db1\u0dca\u0db1",pr2p72l:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1\u0dd2\u0dad\u0dba\u0dd2",pi9375l:"\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0db6\u0dbd \u0d9a\u0dbb\u0db1\u0dca\u0db1",p1xmhdqy:"\u0dc3\u0db8\u0dc4\u0dbb \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0db1\u0ddc\u0d9a\u0dbb\u0db1\u0dd4 \u0d87\u0dad. \u0d85\u0db4\u0dd2 \u0d91\u0dba \u0dc3\u0d9a\u0dca\u0dbb\u0dd2\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dad\u0dbb\u0dba\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0d9a\u0dbb\u0db8\u0dd4.",p1ismk4q:"\u0dc4\u0ddc\u0db3\u0db8 \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf, \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dba\u0da7 \u0d89\u0da9 \u0daf\u0dd9\u0db1\u0dca\u0db1. \u0d91\u0dba \u0d94\u0db6\u0da7 \u0dc0\u0da9\u0dcf \u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0d94\u0db6\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad\u0dc0 \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0db4\u0da7 \u0d8b\u0db4\u0d9a\u0dcf\u0dbb \u0d9a\u0dbb\u0dba\u0dd2.",p1rsaitz:"\u0d85\u0db4\u0da7 \u0d94\u0db6\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d87\u0dba\u0dd2",p1lwhuaj:"\ud83d\udd10 \u0d94\u0db6\u0d9c\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0dc0\u0db1\u0dca\u0db1\u0dda \u0d94\u0db6 \u0dba\u0dd9\u0daf\u0dd4\u0db8 \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0db4\u0db8\u0dab\u0dd2. \u0d91\u0dba \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dd2\u0da7\u0dd9\u0d9a\u0dad\u0dca \u0dad\u0dd9\u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dc0\u0dba\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dd4 \u0db1\u0ddc\u0dbd\u0dd0\u0db6\u0dda.",pi5yj9e:"\u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd3\u0db8 \u0d94\u0db6\u0dda \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0db8\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0d9a\u0dbb\u0dba\u0dd2. \u0d94\u0db6\u0da7 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dca \u0dad\u0dd4\u0dc5 \u0d95\u0db1\u0dd1\u0db8 \u0dc0\u0dda\u0dbd\u0dcf\u0dc0\u0d9a \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0db6\u0dbd \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a.",p1h299pn:"\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0dcf\u0db8\u0da7 \u0db4\u0dd4\u0dbb\u0db1\u0dca\u0db1",punxvbe:"\u0db8\u0dcf\u0dc0 \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dba\u0dcf\u0d9c\u0db1\u0dca\u0db1",p1djn4vs:"\u0dad\u0dd0\u0db4\u0dd1\u0dbd-\u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0daf\u0dc5 \u0dc3\u0da7\u0dc4\u0db1\u0dca",p9joi0e:"phone-portrait-outline",pcm1nee:"\u0d92 \u0d94\u0db6 \u0db6\u0dc0 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1",p39qlxn:"\u0dc3\u0dd0\u0dc3\u0dd2 \u0d9c\u0dd0\u0da7\u0dd4\u0db8 \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0dd2\u0dba",p1nl6f5:"\u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dda \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0dad\u0dca \u0dad\u0dd0\u0db4\u0dd1\u0dbd\u0da7 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca 6\u0d9a \u0d9a\u0dda\u0dad\u0dba\u0d9a\u0dca \u0dba\u0dd0\u0dc0\u0dca\u0dc0\u0dd9\u0db8\u0dd4. \u0d94\u0db6\u0d9c\u0dda \u0d85\u0db1\u0dd9\u0d9a\u0dd4\u0dad\u0dca \u0d8b\u0db4\u0dcf\u0d82\u0d9c \u0dc0\u0dbb\u0db1\u0dba \u0d9a\u0dbb \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0dcf\u0db8\u0da7 \u0d91\u0dba \u0db4\u0dc4\u0dad\u0dd2\u0db1\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1.",p8ykf5k:"\u0d94\u0db6 \u0daf\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0d8b\u0db4\u0dcf\u0d82\u0d9c\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dbb\u0db1\u0dba \u0dc0\u0dd3 \u0d87\u0dad. \u0db8\u0dd9\u0dba \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0d9a\u0dbb\u0d9c\u0dd9\u0db1 \u0dba\u0dcf\u0db8\u0da7 \u0d91\u0dba \u0db4\u0dd4\u0dbb\u0db1\u0dca\u0db1.",p18vcp24:"OTP \u0dba\u0dc0\u0db8\u0dd2\u0db1\u0dca...",p1ntvp8x:"\u0dc0\u0dd9\u0db1\u0dad\u0dca \u0d8b\u0db4\u0dcf\u0d82\u0d9c\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0dc0\u0dd3 OTP \u0dba\u0dc0\u0db1\u0dca\u0db1",pn5i6fn:"\u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca 6\u0d9a OTP \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",p12n3zp8:"\u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca...",pohmzat:"\u0db8\u0dd4\u0dbb\u0db4\u0daf\u0dba \u0dba\u0dc5\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0db8...",p1e6s4y0:"\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0dad\u0dca \u0dad\u0dd0\u0db4\u0dd1\u0dbd\u0dd9\u0db1\u0dca \u0dbd\u0ddc\u0d9c\u0dca \u0dc0\u0dd9\u0db1\u0dca\u0db1",p1aafagh:"\u0d94\u0db6\u0d9c\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0db8 \u0dc3\u0dcf\u0daf\u0db1\u0dca\u0db1",pasmu26:"\u0d94\u0db6\u0da7 Humaeli \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1",pqh0i9l:"\u0daf\u0dca\u0dc0\u0dcf\u0dbb\u0dba \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1",pyjrj1w:"\u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0d9a",p1rlv5t:"\u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0dc0\u0db1\u0dca\u0dad \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0ddc\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1",p19cu11q:"\u0d94\u0db6\u0dda \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1",pbe3qyw:"\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1",p1d9tqw:"\u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0d82\u0d9a\u0dda\u0dad\u0db1\u0dba \u0d9a\u0dbb \u0d87\u0dad",p1696fig:"\u0d9a\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d94\u0db6\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0d89\u0da9",p14mamw2:"\u0d94\u0db6\u0dda \u0db8\u0dcf\u0db1\u0dc3\u0dd2\u0d9a \u0dba\u0dc4\u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0db8\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a, \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba\u0d9a \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc0\u0db1\u0dca\u0db1.",p16mi6u6:"\u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dcf \u0dc3\u0ddc\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1",pcyp7gf:"\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dad\u0dca\u0dc0\u0dba, \u0db7\u0dcf\u0dc2\u0dcf\u0dc0, \u0dbd\u0db6\u0dcf \u0d9c\u0dad \u0dc4\u0dd0\u0d9a\u0dd2 \u0db6\u0dc0, \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0db1 \u0dc0\u0dbb\u0dca\u0d9c\u0dba \u0dc3\u0dc4 \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1 \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca\u0dc0 \u0db4\u0dc5\u0db4\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dc3\u0db1\u0dca\u0db1.",p1j7paqb:"\u0d94\u0db6\u0dda AI \u0dc3\u0dd4\u0dc0\u0dad\u0dcf \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb\u0dd2\u0dba",p235k91:"\u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0dba\u0dd9\u0d9a\u0dd4 \u0dc4\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dbb \u0d95\u0db1\u0dd1\u0db8 \u0dc0\u0dda\u0dbd\u0dcf\u0dc