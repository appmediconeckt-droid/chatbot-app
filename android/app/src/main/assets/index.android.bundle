0627\u06cc \u0645\u06cc\u0644 \u0633\u067e\u0648\u0631\u0679",p12y1fw5:"\u0627\u067e\u0646\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4",pi7el9x:"24 \u06af\u06be\u0646\u0679\u06d2 \u06a9\u06d2 \u0627\u0646\u062f\u0631",peza8d7:"\u06c1\u0645\u0627\u0644\u06cc\u0648",p1k70v3b:"\u0641\u0648\u0631\u06cc \u062c\u0648\u0627\u0628\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",pi7p4si:"24/7 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2\u06d4",ptmpaw1:"\u0645\u06cc\u06ba \u0627\u067e\u0648\u0627\u0626\u0646\u0679\u0645\u0646\u0679 \u06a9\u06cc\u0633\u06d2 \u0628\u06a9 \u06a9\u0631\u0648\u06ba\u061f",pq44ijf:"\u0627\u067e\u0648\u0627\u0626\u0646\u0679\u0645\u0646\u0679 \u0628\u064f\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u06a9\u0646\u0633\u0644\u0679\u0646\u0679\u0633 \u06a9\u06d2 \u0679\u06cc\u0628 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u060c \u0627\u067e\u0646\u0627 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06a9\u0646\u0633\u0644\u0679\u0646\u0679 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u060c \u0627\u067e\u0646\u06cc \u0645\u0634\u0627\u0648\u0631\u062a \u06a9\u06cc \u0642\u0633\u0645 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u060c \u0627\u0648\u0631 \u062a\u0627\u0631\u06cc\u062e \u0627\u0648\u0631 \u0648\u0642\u062a \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0648 \u062a\u0645\u0627\u0645 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u06cc\u06a9 \u062a\u0635\u062f\u06cc\u0642\u06cc \u0627\u06cc \u0645\u06cc\u0644 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u06af\u0627\u06d4",pvi5gau:"\u0645\u06cc\u06ba \u06a9\u06cc\u0633\u06d2 \u0645\u0646\u0633\u0648\u062e \u06cc\u0627 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u06cc\u0688\u0648\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",pfqgfyn:"\u0622\u067e \u0627\u067e\u0648\u0627\u0626\u0646\u0679\u0645\u0646\u0679 \u0633\u06cc\u06a9\u0634\u0646 \u0633\u06d2 \u0627\u067e\u0646\u06cc \u0627\u067e\u0627\u0626\u0646\u0679\u0645\u0646\u0679\u0633 \u06a9\u0627 \u0627\u0646\u062a\u0638\u0627\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u06cc\u0688\u0648\u0644 \u06cc\u0627 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06cc \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u0644\u0627\u0642\u0627\u062a \u06a9\u0648 \u062a\u06be\u067e\u062a\u06be\u067e\u0627\u0626\u06cc\u06ba\u06d4 \u0633\u06cc\u0634\u0646 \u0633\u06d2 24 \u06af\u06be\u0646\u0679\u06d2 \u067e\u06c1\u0644\u06d2 \u06a9\u06cc \u06af\u0626\u06cc \u0645\u0646\u0633\u0648\u062e\u06cc\u0627\u06ba \u0631\u06cc\u0641\u0646\u0688\u0632 \u06a9\u06d2 \u0627\u06c1\u0644 \u06c1\u06cc\u06ba\u06d4",p1h9bcwo:"\u06a9\u06cc\u0627 \u0645\u06cc\u0631\u0627 \u0637\u0628\u06cc \u0688\u06cc\u0679\u0627 \u0645\u062d\u0641\u0648\u0638 \u06c1\u06d2\u061f",ps9lc26:"\u06c1\u0627\u06ba\u060c \u0622\u067e \u06a9\u0627 \u062a\u0645\u0627\u0645 \u0630\u0627\u062a\u06cc \u0627\u0648\u0631 \u0637\u0628\u06cc \u0688\u06cc\u0679\u0627 \u0627\u06cc\u0646\u0688 \u0679\u0648 \u0627\u06cc\u0646\u0688 \u0627\u0646\u06a9\u0631\u067e\u0634\u0646 \u0627\u0648\u0631 \u0627\u0646\u0688\u0633\u0679\u0631\u06cc \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u067e\u0631\u0648\u0679\u0648\u06a9\u0648\u0644 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u062d\u0641\u0648\u0638 \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u0622\u067e \u06a9\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u06a9\u06d2 \u0628\u063a\u06cc\u0631 \u062a\u06cc\u0633\u0631\u06d2 \u0641\u0631\u06cc\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0628\u06be\u06cc \u0628\u06be\u06cc \u0634\u06cc\u0626\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4",p1c63b9n:"\u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0648\u0627\u0644\u06cc\u0679 \u0645\u06cc\u06ba \u0641\u0646\u0688\u0632 \u06a9\u06cc\u0633\u06d2 \u0634\u0627\u0645\u0644 \u06a9\u0631\u0648\u06ba\u061f",pfulep3:"\u0648\u0627\u0644\u06cc\u0679 \u0679\u06cc\u0628 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \"\u067e\u06cc\u0633\u06d2 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\" \u067e\u0631 \u0679\u06cc\u067e \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u067e\u0646\u0627 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u2014 \u06a9\u0627\u0631\u0688\u060c UPI\u060c \u06cc\u0627 \u0628\u06cc\u0646\u06a9 \u0679\u0631\u0627\u0646\u0633\u0641\u0631 \u2014 \u0627\u0648\u0631 \u0648\u06c1 \u0631\u0642\u0645 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0622\u067e \u0634\u0627\u0645\u0644 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",pex3sts:"\u0645\u062f\u062f \u0627\u0648\u0631 \u0633\u067e\u0648\u0631\u0679",p1ofqfdp:"\u0645\u0642\u0628\u0648\u0644 \u0633\u0648\u0627\u0644\u0627\u062a",p1m6uxly:"\u0634\u06cc\u0648\u0631\u0648\u0646 \u0627\u067e",p9wx6ep:"\u0634\u06cc\u0648\u0631\u0648\u0646 \u0646\u06cc\u0686\u06d2",pmkl5g0:"\u0641\u0648\u0631\u06cc \u0645\u062f\u062f \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f",p1ucr8ie:"\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u06a9\u0633\u06cc \u0637\u0628\u06cc \u0627\u06cc\u0645\u0631\u062c\u0646\u0633\u06cc \u06a9\u0627 \u0633\u0627\u0645\u0646\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0627\u067e\u0646\u06cc \u0645\u0642\u0627\u0645\u06cc \u0627\u06cc\u0645\u0631\u062c\u0646\u0633\u06cc \u0633\u0631\u0648\u0633\u0632 \u06a9\u0648 \u06a9\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",p1k15svg:"\u06c1\u0646\u06af\u0627\u0645\u06cc \u0631\u0627\u0628\u0637\u06c1",p1il8i8d:"\u0628\u062d\u0631\u0627\u0646\u06cc \u0648\u0633\u0627\u0626\u0644",pgcsuld:"\u06a9\u0633\u06cc \u0645\u0633\u0626\u0644\u06d2 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc\u06ba\u06d4",p1x9xuzh:"\u0627\u06cc\u067e \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0628\u06af \u06cc\u0627 \u062a\u06a9\u0646\u06cc\u06a9\u06cc \u0645\u0633\u0626\u0644\u06d2 \u06a9\u0627 \u0633\u0627\u0645\u0646\u0627 \u06c1\u0648\u0627\u061f",p18t3p8y:"\u0631\u067e\u0648\u0631\u0679 \u0627\u06cc\u0634\u0648",p11jo8ku:"Humaeli \u0648\u0631\u0698\u0646",prnsj34:"\u0622\u062e\u0631\u06cc \u0628\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc\u0627 \u06af\u06cc\u0627:",p8lq2oq:"\u0627\u067e \u0688\u06cc\u0679\u0633 \u06a9\u06cc \u062c\u0627\u0646\u0686 \u06a9\u0631\u06cc\u06ba\u06d4",pg6nyxd:"\u0627\u06cc\u0646\u0688 \u0679\u0648 \u0627\u06cc\u0646\u0688 \u0627\u0646\u06a9\u0631\u067e\u0634\u0646",pm4qf9j:"GDPR \u0645\u0635\u062f\u0642\u06c1 \u0631\u0633\u0627\u0626\u06cc",p13tbyt3:"\u06af\u0645\u0646\u0627\u0645 \u0645\u0634\u0627\u0648\u0631\u062a",p1474pj6:"\u067e\u0631\u0633 \u06a9\u06d2 \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u0628\u0646\u0627\u0626\u06cc\u06ba",p12ddn6e:"\u0630\u0627\u062a\u06cc \u067e\u0631\u0648\u0641\u0627\u0626\u0644",p178beh:"\u0646\u0627\u0645\u060c \u0639\u0645\u0631 \u0627\u0648\u0631 \u062c\u0646\u0633",p1el3mqv:"\u0631\u0627\u0628\u0637\u06c1 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a",p1uqyawh:"\u0635\u062d\u062a \u06a9\u06cc \u062a\u0631\u062c\u06cc\u062d\u0627\u062a",p1j5drmg:"\u0627\u067e\u0646\u06d2 \u0646\u06af\u06c1\u062f\u0627\u0634\u062a \u06a9\u06d2 \u062a\u062c\u0631\u0628\u06d2 \u06a9\u0648 \u0630\u0627\u062a\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba",p1hshih:"\u0622\u067e \u06a9\u0648 \u0635\u062d\u06cc\u062d \u0645\u0634\u06cc\u0631 \u0633\u06d2 \u0645\u0644\u0627\u0626\u06cc\u06ba\u06d4",p4lwpxb:"\u0686\u06cc\u0679\u0633 \u0627\u0648\u0631 \u06a9\u0627\u0644\u0632",p16o5duv:"\u067e\u06cc\u063a\u0627\u0645\u0627\u062a \u0627\u0648\u0631 \u0641\u0648\u0631\u06cc \u062c\u0648\u0627\u0628\u0627\u062a",pjualou:"\u0686\u06cc\u0679 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u0627\u0648\u0631 \u0645\u0646\u0633\u0644\u06a9\u0627\u062a",p8fcohj:"\u0642\u0628\u0648\u0644 \u0634\u062f\u06c1 \u0686\u06cc\u0679 \u0633\u06cc\u0634\u0646\u0632",pqugyus:"\u0645\u0633\u0644\u0633\u0644 \u06af\u0641\u062a\u06af\u0648 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06cc\u06ba\u06d4",pxw259e:"\u0633\u06cc\u0634\u0646 \u06a9\u06d2 \u062f\u0648\u0631\u0627\u0646 \u06a9\u0646\u0633\u0644\u0679\u0646\u0679 \u0633\u067e\u0648\u0631\u0679 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",ppapyhl:"\u062a\u0642\u0631\u0631\u06cc\u0627\u06ba",ppjebc6:"\u0628\u06a9\u0646\u06af \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u0627\u0648\u0631 \u0648\u0642\u062a",prz84q3:"\u0645\u0646\u062a\u062e\u0628 \u06a9\u0646\u0633\u0644\u0679\u0646\u0679",p6bzi8o:"\u0633\u06cc\u0634\u0646 \u0646\u0648\u0679\u0633",pfby3q4:"\u0627\u067e\u0646\u06d2 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0633\u06cc\u0634\u0646\u0632 \u06a9\u0627 \u0646\u0638\u0645 \u06a9\u0631\u06cc\u06ba\u06d4",p1px010k:"\u0628\u0631\u0648\u0642\u062a \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\u0627\u06ba \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4",pl6oj3n:"\u0648\u0627\u0644\u06cc\u0679 \u0627\u0648\u0631 \u0644\u06cc\u0646 \u062f\u06cc\u0646",pcisb5n:"\u0631\u06cc\u0686\u0627\u0631\u062c \u0627\u0648\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",p11x8ws5:"\u0631\u0642\u0645 \u06a9\u06cc \u0648\u0627\u067e\u0633\u06cc \u06a9\u06d2 \u0631\u06cc\u06a9\u0627\u0631\u0688",p1jezb8u:"\u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u06cc \u0631\u0633\u06cc\u062f\u06cc\u06ba",p1kxmxol:"\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0648\u06ba \u067e\u0631 \u0645\u062d\u0641\u0648\u0638 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u0639\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",p1soeejn:"\u0628\u0644\u0646\u06af \u06a9\u06cc \u062f\u0631\u0633\u062a \u062a\u0627\u0631\u06cc\u062e \u06a9\u0648 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u06cc\u06ba",p3fb3fk:"\u0627\u067e\u0646\u06d2 \u0688\u06cc\u0679\u0627 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",paxx0ja:"\u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u0627\u06cc\u06a9 \u06a9\u0627\u067e\u06cc \u0637\u0644\u0628 \u06a9\u0631\u06cc\u06ba Humaeli \u0622\u067e \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4",py8xd5m:"\u0627\u067e\u0646\u0627 \u0688\u06cc\u0679\u0627 \u062f\u0631\u0633\u062a \u06a9\u0631\u06cc\u06ba\u06d4",pg1ugci:"\u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0633\u06d2 \u063a\u0644\u0637 \u06cc\u0627 \u067e\u0631\u0627\u0646\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba\u06d4",p13743po:"\u0627\u067e\u0646\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u062d\u0630\u0641 \u06a9\u0631\u06cc\u06ba\u06d4",p12l9hlj:"\u0627\u067e\u0646\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0627\u0648\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u0648 \u0645\u0679\u0627\u0646\u06d2 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u06cc\u06ba\u06d4",pqqlbs9:"\u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0648\u0627\u067e\u0633 \u0644\u06cc\u06ba\u06d4",p7r950p:"\u0628\u0646\u06cc\u0627\u062f\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u0648 \u06a9\u06be\u0648\u0646\u06d2 \u06a9\u06d2 \u0628\u063a\u06cc\u0