 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7",p1nb6hqp:"\u09a1\u09be\u0995\u09cd\u09a4\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u0995\u098f\u09a8\u09cd\u09a1 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u09b9\u09af\u09bc\u09c7 \u0997\u09c7\u09b2\u09c7 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b0\u09bf\u09b8\u09c7\u099f \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09ac\u09c7",pky4h36:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09ad\u09c1\u09b2\u09c7 \u0997\u09c7\u099b\u09c7\u09a8?",prejna:"Google \u09b8\u09be\u0987\u09a8-\u0987\u09a8 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u09f7",pvu0wuw:"\u098f\u0995\u099f\u09bf \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09c7\u0987?",p6kesda:"\u0987\u09ae\u09c7\u09b2 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",p39j8ek:"\u0993\u09af\u09bc\u09be\u09a8-\u099f\u09be\u0987\u09ae \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 *",pqjslim:"\u0993\u099f\u09bf\u09aa\u09bf \u09aa\u09be\u09a8\u09a8\u09bf?",p1seagg0:"\u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7...",pvitosp:"\u0986\u09ac\u09be\u09b0 \u09aa\u09be\u09a0\u09be\u09a8",p156tq0x:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b0\u09bf\u09b8\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09ae\u09c7\u09b2 \u09b2\u09bf\u0996\u09c1\u09a8",p1es6jgh:"\u0987\u09ae\u09c7\u0987\u09b2 \u09b2\u09bf\u0996\u09c1\u09a8",p1ncbamm:"\u09b9\u09c1\u09ae\u09be\u0987\u09b2\u09bf - \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09be\u09a8\u09b8\u09bf\u0995 \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be",p1mkbgjw:"\u09ae\u09be\u09a8\u09ac \u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4",p67t5ik:"\u09ae\u09be\u09a8\u09b8\u09bf\u0995 \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8",p15kdwif:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09be\u09a8\u09b8\u09bf\u0995 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09c7\u09b0 \u0995\u09a0\u09bf\u09a8 \u09b8\u09ae\u09af\u09bc\u09c7 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be, \u09ae\u09a8\u09cb\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09a8\u09c0, \u09ae\u09a8\u09b8\u09cd\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8\u0995\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u09ae\u09a8\u09cb\u09b0\u09cb\u0997 \u09ac\u09bf\u09b6\u09c7\u09b7\u099c\u09cd\u099e\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8",puqjq8w:"\u0986\u09b6\u09c7\u09aa\u09be\u09b6\u09c7\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09c7\u09b2\u09c7",pglw0op:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u09b0\u09be\u0996\u09c1\u09a8",pdkk7ab:"\u099c\u09b0\u09c1\u09b0\u09c0 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be",p6s9e29:"\u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09b0\u09cb\u0997\u09c0\u09a6\u09c7\u09b0 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0996\u09c1\u0981\u099c\u09c7 \u09aa\u09c7\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09c1\u09a8",p1kc2xvx:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0\u09ad\u09be\u09ac\u09c7 \u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7. \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0996\u09c1\u09b2\u09c1\u09a8 \u2192 \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09c1\u09a8, \u09a4\u09be\u09b0\u09aa\u09b0\u09c7 \u09ab\u09bf\u09b0\u09c7 \u0986\u09b8\u09c1\u09a8\u0964",pj1z8my:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u099b\u09be\u09a1\u09bc\u09be, \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09b0\u09cb\u0997\u09c0\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u0996\u09c1\u0981\u099c\u09c7 \u09a8\u09be\u0993 \u09aa\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u098f\u09ac\u0982 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8-\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09b8\u09c0\u09ae\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964",pe2sfkx:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u0996\u09a8\u0993 \u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7. \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a6\u09c3\u09b6\u09cd\u09af\u09ae\u09be\u09a8\u09a4\u09be \u098f\u09ac\u0982 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8-\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be\u09b0 \u09ae\u09a4\u09cb \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09b8\u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09ac\u09c7 \u09a8\u09be\u0964",p1bc8b0q:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u099b\u09be\u09a1\u09bc\u09be \u0986\u09aa\u09a8\u09bf \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be, \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09b8\u09a4\u09b0\u09cd\u0995\u09a4\u09be, \u098f\u09ac\u0982 \u099c\u09b0\u09c1\u09b0\u09c0 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u09ae\u09bf\u09b8 \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964",p1kxnr6x:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u0996\u09a8\u0993 \u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7. \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u098f\u09ac\u0982 \u099c\u09b0\u09c1\u09b0\u09bf \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be\u09b0 \u09ae\u09a4\u09cb \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09b8\u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09ac\u09c7 \u09a8\u09be\u09f7",p1qfkxpw:"\u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0996\u09c1\u09b2\u09c1\u09a8",p19izdw2:"\u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7...",pudz60s:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u099a\u09cd\u099b\u09c7...",p1nyz8sj:"\ud83d\udd04 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8",p129dr11:"\ud83d\udccd \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09c7\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8",p13kffw5:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u099b\u09be\u09a1\u09bc\u09be\u0987 \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8",pr2p72l:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac\u09bf\u09a4",pi9375l:"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09c1\u09a8",p1xmhdqy:"\u0995\u09bf\u099b\u09c1 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u099b\u09be\u09a1\u09bc\u09be \u0995\u09be\u099c \u0995\u09b0\u09ac\u09c7 \u09a8\u09be\u0964 \u0986\u09ae\u09b0\u09be \u09a6\u09c3\u09a2\u09bc\u09ad\u09be\u09ac\u09c7 \u098f\u099f\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be\u09b0 \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6.",p1ismk4q:"\u09b8\u09c7\u09b0\u09be \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09c7\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964 \u098f\u099f\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09b0\u0993 \u09ad\u09be\u09b2 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09a8 \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u09b0\u09be\u0996\u09a4\u09c7 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u0995\u09b0\u09c7\u0964",p1rsaitz:"\u0995\u09c7\u09a8 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8",p1lwhuaj:"\ud83d\udd10 \u0986\u09aa\u09a8\u09bf \u09af\u0996\u09a8 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u099b\u09c7\u09a8 \u09a4\u0996\u09a8\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u098f\u099f\u09bf \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ac\u09bf\u0995\u09cd\u09b0\u09bf \u09ac\u09be \u09ad\u09be\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09a8\u09be\u0964",pi5yj9e:"\u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09b8\u09c0\u09ae\u09bf\u09a4 \u0995\u09b0\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a5\u09c7\u0995\u09c7 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",p1h299pn:"\u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b8\u09be\u0987\u09a8 \u0987\u09a8 \u0995\u09b0\u09c1\u09a8",punxvbe:"\u0986\u09ae\u09be\u0995\u09c7 \u09ae\u09a8\u09c7 \u09b0\u09c7\u0996\u09cb",p1djn4vs:"\u09ae\u09c7\u0987\u09b2-\u0993\u09aa\u09c7\u09a8-\u0986\u0989\u099f\u09b2\u09be\u0987\u09a8",p9joi0e:"\u09ab\u09cb\u09a8-\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09c3\u09a4\u09bf-\u09b0\u09c2\u09aa\u09b0\u09c7\u0996\u09be",pcm1nee:"\u098f\u099f\u09be \u0986\u09aa\u09a8\u09bf \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",p39qlxn:"\u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8 \u09a6\u09cd\u09ac\u09a8\u09cd\u09a6\u09cd\u09ac \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7",p1nl6f5:"\u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u0987\u09ae\u09c7\u09b2\u09c7 \u098f\u0995\u099f\u09bf 6-\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u0995\u09cb\u09a1 \u09aa\u09be\u09a0\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u09b8\u09be\u0987\u09a8 \u0986\u0989\u099f \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09a8\u09bf\u099a\u09c7 \u098f\u099f\u09bf \u09b2\u09bf\u0996\u09c1\u09a8\u0964",p8ykf5k:"\u0986\u09aa\u09a8\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u0985\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u09f7 \u098f\u099f\u09bf \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b8\u09be\u0987\u09a8 \u0986\u0989\u099f \u0995\u09b0\u09c1\u09a8\u0964",p18vcp24:"OTP \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7...",p1ntvp8x:"\u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09b2\u0997\u0986\u0989\u099f \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 OTP \u09aa\u09be\u09a0\u09be\u09a8",pn5i6fn:"6-\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 OTP \u09b2\u09bf\u0996\u09c1\u09a8",p12n3zp8:"\u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7...",pohmzat:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b0\u09bf\u09b8\u09c7\u099f \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7...",p1e6s4y0:"\u0987\u09ae\u09c7\u0987\u09b2 \u09a6\u09bf\u09af\u09bc\u09c7 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09c1\u09a8",p1aafagh:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8",pasmu26:"\u0986\u09aa\u09a8\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8 \u09a4\u09be \u099a\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8 Humaeli",pqh0i9l:"\u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",pyjrj1w:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0",p1rlv5t:"\u09ac\u09bf\u09b6\u09cd\u09ac\u09b8\u09cd\u09a4 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u0996\u09c1\u0981\u099c\u09c1\u09a8",p19cu11q:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8",pbe3qyw:"\u09aa\u09c7\u09b6\u09be\u09a6\u09be\u09b0 \u09af\u09a4\u09cd\u09a8 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8",p1d9tqw:"\u098f\u09a8\u09cd\u09a1-\u099f\u09c1-\u098f\u09a8\u09cd\u09a1 \u098f\u09a8\u0995\u09cd\u09b0\u09bf\u09aa\u09cd\u099f\u09c7\u09a1",p1696fig:"\u0995\u09a5\u09be \u09ac\u09b2\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09b8\u09cd\u09a5\u09be\u09a8",p14mamw2:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09be\u09a8\u09b8\u09bf\u0995 \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a1\u09bf\u099c\u09be\u0987\u09a8 \u0995\u09b0\u09be \u098f\u0995\u099f\u09bf \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4, \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09b8\u09cd\u09a4 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964",p16mi6u6:"\u09b8\u09a0\u09bf\u0995 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u0996\u09c1\u0981\u099c\u09c1\u09a8",pcyp7gf:"\u09ac\u09bf\u09b6\u09c7\u09b7\u09a4\u09cd\u09ac, \u09ad\u09be\u09b7\u09be, \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09af\u09a4\u09be, \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09c7\u09b0 \u09a7\u09b0\u09a8 \u098f\u09ac\u0982 \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u0985\u09ad\u09bf\u099c\u09cd\u099e \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 \u09ac\u09cd\u09b0\u09be\u0989\u099c \u0995\u09b0\u09c1\u09a8\u0964",p1j7paqb:"\u0986\u09aa\u09a8\u09be\u09b0 AI \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be\u09b0 \u09b8\u0999\u09cd\u0997\u09c0",p235k91:"\u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09cb\u0997 \u0995\u09b0\u09be\u09b0 \u0986\u0997\u09c7 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc \u09a4\u09be\u09a4\u09cd\u0995\u09cd\u09b7\u09a3\u09bf\u0995 \u09ae\u09be\u09a8\u09b8\u09bf\u0995 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8, \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u098f\u09ac\u0982 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be \u09aa\u09be\u09a8\u0964",p12cl72e:"\u09b9\u09cd\u09af\u09be\u09b2\u09cb \ud83d\udc4b \u0986\u099c\u0995\u09c7 \u0995\u09c7\u09ae\u09a8 \u09b2\u09be\u0997\u099b\u09c7?",pz0a21k:"\u09ac\u0987, \u099a\u09cd\u09af\u09be\u099f \u098f\u09ac\u0982 \u09a8\u09bf\u09b0\u09be\u09ae\u09af\u09bc",pahuuzy:"\u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u09b8\u09c2\u099a\u09c0 \u0995\u09b0\u09c1\u09a8, \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09ad\u09bf\u09a1\u09bf\u0993 \u09b8\u09c7\u09b6\u09a8\u09c7 \u09af\u09cb\u0997 \u09a6\u09bf\u09a8, \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u099a\u09cd\u09af\u09be\u099f \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09c1\u09b8\u09cd\u09a5\u09a4\u09be\u09b0 \u09af\u09be\u09a4\u09cd\u09b0\u09be \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995 \u0995\u09b0\u09c1\u09a8\u2014\u09b8\u09ac\u0995\u09bf\u099b\u09c1 \u098f\u0995 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc\u0964",pefpvkx:"\u09ac\u0987 \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8",pvu2nj9:"\u09ad\u09bf\u09a1\u09bf\u0993 \u0995\u09b2",p1dfp17w:"\u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u099a\u09cd\u09af\u09be\u099f",pz29fz2:"\u098f\u09a8\u09cd\u09a1-\u099f\u09c1-\u098f\u09a8\u09cd\u09a1",prcdi82:"#cbd5e1",p8cqkqc:"#00652C",pyj27bj:"\u0995\u09cb\u09a8\u099f\u09bf",pyivru2:"\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc",pdfz3q4:"\u098f\u0996\u09be\u09a8\u09c7 \u09a8\u09a4\u09c1\u09a8?",plg5b3z:"\u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u09af\u09cb\u0997\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8?",p86so6m:"\u09aa\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4 \u0995\u09cb\u09a1 \u09b2\u09bf\u0996\u09c1\u09a8",pwma7ac:"\u098f\u0996\u09a8\u0987 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",p1girtza:"\u09ab\u09bf\u09b0\u09c7 \u09af\u09be\u09a8",p16rk3ld:"\u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0985\u09a7\u09bf\u09ac\u09c7\u09b6\u09a8 \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7",p1e642qo:"\u0986\u09aa\u09a8\u09bf \u0985\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u0995\u09bf \u0985\u09a8\u09cd\u09af \u09b8\u09ac \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u09b2\u0997 \u0986\u0989\u099f \u0995\u09b0\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8?",piwem5c:"\u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09b2\u0997 \u0986\u0989\u099f \u0995\u09b0\u09c1\u09a8",p1279ro7:"\u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09c1\u09a8",pa7nvn9:"#10b981",plz121n:"\u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be",p375zml:"\u09ac\u099b\u09b0",ph29zus:"\u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6",pg673oj:"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a6\u09c7\u0996\u09c1\u09a8",p1db5cid:"\u09ad\u09bf\u09a1\u09bf\u0993 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6",p1yu9pu:"\u09ad\u09af\u09bc\u09c7\u09b8 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6",p191keun:"\u0993\u09af\u09bc\u09be\u0995-\u0987\u09a8 \u09ad\u09bf\u099c\u09bf\u099f",piytekc:"\u0987\u09a8-\u0995\u09cd\u09b2\u09bf\u09a8\u09bf\u0995 \u09aa\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8",p1e54nbv:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09b8\u0999\u09cd\u0997\u09c7",pkt8by3:"BREAK \u099a\u09be\u09b2\u09c1",p1j5edg3:"\u09ac\u09bf\u09b0\u09be\u09ae \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7",p1g2ipl4:"\u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc