,credits:"Kiredit",spent:"An kashe",completed:"An kammala",spendingSummary:"Takaitaccen Bayanin kashewa",noSpendingRecorded:"Babu kashe kudi da aka rubuta a wannan watan.",totalSpentThisMonth:"Jimlar da aka kashe a wannan watan",addMoney:"\u0198ara Kudi",fastSecureWalletTopup:"Mai sauri kuma amintacce sama-sama",paymentMethod:"Hanyar Biyan Ku\u0257i",transactionHistory:"Tarihin ciniki",noTransactionsFound:"Ba a sami ma'amaloli ba.",refresh:"Sake sabuntawa",needPaymentHelp:"Kuna bu\u0199atar taimakon biyan ku\u0257i?",supportTeamAvailable:"\u0198ungiyar tallafi tana samuwa 24x7 don walat da batutuwan biyan ku\u0257i.",support:"Taimako",confirmAndAddFunds:"Tabbatar da \u0198ara Ku\u0257i",invalidAmount:"Adadin da ba daidai ba",pleaseEnterValidAmount:"Da fatan za a shigar da ingantaccen adadin",success:"Nasara",fundsAddedSuccessfully:"An \u0199ara ku\u0257i cikin nasara.",paymentFailed:"Biyan ya kasa",verificationFailed:"Tabbatarwa ya kasa. Da fatan za a sake gwadawa.",paymentError:"Kuskuren Biyan Ku\u0257i",couldNotInitiatePayment:"An kasa fara biyan ku\u0257i.",walletFailedToLoad:"An kasa loda bayanan walat.",upi:"UPI",card:"Katin",netbanking:"NetBanking",walletPayment:"Wallet"},appointment:{counselorDirectory:"Littafin Masu ba da shawara",trustedExperts:"Amintattun \u0199wararru don tallafin lafiyar hankali na sirri",sort:"Tsara:",name:"Suna",rating:"Rating",experience:"Kwarewa",appointmentDate:"Kwanan Wa'adin & Lokaci",date:"Kwanan wata",time:"Lokaci",clinicalNotes:"Bayanan asibiti / Dalili",cancel:"Sokewa",confirm:"Tabbatar",booking:"Yin booking...",counselorUnavailable:"Babu mai ba da shawara",notAvailableNow:"a halin yanzu babu. Da fatan za a gwada daga baya.",schedule:"Jadawalin",chatNow:"Tattaunawa Yanzu",youAlreadyHaveChat:"Kun riga kun sami kar\u0253ar ta\u0257i tare da wannan mashawarcin.",tapChatNowToContinue:"Matsa Ta\u0257i Yanzu don ci gaba da tattaunawar ku.",sessionRequestWillBeSent:"Za a aika bu\u0199atar zaman ku ga mai ba da shawara.",youCanChatOnceAccepts:"Kuna iya yin ta\u0257i da zarar mai ba da shawara ya kar\u0253i bu\u0199atarku.",chatting:"Kuna magana ba tare da suna ba kamar:",sessionRequestSent:"An aika bu\u0199atar",sessionRequestMessage:"An aika bu\u0199atar zama Kuna iya bu\u0257e hira da zarar mai ba da shawara ya kar\u0253a.",counselorNotSelected:"Kuskure",counselorNotSelectedMessage:"Ba a za\u0253i mai ba da shawara ba",invalidDate:"Kwanan wata mara aiki",pleaseChooseValidDateTime:"Da fatan za a za\u0253i ingantaccen kwanan wata da lokacin al\u0199awari.",invalidTime:"Lokaci mara inganci",pleaseChooseFutureDateTime:"Da fatan za a za\u0253i kwanan wata da lokaci na gaba don al\u0199awari.",clinicalNotesRequired:"Ana Bukatar Bayanan kula na asibiti",pleaseAddReasonForBooking:"Da fatan za a \u0199ara dalilin yin ajiyar wannan al\u0199awari.",bookedSuccessfully:"Yayi Nasara",appointmentRequestSent:"An aika bu\u0199atar al\u0199awari. An sanar da mai ba da shawara.",bookingFailed:"An kasa yin ajiya",failedToBook:"An kasa yin al\u0199awari.",accepted:"Karba",searchCounselorPlaceholder:"Bincika mai ba da shawara ta suna, \u0199warewa, ko wuri",sessionReasonPlaceholder:"Raba abin da kuke son tattaunawa a wannan zaman..."},helpPage:{title:"Taimako Taimako",centerTitle:"Cibiyar tallafi ta Humaeli",centerDesc:"Yi amfani da wannan cibiyar tallafi don tsalle zuwa fasalin Humaeli na dama, magance matsalolin gama gari, da fahimtar lokacin da za a tuntu\u0253ar taimakon gaggawa a wajen \u0199a'idar.",aiWellnessChat:"AI zaman lafiya chat",aiWellnessDesc:"Yi tambayoyin lafiya-tunani, yi amfani da shigar da murya, samun amsa cikin sauri, kuma ci gaba da ta\u0257i na AI kwanan nan daga dashboard.",aiWellnessAction:"Bude AI ta\u0257i",counselorSupport:"Taimakon mai ba da shawara",counselorDesc:"Bincika masu ba da shawara da suna, \u0199warewa, harshe, wuri, \u0199ima, da matsayin kan layi kafin fara kulawa.",counselorAction:"Nemo mai ba da shawara",appointments:"Al\u0199awura",appointmentsDesc:"Yi bitar al\u0199awura masu zuwa da wa\u0257anda suka gabata, duba matsayin bu\u0199atun, da zaman littafi tare da masu ba da shawara.",appointmentsAction:"Duba al\u0199awura",walletPayments:"Wallet da biyan ku\u0257i",walletDesc:"\u0198ara ku\u0257i, duba ma'amaloli, zazzage rahotannin walat, da tuntu\u0253ar tallafin don tambayoyin biyan ku\u0257i.",walletAction:"Bude walat",beforeContact:"Kafin ku tuntu\u0253i tallafi",checklist1:"Tabbatar da ha\u0257in Intanet \u0257in ku kuma sabunta \u0199a'idar kafin yin rahoton matsalar lodawa.",checklist2:"Ajiye sabon hoton allo, ainihin lokacin, da sunan allo a shirye lokacin da ake tuntu\u0253ar tallafi.",checklist3:"Don kamara, makirufo, sanarwa, da batutuwan wuri, fara bincika izinin aikace-aikacen na'urar.",checklist4:"Don batutuwan biyan ku\u0257i, sun ha\u0257a da kwanan wata, adadin, matsayin ciniki, da ma'aunin walat da aka nuna a cikin app.",commonIssues:"Matsalolin gama gari",aiChatNotReply:"AI chat baya amsawa",aiChatNotReplyDesc:"Bincika ha\u0257in Intanet \u0257in ku, gwada aika \u0257an gajeren sa\u0199o, kuma sake bu\u0257e ta\u0257i na AI daga dashboard. Idan har yanzu ta gaza, raba ainihin hoton hoton kuskure tare da goyan baya.",counselorChatNotOpen:"Hirar mai ba da shawara baya bu\u0257ewa",counselorChatNotOpenDesc:"Bu\u0257e Tallafin Mashawarci, za\u0253i mai ba da shawara da ke akwai, kuma jira a kar\u0253i bu\u0199atun. Hirar da ake ciki suna bayyana a allon ta\u0257i na mai ba da shawara.",callNotConnecting:"Kira baya ha\u0257awa",callNotConnectingDesc:"Tabbatar cewa mai ba da shawara ya kar\u0253i ta\u0257i/zamanku, duka masu amfani suna kan layi, kuma an ba da izinin makirufo/kamara.",walletPaymentIssue:"Wallet ko batun biyan ku\u0257i",walletPaymentIssueDesc:"Bude Wallet don duba sabuwar ciniki da zazzage rahoto. Raba kwanan wata, adadin, da matsayin ma'amala lokacin tuntu\u0253ar tallafi.",languageWrongTitle:"Harshe ko fassarar yayi kuskure",languageWrongDesc:"Yi amfani da za\u0253in harshe daga dashboard/saituna. Wasu masu ba da shawara ko bayanan likita na iya kasancewa a cikin yaren da mai bada ya shigar.",needMoreHelp:"Kuna bu\u0199atar \u0199arin taimako?",needMoreHelpDesc:"Sabunta bayanan asusun daga Bayanan martaba/Saituna, ko tallafin imel tare da hotunan kariyar kwamfuta, sigar app, imel/waya mai amfani, da ainihin lokacin da batun ya faru. Don tallafin rikici a Indiya, kira 9152987821 ko sabis na gaggawa na gida.",myProfile:"Bayanan Bayani na",settings:"Saituna",emailSupport:"Tallafin imel"},privacyPage:{title:"Manufar Ke\u0253antawa",centerTitle:"Cibiyar sirri ta Humaeli",centerDesc:"Wannan cibiyar ke\u0253ancewa tana bayanin yadda Humaeli ke amfani da bayanan ku, ta\u0257i, al\u0199awari, walat, kira, wurin aiki, da bayanan tsaro a cikin wannan wayar hannu.",otpProtected:"An kare OTP",otpProtectedDesc:"Canje-canjen imel da waya",anonymousCare:"Imani na kulawa mara izini",anonCareDesc:"Nuna wa masu ba da shawara inda aka tallafa",sensitiveAreas:"Wurare masu hankali",sensitiveAreasDesc:"Ta\u0257i, kira, al\u0199awura, bayanin martaba",dataUsedTitle:"Bayanan da aka yi amfani da su a cikin app",profileHealth:"Bayanan martaba da bayanan lafiya",profileHealthDesc:"Sunanka, sunan nuni da ba a san suna ba, shekaru, jinsi, bayanan tuntu\u0253ar, hoto/avatar, adireshi, lambar gaggawa, cikakkun bayanan likita, da filayen inshora ana amfani da su don kula da bayanan majiyyatan ku.",aiConversations:"AI ta\u0257i da tattaunawa mai ba da shawara",aiConversationsDesc:"Ana amfani da sa\u0199onni, saurin amsawa, matsayin ta\u0257i, ha\u0257e-ha\u0257e, kar\u0253ar zaman ta\u0257i, da cikakkun bayanai masu ba da shawara don samar da tattaunawa, ci gaba da tarihi, da fa\u0257akarwar \u0199ima.",appointments:"Al\u0199awura da zama",appointmentsDesc:"Kwanan alkawari, lokaci, dalili/bayanin kula, matsayi, mai ba da shawara da aka sanya, kira metadata, da tarihin zama na taimaka wa masu amfani da masu ba da shawara su sarrafa kulawa.",wallet:"Wallet da ma'amaloli",walletDesc:"Ana amfani da ma'auni na walat, ha\u0253akawa, bayanan ma'amala, rahotannin da aka samar, da mahallin tallafi masu ala\u0199a don biyan biyan ku\u0257i.",location:"Wuri da mahallin na'urar",locationDesc:"Ana iya \u0257aukar wuri a yin rajista, shiga, ko sabuntawa na hannu don tabbatar da zama, tallafawa amincin asusun, da ha\u0253aka fasalulluka na kula da wuri.",security:"Tsaro da shiga asusu",securityDesc:"Alamu na shiga, mai ba da izini, matsayin kalmar sirri, tabbaci na OTP, matsayi, da matsayin asusu ana amfani da su don ware wuraren masu amfani da masu ba da shawara.",whoCanSee:"Wanene zai iya ganin me",visibleToYou:"Ganuwa gare ku",visibleDesc:"Dashboard \u0257inku yana nuna bayanin martabarku, hirar AI, hul\u0257ar mai ba da shawara, al\u0199awura, walat, tarihin kira, fa\u0257akarwar \u0199ima, da sarrafa wuri/sabuntawa.",sharedForCare:"Raba don kulawa",sharedDesc:"Masu ba da shawara na iya ganin bayanan da ake bu\u0199ata don gudanar da zaman kar\u0253uwa, al\u0199awura, da tattaunawar goyan baya. Ana amfani da shaidar da ba a sani ba inda aka goyan baya.",protectedAccess:"An kiyaye shi ta hanyar sarrafa shiga",protectedDesc:"An raba yankunan mai amfani da masu ba da shawara ta hanyar rawar aiki, zaman aiki, tabbatarwar OTP, da ingantattun bu\u0199atun API.",checklist:"Jerin bayanan sirrinku",checklistItem1:"Yi amfani da sunanka da ba a san ka ba don hul\u0257ar masu ba da shawara lokacin da ba ka so a nuna ainihin sunanka.",checklistItem2:"Ci gaba da tuntu\u0253ar gaggawa da bayanan bayanan likita daidai idan kun za\u0253i cika su.",checklistItem3:"Yi bita izinin na'ura don wuri, kamara, da makirufo kafin kira.",checklistItem4:"Sabunta wurin da hannu daga Saituna/Profile idan an tsallake saurin shiga.",checklistItem5:"Kar a raba OTPs, kalmomin shiga, ko cikakkun bayanan asusu a cikin sa\u0199onnin ta\u0257i.",checklistItem6:"Yi amfani da Fayil nawa da Saituna don \u0257aukaka ko duba bayanan da aka adana a asusunku.",manageData:"Sarrafa bayanan martaba",securitySettings:"Saitunan tsaro",aiQuickReplyLow:"\u0198ananan",aiQuickReplyOkay:"Lafiya",aiQuickReplyGood:"Yayi kyau",aiQuickReplyGreat:"Mai girma",aiPhotoAttached:"An makala hoto",aiTryAgain:"Sake gwadawa",aiVoiceHint:"Yi magana idan kun shirya - Zan ba da amsa da zarar kun dakata.",resetChatTitle:"Fara sabon hira?",resetChatMessage:"Wannan yana share tattaunawar AI na yanzu kuma yana farawa tare da za\u0253u\u0253\u0253ukan yanayi maraba.",startFresh:"Fara Sabo",startingFresh:"Ana farawa..."},phrases:{p1le0g3x:"Ba a sani ba",p3rvtpe:"Yau",poh8cad:"Jiya",p1mrhzr7:"Mai shigowa",pfebfdv:"Mai fita",p17k42kg:"An rasa",pvw9wg8:"An kammala",p15m090m:"Ba a yi nasara ba",p1q8utwa:"Ana jiran",pcqxqrc:"mintuna",p15oehty:"seconds",p17tqvf1:"Tattaunawa kai tsaye",pos6ydf:"Yi ta\u0257i tare da \u0199ungiyar tallafin mu",p1jk4gbo:"Yawanci kan layi a ciki",pztgw94:"Tallafin Kira",pig8opb:"Yi magana kai tsaye",pla6vae:"Tallafin Imel",p12y1fw5:"Aika tambayoyinku",pi7el9x:"A cikin sa'o'i 24",peza8d7:"Humaelio",p1k70v3b:"Samu amsoshi nan take",pi7p4si:"24/7 Akwai",ptmpaw1:"Ta yaya zan yi alkawari?",pq44ijf:"Don yin al\u0199awari, kewaya zuwa shafin masu ba da shawara, za\u0253i mashawarcin da kuka fi so, za\u0253i nau'in shawarwarinku, sannan za\u0253i kwanan wata da lokaci. Za ku kar\u0253i imel \u0257in tabbatarwa tare da duk cikakkun bayanai.",pvi5gau:"Ta yaya zan iya soke ko sake tsarawa?",pfqgfyn:"Kuna iya sarrafa al\u0199awuranku daga sashin al\u0199awura. Matsa kowane al\u0199awari mai zuwa don sake tsarawa ko sokewa. Sokewa da aka yi awanni 24 kafin zaman sun cancanci maida ku\u0257i.",p1h9bcwo:"Shin bayanan likitana amintacce ne?",ps9lc26:"Ee, duk bayanan ke\u0253a\u0253\u0253en ku da na likitanci ana kiyaye su tare da \u0253oyayyen \u0199arshen-zuwa-\u0199arshe da \u0199a'idodin tsaro na masana'antu. Ba a ta\u0253a raba bayananku tare da wasu mutane ba tare da izinin ku ba.",p1c63b9n:"Ta yaya zan \u0199ara ku\u0257i a Wallet na?",pfulep3:"Je zuwa shafin Wallet kuma danna \"\u0198ara Kudi\". Za\u0253i hanyar biyan ku\u0257in da kuka fi so - katin, UPI, ko canja wurin banki - kuma shigar da adadin da kuke son \u0199arawa.",pex3sts:"Taimako da Tallafawa",p1ofqfdp:"Shahararrun Tambayoyi",p1m6uxly:"chevron-up",p9wx6ep:"chevron - kasa",pmkl5g0:"Ana Bukatar Taimako na Gaggawa?",p1ucr8ie:"Idan kuna fuskantar gaggawa na likita, da fatan za a kira ma'aikatan gaggawa na gida nan da nan.",p1k15svg:"Tuntu\u0253ar Gaggawa",p1il8i8d:"Albarkatun Rikicin",pgcsuld:"Bayar da Matsala",p1x9xuzh:"An fuskanci matsala ko fasaha a cikin app?",p18t3p8y:"Batun Rahoto",p11jo8ku:"Humaeli Sigar",prnsj34:"An sabunta ta \u0199arshe:",p8lq2oq:"Duba Sabuntawa",pg6nyxd:"\u0198arshe-zuwa-\u0199arshen \u0253oyewa",pm4qf9j:"GDPR \u0199wararriyar damar shiga",p13tbyt3:"Shawarwari maras amfani",p1474pj6:"Amintaccen ma'amalar walat",p12ddn6e:"Bayanan sirri",p178beh:"Suna, shekaru da jinsi",p1el3mqv:"Bayanan tuntu\u0253ar juna",p1uqyawh:"Abubuwan da ake so na lafiya",p1j5drmg:"Ke\u0253ance kwarewar kulawarku",p1hshih:"Daidaita ku da mai ba da shawara daidai",p4lwpxb:"Ta\u0257i & Kira",p16o5duv:"Sa\u0199onni da amsoshi masu sauri",pjualou:"Halin ta\u0257i da ha\u0257e-ha\u0257e",p8fcohj:"Kar\u0253ar zaman ta\u0257i",pqugyus:"Samar da tarihin tattaunawa mai ci gaba",pxw259e:"Kunna tallafin mai ba da shawara yayin zaman",ppapyhl:"Al\u0199awura",ppjebc6:"Kwanan rajista da lokaci",prz84q3:"Za\u0253a\u0253\u0253en mai ba da shawara",p6bzi8o:"Bayanan kula",pfby3q4:"Sarrafa zaman ku masu zuwa",p1px010k:"Aika masu tuni masu dacewa",pl6oj3n:"Wallet & Ma'amaloli",pcisb5n:"Sake caji da tarihin biyan ku\u0257i",p11x8ws5:"Bayanan mayar da ku\u0257i",p1jezb8u:"Rasidun ciniki",p1kxmxol:"Tsarin biyan ku\u0257i amintacce",p1soeejn:"Ri\u0199e ingantaccen tarihin lissafin ku\u0257i",p3fb3fk:"Shiga bayanan ku",paxx0ja:"Nemi kwafin bayanan sirri da Humaeli ke ri\u0199e game da ku.",py8xd5m:"Gyara bayanan ku",pg1ugci:"Sabunta bayanai marasa kuskure ko tsofaffi daga bayanan martaba a kowane lokaci.",p13743po:"