,walletAction:"\uc624\ud508 \uc9c0\uac11",beforeContact:"\uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uae30 \uc804\uc5d0",checklist1:"\ub85c\ub529 \ubb38\uc81c\ub97c \ubcf4\uace0\ud558\uae30 \uc804\uc5d0 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0 \uc571\uc744 \uc0c8\ub85c \uace0\uce58\uc138\uc694.",checklist2:"\uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud560 \ub54c \ucd5c\uc2e0 \uc2a4\ud06c\ub9b0\uc0f7, \uc815\ud655\ud55c \uc2dc\uac04, \ud654\uba74 \uc774\ub984\uc744 \uc900\ube44\ud558\uc138\uc694.",checklist3:"\uce74\uba54\ub77c, \ub9c8\uc774\ud06c, \uc54c\ub9bc, \uc704\uce58 \ubb38\uc81c\uc758 \uacbd\uc6b0 \uba3c\uc800 \uae30\uae30 \uc571 \uad8c\ud55c\uc744 \ud655\uc778\ud558\uc138\uc694.",checklist4:"\uacb0\uc81c \ubb38\uc81c\uc758 \uacbd\uc6b0 \uc571\uc5d0 \ud45c\uc2dc\ub41c \ub0a0\uc9dc, \uae08\uc561, \uac70\ub798 \uc0c1\ud0dc, \uc9c0\uac11 \uc794\uc561\uc744 \ud3ec\ud568\ud558\uc138\uc694.",commonIssues:"\uc77c\ubc18\uc801\uc778 \ubb38\uc81c",aiChatNotReply:"AI\ucc44\ud305\uc774 \uc751\ub2f5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4",aiChatNotReplyDesc:"\uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0, \uc9e7\uc740 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uace0, \ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c AI \ucc44\ud305\uc744 \ub2e4\uc2dc \uc5f4\uc5b4\ubcf4\uc138\uc694. \uadf8\ub798\ub3c4 \uc2e4\ud328\ud558\uba74 \uc815\ud655\ud55c \uc624\ub958 \uc2a4\ud06c\ub9b0\uc0f7\uc744 \uc9c0\uc6d0\ud300\uc5d0 \uacf5\uc720\ud558\uc138\uc694.",counselorChatNotOpen:"\uc0c1\ub2f4\uc0ac \ucc44\ud305\uc774 \uc5f4\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4",counselorChatNotOpenDesc:"\uc0c1\ub2f4\uc0ac \uc9c0\uc6d0\uc744 \uc5f4\uace0 \uc774\uc6a9 \uac00\ub2a5\ud55c \uc0c1\ub2f4\uc0ac\ub97c \uc120\ud0dd\ud55c \ud6c4 \uc694\uccad\uc774 \uc218\ub77d\ub420 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \uc0c1\ub2f4\uc0ac \ucc44\ud305 \ud654\uba74\uc5d0 \uae30\uc874 \ucc44\ud305 \ub0b4\uc6a9\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4.",callNotConnecting:"\ud1b5\ud654\uac00 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4",callNotConnectingDesc:"\uc0c1\ub2f4\uc0ac\uac00 \ucc44\ud305/\uc138\uc158\uc744 \uc218\ub77d\ud588\ub294\uc9c0, \ub450 \uc0ac\uc6a9\uc790\uac00 \ubaa8\ub450 \uc628\ub77c\uc778 \uc0c1\ud0dc\uc778\uc9c0, \ub9c8\uc774\ud06c/\uce74\uba54\ub77c \uad8c\ud55c\uc774 \ud5c8\uc6a9\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",walletPaymentIssue:"\uc9c0\uac11 \ub610\ub294 \uacb0\uc81c \ubb38\uc81c",walletPaymentIssueDesc:"Wallet\uc744 \uc5f4\uc5b4 \ucd5c\uc2e0 \uac70\ub798\ub97c \uac80\ud1a0\ud558\uace0 \ubcf4\uace0\uc11c\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud560 \ub54c \ub0a0\uc9dc, \uae08\uc561, \uac70\ub798 \uc0c1\ud0dc\ub97c \uacf5\uc720\ud558\uc138\uc694.",languageWrongTitle:"\uc5b8\uc5b4 \ub610\ub294 \ubc88\uc5ed\uc774 \uc798\ubabb\ub41c \uac83 \uac19\uc2b5\ub2c8\ub2e4.",languageWrongDesc:"\ub300\uc2dc\ubcf4\ub4dc/\uc124\uc815\uc5d0\uc11c \uc5b8\uc5b4 \uc120\ud0dd\uae30\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc77c\ubd80 \uc0c1\ub2f4\uc0ac \u200b\u200b\ub610\ub294 \uc758\ub8cc \uc815\ubcf4\ub294 \uc11c\ube44\uc2a4 \uc81c\uacf5\uc790\uac00 \uc785\ub825\ud55c \uc5b8\uc5b4\ub85c \uc720\uc9c0\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",needMoreHelp:"\ub3c4\uc6c0\uc774 \ub354 \ud544\uc694\ud558\uc2e0\uac00\uc694?",needMoreHelpDesc:"\ud504\ub85c\ud544/\uc124\uc815\uc758 \uacc4\uc815 \uc138\ubd80\uc815\ubcf4\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uac70\ub098 \uc2a4\ud06c\ub9b0\uc0f7, \uc571 \ubc84\uc804, \uc0ac\uc6a9\uc790 \uc774\uba54\uc77c/\uc804\ud654, \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud55c \uc815\ud655\ud55c \uc2dc\uac04\uc744 \ud3ec\ud568\ud55c \uc774\uba54\uc77c \uc9c0\uc6d0\uc744 \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694. \uc778\ub3c4\uc758 \uc704\uae30 \uc9c0\uc6d0\uc744 \ubc1b\uc73c\ub824\uba74 9152987821 \ub610\ub294 \uc9c0\uc5ed \uc751\uae09 \uc11c\ube44\uc2a4\uc5d0 \uc804\ud654\ud558\uc138\uc694.",myProfile:"\ub0b4 \ud504\ub85c\ud544",settings:"\uc124\uc815",emailSupport:"\uc774\uba54\uc77c \uc9c0\uc6d0"},privacyPage:{title:"\uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45",centerTitle:"Humaeli \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc13c\ud130",centerDesc:"\uc774 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc13c\ud130\ub294 Humaeli\uac00 \uc774 \ubaa8\ubc14\uc77c \uc571 \ub0b4\uc5d0\uc11c \uadc0\ud558\uc758 \ud504\ub85c\ud544, \ucc44\ud305, \uc57d\uc18d, \uc9c0\uac11, \ud1b5\ud654, \uc704\uce58 \ubc0f \ubcf4\uc548 \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \uc124\uba85\ud569\ub2c8\ub2e4.",otpProtected:"OTP \ubcf4\ud638\ub428",otpProtectedDesc:"\uc774\uba54\uc77c \ubc0f \uc804\ud654\ubc88\ud638 \ubcc0\uacbd",anonymousCare:"\uc775\uba85 \uc9c4\ub8cc ID",anonCareDesc:"\uc9c0\uc6d0\ub418\ub294 \uacbd\uc6b0 \uc0c1\ub2f4\uc0ac\uc5d0\uac8c \ud45c\uc2dc\ub429\ub2c8\ub2e4.",sensitiveAreas:"\ubbfc\uac10\ud55c \ubd80\uc704",sensitiveAreasDesc:"\ucc44\ud305, \ud1b5\ud654, \uc57d\uc18d, \ud504\ub85c\ud544",dataUsedTitle:"\uc571\uc5d0\uc11c \uc0ac\uc6a9\ub418\ub294 \ub370\uc774\ud130",profileHealth:"\ud504\ub85c\ud544 \ubc0f \uac74\uac15 \uc138\ubd80\uc815\ubcf4",profileHealthDesc:"\uadc0\ud558\uc758 \uc774\ub984, \uc775\uba85 \ud45c\uc2dc \uc774\ub984, \ub098\uc774, \uc131\ubcc4, \uc5f0\ub77d\ucc98 \uc815\ubcf4, \uc0ac\uc9c4/\uc544\ubc14\ud0c0, \uc8fc\uc18c, \ube44\uc0c1 \uc5f0\ub77d\ucc98, \uae30\ubcf8 \uc758\ub8cc \uc815\ubcf4 \ubc0f \ubcf4\ud5d8 \ud544\ub4dc\ub294 \ud658\uc790 \ud504\ub85c\ud544\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",aiConversations:"AI\ucc44\ud305 \ubc0f \uc0c1\ub2f4\uc0ac \ub300\ud654",aiConversationsDesc:"\uba54\uc2dc\uc9c0, \ube60\ub978 \ub2f5\uc7a5, \ucc44\ud305 \uc0c1\ud0dc, \ucca8\ubd80 \ud30c\uc77c, \ud5c8\uc6a9\ub41c \ucc44\ud305 \uc138\uc158 \ubc0f \uc0c1\ub2f4\uc0ac \uc138\ubd80 \uc815\ubcf4\ub294 \ub300\ud654, \uacc4\uc18d \uae30\ub85d \ubc0f \uc9c0\uc6d0 \ub4f1\uae09 \ud504\ub86c\ud504\ud2b8\ub97c \uc81c\uacf5\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",appointments:"\uc57d\uc18d \ubc0f \uc138\uc158",appointmentsDesc:"\uc57d\uc18d \ub0a0\uc9dc, \uc2dc\uac04, \uc0ac\uc720/\uba54\ufffd\ufffd\ufffd, \uc0c1\ud0dc, \ubc30\uc815\ub41c \uc0c1\ub2f4\uc0ac, \ud1b5\ud654 \uba54\ud0c0\ub370\uc774\ud130, \uc138\uc158 \ub0b4\uc5ed\uc740 \uc0ac\uc6a9\uc790\uc640 \uc0c1\ub2f4\uc0ac\uac00 \uce58\ub8cc\ub97c \uad00\ub9ac\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.",wallet:"\uc9c0\uac11\uacfc \uac70\ub798",walletDesc:"\uc9c0\uac11 \uc794\uc561, \ucda9\uc804, \uac70\ub798 \uae30\ub85d, \uc0dd\uc131\ub41c \ubcf4\uace0\uc11c \ubc0f \uad00\ub828 \uc9c0\uc6d0 \uc0c1\ud669\uc774 \uacb0\uc81c \ucd94\uc801\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",location:"\uc704\uce58 \ubc0f \uc7a5\uce58 \ucee8\ud14d\uc2a4\ud2b8",locationDesc:"\uc138\uc158\uc744 \ud655\uc778\ud558\uace0 \uacc4\uc815 \uc548\uc804\uc744 \uc9c0\uc6d0\ud558\uba70 \uc704\uce58 \uc778\uc2dd \uad00\ub9ac \uae30\ub2a5\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uac00\uc785, \ub85c\uadf8\uc778 \ub610\ub294 \uc218\ub3d9 \uc0c8\ub85c \uace0\uce68 \uc2dc \uc704\uce58\ub97c \ucea1\ucc98\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",security:"\ubcf4\uc548 \ubc0f \uacc4\uc815 \uc561\uc138\uc2a4",securityDesc:"\ub85c\uadf8\uc778 \ud1a0\ud070, \uc778\uc99d \uc81c\uacf5\uc790, \ube44\ubc00\ubc88\ud638 \uc0c1\ud0dc, OTP \ud655\uc778, \uc5ed\ud560 \ubc0f \uacc4\uc815 \uc0c1\ud0dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0ac\uc6a9\uc790 \uc601\uc5ed\uacfc \uc0c1\ub2f4\uc0ac \uc601\uc5ed\uc744 \ubd84\ub9ac\ud558\uace0 \ubcf4\ud638\ud569\ub2c8\ub2e4.",whoCanSee:"\ub204\uac00 \ubb34\uc5c7\uc744 \ubcfc \uc218 \uc788\ub098\uc694?",visibleToYou:"\ub098\uc5d0\uac8c \uacf5\uac1c",visibleDesc:"\ub300\uc2dc\ubcf4\ub4dc\uc5d0\ub294 \ud504\ub85c\ud544, AI \ucc44\ud305, \uc0c1\ub2f4\uc0ac\uc640\uc758 \uc0c1\ud638 \uc791\uc6a9, \uc57d\uc18d, \uc9c0\uac11, \ud1b5\ud654 \uae30\ub85d, \ud3c9\uac00 \uba54\uc2dc\uc9c0 \ubc0f \uc704\uce58/\uc5c5\ub370\uc774\ud2b8 \uc81c\uc5b4\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4.",sharedForCare:"\ub3cc\ubd04\uc744 \uc704\ud574 \uacf5\uc720\ub428",sharedDesc:"\uc0c1\ub2f4\uc0ac\ub294 \uc218\ub77d\ub41c \uc138\uc158, \uc57d\uc18d \ubc0f \uc9c0\uc6d0 \ub300\ud654\ub97c \uad00\ub9ac\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc6d0\ub418\ub294 \uacbd\uc6b0 \uc775\uba85 ID\uac00 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",protectedAccess:"\uc561\uc138\uc2a4 \uc81c\uc5b4\ub85c \ubcf4\ud638\ub428",protectedDesc:"\uc0ac\uc6a9\uc790 \ubc0f \uc0c1\ub2f4\uc0ac \uc601\uc5ed\uc740 \uc5ed\ud560, \ud65c\uc131 \uc138\uc158, OTP \ud655\uc778 \ubc0f \uc778\uc99d\ub41c API \uc694\uccad\uc73c\ub85c \uad6c\ubd84\ub429\ub2c8\ub2e4.",checklist:"\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638 \uccb4\ud06c\ub9ac\uc2a4\ud2b8",checklistItem1:"\uadc0\ud558\uc758 \uc2e4\uba85\uc774 \ud45c\uc2dc\ub418\ub294 \uac83\uc744 \uc6d0\ud558\uc9c0 \uc54a\uc744 \uacbd\uc6b0 \uc0c1\ub2f4\uc0ac\uc640 \uc0c1\ud638\uc791\uc6a9\ud560 \ub54c \uc775\uba85\uc758 \uc774\ub984\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624.",checklistItem2:"\ube44\uc0c1 \uc5f0\ub77d\ucc98\uc640 \uc758\ub8cc \ud504\ub85c\ud544 \uc815\ubcf4\ub97c \uc815\ud655\ud558\uac8c \uc785\ub825\ud558\ub824\uba74 \uc815\ud655\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694.",checklistItem3:"\ud1b5\ud654\ud558\uae30 \uc804\uc5d0 \uc704\uce58, \uce74\uba54\ub77c, \ub9c8\uc774\ud06c\uc5d0 \ub300\ud55c \uc7a5\uce58 \uad8c\ud55c\uc744 \uac80\ud1a0\ud558\uc138\uc694.",checklistItem4:"\ub85c\uadf8\uc778 \ud504\ub86c\ud504\ud2b8\ub97c \uac74\ub108\ub6f4 \uacbd\uc6b0 \uc124\uc815/\ud504\ub85c\ud544\uc5d0\uc11c \uc218\ub3d9\uc73c\ub85c \uc704\uce58\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694.",checklistItem5:"\ucc44\ud305 \uba54\uc2dc\uc9c0 \ub0b4\uc5d0\uc11c OTP, \ube44\ubc00\ubc88\ud638 \ub610\ub294 \ubbfc\uac10\ud55c \uacc4\uc815 \uc138\ubd80\uc815\ubcf4\ub97c \uacf5\uc720\ud558\uc9c0 \ub9c8\uc138\uc694.",checklistItem6:"\ub0b4 \ud504\ub85c\ud544 \ubc0f \uc124\uc815\uc744 \uc0a