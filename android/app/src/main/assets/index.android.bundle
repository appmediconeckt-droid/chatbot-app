5\u09a8\u09b2\u09be\u0987\u09a8 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u098f\u0996\u09a8\u0993 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7 \u09a8\u09af\u09bc. \u09aa\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8.",paaukf8:"\u0989\u09aa\u09b2\u09ac\u09cd\u09a7\u09a4\u09be \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf. \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8.",p1767en8:"\u09a1\u09be\u0995\u09cd\u09a4\u09be\u09b0",pz3uvj6:"\u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be",p1dd8d4l:"\u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8",p6kq7jc:"\u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09b9\u09b2\u09c7 \u0986\u09ae\u09be\u0995\u09c7 \u0985\u09ac\u09b9\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8",pa0r5vf:"\u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf",p1h0t9h2:"\u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf-\u09b0\u09c2\u09aa\u09b0\u09c7\u0996\u09be",p42jbpz:"\u09a1\u09be\u0995\u09cd\u09a4\u09be\u09b0\u09b0\u09be",p1av2qiu:"\u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf",poad1ph:"\u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u0995\u09cb\u09a8 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf",pynbw50:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc \u09a8\u09be",p1rc095z:"\u0986\u09b6\u09c7\u09aa\u09be\u09b6\u09c7\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u098f\u09ac\u0982 \u09a1\u09be\u0995\u09cd\u09a4\u09be\u09b0\u09a6\u09c7\u09b0 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u09b0\u09bf\u09ab\u09cd\u09b0\u09c7\u09b6 \u0995\u09b0\u09c1\u09a8\u0964",py13efi:"\u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u09a6\u09be\u09a4\u09be \u09ac\u09cd\u09b0\u09be\u0989\u099c \u0995\u09b0\u09c1\u09a8",p5fo9od:"\u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u09ab\u09c7\u09b0\u09a4 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09c1\u09a8",p1f69fpb:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u0985\u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u09a4\u09b9\u09ac\u09bf\u09b2 \u09aa\u09be\u09a0\u09be\u09a8\u0964 \u0985\u09cd\u09af\u09be\u09a1\u09ae\u09bf\u09a8 \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u098f\u09ac\u0982 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u09b9\u09a4\u09c7 48 \u0998\u09a8\u09cd\u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09ae\u09af\u09bc \u09b2\u09be\u0997\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09f7",p1q7zz6b:"\xb7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7",pol0i1z:"\u09ab\u09c7\u09b0\u09a4\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3",p122pd6u:"\u0989\u09aa\u09b2\u09ac\u09cd\u09a7:",pnfx3og:"\u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3",plsi9q4:"\u09ac\u09bf\u09ac\u09b0\u09a3 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u098f\u0987 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09b