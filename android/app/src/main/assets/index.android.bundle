18\u0947\u0923\u093e\u0930\u093e \u092e\u093e\u0923\u0942\u0938 \u0936\u094b\u0927\u093e",p1n4jnka:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930 \u0915\u0930\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923 \u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947 \u0924\u0947 \u0928\u093f\u0935\u0921\u093e.",p1ligovc:"\u0916\u093e\u091c\u0917\u0940",p17bt1m8:"\u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0942",p1a334hr:"\u0906\u092a\u0932\u0940 \u0928\u093f\u0935\u0921",p11sy06:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e",p1ixdjxz:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0920\u0930\u0935\u093f\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e",p1ns5701:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e...",p1yvu9zk:"\u0905\u0932\u0940\u0915\u0921\u0940\u0932 \u0938\u0902\u092d\u093e\u0937\u0923\u0947",pwchxnm:"\u091a\u0945\u091f \u0939\u091f\u0935\u093e",p8z5j4b:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0939\u0940 \u091a\u0945\u091f \u0939\u091f\u0935\u0942 \u0907\u091a\u094d\u091b\u093f\u0924\u093e?",p22tyg:"\u0939\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0926\u0943\u0936\u094d\u092f\u093e\u0924\u0942\u0928 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u0924\u0947. \u0928\u0935\u0940\u0928 \u0938\u0902\u0926\u0947\u0936 \u0938\u0902\u092d\u093e\u0937\u0923 \u092a\u0941\u0928\u0930\u094d\u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0924\u0940\u0932.",p14ysx9g:"\u0936\u0947\u0935\u091f\u091a\u093e \u0938\u0902\u0926\u0947\u0936",p10xzpwg:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u0947\u091f\u093e\u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u093e",p18q7bjm:"\u0924\u0941\u092e\u091a\u0940 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u0915\u0936\u0940 \u092a\u0939\u093e\u0935\u0940 \u0924\u0947 \u0936\u093f\u0915\u093e",po7e42i:"\u0924\u0941\u092e\u091a\u093e \u0921\u0947\u091f\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u093e",po8rj6t:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u0935\u0930\u0942\u0928 \u0924\u0941\u092e\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e",piaxnod:"\u0916\u093e\u0924\u0947 \u0939\u091f\u0935\u093e",pgdy5y4:"\u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0915\u093e\u092f\u092e\u091a\u0947 \u0915\u0938\u0947 \u0939\u091f\u0935\u093e\u092f\u091a\u0947 \u0924\u0947 \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e",p9t8y0e:"\u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u093e",p1om18ny:"\u0938\u092e\u0938\u094d\u092f\u0947\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e Humaeli \u0938\u092a\u094b\u0930\u094d\u091f\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e",p1ih5m0b:"\u092a\u0930\u0924\u093e\u0935\u093e",pio6wsx:"\u092a\u0930\u0924\u093e\u0935\u093e \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0936\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947 \u0924\u0947 \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e",p1ch3j6g:"\u0936\u0947\u0935\u0930\u0949\u0928-\u092b\u0949\u0930\u0935\u0930\u094d\u0921",p1ik11pv:"\u0939\u0940 \u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924 \u0928\u093e\u0939\u0940. \u0924\u0941\u092e\u091a\u093e \u0938\u0930\u094d\u0935 \u0921\u0947\u091f\u093e \u0915\u093e\u092f\u092e\u091a\u093e \u0939\u091f\u0935\u0932\u093e \u091c\u093e\u0908\u0932.",p2sz7zo:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0942\u091a\u0928\u093e",p6uwjmz:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0942\u091a\u0928\u093e \u0905\u0926\u094d\u092f\u093e\u092a \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940\u0924. \u0915\u0943\u092a\u092f\u093e \u0928\u0902\u0924\u0930 \u092a\u0930\u0924 \u0924\u092a\u093e\u0938\u093e.",paaukf8:"\u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0938\u0942\u091a\u0928\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0932\u094b \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.",p1767en8:"\u0921\u0949\u0915\u094d\u091f\u0930",pz3uvj6:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930",p1dd8d4l:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0942\u091a\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u093e",p6kq7jc:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0938\u0924\u093e\u0928\u093e \u092e\u0932\u093e \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u093e",pa0r5vf:"\u0938\u0942\u091a\u0928\u093e",p1h0t9h2:"\u0938\u0942\u091a\u0928\u093e-\u0930\u0942\u092a\u0930\u0947\u0937\u093e",p42jbpz:"\u0921\u0949\u0915\u094d\u091f\u0930",p1av2qiu:"\u091c\u0935\u0933\u092a\u093e\u0938",poad1ph:"\u091c\u0935\u0933\u092a\u093e\u0938 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0906\u0922\u0933\u0932\u0947 \u0928\u093e\u0939\u0940\u0924",pynbw50:"\u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",p1rc095z:"\u091c\u0935\u0933\u092a\u093e\u0938\u091a\u0947 \u0938\u0932\u094d\u0932\u093e\u0917\u093e