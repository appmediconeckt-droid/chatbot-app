4ijf:"\uc57d\uc18d\uc744 \uc608\uc57d\ud558\ub824\uba74 \ucee8\uc124\ud134\ud2b8 \ud0ed\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc120\ud638\ud558\ub294 \ucee8\uc124\ud134\ud2b8\ub97c \uc120\ud0dd\ud558\uace0 \uc0c1\ub2f4 \uc720\ud615\uc744 \uc120\ud0dd\ud55c \ub2e4\uc74c \ub0a0\uc9dc\uc640 \uc2dc\uac04\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \ubaa8\ub4e0 \uc138\ubd80\uc815\ubcf4\uac00 \ud3ec\ud568\ub41c \ud655\uc778 \uc774\uba54\uc77c\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4.",pvi5gau:"\ucde8\uc18c\ud558\uac70\ub098 \uc77c\uc815\uc744 \ubcc0\uacbd\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?",pfqgfyn:"\uc57d\uc18d \uc139\uc158\uc5d0\uc11c \uc57d\uc18d\uc744 \uad00\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\uc815\uc744 \ubcc0\uacbd\ud558\uac70\ub098 \ucde8\uc18c\ud558\ub824\uba74 \uc608\uc815\ub41c \uc57d\uc18d\uc744 \ud0ed\ud558\uc138\uc694. \uc138\uc158 24\uc2dc\uac04 \uc804\uc5d0 \ucde8\uc18c\ud558\uc2dc\uba74 \ud658\ubd88\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.",p1h9bcwo:"\ub0b4 \uc758\ub8cc \ub370\uc774\ud130\ub294 \uc548\uc804\ud55c\uac00\uc694?",ps9lc26:"\uc608, \uadc0\ud558\uc758 \ubaa8\ub4e0 \uac1c\uc778 \ubc0f \uc758\ub8cc \ub370\uc774\ud130\ub294 \uc885\ub2e8 \uac04 \uc554\ud638\ud654 \ubc0f \uc5c5\uacc4 \ud45c\uc900 \ubcf4\uc548 \ud504\ub85c\ud1a0\ucf5c\ub85c \ubcf4\ud638\ub429\ub2c8\ub2e4. \uadc0\ud558\uc758 \ub370\uc774\ud130\ub294 \uadc0\ud558\uc758 \ub3d9\uc758 \uc5c6\uc774 \uc81c3\uc790\uc640 \uacf5\uc720\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",p1c63b9n:"\ub0b4 \uc9c0\uac11\uc5d0 \uc790\uae08\uc744 \uc5b4\ub5bb\uac8c \ucd94\uac00\ud558\ub098\uc694?",pfulep3:"\uc9c0\uac11 \ud0ed\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec '\uae08\uc561 \ucd94\uac00'\ub97c \ud0ed\ud558\uc138\uc694. \uce74\ub4dc, UPI, \uc740\ud589 \uc1a1\uae08 \ub4f1 \uc6d0\ud558\ub294 \uacb0\uc81c \ubc29\ubc95\uc744 \uc120\ud0dd\ud558\uace0 \ucd94\uac00\ud560 \uae08\uc561\uc744 \uc785\ub825\ud558\uc138\uc694.",pex3sts:"\ub3c4\uc6c0\ub9d0 \ubc0f \uc9c0\uc6d0",p1of