u0645\u06cc\u0644 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f",p1ncbamm:"HUMAELI - \u0633\u0644\u0627\u0645\u062a \u0631\u0648\u0627\u0646\u06cc \u0634\u0645\u0627",p1mkbgjw:"\u0627\u0646\u0633\u0627\u0646 \u062a\u0648\u0627\u0646\u0645\u0646\u062f",p67t5ik:"\u062d\u0645\u0627\u06cc\u062a \u0627\u0632 \u0633\u0644\u0627\u0645\u062a \u0631\u0648\u0627\u0646",p15kdwif:"\u062f\u0631 \u0632\u0645\u0627\u0646 \u0633\u062e\u062a \u0633\u0644\u0627\u0645\u062a \u0631\u0648\u0627\u0646 \u062e\u0648\u062f \u0628\u0627 \u0645\u0634\u0627\u0648\u0631\u0627\u0646\u060c \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u0627\u0646\u060c \u067e\u0632\u0634\u06a9\u0627\u0646 \u0633\u0644\u0627\u0645\u062a \u0631\u0648\u0627\u0646 \u0648 \u0631\u0648\u0627\u0646\u067e\u0632\u0634\u06a9\u0627\u0646 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0631\u0642\u0631\u0627\u0631 \u06a9\u0646\u06cc\u062f.",puqjq8w:"\u0634\u0645\u0627 \u0631\u0627 \u0628\u0627 \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9 \u0647\u0645\u0627\u0647\u0646\u06af \u06a9\u0646\u06cc\u062f",pglw0op:"\u062d\u0633\u0627\u0628 \u062e\u0648\u062f \u0631\u0627 \u0627\u06cc\u0645\u0646 \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f",pdkk7ab:"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0636\u0637\u0631\u0627\u0631\u06cc",p6s9e29:"\u0628\u0647 \u0628\u06cc\u0645\u0627\u0631\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9 \u06a9\u0645\u06a9 \u06a9\u0646\u06cc\u062f \u0634\u0645\u0627 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u0646\u062f",p1kc2xvx:"\u0645\u06a9\u0627\u0646 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0645\u0633\u062f\u0648\u062f \u0634\u062f. \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u2192 \u0645\u06a9\u0627\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f\u060c \u0633\u067e\u0633 \u0628\u0631\u06af\u0631\u062f\u06cc\u062f.",pj1z8my:"\u0628\u062f\u0648\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc\u060c \u0628\u06cc\u0645\u0627\u0631\u0627\u0646 \u0627\u0637\u0631\u0627\u0641 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0646\u0645\u0627\u06cc\u0647 \u0634\u0645\u0627 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u0646\u06a9\u0646\u0646\u062f \u0648 \u0627\u0645\u0646\u06cc\u062a \u062d\u0633\u0627\u0628 \u0645\u0628\u062a\u0646\u06cc \u0628\u0631 \u0645\u06a9\u0627\u0646 \u0645\u062d\u062f\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0644\u0637\u0641\u0627 \u0627\u062c\u0627\u0632\u0647 \u0628\u062f\u0647\u06cc\u062f.",pe2sfkx:"\u0645\u06a9\u0627\u0646 \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u0633\u062f\u0648\u062f \u0627\u0633\u062a. \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u0646\u0645\u0627\u06cc\u0627\u0646 \u0628\u0648\u062f\u0646 \u0646\u0645\u0627\u06cc\u0647 \u0645\u062d\u0644\u06cc \u0648 \u0627\u0645\u0646\u06cc\u062a \u0645\u0628\u062a\u0646\u06cc \u0628\u0631 \u0645\u06a9\u0627\u0646 \u0628\u0647 \u062f\u0631\u0633\u062a\u06cc \u06a9\u0627\u0631 \u0646\u0645\u06cc \u06a9\u0646\u0646\u062f.",p1bc8b0q:"\u0628\u062f\u0648\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc\u060c \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9\u060c \u0647\u0634\u062f\u0627\u0631\u0647\u0627\u06cc \u0627\u0645\u0646\u06cc\u062a\u06cc \u062d\u0633\u0627\u0628\u060c \u0648 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0636\u0637\u0631\u0627\u0631\u06cc \u0631\u0627 \u0627\u0632 \u062f\u0633\u062a \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u062f. \u0644\u0637\u0641\u0627 \u0627\u062c\u0627\u0632\u0647 \u0628\u062f\u0647\u06cc\u062f.",p1kxnr6x:"\u0645\u06a9\u0627\u0646 \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u0633\u062f\u0648\u062f \u0627\u0633\u062a. \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9 \u0648 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0636\u0637\u0631\u0627\u0631\u06cc \u0628\u0647 \u062f\u0631\u0633\u062a\u06cc \u06a9\u0627\u0631 \u0646\u0645\u06cc \u06a9\u0646\u0646\u062f.",p1qfkxpw:"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f",p19izdw2:"\u062f\u0631 \u062d\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u2026",pudz60s:"\u062f\u0631 \u062d\u0627\u0644 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06a9\u0627\u0646\u2026",p1nyz8sj:"\ud83d\udd04 \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f",p129dr11:"\ud83d\udccd \u0627\u062c\u0627\u0632\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc",p13kffw5:"\u0628\u062f\u0648\u0646 \u0645\u06a9\u0627\u0646 \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u06cc\u062f",pr2p72l:"\u0645\u06a9\u0627\u0646 \u062a\u0648\u0635\u06cc\u0647 \u0645\u06cc \u0634\u0648\u062f",pi9375l:"\u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f",p1xmhdqy:"\u0628\u0631\u062e\u06cc \u0627\u0632 \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627 \u0628\u062f\u0648\u0646 \u0645\u06a9\u0627\u0646 \u06a9\u0627\u0631 \u0646\u0645\u06cc \u06a9\u0646\u0646\u062f. \u0645\u0627 \u0642\u0648\u06cc\u0627\u064b \u062a\u0648\u0635\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0622\u0646 \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.",p1ismk4q:"\u0628\u0631\u0627\u06cc \u0628\u0647\u062a\u0631\u06cc\u0646 \u062a\u062c\u0631\u0628\u0647\u060c \u0627\u062c\u0627\u0632\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0631\u0627 \u0628\u062f\u0647\u06cc\u062f. \u0627\u06cc\u0646 \u0628\u0647 \u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc \u06a9\u0646\u062f \u062a\u0627 \u0628\u0647\u062a\u0631 \u0628\u0647 \u0634\u0645\u0627 \u062e\u062f\u0645\u062a \u06a9\u0646\u06cc\u0645 \u0648 \u0634\u0645\u0627 \u0631\u0627 \u0627\u06cc\u0645\u0646 \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u0645.",p1rsaitz:"\u0686\u0631\u0627 \u0645\u0627 \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0634\u0645\u0627 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u06cc\u0645",p1lwhuaj:"\ud83d\udd10 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0634\u0645\u0627 \u0641\u0642\u0637 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0627\u0632 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f. \u0647\u0631\u06af\u0632 \u0641\u0631\u0648\u062e\u062a\u0647 \u0646\u0645\u06cc \u0634\u0648\u062f \u0648 \u0628\u0627 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06af\u0630\u0627\u0634\u062a\u0647 \u0646\u0645\u06cc \u0634\u0648\u062f.",pi5yj9e:"\u0646\u0627\u062f\u06cc\u062f\u0647 \u06af\u0631\u0641\u062a\u0646 \u062a\u062c\u0631\u0628\u0647 \u0634\u0645\u0627 \u0631\u0627 \u0645\u062d\u062f\u0648\u062f \u0645\u06cc \u06a9\u0646\u062f. \u0647\u0631 \u0632\u0645\u0627\u0646 \u062e\u0648\u0627\u0633\u062a\u06cc\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0631\u0627 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.",p1h299pn:"\u0628\u0631\u0627\u06cc \u0627\u062f\u0627\u0645\u0647 \u0648\u0627\u0631\u062f \u0634\u0648\u06cc\u062f",punxvbe:"\u0645\u0631\u0627 \u0628\u0647 \u062e\u0627\u0637\u0631 \u0628\u0633\u067e\u0627\u0631",p1djn4vs:"mail-open-outline",p9joi0e:"\u062a\u0644\u0641\u0646-\u067e\u0631\u062a\u0631\u0647-\u0637\u0631\u062d \u06a9\u0644\u06cc",pcm1nee:"\u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0634\u0645\u0627 \u0647\u0633\u062a\u06cc\u062f",p39qlxn:"\u062a\u0636\u0627\u062f \u062c\u0644\u0633\u0647 \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0634\u062f",p1nl6f5:"\u0645\u0627 \u06cc\u06a9 \u06a9\u062f 6 \u0631\u0642\u0645\u06cc \u0628\u0647 \u0627\u06cc\u0645\u06cc\u0644 \u062b\u0628\u062a \u0634\u062f\u0647 \u0634\u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u06a9\u0631\u062f\u06cc\u0645. \u0628\u0631\u0627\u06cc \u062e\u0631\u0648\u062c \u0627\u0632 \u0633\u06cc\u0633\u062a\u0645 \u062f\u0633\u062a\u06af\u0627\u0647 \u0647\u0627\u06cc \u062f\u06cc\u06af\u0631 \u062e\u0648\u062f\u060c \u0622\u0646 \u0631\u0627 \u062f\u0631 \u0632\u06cc\u0631 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f \u0648 \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u06cc\u062f.",p8ykf5k:"\u0634\u0645\u0627 \u0642\u0628\u0644\u0627\u064b \u062f\u0631 \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631\u06cc \u0648\u0627\u0631\u062f \u0633\u06cc\u0633\u062a\u0645 \u0634\u062f\u0647 \u0627\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0627\u062f\u0627\u0645\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0645\u0648\u0631\u062f\u060c \u0627\u0632 \u0622\u0646 \u062e\u0627\u0631\u062c \u0634\u0648\u06cc\u062f.",p18vcp24:"\u0627\u0631\u0633\u0627\u0644 OTP...",p1ntvp8x:"\u0627\u0632 \u062f\u0633\u062a\u06af\u0627\u0647 \u0647\u0627\u06cc \u062f\u06cc\u06af\u0631 \u062e\u0627\u0631\u062c \u0634\u0648\u06cc\u062f \u0648 OTP \u0627\u0631\u0633\u0627\u0644 \u06a9\u0646\u06cc\u062f",pn5i6fn:"OTP 6 \u0631\u0642\u0645\u06cc \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f",p12n3zp8:"\u062f\u0631 \u062d\u0627\u0644 \u062a\u0623\u06cc\u06cc\u062f...",pohmzat:"\u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc \u0631\u0645\u0632 \u0639\u0628\u0648\u0631...",p1e6s4y0:"\u0628\u0627 \u0627\u06cc\u0645\u06cc\u0644 \u0648\u0627\u0631\u062f \u0634\u0648\u06cc\u062f",p1aafagh:"\u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f \u0631\u0627 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f",pasmu26:"\u0646\u062d\u0648\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 Humaeli \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f",pqh0i9l:"\u067e\u0648\u0631\u062a\u0627\u0644 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f",pyjrj1w:"\u06a9\u0627\u0631\u0628\u0631",p1rlv5t:"\u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f",p19cu11q:"\u062a\u0645\u0631\u06cc\u0646 \u062e\u0648\u062f \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0646\u06cc\u062f",pbe3qyw:"\u0645\u0631\u0627\u0642\u0628\u062a \u062d\u0631\u0641\u0647 \u0627\u06cc \u0627\u0631\u0627\u0626\u0647 \u062f\u0647\u06cc\u062f",p1d9tqw:"\u0627\u0646\u062a\u0647\u0627 \u0628\u0647 \u0627\u0646\u062a\u0647\u0627 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0634\u062f\u0647 \u0627\u0633\u062a",p1696fig:"\u0641\u0636\u0627\u06cc \u0627\u0645\u0646 \u0634\u0645\u0627 \u0628\u0631\u0627\u06cc \u0635\u062d\u0628\u062a",p14mamw2:"\u0628\u0627 \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0645\u0648\u0631\u062f \u0627\u0639\u062a\u0645\u0627\u062f \u062f\u0631 \u06cc\u06a9 \u0645\u062d\u06cc\u0637 \u062e\u0635\u0648\u0635\u06cc \u0648 \u0627\u0645\u0646 \u06a9\u0647 \u0628\u0631\u0627\u06cc \u062d\u0645\u0627\u06cc\u062a \u0627\u0632 \u0631\u0641\u0627\u0647 \u0630\u0647\u0646\u06cc \u0634\u0645\u0627 \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0631\u0642\u0631\u0627\u0631 \u06a9\u0646\u06cc\u062f.",p16mi6u6:"\u0645\u0634\u0627\u0648\u0631 \u0645\u0646\u0627\u0633\u0628 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u0