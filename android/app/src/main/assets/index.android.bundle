0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639. \u0623\u0631\u062c\u0648 \u0623\u0646 \u062a\u0633\u0645\u062d\u0648\u0627 \u0628\u0630\u0644\u0643.",pe2sfkx:"\u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0645\u062d\u0638\u0648\u0631\u0627. \u0644\u0646 \u062a\u0639\u0645\u0644 \u0645\u064a\u0632\u0627\u062a \u0645\u062b\u0644 \u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u062d\u0644\u064a \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d.",p1bc8b0q:"\u0628\u062f\u0648\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639\u060c \u0633\u062a\u0641\u062a\u0642\u062f \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u0627\u0644\u0642\u0631\u064a\u0628\u064a\u0646 \u0648\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0623\u0645\u0627\u0646 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0627\u0644\u062f\u0639\u0645 \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626. \u0623\u0631\u062c\u0648 \u0623\u0646 \u062a\u0633\u0645\u062d\u0648\u0627 \u0628\u0630\u0644\u0643.",p1kxnr6x:"\u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0645\u062d\u0638\u0648\u0631\u0627. \u0644\u0646 \u062a\u0639\u0645\u0644 \u0645\u064a\u0632\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u0627\u0644\u0642\u0631\u064a\u0628\u064a\u0646 \u0648\u062f\u0639\u0645 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d.",p1qfkxpw:"\u0627\u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",p19izdw2:"\u062c\u0627\u0631\u064d \u0627\u0644\u0637\u0644\u0628\u2026",pudz60s:"\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639\u2026",p1nyz8sj:"\ud83d\udd04 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649",p129dr11:"\ud83d\udccd \u0627\u0644\u0633\u0645\u0627\u062d \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639",p13kffw5:"\u062a\u0648\u0627\u0635\u0644 \u062f\u0648\u0646 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u0648\u0642\u0639",pr2p72l:"\u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0648\u0635\u0649 \u0628\u0647",pi9375l:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0648\u0642\u0639",p1xmhdqy:"\u0644\u0646 \u062a\u0639\u0645\u0644 \u0628\u0639\u0636 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0628\u062f\u0648\u0646 \u0627\u0644\u0645\u0648\u0642\u0639. \u0648\u0646\u062d\u0646 \u0646\u0648\u0635\u064a \u0628\u0634\u062f\u0629 \u0628\u062a\u0645\u0643\u064a\u0646\u0647.",p1ismk4q:"\u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u0641\u0636\u0644 \u062a\u062c\u0631\u0628\u0629\u060c \u0627\u0633\u0645\u062d \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639. \u064a\u0633\u0627\u0639\u062f\u0646\u0627 \u0639\u0644\u0649 \u062e\u062f\u0645\u062a\u0643 \u0628\u0634\u0643\u0644 \u0623\u0641\u0636\u0644 \u0648\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u0644\u0627\u0645\u062a\u0643.",p1rsaitz:"\u0644\u0645\u0627\u0630\u0627 \u0646\u062d\u062a\u0627\u062c \u0645\u0648\u0642\u0639\u0643",p1lwhuaj:"\ud83d\udd10 \u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0648\u0642\u0639\u0643 \u0641\u0642\u0637 \u0623\u062b\u0646\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642. \u0648\u0644\u0627 \u064a\u062a\u0645 \u0628\u064a\u0639\u0647\u0627 \u0623\u0648 \u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0645\u0639 \u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629 \u0623\u0628\u062f\u064b\u0627.",pi5yj9e:"\u0627\u0644\u062a\u062e\u0637\u064a \u0633\u0648\u0641 \u064a\u062d\u062f \u0645\u0646 \u062a\u062c\u0631\u0628\u062a\u0643. \u064a\u0645\u0643\u0646\u0643 \u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0648\u0642\u0639 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a.",p1h299pn:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629",punxvbe:"\u062a\u0630\u0643\u0631\u0646\u064a",p1djn4vs:"\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0645\u062e\u0637\u0637 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a",p9joi0e:"\u0627\u0644\u0647\u0627\u062a\u0641 \u0635\u0648\u0631\u0629 \u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u0639\u0631\u064a\u0636\u0629",pcm1nee:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0647\u0648\u064a\u062a\u0643",p39qlxn:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u062a\u0639\u0627\u0631\u0636 \u0641\u064a \u0627\u0644\u062c\u0644\u0633\u0629",p1nl6f5:"\u0644\u0642\u062f \u0623\u0631\u0633\u0644\u0646\u0627 \u0631\u0645\u0632\u064b\u0627 \u0645\u0643\u0648\u0646\u064b\u0627 \u0645\u0646 6 \u0623\u0631\u0642\u0627\u0645 \u0625\u0644\u0649 \u0628\u0631\u064a\u062f\u0643 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0627\u0644\u0645\u0633\u062c\u0644. \u0623\u062f\u062e\u0644\u0647 \u0623\u062f\u0646\u0627\u0647 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0623\u062c\u0647\u0632\u062a\u0643 \u0627\u0644\u0623\u062e\u0631\u0649 \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629.",p8ykf5k:"\u0644\u0642\u062f \u0642\u0645\u062a \u0628\u0627\u0644\u0641\u0639\u0644 \u0628\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0639\u0644\u0649 \u062c\u0647\u0627\u0632 \u0622\u062e\u0631. \u0642\u0645 \u0628\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c \u0644\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0647\u0630\u0627.",p18vcp24:"\u0625\u0631\u0633\u0627\u0644 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629...",p1ntvp8x:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0648\u0625\u0631\u0633\u0627\u0644 OTP",pn5i6fn:"\u0623\u062f\u062e\u0644 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 (OTP) \u0645\u0643\u0648\u0646\u0629 \u0645\u0646 6 \u0623\u0631\u0642\u0627\u0645",p12n3zp8:"\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642...",pohmzat:"\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631...",p1e6s4y0:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a",p1aafagh:"\u0642\u0645 \u0628\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628\u0643",pasmu26:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0628\u0647\u0627 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 Humaeli",pqh0i9l:"\u062d\u062f\u062f \u0627\u0644\u0628\u0648\u0627\u0628\u0629",pyjrj1w:"\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645",p1rlv5t:"\u0627\u0628\u062d\u062b \u0639\u0646 \u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u0645\u0648\u062b\u0648\u0642\u064a\u0646",p19cu11q:"\u0625\u062f\u0627\u0631\u0629 \u0645\u0645\u0627\u0631\u0633\u062a\u0643",pbe3qyw:"\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0645\u0647\u0646\u064a\u0629",p1d9tqw:"\u0645\u0634\u0641\u0631\u0629 \u0645\u0646 \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u0646\u0647\u0627\u064a\u0629",p1696fig:"\u0645\u0633\u0627\u062d\u062a\u0643 \u0627\u0644\u0622\u0645\u0646\u0629 \u0644\u0644\u062a\u062d\u062f\u062b",p14mamw2:"\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646 \u0645\u0648\u062b\u0648\u0642\u064a\u0646 \u0641\u064a \u0628\u064a\u0626\u0629 \u062e\u0627\u0635\u0629 \u0648\u0622\u0645\u0646\u0629 \u0645\u0635\u0645\u0645\u0629 \u0644\u062f\u0639\u0645 \u0635\u062d\u062a\u0643 \u0627\u0644\u0639\u0642\u0644\u064a\u0629.",p16mi6u6:"\u0627\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0645\u0646\u0627\u0633\u0628",pcyp7gf:"\u062a\u0635\u0641\u062d \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a\u064a\u0646 \u0630\u0648\u064a \u0627\u0644\u062e\u0628\u0631\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u062a\u062e\u0635\u0635 \u0648\u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u062a\u0648\u0641\u0631 \u0648\u0646\u0648\u0639 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0648\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a.",p1j7paqb:"\u0631\u0641\u064a\u0642\u0643 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0639\u0627\u0641\u064a\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a",p235k91:"\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u062f\u0639\u0645 \u0639\u0627\u0637\u0641\u064a \u0641\u0648\u0631\u064a \u0648\u0646\u0635\u0627\u0626\u062d \u0635\u062d\u064a\u0629 \u0648\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0642\u0628\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0623\u062d\u062f \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631\u064a\u0646.",p12cl72e:"\u0645\u0631\u062d\u0628\u0627 \ud83d\udc4b \u0643\u064a\u0641 \u062a\u0634\u0639\u0631 \u0627\u0644\u064a\u0648\u0645\u061f",pz0a21k:"\u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u062f