0637\u0628\u064a \u0625\u0630\u0627 \u0627\u062e\u062a\u0631\u062a \u0645\u0644\u0626\u0647\u0627.",checklistItem3:"\u0642\u0645 \u0628\u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u062c\u0647\u0627\u0632 \u0641\u064a\u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0648\u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0642\u0628\u0644 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a.",checklistItem4:"\u0642\u0645 \u0628\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0648\u0642\u0639 \u064a\u062f\u0648\u064a\u064b\u0627 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a/\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0625\u0630\u0627 \u062a\u0645 \u062a\u062e\u0637\u064a \u0645\u0637\u0627\u0644\u0628\u0629 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644.",checklistItem5:"\u0644\u0627 \u062a\u0634\u0627\u0631\u0643 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 (OTP) \u0623\u0648 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0623\u0648 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u062d\u0633\u0627\u0633\u0629 \u062f\u0627\u062e\u0644 \u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u062f\u0631\u062f\u0634\u0629.",checklistItem6:"\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u0644\u0641\u064a \u0627\u0644\u0634\u062e\u0635\u064a \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u062a\u062d\u062f\u064a\u062b \u0623\u0648 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062e\u0632\u0646\u0629 \u0641\u064a \u062d\u0633\u0627\u0628\u0643.",manageData:"\u0625\u062f\u0627\u0631\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",securitySettings:"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0646",aiQuickReplyLow:"\u0645\u0646\u062e\u0641\u0636",aiQuickReplyOkay:"\u062d\u0633\u0646\u0627",aiQuickReplyGood:"\u062c\u064a\u062f",aiQuickReplyGreat:"\u0639\u0638\u064a\u0645",aiPhotoAttached:"\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u0641\u0642\u0629",aiTryAgain:"\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649",aiVoiceHint:"\u062a\u062d\u062f\u062b \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0645\u0633\u062a\u0639\u062f\u064b\u0627 - \u0633\u0623\u0631\u062f \u0639\u0644\u064a\u0643 \u0628\u0645\u062c\u0631\u062f \u0627\u0644\u062a\u0648\u0642\u0641.",resetChatTitle:"\u0628\u062f\u0621 \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629\u061f",resetChatMessage:"\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0645\u0633\u062d \u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0628\u062f\u0621 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0628\u062e\u064a\u0627\u0631\u0627\u062a \u0645\u0632\u0627\u062c \u0627\u0644\u062a\u0631\u062d\u064a\u0628.",startFresh:"\u0627\u0628\u062f\u0623 \u0637\u0627\u0632\u062c\u064b\u0627",startingFresh:"\u062c\u0627\u0631\u064d \u0627\u0644\u0628\u062f\u0621..."},phrases:{p1le0g3x:"\u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641",p3rvtpe:"\u0627\u0644\u064a\u0648\u0645",poh8cad:"\u0623\u0645\u0633",p1mrhzr7:"\u0648\u0627\u0631\u062f",pfebfdv:"\u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0648\u0644\u0627\u064a\u062a\u0647",p17k42kg:"\u063a\u0627\u0628",pvw9wg8:"\u0645\u0643\u062a\u0645\u0644",p15m090m:"\u0641\u0634\u0644",p1q8utwa:"\u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631",pcqxqrc:"\u062f\u0642\u0627\u0626\u0642",p15oehty:"\u062b\u0648\u0627\u0646\u064a",p17tqvf1:"\u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u062d\u064a\u0629",pos6ydf:"\u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0645\u0639 \u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u0644\u062f\u064a\u0646\u0627",p1jk4gbo:"\u0639\u0627\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062a\u0631\u0646\u062a \u062f\u0627\u062e\u0644",pztgw94:"\u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u062f\u0639\u0645",pig8opb:"\u0627\u0644\u062a\u062d\u062f\u062b \u0645\u0628\u0627\u0634\u0631\u0629",pla6vae:"\u062f\u0639\u0645 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a",p12y1fw5:"\u0623\u0631\u0633\u0644 \u0623\u0633\u0626\u0644\u062a\u0643",pi7el9x:"\u062e\u0644\u0627\u0644 24 \u0633\u0627\u0639\u0629",peza8d7:"\u0647\u0648\u0645\u064a\u0644\u064a\u0648",p1k70v3b:"\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u062c\u0627\u0628\u0627\u062a \u0641\u0648\u0631\u064a\u0629",pi7p4si:"\u0645\u062a\u0627\u062d 24/7",ptmpaw1:"\u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u064a \u062d\u062c\u0632 \u0645\u0648\u0639\u062f\u061f",pq44ijf:"\u0644\u062d\u062c\u0632 \u0645\u0648\u0639\u062f\u060c \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u0628\u0648\u064a\u0628 \"\u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0648\u0646\"\u060c \u062b\u0645 \u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0645\u0641\u0636\u0644 \u0644\u062f\u064a\u0643\u060c \u0648\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629\u060c \u062b\u0645 \u0627\u062e\u062a\u0631 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0627\u0644\u0648\u0642\u062a. \u0633\u062a\u062a\u0644\u0642\u0649 \u0631\u0633\u0627\u0644\u0629 \u062a\u0623\u0643\u064a\u062f \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0643\u0627\u0641\u0629 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644.",pvi5gau:"\u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0623\u0648 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062c\u062f\u0648\u0644\u0629\u061f",pfqgfyn:"\u064a\u0645\u0643\u0646\u0643 \u0625\u062f\u0627\u0631\u0629 \u0645\u0648\u0627\u0639\u064a\u062f\u0643 \u0645\u0646 \u0642\u0633\u0645 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a \u0645\u0648\u0639\u062f \u0642\u0627\u062f\u0645 \u0644\u0625\u0639\u0627\u062f\u0629 \u062c\u062f\u0648\u0644\u062a\u0647 \u0623\u0648 \u0625\u0644\u063a\u0627\u0626\u0647. \u0627\u0644\u0625\u0644\u063a\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0645 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u062c\u0644\u0633\u0629 \u0645\u0624\u0647\u0644\u0629 \u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644.",p1h9bcwo:"\u0647\u0644 \u0628\u064a\u0627\u0646\u0627\u062a\u064a \u0627\u0644\u0637\u0628\u064a\u0629 \u0622\u0645\u0646\u0629\u061f",ps9lc26:"\u0646\u0639\u0645\u060c \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0627\u0644\u0637\u0628\u064a\u0629 \u0645\u062d\u0645\u064a\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0634\u0627\u0645\u0644 \u0648\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0635\u0646\u0627\u0639\u0629. \u0644\u0627 \u062a\u062a\u0645 \u0645\u0634\u0627\u0631\u0643\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0623\u0628\u062f\u064b\u0627 \u0645\u0639 \u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629 \u062f\u0648\u0646 \u0645\u0648\u0627\u0641\u0642\u062a\u0643.",p1c63b9n:"\u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u064a \u0625\u0636\u0627\u0641\u0629 \u0623\u0645\u0648\u0627\u0644 \u0625\u0644\u0649 \u0645\u062d\u0641\u0638\u062a\u064a\u061f",pfulep3:"\u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u0628\u0648\u064a\u0628 \"\u0627\u0644\u0645\u062d\u0641\u0638\u0629\" \u0648\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \"\u0625\u0636\u0627\u0641\u0629 \u0623\u0645\u0648\u0627\u0644\". \u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0644\u062f\u064a\u0643 \u2014 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\u060c \u0623\u0648 UPI\u060c \u0623\u0648 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0645\u0635\u0631\u0641\u064a \u2014 \u0648\u0623\u062f\u062e\u0644 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0630\u064a \u062a\u0631\u064a\u062f \u0625\u0636\u0627\u0641\u062a\u0647.",pex3sts:"\u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u0627\u0644\u062f\u0639\u0645",p1ofqfdp:"\u0623\u0633\u0626\u0644\u0629 \u0634\u0639\u0628\u064a\u0629",p1m6uxly:"\u0634\u064a\u0641\u0631\u0648\u0646 \u0645\u062a\u0627\u0628\u0639\u0629",p9wx6ep:"\u0634\u064a\u0641\u0631\u0648\u0646 \u0644\u0623\u0633\u0641\u0644",pmkl5g0:"\u0647\u0644 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u0648\u0631\u064a\u0629\u061f",p1ucr8ie:"\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0639\u0627\u0646\u064a \u0645\u0646 \u062d\u0627\u0644\u0629 \u0637\u0628\u064a\u0629 \u0637\u0627\u0631\u0626\u0629\u060c \u0641\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631.",p1k15svg:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626",p1il8i8d:"\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0623\u0632\u0645\u0627\u062a",pgcsuld:"\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0645\u0634\u0643\u0644\u0629",p1x9xuzh:"\u0647\u0644 \u0648\u0627\u062c\u0647\u062a \u062e\u0637\u0623 \u0623\u0648 \u0645\u0634\u0643\u0644\u0629 \u0641\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061f",p18t3p8y:"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0634\u0643\u0644\u0629",p11jo8ku:"Humaeli \u0627\u0644\u0625\u0635\u062f\u0627\u0631",prnsj34:"\u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b:",p8lq2oq:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0648\u062c\u0648\u062f \u062a\u062d\u062f\u064a\u062b\u0627\u062a",pg6nyxd:"\u0627\u0644\u062a\u0634\u0641\u064a\u0631 \u0645\u0646 \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u0646\u0647\u0627\u064a\u0629",pm4qf9j:"\u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u0645\u0646 \u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a (GDPR).",p13tbyt3:"\u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0647\u0648\u0644\u0629",p1474pj6:"\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0622\u0645\u0646\u0629",p12ddn6e:"\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",p178beh:"\u0627\u0644\u0627\u0633\u0645 \u0648\u0627\u0644\u0639\u0645\u0631 \u0648\u0627\u0644\u062c\u0646\u0633",p1el3mqv:"\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",p1uqyawh:"\u0627\u0644\u062a\u0641\u0636\u064a\u0644\u0627\u062a \u0627\u0644\u0635\u062d\u064a\u0629",p1j5drmg:"\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u0637\u0627\u0628\u0639 \u0627\u0644\u0634\u062e\u0635\u064a \u0639\u0644\u0649 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643",p1hshih:"\u0646\u0637\u0627\u0628\u0642\u0643 \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0645\u0646\u0627\u0633\u0628",p4lwpxb:"\u0627\u0644\u062f\u0631\u062f\u0634\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a",p16o5duv:"\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0648\u0627\u0644\u0631\u062f\u0648\u062f \u0627\u0644\u0633\u0631\u064a\u0639\u0629",pjualou:"\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0648\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a",p8fcohj:"\u062c\u0644\u0633\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0642\u0628\u0648\u0644\u0629",pqugyus:"\u062a\u0648\u0641\u064a\u0631 \u0633\u062c\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u0645\u0633\u062a\u0645\u0631",pxw259e:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a \u062e\u0644\u0627\u0644 \u0627\u0644\u062c\u0644\u0633\u0627\u062a",ppapyhl:"\u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f",ppjebc6:"\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u062d\u062c\u0632",prz84q3:"\u0645\u0633\u062a\u0634\u0627\u0631 \u0645\u062e\u062a\u0627\u0631",p6bzi8o:"\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062c\u0644\u0633\u0629",pfby3q4:"\u0625\u062f\u0627\u0631\u0629 \u062c\u0644\u0633\u0627\u062a\u0643 \u0627\u0644\u0642\u0627\u062f\u0645\u0629",p1px010k:"\u0625\u0631\u0633\u0627\u0644 \u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628",pl6oj3n:"\u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0648\u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a",pcisb5n:"\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0634\u062d\u0646 \u0648\u0633\u062c\u0644 \u0627\u0644\u062f\u0641\u0639",p11x8ws5:"\u0633\u062c\u0644\u0627\u062a \u0627\u0633\u062a\u0631\u062f\u0627\u062f",p1jezb8u:"\u0625\u064a\u0635\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a",p1kxmxol:"\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0628\u0634\u0643\u0644 \u0622\u0645\u0646",p1soeejn:"\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u062f\u0642\u064a\u0642",p3fb3fk:"\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643",paxx0ja:"\u0627\u0637\u0644\u0628 \u0646\u0633\u062e\u0629 \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062d\u0645\u0644\u0647\u0627 Humaeli \u0639\u0646\u0643.",py8xd5m:"\u0642\u0645 \u0628\u062a\u0635\u062d\u064a\u062d \u0628\u064a\u0627\u0646\u0627\u062a\u0643",pg1ugci:"\u0642\u0645 \u0628\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062e\u0627\u0637\u0626\u0629 \u0623\u0648 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0645\u0646 \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062e\u0635\u064a \u0641\u064a \u0623\u064a \u0648\u0642\u062a.",p13743po:"\u0627\u062d\u0630\u0641 \u062d\u0633\u0627\u0628\u0643",p12l9hlj:"\u0637\u0644\u0628 \u0645\u0633\u062d \u062d\u0633\u0627\u0628\u0643 \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647.",pqqlbs9:"\u0633\u062d\u0628 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629",p7r950p:"\u0623\u0648\u0642\u0641 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629 \u062f\u0648\u0646 \u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629.",ph7kh1q:"\u0631\u0641\u0639 \u0627\u0644\u062a\u0638\u0644\u0645",pikxi8f:"\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",pr4om3a:"\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644",pwprq2e:"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0646",p16wv544:"\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0648\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 (OTP).",pot76bn:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629",p10c9lnf:"\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0643\u064a\u0641\u064a\u0629 \u0642\u064a\u0627\u0645 Humaeli \u0628\u062c\u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0648\u062d\u0645\u0627\u064a\u062a\u0647\u0627",pbsv2pb:"\u0645\u062d\u0645\u064a",p1x5pqp5:"\u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0622\u0645\u0646\u0629",p1bi06rx:"\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0633\u0631\u064a\u0639\u0629",p58qcud:"#FEECEC",p6ymdgj:"\u062c\u0645\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",p1cl13bd:"\u0645\u0627 \u064a\u062c\u0645\u0639\u0647 Humaeli:",pa093vl:"\u0627\u0644\u063a\u0631\u0636:",pkl1056:"\u064a\u062a\u0645 \u062a\u0634\u0641\u064a\u0631 \u0643\u0627\u0641\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u0627\u062a \u0645\u0646 \u0637\u0631\u0641 \u0625\u0644\u0649 \u0637\u0631\u0641 \u0648\u062a\u062e\u0632\u064a\u0646\u0647\u0627 \u0628\u0634\u0643\u0644 \u0622\u0645\u0646.",pcko3gn:"\u062d\u0642\u0648\u0642\u0643",p1e6yfzx:"\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",pehh8qp:"\u0627