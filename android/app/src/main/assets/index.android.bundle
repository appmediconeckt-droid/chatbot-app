ected:"Feil",counselorNotSelectedMessage:"Konsulent ikke valgt",invalidDate:"Ugyldig dato",pleaseChooseValidDateTime:"Vennligst velg en gyldig avtale dato og klokkeslett.",invalidTime:"Ugyldig tid",pleaseChooseFutureDateTime:"Vennligst velg en fremtidig dato og tid for avtalen.",clinicalNotesRequired:"Kliniske merknader kreves",pleaseAddReasonForBooking:"Vennligst legg til grunnen din for \xe5 bestille denne avtalen.",bookedSuccessfully:"Booket vellykket",appointmentRequestSent:"Timeforesp\xf8rsel sendt. Konsulenten er varslet.",bookingFailed:"Bestilling mislyktes",failedToBook:"Kunne ikke bestille time.",accepted:"Godtatt",searchCounselorPlaceholder:"S\xf8k etter konsulent etter navn, spesialisering eller sted",sessionReasonPlaceholder:"Del hva du vil diskutere i denne \xf8kten..."},helpPage:{title:"Hjelp Support",centerTitle:"Humaeli st\xf8ttesenter",centerDesc:"Bruk dette st\xf8ttesenteret til \xe5 hoppe til h\xf8yre Humaeli-funksjon, feils\xf8ke vanlige problemer og forst\xe5 n\xe5r du skal kontakte akutthjelp utenfor appen.",aiWellnessChat:"AI wellness chat",aiWellnessDesc:"Still sp\xf8rsm\xe5l om mental velv\xe6re, bruk stemmeinndata, f\xe5 raske svar og fortsett den siste AI-chatten fra dashbordet.",aiWellnessAction:"\xc5pne AI-chat",counselorSupport:"R\xe5dgiverst\xf8tte",counselorDesc:"Bla gjennom r\xe5dgivere etter navn, spesialisering, spr\xe5k, plassering, vurdering og online-status f\xf8r du starter omsorgen.",counselorAction:"Finn r\xe5dgiver",appointments:"Avtaler",appointmentsDesc:"Gjennomg\xe5 kommende og tidligere avtaler, sjekk foresp\xf8rselsstatus og bestill \xf8kter med tilgjengelige r\xe5dgivere.",appointmentsAction:"Se avtaler",walletPayments:"Lommebok og betalinger",walletDesc:"Legg til penger, se gjennom transaksjoner, last ned lommebokrapporter og kontakt support for sp\xf8rsm\xe5l om betaling.",walletAction:"\xc5pne lommeboken",beforeContact:"F\xf8r du kontakter support",checklist1:"Bekreft internettforbindelsen din og oppdater appen f\xf8r du rapporterer et lasteproblem.",checklist2:"Hold det siste skjermbildet, n\xf8yaktig tid og skjermnavnet klart n\xe5r du kontakter support.",checklist3:"For kamera-, mikrofon-, varslings- og plasseringsproblemer, sjekk enhetens apptillatelser f\xf8rst.",checklist4:"For betalingsproblemer, inkluderer dato, bel\xf8p, transaksjonsstatus og lommeboksaldo vist i appen.",commonIssues:"Vanlige problemer",aiChatNotReply:"AI-chat svarer ikke",aiChatNotReplyDesc:"Sjekk internettforbindelsen din, pr\xf8v \xe5 sende en kort melding og \xe5pne AI-chatten p\xe5 nytt fra dashbordet. Hvis det fortsatt mislykkes, del det n\xf8yaktige feilskjermbildet med st\xf8tte.",counselorChatNotOpen:"R\xe5dgiverchatten \xe5pner ikke",counselorChatNotOpenDesc:"\xc5pne Consultant Support, velg en tilgjengelig r\xe5dgiver, og vent til foresp\xf8rselen blir akseptert. Eksisterende chatter vises i r\xe5dgiverens chatskjerm.",callNotConnecting:"Samtalen kobles ikke til",callNotConnectingDesc:"Forsikre deg om at r\xe5dgiveren har godtatt chatten/\xf8kten din, at begge brukerne er online, og at mikrofon-/kameratillatelser er tillatt.",walletPaymentIssue:"Lommebok eller betalingsproblem",walletPaymentIssueDesc:"\xc5pne Wallet for \xe5 se den siste transaksjonen og laste ned en rapport. Del dato, bel\xf8p og transaksjonsstatus n\xe5r du kontakter brukerst\xf8tten.",languageWrongTitle:"Spr\xe5k eller oversettelse ser feil ut",languageWrongDesc:"Bruk spr\xe5kvelgeren fra dashbordet/innstillingene. Noen r\xe5dgivere eller medisinske detaljer kan forbli p\xe5 spr\xe5ket som er angitt av leverand\xf8ren.",needMoreHelp:"Trenger du mer hjelp?",needMoreHelpDesc:"Oppdater kontodetaljer fra Profil/Innstillinger, eller e-postst\xf8tte med skjermbilder, appversjon, bruker-e-post/telefon og det n\xf8yaktige tidspunktet problemet oppsto. For krisest\xf8tte i India, ring 9152987821 eller lokale n\xf8detater.",myProfile:"Min profil",settings:"Innstillinger",emailSupport:"E-postst\xf8tte"},privacyPage:{title:"Personvernerkl\xe6ring",centerTitle:"Humaeli personvernsenter",centerDesc:"Dette personvernsenteret forklarer hvordan Humaeli bruker din profil, chat, avtale, lommebok, samtale, plassering og sikkerhetsdata i denne mobilappen.",otpProtected:"OTP-beskyttet",otpProtectedDesc:"E-post og telefonendringer",anonymousCare:"Anonym omsorgsidentitet",anonCareDesc:"Vist til r\xe5dgivere der de st\xf8ttes",sensitiveAreas:"Sensitive omr\xe5der",sensitiveAreasDesc:"Chatter, samtaler, avtaler, profil",dataUsedTitle:"Data brukt i appen",profileHealth:"Profil og helsedetaljer",profileHealthDesc:"Ditt navn, anonyme visningsnavn, alder, kj\xf8nn, kontaktdetaljer, bilde/avatar, adresse, n\xf8dkontakt, grunnleggende medisinske detaljer og forsikringsfelt brukes til \xe5 opprettholde pasientprofilen din.",aiConversations:"AI-chat og r\xe5dgiversamtaler",aiConversationsDesc:"Meldinger, raske svar, chatstatus, vedlegg, aksepterte chatte\xf8kter og r\xe5dgiverdetaljer brukes til \xe5 gi samtaler, fortsette historikken og st\xf8tte vurderingsforesp\xf8rsel.",appointments:"Avtaler og \xf8kter",appointmentsDesc:"Avtaledato, klokkeslett, \xe5rsak/notater, status, tildelt r\xe5dgiver, samtalemetadata og \xf8kthistorikk hjelper brukere og r\xe5dgivere med \xe5 administrere omsorgen.",wallet:"Lommebok og transaksjoner",walletDesc:"Lommeboksaldo, p\xe5fyll, transaksjonsposter, genererte rapporter og relatert st\xf8ttekontekst brukes til betalingssporing.",location:"Plassering og enhetskontekst",locationDesc:"Plassering kan registreres ved registrering, p\xe5logging eller manuell oppdatering for \xe5 bekrefte \xf8kter, st\xf8tte kontosikkerhet og forbedre plasseringsbevisste omsorgsfunksjoner.",security:"Sikkerhet og kontotilgang",securityDesc:"P\xe5loggingstokener, autentiseringsleverand\xf8r, passordstatus, OTP-verifisering, rolle og kontostatus brukes for \xe5 holde bruker- og r\xe5dgiveromr\xe5der atskilt og beskyttet.",whoCanSee:"Hvem kan se hva",visibleToYou:"Synlig for deg",visibleDesc:"Dashbordet ditt viser profilen din, AI-chatter, r\xe5dgiverinteraksjoner, avtaler, lommebok, anropshistorikk, vurderingsmeldinger og plasserings-/oppdateringskontroller.",sharedForCare:"Delt for omsorg",sharedDesc:"R\xe5dgivere kan se informasjonen som trengs for \xe5 administrere aksepterte \xf8kter, avtaler og st\xf8ttesamtaler. Anonym identitet brukes der det st\xf8ttes.",protectedAccess:"Beskyttet av tilgangskontroller",protectedDesc:"Bruker- og r\xe5dgiveromr\xe5der er atskilt etter rolle, aktive \xf8kter, OTP-verifisering og autentiserte API-foresp\xf8rsler.",checklist:"Din personvernsjekkliste",checklistItem1:"Bruk ditt anonyme navn for r\xe5dgiverinteraksjoner n\xe5r du ikke vil at ditt virkelige navn skal vises.",checklistItem2:"Hold n\xf8dkontakt og medisinske profildetaljer n\xf8yaktige hvis du velger \xe5 fylle dem ut.",checklistItem3:"Se gjennom enhetstillatelser for plassering, kamera og mikrofon f\xf8r samtaler.",checklistItem4:"Oppdater plassering manuelt fra Innstillinger/Profil hvis p\xe5loggingsforesp\xf8rselen ble hoppet over.",checklistItem5:"Ikke del engangskoder, passord eller sensitive kontodetaljer i chat-meldinger.",checklistItem6:"Bruk Min profil og innstillinger for \xe5 oppdatere eller gjennomg\xe5 dataene som er lagret p\xe5 kontoen din.",manageData:"Administrer profildata",securitySettings:"Sikkerhetsinnstillinger",aiQuickReplyLow:"Lavt",aiQuickReplyOkay:"Ok",aiQuickReplyGood:"Bra",aiQuickReplyGreat:"Flott",aiPhotoAttached:"Bilde vedlagt",aiTryAgain:"Pr\xf8v igjen",aiVoiceHint:"Snakk n\xe5r du er klar \u2013 jeg svarer n\xe5r du stopper.",resetChatTitle:"Starte en ny chat?",resetChatMessage:"Dette sletter den n\xe5v\xe6rende AI-chatten og starter p\xe5 nytt med velkomststemningsalternativene.",startFresh:"Start p\xe5 nytt",startingFresh:"Starter..."},phrases:{p1le0g3x:"Ukjent",p3rvtpe:"I dag",poh8cad:"I g\xe5r",p1mrhzr7:"Innkommende",pfebfdv:"Utg\xe5ende",p17k42kg:"Savnet",pvw9wg8:"Fullf\xf8rt",p15m090m:"Mislyktes",p1q8utwa:"Venter",pcqxqrc:"minutt