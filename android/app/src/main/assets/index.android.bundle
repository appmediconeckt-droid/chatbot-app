0628\u0644\u063a\u060c \u0648\u0636\u0639\u06cc\u062a \u062a\u0631\u0627\u06a9\u0646\u0634 \u0648 \u0645\u0648\u062c\u0648\u062f\u06cc \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0631\u0627 \u06a9\u0647 \u062f\u0631 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u062f\u0631\u062c \u06a9\u0646\u06cc\u062f.",commonIssues:"\u0645\u0633\u0627\u0626\u0644 \u0631\u0627\u06cc\u062c",aiChatNotReply:"\u0686\u062a \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u067e\u0627\u0633\u062e \u0646\u0645\u06cc \u062f\u0647\u062f",aiChatNotReplyDesc:"\u0627\u062a\u0635\u0627\u0644 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f\u060c \u06cc\u06a9 \u067e\u06cc\u0627\u0645 \u06a9\u0648\u062a\u0627\u0647 \u0627\u0631\u0633\u0627\u0644 \u06a9\u0646\u06cc\u062f \u0648 \u0686\u062a \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0631\u0627 \u0627\u0632 \u062f\u0627\u0634\u0628\u0648\u0631\u062f \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f. \u0627\u06af\u0631 \u0628\u0627\u0632 \u0647\u0645 \u0634\u06a9\u0633\u062a \u062e\u0648\u0631\u062f\u060c \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0634\u0627\u062a \u062e\u0637\u0627\u06cc \u062f\u0642\u06cc\u0642 \u0631\u0627 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.",counselorChatNotOpen:"\u0686\u062a \u0645\u0634\u0627\u0648\u0631 \u0628\u0627\u0632 \u0646\u0645\u06cc \u0634\u0648\u062f",counselorChatNotOpenDesc:"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u0634\u0627\u0648\u0631 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f\u060c \u06cc\u06a9 \u0645\u0634\u0627\u0648\u0631 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f \u0648 \u0645\u0646\u062a\u0638\u0631 \u0628\u0645\u0627\u0646\u06cc\u062f \u062a\u0627 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0630\u06cc\u0631\u0641\u062a\u0647 \u0634\u0648\u062f. \u0686\u062a \u0647\u0627\u06cc \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0635\u0641\u062d\u0647 \u0686\u062a \u0645\u0634\u0627\u0648\u0631 \u0638\u0627\u0647\u0631 \u0645\u06cc \u0634\u0648\u0646\u062f.",callNotConnecting:"\u062a\u0645\u0627\u0633 \u062f\u0631 \u062d\u0627\u0644 \u0627\u062a\u0635\u0627\u0644 \u0646\u06cc\u0633\u062a",callNotConnectingDesc:"\u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u062f \u06a9\u0647 \u0645\u0634\u0627\u0648\u0631 \u0686\u062a/\u062c\u0644\u0633\u0647 \u0634\u0645\u0627 \u0631\u0627 \u067e\u0630\u06cc\u0631\u0641\u062a\u0647 \u0627\u0633\u062a\u060c \u0647\u0631 \u062f\u0648 \u06a9\u0627\u0631\u0628\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0647\u0633\u062a\u0646\u062f \u0648 \u0645\u062c\u0648\u0632\u0647\u0627\u06cc \u0645\u06cc\u06a9\u0631\u0648\u0641\u0648\u0646/\u062f\u0648\u0631\u0628\u06cc\u0646 \u0645\u062c\u0627\u0632 \u0627\u0633\u062a.",walletPaymentIssue:"\u0645\u0634\u06a9\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u06cc\u0627 \u067e\u0631\u062f\u0627\u062e\u062a",walletPaymentIssueDesc:"\u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0622\u062e\u0631\u06cc\u0646 \u062a\u0631\u0627\u06a9\u0646\u0634 \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0631\u062f\u0647 \u0648 \u06af\u0632\u0627\u0631\u0634\u06cc \u0631\u0627 \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f. \u0647\u0646\u06af\u0627\u0645 \u062a\u0645\u0627\u0633 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc\u060c \u062a\u0627\u0631\u06cc\u062e\u060c \u0645\u0628\u0644\u063a \u0648 \u0648\ufffd\ufffd\u0639\u06cc\u062a \u062a\u0631\u0627\u06a9\u0646\u0634 \u0631\u0627 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.",languageWrongTitle:"\u0632\u0628\u0627\u0646 \u06cc\u0627 \u062a\u0631\u062c\u0645\u0647 \u0627\u0634\u062a\u0628\u0627\u0647 \u0628\u0647 \u0646\u0638\u0631 \u0645\u06cc \u0631\u0633\u062f",languageWrongDesc:"\u0627\u0632 \u0627\u0646\u062a\u062e\u0627\u0628\u06af\u0631 \u0632\u0628\u0627\u0646 \u0627\u0632 \u062f\u0627\u0634\u0628\u0648\u0631\u062f/\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u0628\u0631\u062e\u06cc \u0627\u0632 \u062c\u0632\u0626\u06cc\u0627\u062a \u0645\u0634\u0627\u0648\u0631 \u06cc\u0627 \u067e\u0632\u0634\u06a9\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0628\u0647 \u0632\u0628\u0627\u0646 \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u062a\u0648\u0633\u0637 \u0627\u0631\u0627\u0626\u0647 \u062f\u0647\u0646\u062f\u0647 \u0628\u0627\u0642\u06cc \u0628\u0645\u0627\u0646\u062f.",needMoreHelp:"\u0628\u0647 \u06a9\u0645\u06a9 \u0628\u06cc\u0634\u062a\u0631\u06cc \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u06cc\u062f\u061f",needMoreHelpDesc:"\u062c\u0632\u0626\u06cc\u0627\u062a \u062d\u0633\u0627\u0628 \u0631\u0627 \u0627\u0632 \u0646\u0645\u0627\u06cc\u0647/\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06cc\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u06cc\u0645\u06cc\u0644 \u0628\u0627 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0635\u0641\u062d\u0647\u060c \u0646\u0633\u062e\u0647 \u0628\u0631\u0646\u0627\u0645\u0647\u060c \u0627\u06cc\u0645\u06cc\u0644/\u062a\u0644\u0641\u0646 \u06a9\ufffd\ufffd\u0631\u0628\u0631 \u0648 \u0632\u0645\u0627\u0646 \u062f\u0642\u06cc\u0642 \u0628\u0631\u0648\u0632 \u0645\u0634\u06a9\u0644 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06a9\u0646\u06cc\u062f. \u0628\u0631\u0627\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0632 \u0628\u062d\u0631\u0627\u0646 \u062f\u0631 \u0647\u0646\u062f\u060c \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 9152987821 \u06cc\u0627 \u062e\u062f\u0645\u0627\u062a \u0627\u0648\u0631\u0698\u0627\u0646\u0633 \u0645\u062d\u0644\u06cc \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f.",myProfile:"\u0646\u0645\u0627\u06cc\u0647 \u0645\u0646",settings:"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a",emailSupport:"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u06cc\u0645\u06cc\u0644"},privacyPage:{title:"\u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc",centerTitle:"\u0645\u0631\u06a9\u0632 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc Humaeli",centerDesc:"\u0627\u06cc\u0646 \u0645\u0631\u06a9\u0632 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u062a\u0648\u0636\u06cc\u062d \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u0686\u06af\u0648\u0646\u0647 Humaeli \u0627\u0632 \u0646\u0645\u0627\u06cc\u0647\u060c \u0686\u062a\u060c \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a\u060c \u06a9\u06cc\u0641 \u067e\u0648\u0644\u060c \u062a\u0645\u0627\u0633\u060c \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0627\u0645\u0646\u06cc\u062a\u06cc \u0634\u0645\u0627 \u062f\u0631 \u062f\u0627\u062e\u0644 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f.",otpProtected:"OTP \u0645\u062d\u0627\u0641\u0638\u062a \u0634\u062f\u0647 \u0627\u0633\u062a",otpProtectedDesc:"\u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0627\u06cc\u0645\u06cc\u0644 \u0648 \u062a\u0644\u0641\u0646",anonymousCare:"\u0647\u0648\u06cc\u062a \u0645\u0631\u0627\u0642\u0628\u062a \u0646\u0627\u0634\u0646\u0627\u0633",anonCareDesc:"\u062f\u0631 \u062c\u0627\u06cc\u06cc \u06a9\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u06cc \u0634\u0648\u062f \u0628\u0647 \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f",sensitiveAreas:"\u0645\u0646\u0627\u0637\u0642 \u062d\u0633\u0627\u0633",sensitiveAreasDesc:"\u0686\u062a\u060c \u062a\u0645\u0627\u0633\u060c \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a\u060c \u0646\u0645\u0627\u06cc\u0647",dataUsedTitle:"\u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0628\u0631\u0646\u0627\u0645\u0647",profileHealth:"\u0645\u0634\u062e\u0635\u0627\u062a \u0648 \u0645\u0634\u062e\u0635\u0627\u062a \u0633\u0644\u0627\u0645\u062a\u06cc",profileHealthDesc:"\u0646\u0627\u0645 \u0634\u0645\u0627\u060c \u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc \u0646\u0627\u0634\u0646\u0627\u0633\u060c \u0633\u0646\u060c \u062c\u0646\u0633\u06cc\u062a\u060c \u062c\u0632\u0626\u06cc\u0627\u062a \u062a\u0645\u0627\u0633\u060c \u0639\u06a9\u0633/\u0622\u0648\u0627\u062a\u0627\u0631\u060c \u0622\u062f\u0631\u0633\u060c \u062a\u0645\u0627\u0633 \u0627\u0636\u0637\u0631\u0627\u0631\u06cc\u060c \u062c\u0632\u0626\u06cc\u0627\u062a \u0627\u0648\u0644\u06cc\u0647 \u067e\u0632\u0634\u06a9\u06cc \u0648 \u0641\u06cc\u0644\u062f\u0647\u0627\u06cc \u0628\u06cc\u0645\u0647 \u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0645\u0634\u062e\u0635\u0627\u062a \u0628\u06cc\u0645\u0627\u0631 \u0634\u0645\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f.",aiConversations:"\u0686\u062a \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0648 \u06af\u0641\u062a\u06af\u0648\u0647\u0627\u06cc \u0645\u0634\u0627\u0648\u0631",aiConversationsDesc:"\u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u060c \u067e\u0627\u0633\u062e\u200c\u0647\u0627\u06cc \u0633\u0631\u06cc\u0639\u060c \u0648\u0636\u0639\u06cc\u062a \u0686\u062a\u060c \u067e\u06cc\u0648\u0633\u062a\u200c\u0647\u0627\u060c \u062c\u0644\u0633\u0627\u062a \u06af\u067e \u067e\u0630\u06cc\u0631\u0641\u062a\u0647\u200c\u0634\u062f\u0647 \u0648 \u062c\u0632\u0626\u06cc\u0627\u0