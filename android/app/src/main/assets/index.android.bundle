atar",p1iteube:"Bina avatar kartun tersuai",p1ay9ndp:"Permintaan diperlukan",pyp6eyp:"Permintaan anda sedang menunggu perunding untuk menerima. Anda boleh menjadualkan temu janji sebaik sahaja ia diterima.",p1kdspac:"Hantar permintaan kepada perunding ini terlebih dahulu. Anda boleh menjadualkan temu janji sebaik sahaja mereka menerima.",p1ykc6c:"Tempahan Berjaya",p1mkqpql:"Permintaan temu janji telah dihantar. Perunding telah dimaklumkan.",p376cnt:"baru",pdtikix:"#9CA3AF",p457iov:"#6B7280",pdeg0u4:"TERSEDIA",poid0ys:"LUAR TALIAN",p1k71ak3:"Permintaan belum selesai \u2014 menunggu perunding untuk menerima",pqdsfmj:"Seterusnya Tersedia",p1pbfmaj:"Tidak tersedia pada masa ini",poexnlb:"Jadual Temujanji",p1bc3ymi:"dalam talian",p4eopgk:"Luar talian",p1mrbbye:"Cari kaunselor...",p1qu9kiw:"Disyorkan untuk anda",pdiccwv:"Kaunselor Tersedia",p19t8t9z:"Lihat Semua",px2apx5:"Memuatkan perunding...",p8w729e:"Tiada perunding yang sepadan dengan carian anda.",p1kb591n:"Tiada perunding yang sepadan dengan penapis ini.",pydi3yr:"Tunjukkan semua perunding",p8tgoop:"Mulakan Sembang dengan",px5mhqy:"Anda sedang bersembang tanpa nama",pfnws9p:"Identiti sebenar anda masih tersembunyi. Hanya nama tanpa nama anda kelihatan kepada perunding.",p1q8bxht:"Anda sedang bersembang tanpa nama. Identiti sebenar anda dilindungi.",p1vrzc75:"Tempah Janji Temu dengan",pk9sr4d:"Tarikh & Masa Temujanji",p19b133j:"Kongsikan apa yang anda ingin bincangkan dalam sesi ini...",p1ofe49j:"sahkan",pod8om5:"#f1f5f9",p4jwrwd:"#64748b",p12rxnw6:"DISAHKAN",p3qck1g:"Video",p3qgs6r:"Suara",piqr3yv:"Jadual semula",p1ih37q3:"Tempah semula",p9f13kd:"Janji Temu Saya",pib04ak:"Tiada janji temu akan datang",pgl6xta:"Tiada janji temu yang lalu",pvoub8r:"tadi",pbb6h7f:"Baru-baru ini",pxmmv5g:"Tiada mesej lagi",p8kq06q:"Tamat tempoh",pr2mc4m:"Tiada perunding ditemui",p1pqa80d:"Tiada perunding yang sepadan dengan \"{{term}}\"",pgpj1xu:"Kosongkan carian",p13kxm4h:"RUANG SELAMAT ANDA",p13p0dnb:"Cari orang yang memahami",p1n4jn