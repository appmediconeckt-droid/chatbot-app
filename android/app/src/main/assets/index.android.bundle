0939\u0930\u0942 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a\u092e\u093e \u092c\u091a\u0924 \u0939\u0941\u0928\u094d\u091b\u0928\u094d\u0964 \u0906\u0917\u092e\u0928 \u0915\u0932\u0939\u0930\u0942 \u0938\u0927\u0948\u0902 \u0918\u0923\u094d\u091f\u0940 \u092c\u091c\u094d\u091b\u0928\u094d\u0964",pd38tmt:"\u092a\u0941\u0936 \u0938\u0942\u091a\u0928\u093e\u0939\u0930\u0942",py0sci4:"\u092f\u094b \u092f\u0928\u094d\u0924\u094d\u0930\u092e\u093e \u092a\u091c \u0917\u0930\u093f\u092f\u094b",pa95e8x:"\u092f\u094b \u092f\u0928\u094d\u0924\u094d\u0930\u0915\u094b \u0932\u093e\u0917\u093f \u0938\u0915\u094d\u0930\u093f\u092f \u091b",pqyj5d6:"\u0936\u093e\u0928\u094d\u0924 \u0918\u0923\u094d\u091f\u093e",putfm6j:"\u0936\u093e\u0928\u094d\u0924 \u0918\u0923\u094d\u091f\u093e \u091a\u093e\u0932\u0942",pmjqk1x:"\u0936\u093e\u0928\u094d\u0924 \u0918\u0923\u094d\u091f\u093e \u092c\u0928\u094d\u0926",pc92v4f:"\u0939\u0930\u0947\u0915 \u0926\u093f\u0928 \u092f\u0940 \u0938\u092e\u092f\u0939\u0930\u0942 \u092c\u0940\u091a\u0915\u094b \u0915\u0932\u0939\u0930\u0942 \u092c\u093e\u0939\u0947\u0915 \u0938\u092c\u0948 \u0938\u0942\u091a\u0928\u093e\u0939\u0930\u0942 \u092e\u094c\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pyjj0j7:"\u092c\u093e\u091f",p3hnj2:"TO",p1q93ymg:"\u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0938\u0942\u091a\u0928\u093e \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942",p1ukfouf:"\u0927\u094d\u0935\u0928\u093f, \u0915\u092e\u094d\u092a\u0928 \u0930 \u0932\u0915-\u0938\u094d\u0915\u094d\u0930\u093f\u0928 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092b\u094b\u0928\u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u092f\u0928\u094d\u0924\u094d\u0930\u0923 \u0917\u0930\u093f\u0928\u094d\u091b\u0964",prlcmwg:"\u0905\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940",p1qpo70d:"\u0915\u093e\u0930\u094d\u0921 \u0930 \u0905\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940\u0939\u0930\u0942 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1qsebez:"UPI / \u092c\u0948\u0902\u0915 \u0938\u094d\u0925\u093e\u0928\u093e\u0928\u094d\u0924\u0930\u0923",p1na12vk:"UPI \u0935\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0935\u093f\u0935\u0930\u0923\u0939\u0930\u0942 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u0947\u0930 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940\u0939\u0930\u0942 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pq5h5mu:"\u0928\u0917\u0926 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940",pnxuba:"\u092c\u093f\u0930\u093e\u092e\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u0915\u094d\u0932\u093f\u0928\u093f\u0915\u092e\u093e \u0928\u0917\u0926 \u0924\u093f\u0930\u094d\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pnbx6ey:"\u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942",p1rc1vbw:"\u092c\u093f\u0930\u093e\u092e\u0940\u0939\u0930\u0942\u0932\u0947 \u0905\u092a\u094b\u0907\u0928\u094d\u091f\u092e\u0947\u0928\u094d\u091f\u0939\u0930\u0942 \u0930 \u092a\u0930\u093e\u092e\u0930\u094d\u0936\u0939\u0930\u0942\u0915\u094b \u0932\u093e\u0917\u093f \u0915\u0938\u0930\u0940 \u092d\u0941\u0915\u094d\u0924\u093e\u0928\u0940 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u091b\u0928\u094d \u091b\u0928\u094c\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1iurqt3:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942",p13wbph8:"\u0909\u092a\u0932\u092c\u094d\u0927 \u091b",p5c2ocm:"#FFFFFF",p1u56grv:"UPI \u0930 \u092c\u0948\u0902\u0915 \u0935\u093f\u0935\u0930\u0923",puflyd8:"UPI \u0906\u0908\u0921\u0940 \u0935\u093e \u092c\u0