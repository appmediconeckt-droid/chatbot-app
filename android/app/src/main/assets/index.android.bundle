\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c3f\u0c15\u0c3f \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.",bookingFailed:"\u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f",failedToBook:"\u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2c\u0c41\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02\u0c32\u0c4b \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f.",accepted:"\u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",searchCounselorPlaceholder:"\u0c2a\u0c47\u0c30\u0c41, \u0c38\u0c4d\u0c2a\u0c46\u0c37\u0c32\u0c48\u0c1c\u0c47\u0c37\u0c28\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c28\u0c4d\u0c38\u0c32\u0c4d\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",sessionReasonPlaceholder:"\u0c08 \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c2e\u0c40\u0c30\u0c41 \u0c0f\u0c2e\u0c3f \u0c1a\u0c30\u0c4d\u0c1a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c4b \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f..."},helpPage:{title:"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41",centerTitle:"Humaeli \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02",centerDesc:"\u0c38\u0c30\u0c48\u0c28 Humaeli \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u200c\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32\u0c28\u0c41 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2f\u0c3e\u0c2a\u0c4d \u0c35\u0c46\u0c32\u0c41\u0c2a\u0c32 \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c38\u0c39\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c38\ufffd\ufffd\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4b \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c08 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",aiWellnessChat:"AI \u0c35\u0c46\u0c32\u0c4d\u0c28\u0c46\u0c38\u0c4d \u0c1a\u0c3e\u0c1f\u0c4d",aiWellnessDesc:"\u0c2e\u0c3e\u0c28\u0c38\u0c3f\u0c15 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c28\u0c41 \u0c05\u0c21\u0c17\u0c02\u0c21\u0c3f, \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c07\u0c28\u0c4d\u200c\u0c2a\u0c41\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c36\u0c40\u0c18\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c41\u0c24\u0c4d\u0c24\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2e\u0c40 \u0c07\u0c1f\u0c40\u0c35\u0c32\u0c3f AI \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",aiWellnessAction:"AI \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f",counselorSupport:"\u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c30\u0c4d \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41",counselorDesc:"\u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2a\u0c47\u0c30\u0c41, \u0c38\u0c4d\u0c2a\u0c46\u0c37\u0c32\u0c48\u0c1c\u0c47\u0c37\u0c28\u0c4d, \u0c2d\u0c3e\u0c37, \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02, \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2c\u0c4d\u0c30\u0c4c\u0c1c\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",counselorAction:"\u0c38\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c02\u0c21\u0c3f",appointments:"\u0c28\u0c3f\u0c2f\u0c3e\u0c2e\u0c15\u0c3e\u0c32\u0c41",appointmentsDesc:"\u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c17\u0c24 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d\u200c\u0c32\u0c24\u0c4b \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2c\u0c41\ufffd\ufffd\ufffd\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",appointmentsAction:"\u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",walletPayments:"\u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c41",walletDesc:"\u0c21\u0c2c\u0c4d\u0c2c\u0c41\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",walletAction:"\u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f",beforeContact:"\u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\ufffd\ufffd \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41",checklist1:"\u0c32\u0c4b\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2e\u0c40 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c3f, \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c41 \u0c30\u0c3f\u0c2b\u0c4d\u0c30\u0c46\u0c37\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",checklist2:"\u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c24\u0c3e\u0c1c\u0c3e \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d\u200c\u0c37\u0c3e\u0c1f\u0c4d, \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c38\u0c2e\u0c2f\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d \u0c2a\u0c47\u0c30\u0c41\u0c28\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1a\u0c02\u0c21\u0c3f.",checklist3:"\u0c15\u0c46\u0c2e\u0c46\u0c30\u0c3e, \u0c2e\u0c48\u0c15\u0c4d\u0c30\u0c4b\u0c2b\u0c4b\u0c28\u0c4d, \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4d\u0c25\u0c3e\u0c28 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32 \u0c15\u0c4b\u0c38\u0c02, \u0c2e\u0c41\u0c02\u0c26\u0c41\u0c17\u0c3e \u0c2a\u0c30\u0c3f\u0c15\u0c30 \u0c2f\u0c3e\u0c2a\u0c4d \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c41\u0c32\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",checklist4:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32 \u0c15\u0c4b\u0c38\u0c02, \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c1a\u0c42\u0c2a\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40, \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02, \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c28\u0c3f \u0c1a\u0c47\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f.",commonIssues:"\u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32\u0c41",aiChatNotReply:"AI \u0c1a\u0c3e\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c41\u0c24\u0c4d\u0c24\u0c30\u0c02 \u0c07\u0c35\u0c4d\u0c35\u0c21\u0c02 \u0c32\u0c47\u0c26\u0c41",aiChatNotReplyDesc:"\u0c2e\u0c40 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f, \u0c38\u0c02\u0c15\u0c4d\u0c37\u0c3f\u0c2a\u0c4d\u0c24 \u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c02\u0c2a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c4d\u0c2f\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f AI \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f. \u0c07\u0c26\u0c3f \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c24\u0c47, \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c0e\u0c30\u0c4d\u0c30\u0c30\u0c4d \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d\u200c\u0c37\u0c3e\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c24\u0c4b \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",counselorChatNotOpen:"\u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c1a\u0c3e\u0c1f\u0c4d \u0c24\u0c46\u0c30\u0c35\u0c21\u0c02 \u0c32\u0c47\u0c26\u0c41",counselorChatNotOpenDesc:"\u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c3f, \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c38\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c47 \u0c35\u0c30\u0c15\u0c41 \u0c35\u0c47\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f. \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c28\u0c4d\u0c28 \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c3e\ufffd\ufffd\u0c3f.",callNotConnecting:"\u0c15\u0c3e\u0c32\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c1f\u0c4d \u0c15\u0c3e\u0c35\u0c21\u0c02 \u0c32\u0c47\u0c26\u0c41",callNotConnectingDesc:"\u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c2e\u0c40 \u0c1a\u0c3e\u0c1f\u0c4d/\u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c28\u0c3f, \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c07\u0c26\u0c4d\u0c26\u0c30\u0c42 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c48\u0c15\u0c4d\u0c30\u0c4b\u0c2b\u0c4b\u0c28\u0c4d/\u0c15\u0c46\u0c2e\u0c46\u0c30\u0c3e \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c41\u0c32\u0c41 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",walletPaymentIssue:"\u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c2e\u0c38\u0c4d\u0c2f",walletPaymentIssueDesc:"\u0c24\u0c3e\u0c1c\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c28\u0c3f \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c28\u0c41 \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f Wallet\u0c28\u0c3f \u0c24\u0c46\u0c30\u0c35\ufffd\ufffd\ufffd\u0c21\u0c3f. \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c24\u0c47\u0c26\u0c40, \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",languageWrongTitle:"\u0c2d\u0c3e\u0c37 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c28\u0c41\u0c35\u0c3e\u0c26\u0c02 \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c17\u0c3e \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f",languageWrongDesc:"\u0c21\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d/\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2d\u0c3e\u0c37 \u0c0e\u0c02\u0c2a\u0c3f\u0c15 \u0c38\u0c3e\u0c27\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c48\u0c26\u0c4d\u0c2f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c35\u0c48\u0c21\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c2d\u0c3e\u0c37\u0c32\u0c4b\u0c28\u0c47 \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",needMoreHelp:"\u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e?",needMoreHelpDesc:"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d/\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d\u200c\u0c37\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c24\u0c4b \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41, \u0c2f\u0c3e\u0c2a\u0c4d \u0c35\u0c46\u0c30\u0c4d\u0c37\u0c28\u0c4d, \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d/\u0c2b\u0c4b\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c1c\u0c30\u0c3f\u0c17\u0c3f\u0c28 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c38\u0c2e\u0c2f\u0c02. \u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c38\u0c02\u0c15\u0c4d\u0c37\u0c4b\u0c2d \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c15\u0c4b\u0c38\u0c02, 9152987821 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c38\u0c47\u0c35\u0c32\u0c15\u0c41 \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",myProfile:"\u0c28\u0c3e \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\ufffd\ufffd\ufffd\u0c4d",settings:"\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41",emailSupport:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41"},privacyPage:{title:"\u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02",centerTitle:"Humaeli \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02",centerDesc:"\u0c08 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b Humaeli \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d, \u0c1a\u0c3e\u0c1f\u0c4d, \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d, \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d, \u0c15\u0c3e\u0c32\u0c4d, \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c46\u0c15\u0c4d\u0c2f\u0c42\u0c30\u0c3f\u0c1f\u0c40 \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c4b \u0c08 \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",otpProtected:"OTP \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",otpProtectedDesc:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2b\u0c4b\u0c28\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41",anonymousCare:"\u0c05\u0c28\u0c3e\u0c2e\u0c15 \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41",anonCareDesc:"\u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c09\u0c28\u0c4d\u0c28 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c1a\u0c42\u0c2a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",sensitiveAreas:"\u0c38\u0c41\u0c28\u0c4d\u0c28\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32\u0c41",sensitiveAreasDesc:"\u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c15\u0c3e\u0c32\u0c4d\u200c\u0c32\u0c41, \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d",dataUsedTitle:"\u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c21\u0c47\u0c1f\u0c3e",profileHealth:"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41",profileHealthDesc:"\u0c2e\u0c40 \u0c2a\u0c47\u0c37\u0c46\u0c02\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41, \u0c05\u0c28\u0c3e\u0c2e\u0c15 \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c28 \u0c2a\u0c47\u0c30\u0c41, \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41, \u0c32\u0c3f\u0c02\u0c17\u0c02, \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41, \u0c2b\u0c4b\u0c1f\u0c4b/\u0c05\u0c35\u0c24\u0c3e\u0c30\u0c4d, \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e, \u0c05\u0c24\u0c4d\u0c2f\u0c35\u0c38\u0c30 \u0c2a\u0c30\u0c3f\u0c1a\u0c2f\u0c02, \u0c2a\u0c4d\u0c30\u0c3e\u0c25\u0c2e\u0c3f\u0c15 \u0c35\u0c48\u0c26\u0c4d\u0c2f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c40\u0c2e\u0c3e \u0c2b\u0c40\u0c32\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",aiConversations:"AI \u0c1a\u0c3e\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c32\u0c41",aiConversationsDesc:"\u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c32\u0c41, \u0c36\u0c40\u0c18\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c41\u0c24\u0c4d\u0c24\u0c30\u0c3e\u0c32\u0c41, \u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c41, \u0c05\u0c02\ufffd\ufffd\ufffd\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c28\u0c41 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c2a\u0c4d\u0c1f\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c07\u0c35\u0c4d\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",appointments:"\u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41",appointmentsDesc:"\u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c24\u0c47\u0c26\u0c40, \u0c38\u0c2e\u0c2f\u0c02, \u0c15\u0c3e\u0c30\u0c23\u0c02/\u0c17\u0c2e\u0c28\u0c3f\u0c15\u0c32\u0c41, \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d, \u0c15\u0c3e\u0c32\u0c4d \u0c2e\u0c46\u0c1f\u0c3e\u0c21\u0c47\u0c1f\u0c3e \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c46\u0c37\u0c28\u0c4d \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",wallet:"\u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32\u0c41",walletDesc:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d, \u0c1f\u0c3e\u0c2a\u0c4d-\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c41, \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c41, \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",location:"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c3f\u0c15\u0c30 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02",locationDesc:"\u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c16\u0c3e\u0c24\u0c3e \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c15\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c07\u0c35\u0c4d\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\ufffd\ufffd\ufffd\u0c15\u0c47\u0c37\u0c28\u0c4d-\u0c05\u0c35\u0c47\u0c30\u0c4d \u0c15\u0c47\u0c30\u0c4d \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c2a\u0c30\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c48\u0c28\u0c4d\u0c05\u0c2a\u0c4d, \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c3e\u0c28\u0c4d\u0c2f\u0c41\u0c35\u0c32\u0c4d \u0c30\u0c3f\u0c2b\u0c4d\u0c30\u0c46\u0c37\u0c4d\u200c\u0c32\u0c4b \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d\u0c1a\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",security:"\u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d",securityDesc:"\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u200c\u0c32\u0c41, \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c24, \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, OTP \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23, \u0c2a\u0c3e\u0c24\u0c4d\u0c30 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",whoCanSee:"\u0c0e\u0c35\u0c30\u0c41 \u0c0f\u0c2e\u0c3f \u0c1a\u0c42\u0c21\u0c17\u0c32\u0c30\u0c41",visibleToYou:"\u0c2e\u0c40\u0c15\u0c41 \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f",visibleDesc:"\u0c2e\u0c40 \u0c21\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d, AI \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d \u0c07\u0c02\u0c1f\u0c30\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41, \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d, \u0c15\u0c3e\u0c32\u0c4d \u0c39\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c40, \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c2a\u0c4d\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d/\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c23\u0c32\u0c28\u0c41 \u0c1a\u0c42\u0c2a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",sharedForCare:"\u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",sharedDesc:"\u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41, \u0c05\u0c2a\u0c3e\ufffd\ufffd\ufffd\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c46\u0c32\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c09\u0c28\u0c4d\u0c28 \u0c1a\u0c4b\u0c1f \u0c05\u0c28\u0c3e\u0c2e\u0c15 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",protectedAccess:"\u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c23\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",protectedDesc:"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32\u0c41 \u0c2a\u0c3e\u0c24\u0c4d\u0c30, \u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c3e\u0c36\u0c40\u0c32 \u0c38\u0c46\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41, OTP 