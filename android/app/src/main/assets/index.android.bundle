erTitle:"Humaeli \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30",centerDesc:"\u0a38\u0a71\u0a1c\u0a47 Humaeli \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e '\u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a32\u0a08, \u0a06\u0a2e \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a26\u0a3e \u0a28\u0a3f\u0a2a\u0a1f\u0a3e\u0a30\u0a3e \u0a15\u0a30\u0a28, \u0a05\u0a24\u0a47 \u0a10\u0a2a \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a39\u0a30 \u0a1c\u0a3c\u0a30\u0a42\u0a30\u0a40 \u0a2e\u0a26\u0a26 \u0a28\u0a3e\u0a32 \u0a15\u0a26\u0a4b\u0a02 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a28\u0a3e \u0a39\u0a48, \u0a07\u0a39 \u0a38\u0a2e\u0a1d\u0a23 \u0a32\u0a08 \u0a07\u0a38 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a4b\u0964",aiWellnessChat:"AI \u0a24\u0a70\u0a26\u0a30\u0a41\u0a38\u0a24\u0a40 \u0a1a\ufffd\ufffd\ufffd\u0a1f",aiWellnessDesc:"\u0a2e\u0a3e\u0a28\u0a38\u0a3f\u0a15 \u0a24\u0a70\u0a26\u0a30\u0a41\u0a38\u0a24\u0a40 \u0a26\u0a47 \u0a38\u0a35\u0a3e\u0a32 \u0a2a\u0a41\u0a71\u0a1b\u0a4b, \u0a35\u0a4c\u0a07\u0a38 \u0a07\u0a28\u0a2a\u0a41\u0a1f \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a4b, \u0a24\u0a41\u0a30\u0a70\u0a24 \u0a1c\u0a35\u0a3e\u0a2c \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a4b, \u0a05\u0a24\u0a47 \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a24\u0a4b\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a39\u0a3e\u0a32\u0a40\u0a06 AI \u0a1a\u0a48\u0a1f \u0a28\u0a42\u0a70 \u0a1c\u0a3e\u0a30\u0a40 \u0a30\u0a71\u0a16\u0a4b\u0964",aiWellnessAction:"AI \u0a1a\u0a48\u0a1f \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a4b",counselorSupport:"\u0a38\u0a32\u0a3e\u0a39\u0a15\u0a3e\u0a30 \u0a38\u0a39\u0a3f\u0a2f\u0a4b\u0a17",counselorDesc:"\u0a26\u0a47\u0a16\u0a2d\u0a3e\u0a32 \u0a38\u0a3c\u0a41\u0a30\u0a42 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a28\u0a3e\u0a2e, \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e, \u0a2d\u0a3e\u0a38\u0a3c\u0a3e, \u0a38\u0a25\u0a3e\u0a28, \u0a30\u0a47\u0a1f\u0a3f\u0a70\u0a17 \u0a05\u0a24\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a32\u0a3e\u0a39\u0a15\u0a3e\u0a30\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2c\u0a4d\u0a30\u0a3e\u0a0a\u0a1c\u0a3c \u0a15\u0a30\u0a4b\u0964",counselorAction:"\u0a38\u0a32\u0a3e\u0a39\u0a15\u0a3e\u0a30 \u0a32\u0a71\u0a2d\u0a4b",appointments:"\u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24\u0a3e\u0a02",appointmentsDesc:"\u0a06\u0a17\u0a3e\u0a2e\u0a40 \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a1b\u0a32\u0a40\u0a06\u0a02 \u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a2e\u0a40\u0a16\u0a3f\u0a06 \u0a15\u0a30\u0a4b, \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b, \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a38\u0a32\u0a3e\u0a39\u0a15\u0a3e\u0a30\u0a3e\u0a02 \u0a28\u0a3e\u0a32 \u0a2c\u0a41\u0a71\u0a15 \u0a38\u0a48\u0a38\u0a3c\u0a28\u0a3e\u0a02 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b\u0964",appointmentsAction:"\u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24\u0a3e\u0a02 \u0a26\u0a47\u0a16\u0a4b",walletPayments:"\u0a35\u0a3e\u0a32\u0a3f\u0a1f \u0a05\u0a24\u0a47 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28",walletDesc:"\u0a2a\u0a48\u0a38\u0a47 \u0a1c\u0a4b\u0a5c\u0a4b, \u0a32\u0a48\u0a23-\u0a26\u0a47\u0a23 \u0a26\u0a40 \u0a38\u0a2e\u0a40\u0a16\u0a3f\u0a06 \u0a15\u0a30\u0a4b, \u0a35\u0a3e\u0a32\u0a3f\u0a1f \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b, \u0a05\u0a24\u0a47 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a38\u0a35\u0a3e\u0a32\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a4b\u0964",walletAction:"\u0a2c\u0a1f\u0a42\u0a06 \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a4b",beforeContact:"\u0a07\u0a38 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a15\u0a3f \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a4b",checklist1:"\u0a06\u0a2a\u0a23\u0a47 \u0a07\u0a70\u0a1f\u0a30\u0a28\u0a48\u0a1f \u0a15\ufffd\ufffd\ufffd\u0a48\u0a15\u0a38\u0a3c\u0a28 \u0a26\u0a40 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a32\u0a4b\u0a21\u0a3f\u0a70\u0a17 \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06 \u0a26\u0a40 \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a10\u0a2a \u0a28\u0a42\u0a70 \u0a24\u0a3e\u0a1c\u0a3c\u0a3e \u0a15\u0a30\u0a4b\u0964",checklist2:"\u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a28 \u0a35\u0a47\u0a32\u0a47 \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28\u0a38\u0a3c\u0a4c\u0a1f, \u0a38\u0a39\u0a40 \u0a38\u0a2e\u0a3e\u0a02, \u0a05\u0a24\u0a47 \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28 \u0a28\u0a3e\u0a2e \u0a24\u0a3f\u0a06\u0a30 \u0a30\u0a71\u0a16\u0a4b\u0964",checklist3:"\u0a15\u0a48\u0a2e\u0a30\u0a3e, \u0a2e\u0a3e\u0a08\u0a15\u0a4d\u0a30\u0a4b\u0a2b\u0a3c\u0a4b\u0a28, \u0a38\u0a42\u0a1a\u0a28\u0a3e, \u0a05\u0a24\u0a47 \u0a1f\u0a3f\u0a15\u0a3e\u0a23\u0a3e \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a32\u0a08, \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a21\u0a40\u0a35\u0a3e\u0a08\u0a38 \u0a10\u0a2a \u0a07\u0a1c\u0a3e\u0a1c\u0a3c\u0a24\u0a3e\u0a02 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b\u0964",checklist4:"\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a32\u0a08, \u0a10\u0a2a \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a3f\u0a16\u0a3e\u0a08 \u0a17\u0a08 \u0a2e\u0a3f\u0a24\u0a40, \u0a30\u0a15\u0a2e, \u0a32\u0a48\u0a23-\u0a26\u0a47\u0a23 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a05\u0a24\u0a47 \u0a35\u0a3e\u0a32\u0a3f\u0a1f \u0a2c\u0a48\u0a32\u0a70\u0a38 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a15\u0a30\u0a4b\u0964",commonIssues:"\u0a06\u0a2e \u0a2e\u0a41\u0a71\u0a26\u0a47",aiChatNotReply:"AI \u0a1a\u0a48\u0a1f \u0a1c\u0a35\u0a3e\u0a2c \u0a28\u0a39\u0a40\u0a02 \u0a26\u0a47 \u0a30\u0a39\u0a40 \u0a39\u0a48",aiChatNotReplyDesc:"\u0a06\u0a2a\u0a23\u0a47 \u0a07\u0a70\u0a1f\u0a30\u0a28\u0a48\u0a1f \u0a15\u0a28\u0a48\u0a15\u0a38\u0a3c\u0a28 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b, \u0a07\u0a71\u0a15 \u0a1b\u0a4b\u0a1f\u0a3e \u0a38\u0a41\u0a28\u0a47\u0a39\u0a3e \u0a2d\u0a47\u0a1c\u0a23 \u0a26\u0a40 \u0a15\u0a4b\u0a38\u0a3c\u0a3f\u0a38\u0a3c \u0a15\u0a30\u0a4b, \u0a05\u0a24\u0a47 \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a24\u0a4b\u0a02 AI \u0a1a\u0a48\u0a1f \u0a28\u0a42\u0a70 \u0a26\u0a41\u0a2c\u0a3e\u0a30\u0a3e \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a4b\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a07\u0a39 \u0a05\u0a1c\u0a47 \u0a35\u0a40 \u0a05\u0a38\u0a2b\u0a32 \u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a38\u0a2e\u0a30\u0a25\u0a28 \u0a28\u0a3e\u0a32 \u0a38\u0a39\u0a40 \u0a17\u0a32\u0a24\u0a40 \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28\u0a38\u0a3c\u0a4c\u0a1f \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a4b\u0964",counselorChatNotOpen:"\u0a15\u0a3e\u0a09\u0a02\u0a38\u0a32\u0a30 \u0a1a\u0a48\u0a1f \u0a28\u0a39\u0a40\u0a02 \u0a16\u0a41\u0a71\u0a32\u0a4d\u0a39 \u0a30\u0a39\u0a40 \u0a39\u0a48",counselorChatNotOpenDesc:"\u0a15\u0a3e\u0a09\u0a02\u0a38\u0a32\u0a30 \u0a38\u0a2a\u0a4b\u0a30\u0a1f \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a4b, \u0a07\u0a71\u0a15 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a15\u0a3e\u0a09\u0a02\u0a38\u0a32\u0a30 \u0a1a\u0a41\u0a23\u0a4b, \u0a05\u0a24\u0a47 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a26\u0a40 \u0a09\u0a21\u0a40\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a1a\u0a48\u0a1f\u0a38 \u0a15\u0a3e\u0a09\u0a02\u0a38\u0a32\u0a30 \u0a1a\u0a48\u0a1f \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a3f\u0a16\u0a3e\u0a08 \u0a26\u0a3f\u0a70\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964",callNotConnecting:"\u0a15\u0a3e\u0a32 \u0a15\u0a28\u0a48\u0a15\u0a1f \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a4b \u0a30\u0a39\u0a40 \u0a39\u0a48",callNotConnectingDesc:"\u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a13 \u0a15\u0a3f \u0a38\u0a32\u0a3e\u0a39\u0a15\u0a3e\u0a30 \u0a28\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a1a\u0a48\u0a1f/\u0a38\u0a48\u0a38\u0a3c\u0a28 \u0a28\u0a42\u0a70 \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30 \u0a32\u0a3f\u0a06 \u0a39\u0a48, \u0a26\u0a4b\u0a35\u0a47\u0a02 \u0a35\u0a30\u0a24\u0a4b\u0a02\u0a15\u0a3e\u0a30 \u0a14\u0a28\ufffd\ufffd\u0a3e\u0a08\u0a28 \u0a39\u0a28, \u0a05\u0a24\u0a47 \u0a2e\u0a3e\u0a08\u0a15\u0a4d\u0a30\u0a4b\u0a2b\u0a3c\u0a4b\u0a28/\u0a15\u0a48\u0a2e\u0a30\u0a47 \u0a26\u0a40 \u0a07\u0a1c\u0a3e\u0a1c\u0a3c\u0a24 \u0a39\u0a48\u0964",walletPaymentIssue:"\u0a35\u0a3e\u0a32\u0a3f\u0a1f \u0a1c\u0a3e\u0a02 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a26\u0a3e \u0a2e\u0a41\u0a71\u0a26\u0a3e",walletPaymentIssueDesc:"\u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e \u0a32\u0a48\u0a23-\u0a26\u0a47\u0a23 \u0a26\u0a40 \u0a38\u0a2e\u0a40\u0a16\u0a3f\u0a06 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a07\u0a71\u0a15 \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a35\u0a3e\u0a32\u0a3f\u0a1f \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a4b\u0964 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a28 \u0a35\u0a47\u0a32\u0a47 \u0a2e\u0a3f\u0a24\u0a40, \u0a30\u0a15\u0a2e \u0a05\u0a24\u0a47 \u0a32\u0a48\u0a23-\u0a26\u0a47\u0a23 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a4b\u0964",languageWrongTitle:"\u0a2d\u0a3e\u0a38\u0a3c\u0a3e \u0a1c\u0a3e\u0a02 \u0a05\u0a28\u0a41\u0a35\u0a3e\u0a26 \u0a17\u0a32\u0a24 \u0a32\u0a71\u0a17\u0a26\u0a3e \u0a39\u0a48",languageWrongDesc:"\u0a21\u0a48\u0a38\