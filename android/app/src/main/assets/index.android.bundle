\u06af\u0627\u0645\u06cc \u0645\u062f\u062f",p6s9e29:"\u0622\u067e \u06a9\u0648 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0642\u0631\u06cc\u0628\u06cc \u0645\u0631\u06cc\u0636\u0648\u06ba \u06a9\u06cc \u0645\u062f\u062f \u06a9\u0631\u06cc\u06ba\u06d4",p1kc2xvx:"\u0645\u0642\u0627\u0645 \u06a9\u0648 \u0645\u0633\u062a\u0642\u0644 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0633\u062f\u0648\u062f \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06be\u0648\u0644\u06cc\u06ba \u2192 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0642\u0627\u0645 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u060c \u067e\u06be\u0631 \u0648\u0627\u067e\u0633 \u0622\u0626\u06cc\u06ba\u06d4",pj1z8my:"\u0645\u0642\u0627\u0645 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u06d2 \u0628\u063a\u06cc\u0631\u060c \u0642\u0631\u06cc\u0628\u06cc \u0645\u0631\u06cc\u0636\u0648\u06ba \u06a9\u0648 \u0622\u067e \u06a9\u0627 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0646\u06c1\u06cc\u06ba \u0645\u0644 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0645\u0642\u0627\u0645 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06cc \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u0645\u062d\u062f\u0648\u062f \u06c1\u0648\u06af\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u06ba\u06d4",pe2sfkx:"\u0645\u0642\u0627\u0645 \u0627\u0628\u06be\u06cc \u0628\u06be\u06cc \u0645\u0633\u062f\u0648\u062f \u06c1\u06d2\u06d4 \u0645\u0642\u0627\u0645\u06cc \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u06cc \u0645\u0631\u0626\u06cc\u062a \u0627\u0648\u0631 \u0645\u0642\u0627\u0645 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u062c\u06cc\u0633\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0679\u06be\u06cc\u06a9 \u0633\u06d2 \u06a9\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba \u06af\u06cc\u06d4",p1bc8b0q:"\u0645\u0642\u0627\u0645 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u06d2 \u0628\u063a\u06cc\u0631 \u0622\u067e \u0642\u0631\u06cc\u0628\u06cc \u06a9\u0646\u0633\u0644\u0679\u0646\u0679\u0633\u060c \u0627\u06a9\u0627\u0624\u0646\u0679 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u0627\u0644\u0631\u0679\u0633 \u0627\u0648\u0631 \u06c1\u0646\u06af\u0627\u0645\u06cc \u0645\u062f\u062f \u0633\u06d2 \u0645\u062d\u0631\u0648\u0645 \u06c1\u0648\u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u06ba\u06d4",p1kxnr6x:"\u0645\u0642\u0627\u0645 \u0627\u0628\u06be\u06cc \u0628\u06be\u06cc \u0645\u0633\u062f\u0648\u062f \u06c1\u06d2\u06d4 \u0642\u0631\u06cc\u0628\u06cc \u06a9\u0646\u0633\u0644\u0679\u0646\u0679\u0633 \u0627\u0648\u0631 \u0627\u06cc\u0645\u0631\u062c\u0646\u0633\u06cc \u0633\u067e\u0648\u0631\u0679 \u062c\u06cc\u0633\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0679\u06be\u06cc\u06a9 \u0633\u06d2 \u06a9\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba \u06af\u06cc\u06d4",p1qfkxpw:"\u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4",p19izdw2:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06d2\u2026",pudz60s:"\u0645\u0642\u0627\u0645 \u062d\u0627\u0635\u0644 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u2026",p1nyz8sj:"\ud83d\udd04 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4",p129dr11:"\ud83d\udccd \u0645\u0642\u0627\u0645 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u06ba\u06d4",p13kffw5:"\u0645\u0642\u0627\u0645 \u06a9\u06d2 \u0628\u063a\u06cc\u0631 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u06cc\u06ba",pr2p72l:"\u0645\u0642\u0627\u0645 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062f\u06c1",pi9375l:"\u0645\u0642\u0627\u0645 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",p1xmhdqy:"\u06a9\u0686\u06be \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0645\u0642\u0627\u0645 \u06a9\u06d2 \u0628\u063a\u06cc\u0631 \u06a9\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba \u06af\u06cc\u06d4 \u06c1\u0645 \u0627\u0633\u06d2 \u0641\u0639\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0633\u062e\u062a\u06cc \u0633\u06d2 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",p1ismk4q:"\u0628\u06c1\u062a\u0631\u06cc\u0646 \u062a\u062c\u0631\u0628\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0645\u0642\u0627\u0645 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u06ba\u06d4 \u0627\u0633 \u0633\u06d2 \u06c1\u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0628\u06c1\u062a\u0631 \u062e\u062f\u0645\u062a \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0622\u067e \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u0631\u06a9\u06be\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4",p1rsaitz:"\u06c1\u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06a9\u06cc\u0648\u06ba \u06c1\u06d2\u06d4",p1lwhuaj:"\ud83d\udd10 \u0622\u067e \u06a9\u0627 \u0645\u0642\u0627\u0645 \u0635\u0631\u0641 \u0627\u0633 \u0648\u0642\u062a \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u062c\u0628 \u0622\u067e \u0627\u06cc\u067e \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u0648\u06ba\u06d4 \u06cc\u06c1 \u06a9\u0628\u06be\u06cc \u0628\u06be\u06cc \u062a\u06cc\u0633\u0631\u06d2 \u0641\u0631\u06cc\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0641\u0631\u0648\u062e\u062a \u06cc\u0627 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4",pi5yj9e:"\u0686\u06be\u0648\u0691\u0646\u0627 \u0622\u067e \u06a9\u06d2 \u062a\u062c\u0631\u0628\u06d2 \u06a9\u0648 \u0645\u062d\u062f\u0648\u062f \u06a9\u0631 \u062f\u06d2 \u06af\u0627\u06d4 \u0622\u067e \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0645\u0642\u0627\u0645 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",p1h299pn:"\u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631\u06cc\u06ba\u06d4",punxvbe:"\u0645\u062c\u06be\u06d2 \u06cc\u0627\u062f \u0631\u06a9\u06be\u0646\u0627",p1djn4vs:"\u0645\u06cc\u0644-\u0627\u0648\u067e\u0646 \u0622\u0624\u0679 \u0644\u0627\u0626\u0646",p9joi0e:"\u0641\u0648\u0646 \u067e\u0648\u0631\u0679\u0631\u06cc\u0679 \u0622\u0624\u0679 \u0644\u0627\u0626\u0646",pcm1nee:"\u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u06cc\u06c1 \u0622\u067e \u06c1\u06cc\u06ba\u06d4",p39qlxn:"\u0633\u06cc\u0634\u0646 \u062a\u0646\u0627\u0632\u0639\u06c1 \u06a9\u0627 \u067e\u062a\u06c1 \u0686\u0644\u0627",p1nl6f5:"\u06c1\u0645 \u0646\u06d2 \u0622\u067e \u06a9\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0627\u06cc \u0645\u06cc\u0644 \u067e\u0631 6 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c\u0627 \u06c1\u06d2\u06d4 \u0627\u067e\u0646\u06d2 \u062f\u0648\u0633\u0631\u06d2 \u0622\u0644\u0627\u062a \u0633\u06d2 \u0633\u0627\u0626\u0646 \u0622\u0624\u0679 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06d2 \u0646\u06cc\u0686\u06d2 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4",p8ykf5k:"\u0622\u067e \u067e\u06c1\u0644\u06d2 \u06c1\u06cc \u06a9\u0633\u06cc \u062f\u0648\u0633\u0631\u06d2 \u0688\u06cc\u0648\u0627\u0626\u0633 \u067e\u0631 \u0644\u0627\u06af \u0627\u0646 \u06c1\u06cc\u06ba\u06d4 \u0627\u0633 \u067e\u0631 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06d2 \u0633\u0627\u0626\u0646 \u0622\u0624\u0679 \u06a9\u0631\u06cc\u06ba\u06d4",p18vcp24:"OTP \u0628\u06be\u06cc\u062c \u0631\u06c1\u0627 \u06c1\u06d2...",p1ntvp8x:"\u062f\u06cc\u06af\u0631 \u0622\u0644\u0627\u062a \u06a9\u0648 \u0644\u0627\u06af \u0622\u0624\u0679 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 OTP \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4",pn5i6fn:"6 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 OTP \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4",p12n3zp8:"\u062a\u0635\u062f\u06cc\u0642 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2...",pohmzat:"\u067e\u0627\u0633 \u0648\u0631\u0688 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0631\u062a\u06cc\u0628 \u062f\u06cc\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u06c1\u06d2...",p1e6s4y0:"\u0627\u06cc \u0645\u06cc\u0644 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0644\u0627\u06af \u0627\u0646 \u06a9\u0631\u06cc\u06ba\u06d4",p1aafagh:"\u0627\u067e\u0646\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0628\u0646\u0627\u0626\u06cc\u06ba",pasmu26:"\u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u0633 \u0637\u0631\u062d \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba Humaeli",pqh0i9l:"\u067e\u0648\u0631\u0679\u0644 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4",pyjrj1w:"\u0635\u0627\u0631\u0641",p1rlv5t:"\u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0634\u06cc\u0631 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba\u06d4",p19cu11q:"\u0627\u067e\u0646\u06cc \u0645\u0634\u0642 \u06a9\u0627 \u0627\u0646\u062a\u0638\u0627\u0645 \u06a9\u0631\u06cc\u06ba\u06d4",pbe3qyw:"\u067e\u06cc\u0634\u06c1 \u0648\u0631\u0627\u0646\u06c1 \u062f\u06cc\u06a9\u06be \u0628\u06be\u0627\u0644 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06cc\u06ba\u06d4",p1d9tqw:"\u0627\u06cc\u0646\u0688 \u0679\u0648 \u0627\u06cc\u0646\u0688 \u0627\u06cc\u0646\u06a9\u0631\u067e\u0679\u0688",p1696fig:"\u0628\u0627\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u06a9\u06cc \u0645\u062d\u0641\u0648\u0638 \u062c\u06af\u06c1",p14mamw2:"\u0627\u06cc\u06a9 \u0646\u062c\u06cc\u060c \u0645\u062d\u0641\u0648\u0638 \u0645\u0627\u062d\u0648\u0644 \u0645\u06cc\u06ba \u0628\u06be\u0631\u0648\u0633\u06c1 \u0645\u0646\u062f \u06a9\u0646\u0633\u0644\u0679\u0646\u0679\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0691\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u06cc \u0630\u06c1\u0646\u06cc \u062a\u0646\u062f\u0631\u0633\u062a\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u0688\u06cc\u0632\u0627\u0626\u0646 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4",p16mi6u6:"\u0635\u062d\u06cc\u062d \u06a9\u0646\u0633\u0644\u0679\u0646\u0679 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba\u06d4",pcyp7gf:"\u062e\u0635\u0648\u0635\u06cc\u062a\u060c \u0632\u0628\u0627\u0646\u060c \u062f\u0633\u062a\u06cc\u0627\u0628\u06cc\u060c \u0645\u0634\u0627\u0648\u0631\u062a \u06a9\u06cc \u0642\u0633\u0645\u060c \u0627\u0648\u0631 \u062c\u0627\u0626\u0632\u0648\u06ba \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u062a\u062c\u0631\u0628\u06c1 \u06a9\u0627\u0631 \u0645\u0634\u06cc\u0631\u0648\u06ba \u06a9\u0648 \u0628\u0631\u0627\u0624\u0632 \u06a9\u0631\u06cc\u06ba\u06d4",p1j7paqb:"\u0622\u067e \u06a9\u0627 AI \u0641\u0644\u0627\u062d \u0648 \u0628\u06c1\u0628\u0648\u062f \u06a9\u0627 \u0633\u0627\u062a\u06be\u06cc",p235k91:"\u06a9\u0633\u06cc \u06a9\u0646\u0633\u0644\u0679\u0646\u0679 \u0633\u06d2 \u062c\u0691\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0641\u0648\u0631\u06cc \u062c\u0630\u0628\u0627\u062a\u06cc \u0645\u062f\u062f\u060c \u062a\u0646\u062f\u0631\u0633\u062a\u06c