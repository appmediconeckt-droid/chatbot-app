\u044a\u0436\u043a\u0430, \u0437\u0430 \u0434\u0430 \u043f\u0440\u0435\u043c\u0438\u043d\u0435\u0442\u0435 \u043a\u044a\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u043d\u0430\u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f Humaeli, \u0434\u0430 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u0447\u0435\u0441\u0442\u043e \u0441\u0440\u0435\u0449\u0430\u043d\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0438 \u0434\u0430 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u043a\u043e\u0433\u0430 \u0434\u0430 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441 \u0441\u043f\u0435\u0448\u043d\u0430 \u043f\u043e\u043c\u043e\u0449 \u0438\u0437\u0432\u044a\u043d \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e.",aiWellnessChat:"AI \u0443\u0435\u043b\u043d\u0435\u0441 \u0447\u0430\u0442",aiWellnessDesc:"\u0417\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u044a\u043f\u0440\u043e\u0441\u0438 \u0437\u0430 \u043f\u0441\u0438\u0445\u0438\u0447\u043d\u043e \u0437\u0434\u0440\u0430\u0432\u0435, \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u0433\u043b\u0430\u0441\u043e\u0432\u043e \u0432\u044a\u0432\u0435\u0436\u0434\u0430\u043d\u0435, \u043f\u043e\u043b\u0443\u0447\u0430\u0432\u0430\u0439\u0442\u0435 \u0431\u044a\u0440\u0437\u0438 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438 \u0438 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u0442\u0435 \u0441\u043a\u043e\u0440\u043e\u0448\u043d\u0438\u044f \u0441\u0438 AI \u0447\u0430\u0442 \u043e\u0442 \u0442\u0430\u0431\u043b\u043e\u0442\u043e \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435.",aiWellnessAction:"\u041e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 AI \u0447\u0430\u0442\u0430",counselorSupport:"\u041f\u043e\u0434\u043a\u0440\u0435\u043f\u0430 \u043e\u0442 \u043a\u043e\u043d\u0441\u0443\u043b\u0442\u0430\u043d\u0442",counselorDesc:"\u041f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438\u0442\u0435 \u043f\u043e \u0438\u043c\u0435, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f, \u0435\u0437\u0438\u043a, \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0438 \u043e\u043d\u043b\u0430\u0439\u043d \u0441\u0442\u0430\u0442\u0443\u0441, \u043f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0437\u0430\u043f\u043e\u0447\u043d\u0435\u0442\u0435 \u0433\u0440\u0438\u0436\u0430.",counselorAction:"\u041d\u0430\u043c\u0435\u0440\u0435\u0442\u0435 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a",appointments:"\u041d\u0430\u0437\u043d\u0430\u0447\u0430\u0432\u0430\u043d\u0438\u044f",appointmentsDesc:"\u041f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0438 \u0438 \u043c\u0438\u043d\u0430\u043b\u0438 \u0441\u0440\u0435\u0449\u0438, \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0437\u0430\u044f\u0432\u043a\u0430\u0442\u0430 \u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u0435\u0441\u0438\u0438 \u0441 \u043d\u0430\u043b\u0438\u0447\u043d\u0438 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438.",appointmentsAction:"\u041f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0430 \u0441\u0440\u0435\u0449\u0438\u0442\u0435",walletPayments:"\u041f\u043e\u0440\u0442\u0444\u0435\u0439\u043b \u0438 \u043f\u043b\u0430\u0449\u0430\u043d\u0438\u044f",walletDesc:"\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043f\u0430\u0440\u0438, \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438\u0442\u0435, \u0438\u0437\u0442\u0435\u0433\u043b\u0435\u0442\u0435 \u043e\u0442\u0447\u0435\u0442\u0438 \u0437\u0430 \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b\u0430 \u0438 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430 \u0437\u0430 \u0432\u044a\u043f\u0440\u043e\u0441\u0438 \u043e\u0442\u043d\u043e\u0441\u043d\u043e \u043f\u043b\u0430\u0449\u0430\u043d\u0438\u044f\u0442\u0430.",walletAction:"\u041e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b\u0430",beforeContact:"\u041f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430",checklist1:"\u041f\u043e\u0442\u0432\u044a\u0440\u0434\u0435\u0442\u0435 \u0432\u0430\u0448\u0430\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0432\u0440\u044a\u0437\u043a\u0430 \u0438 \u043e\u043f\u0440\u0435\u0441\u043d\u0435\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\ufffd\ufffd\u0435\u0442\u043e, \u043f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0441\u044a\u043e\u0431\u0449\u0438\u0442\u0435 \u0437\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0441\u044a\u0441 \u0437\u0430\u0440\u0435\u0436\u0434\u0430\u043d\u0435\u0442\u043e.",checklist2:"\u0421\u044a\u0445\u0440\u0430\u043d\u044f\u0432\u0430\u0439\u0442\u0435 \u043d\u0430\u0439-\u043d\u043e\u0432\u0430\u0442\u0430 \u0435\u043a\u0440\u0430\u043d\u043d\u0430 \u0441\u043d\u0438\u043c\u043a\u0430, \u0442\u043e\u0447\u043d\u0438\u044f \u0447\u0430\u0441 \u0438 \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0430, \u043a\u043e\u0433\u0430\u0442\u043e \u0441\u0435 \u0441\u0432\u044a\u0440\u0437\u0432\u0430\u0442\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430.",checklist3:"\u0417\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0441 \u043a\u0430\u043c\u0435\u0440\u0430\u0442\u0430, \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f\u0442\u0430 \u0438 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u043f\u044a\u0440\u0432\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f\u0442\u0430 \u043d\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e.",checklist4:"\u0417\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0441 \u043f\u043b\u0430\u0449\u0430\u043d\u0435\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u0442\u0435 \u0434\u0430\u0442\u0430, \u0441\u0443\u043c\u0430, \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f \u0438 \u0431\u0430\u043b\u0430\u043d\u0441 \u043d\u0430 \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b\u0430, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e.",commonIssues:"\u0427\u0435\u0441\u0442\u043e \u0441\u0440\u0435\u0449\u0430\u043d\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438",aiChatNotReply:"AI \u0447\u0430\u0442\u044a\u0442 \u043d\u0435 \u043e\u0442\u0433\u043e\u0432\u0430\u0440\u044f",aiChatNotReplyDesc:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0432\u0430\u0448\u0430\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0432\u0440\u044a\u0437\u043a\u0430, \u043e\u043f\u0438\u0442\u0430\u0439\u0442\u0435 \u0434\u0430 \u0438\u0437\u043f\u0440\u0430\u0442\u0438\u0442\u0435 \u043a\u0440\u0430\u0442\u043a\u043e \u0441\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0438 \u043e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 \u043e\u0442\u043d\u043e\u0432\u043e \u0447\u0430\u0442\u0430 \u0441 \u0438\u0437\u043a\u0443\u0441\u0442\u0432\u0435\u043d \u0438\u043d\u0442\u0435\u043b\u0435\u043a\u0442 \u043e\u0442 \u0442\u0430\u0431\u043b\u043e\u0442\u043e \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u0410\u043a\u043e \u0432\u0441\u0435 \u043e\u0449\u0435 \u043d\u0435 \u0443\u0441\u043f\u0435\u0435, \u0441\u043f\u043e\u0434\u0435\u043b\u0435\u0442\u0435 \u0442\u043e\u0447\u043d\u0430\u0442\u0430 \u0435\u043a\u0440\u0430\u043d\u043d\u0430 \u0441\u043d\u0438\u043c\u043a\u0430 \u043d\u0430 \u0433\u0440\u0435\u0448\u043a\u0430\u0442\u0430 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430.",counselorChatNotOpen:"\u0427\u0430\u0442\u044a\u0442 \u043d\u0430 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u043d\u0435 \u0441\u0435 \u043e\u0442\u0432\u0430\u0440\u044f",counselorChatNotOpenDesc:"\u041e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430 \u043d\u0430 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a, \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u043d\u0430\u043b\u0438\u0447\u0435\u043d \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a \u0438 \u0438\u0437\u0447\u0430\u043a\u0430\u0439\u0442\u0435 \u0437\u0430\u044f\u0432\u043a\u0430\u0442\u0430 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u0440\u0438\u0435\u0442\u0430. \u0421\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0449\u0438\u0442\u0435 \u0447\u0430\u0442\u043e\u0432\u0435 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442 \u0432 \u0435\u043a\u0440\u0430\u043d\u0430 \u0437\u0430 \u0447\u0430\u0442 \u043d\u0430 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a\u0430.",callNotConnecting:"\u041e\u0431\u0430\u0436\u0434\u0430\u043d\u0435\u0442\u043e \u043d\u0435 \u0441\u0435 \u0441\u0432\u044a\u0440\u0437\u0432\u0430",callNotConnectingDesc:"\u0423\u0432\u0435\u0440\u0435\u0442\u0435 \u0441\u0435, \u0447\u0435 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a\u044a\u0442 \u0435 \u043f\u0440\u0438\u0435\u043b \u0432\u0430\u0448\u0438\u044f \u0447\u0430\u0442/\u0441\u0435\u0441\u0438\u044f, \u0447\u0435 \u0438 \u0434\u0432\u0430\u043c\u0430\u0442\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438 \u0441\u0430 \u043e\u043d\u043b\u0430\u0439\u043d \u0438 \u0447\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f\u0442\u0430 \u0437\u0430 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d/\u043a\u0430\u043c\u0435\u0440\u0430 \u0441\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438.",walletPaymentIssue:"\u041f\u0440\u043e\u0431\u043b\u0435\u043c \u0441 \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b\u0430 \u0438\u043b\u0438 \u043f\u043b\u0430\u0449\u0430\u043d\u0435\u0442\u043e",walletPaymentIssueDesc:"\u041e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 Wallet, \u0437\u0430 \u0434\u0430 \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0442\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0430\u0442\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f \u0438 \u0434\u0430 \u0438\u0437\u0442\u0435\u0433\u043b\u0438\u0442\u0435 \u043e\u0442\u0447\u0435\u0442. \u0421\u043f\u043e\u0434\u0435\u043b\u0435\u0442\u0435 \u0434\u0430\u0442\u0430\u0442\u0430, \u0441\u0443\u043c\u0430\u0442\u0430 \u0438 \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f\u0442\u0430, \u043a\u043e\u0433\u0430\u0442\u043e \u0441\u0435 \u0441\u0432\u044a\u0440\u0437\u0432\u0430\u0442\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430.",languageWrongTitle:"\u0415\u0437\u0438\u043a\u044a\u0442 \u0438\u043b\u0438 \u043f\u0440\u0435\u0432\u043e\u0434\u044a\u0442 \u0438\u0437\u0433\u043b\u0435\u0436\u0434\u0430\u0442 \u0433\u0440\u0435\u0448\u043d\u0438",languageWrongDesc:"\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430 \u0437\u0430 \u0438\u0437\u0431\u043e\u0440 \u043d\u0430 \u0435\u0437\u0438\u043a \u043e\u0442 \u0442\u0430\u0431\u043b\u043e\u0442\u043e \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435/\u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438. \u041d\u044f\u043a\u043e\u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u0442\u0430\u043d\u0442\u0441\u043a\u0438 \u0438\u043b\u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u0434\u0430\u043d\u043d\u0438 \u043c\u043e\u0436\u0435 \u0434\u0430 \u043e\u0441\u0442\u0430\u043d\u0430\u0442 \u043d\u0430 \u0435\u0437\u0438\u043a\u0430, \u0432\u044a\u0432\u0435\u0434\u0435\u043d \u043e\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u0447\u0438\u043a\u0430.",needMoreHelp:"\u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0435 \u0441\u0435 \u043e\u0442 \u043e\u0449\u0435 \u043f\u043e\u043c\u043e\u0449?",needMoreHelpDesc:"\u0410\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u0439\u0442\u0435 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438\u0442\u0435 \u0437\u0430 \u0430\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0442 \u041f\u0440\u043e\u0444\u0438\u043b/\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438\u043b\u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043f\u043e \u0438\u043c\u0435\u0439\u043b \u0441 \u0435\u043a\u0440\u0430\u043d\u043d\u0438 \u0441\u043d\u0438\u043c\u043a\u0438, \u0432\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e, \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0441\u043a\u0438 \u0438\u043c\u0435\u0439\u043b/\u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0438 \u0442\u043e\u0447\u043d\u043e\u0442\u043e \u0432\u0440\u0435\u043c\u0435, \u043a\u043e\u0433\u0430\u0442\u043e \u0435 \u0432\u044a\u0437\u043d\u0438\u043a\u043d\u0430\u043b \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044a\u0442. \u0417\u0430 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u0430 \u043f\u0440\u0438 \u043a\u0440\u0438\u0437\u0438 \u0432 \u0418\u043d\u0434\u0438\u044f \u0441\u0435 \u043e\u0431\u0430\u0434\u0435\u0442\u0435 \u043d\u0430 9152987821 \u0438\u043b\u0438 \u043d\u0430 \u043c\u0435\u0441\u0442\u043d\u0438\u0442\u0435 \u0441\u043b\u0443\u0436\u0431\u0438 \u0437\u0430 \u0441\u043f\u0435\u0448\u043d\u0430 \u043f\u043e\u043c\u043e\u0449.",myProfile:"\u041c\u043e\u044f\u0442 \u043f\u0440\u043e\u0444\u0438\u043b",settings:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438",emailSupport:"\u041f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043f\u043e \u0438\u043c\u0435\u0439\u043b"},privacyPage:{title:"\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0437\u0430 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442",centerTitle:"\u0426\u0435\u043d\u0442\u044a\u0440 \u0437\u0430 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 Humaeli",centerDesc:"\u0422\u043e\u0437\u0438 \u0446\u0435\u043d\u0442\u044a\u0440 \u0437\u0430 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 \u043e\u0431\u044f\u0441\u043d\u044f\u0432\u0430 \u043a\u0430\u043a Humaeli \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0432\u0430\u0448\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b, \u0447\u0430\u0442, \u0441\u0440\u0435\u0449\u0430, \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b, \u043e\u0431\u0430\u0436\u0434\u0430\u043d\u0435, \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0434\u0430\u043d\u043d\u0438 \u0437\u0430 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0432 \u0442\u043e\u0432\u0430 \u043c\u043e\u0431\u0438\u043b\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435.",otpProtected:"OTP \u0437\u0430\u0449\u0438\u0442\u0435\u043d",otpProtectedDesc:"\u041f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u0438\u043c\u0435\u0439\u043b \u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d",anonymousCare:"\u0421\u0430\u043c\u043e\u043b\u0438\u0447\u043d\u043e\u0441\u0442 \u043d\u0430 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u0430 \u0433\u0440\u0438\u0436\u0430",anonCareDesc:"\u041f\u043e\u043a\u0430\u0437\u0432\u0430 \u0441\u0435 \u043d\u0430 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438, \u043a\u044a\u0434\u0435\u0442\u043e \u0441\u0435 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430",sensitiveAreas:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u043d\u0438 \u0437\u043e\u043d\u0438",sensitiveAreasDesc:"\u0427\u0430\u0442\u043e\u0432\u0435, \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438, \u0441\u0440\u0435\u0449\u0438, \u043f\u0440\u043e\u0444\u0438\u043b",dataUsedTitle:"\u0414\u0430\u043d\u043d\u0438, \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e",profileHealth:"\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u043e\u0444\u0438\u043b \u0438 \u0437\u0434\u0440\u0430\u0432\u0435",profileHealthDesc:"\u0412\u0430\u0448\u0435\u0442\u043e \u0438\u043c\u0435, \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u043e \u0435\u043a\u0440\u0430\u043d\u043d\u043e \u0438\u043c\u0435, \u0432\u044a\u0437\u0440\u0430\u0441\u0442, \u043f\u043e\u043b, \u0434\u0430\u043d\u043d\u0438 \u0437\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442, \u0441\u043d\u0438\u043c\u043a\u0430/\u0430\u0432\u0430\u0442\u0430\u0440, \u0430\u0434\u0440\u0435\u0441, \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0437\u0430 \u0441\u043f\u0435\u0448\u043d\u0438 \u0441\u043b\u0443\u0447\u0430\u0438, \u043e\u0441\u043d\ufffd\ufffd\u0432\u043d\u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u0434\u0430\u043d\u043d\u0438 \u0438 \u043f\u043e\u043b\u0435\u0442\u0430 \u0437\u0430 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430\u043d\u0435 \u043d\u0430 \u0432\u0430\u0448\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0441\u043a\u0438 \u043f\u0440\u043e\u0444\u0438\u043b.",aiConversations:"AI \u0447\u0430\u0442 \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438 \u0441\u044a\u0441 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a",aiConversationsDesc:"\u0421\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u0431\u044a\u0440\u0437\u0438 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438, \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u0447\u0430\u0442, \u043f\u0440\u0438\u043a\u0430\u0447\u0435\u043d\u0438 \u0444\u0430\u0439\u043b\u043e\u0432\u0435, \u043f\u0440\u0438\u0435\u0442\u0438 \u0447\u0430\u0442 \u0441\u0435\u0441\u0438\u0438 \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a\u0430 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438, \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0442\u0430 \u0438 \u043f\u043e\u0434\u043a\u0430\u043d\u0438 \u0437\u0430 \u043e\u0446\u0435\u043d\u043a\u0430 \u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430.",appointments:"\u0421\u0440\u0435\u0449\u0438 \u0438 \u0441\u0435\u0441\u0438\u0438",appointmentsDesc:"\u0414\u0430\u0442\u0430\u0442\u0430, \u0447\u0430\u0441\u044a\u0442, \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u0442\u0430/\u0431\u0435\u043b\u0435\u0436\u043a\u0438\u0442\u0435, \u0441\u0442\u0430\u0442\u0443\u0441\u044a\u0442, \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u0442 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a, \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u0437\u0430 \u043e\u0431\u0430\u0436\u0434\u0430\u043d\u0435\u0442\u043e \u0438 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0442\u0430 \u043d\u0430 \u0441\u0435\u0441\u0438\u0438\u0442\u0435 \u043f\u043e\u043c\u0430\u0433\u0430\u0442 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u0438 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0432\u0430\u0442 \u0433\u0440\u0438\u0436\u0438\u0442\u0435.",wallet:"\u041f\u043e\u0440\u0442\u0444\u0435\u0439\u043b \u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438",walletDesc:"\u0411\u0430\u043b\u0430\u043d\u0441\u044a\u0442 \u043d\u0430 \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b\u0430, \u043f\u0440\u0435\u0437\u0430\u0440\u0435\u0436\u0434\u0430\u043d\u0438\u044f\u0442\u0430, \u0437\u0430\u043f\u0438\u0441\u0438\u0442\u0435 \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438\u0442\u0435, \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0438\u0442\u0435 \u043e\u0442\u0447\u0435\u0442\u0438 \u0438 \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0438\u044f\u0442 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430 \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u0449\u0430\u043d\u0438\u044f\u0442\u0430.",location:"\u041c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043a\u043e\ufffd\ufffd\u0442\u0435\u043a\u0441\u0442 \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e",locationDesc:"\u041c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u0437\u0430\u0441\u043d\u0435\u0442\u043e \u043f\u0440\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f, \u0432\u043b\u0438\u0437\u0430\u043d\u0435 \u0438\u043b\u0438 \u0440\u044a\u0447\u043d\u043e \u043e\u043f\u0440\u0435\u0441\u043d\u044f\u0432\u0430\u043d\u0435, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u043f\u043e\u0442\u0432\u044a\u0440\u0434\u044f\u0442 \u0441\u0435\u0441\u0438\u0438\u0442\u0435, \u0434\u0430 \u0441\u0435 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0430\u043a\u0430\u0443\u043d\u0442\u0430 \u0438 \u0434\u0430 \u0441\u0435 \u043f\u043e\u0434\u043e\u0431\u0440\u044f\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\u0442\u0435 \u0437\u0430 \u0433\u0440\u0438\u0436\u0430 \u0437\u0430 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e.",security:"\u0421\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0438 \u0434\u043e\u0441\u0442\u044a\u043f \u0434\u043e \u0430\u043a\u0430\u0443\u043d\u0442\u0430",securityDesc:"\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0441\u0435 \u0442\u043e\u043a\u0435\u043d\u0438 \u0437\u0430 \u0432\u043b\u0438\u0437\u0430\u043d\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u0447\u0438\u043a \u043d\u0430 \u0443\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u044f\u0432\u0430\u043d\u0435, \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u043f\u0430\u0440\u043e\u043b\u0430, OTP \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430, \u0440\u043e\u043b\u044f \u0438 \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u0430\u043a\u0430\u0443\u043d\u0442\u0430, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0434\u044a\u0440\u0436\u0430\u0442 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u0435\u043d\u0438 \u0437\u043e\u043d\u0438\u0442\u0435 \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438 \u0438 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438.",whoCanSee:"\u041a\u043e\u0439 \u043a\u0430\u043a\u0432\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u0432\u0438\u0434\u0438",visibleToYou:"\u0412\u0438\u0434\u0438\u043c \u0437\u0430 \u0432\u0430\u0441",visibleDesc:"\u0412\u0430\u0448\u0435\u0442\u043e \u0442\u0430\u0431\u043b\u043e \u043f\u043e\u043a\u0430\u0437\u0432\u0430 \u0432\u0430\u0448\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b, AI \u0447\u0430\u0442\u043e\u0432\u0435, \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441\u044a\u0441 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438, \u0441\u0440\u0435\u0449\u0438, \u043f\u043e\u0440\u0442\u0444\u0435\u0439\u043b, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043d\u0430 \u043e\u0431\u0430\u0436\u0434\u0430\u043d\u0438\u044f\u0442\u0430, \u043f\u043e\u0434\u043a\u0430\u043d\u0438 \u0437\u0430 \u043e\u0446\u0435\u043d\u043a\u0438 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438 \u0437\u0430 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435/\u0430\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f.",sharedForCare:"\u0421\u043f\u043e\u0434\u0435\u043b\u0435\u043d\u043e \u0437\u0430 \u0433\u0440\u0438\u0436\u0430",sharedDesc:"\u0421\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438\u0442\u0435 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0432\u0438\u0434\u044f\u0442 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\u0442\u0430, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0438\u0435\u0442\u0438\u0442\u0435 \u0441\u0435\u0441\u0438\u0438, \u0441\u0440\u0435\u0449\u0438 \u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430. \u041a\u043e\u0433\u0430\u0442\u043e \u0441\u0435 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430, \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u0430 \u0441\u0430\u043c\u043e\u043b\u0438\u0447\u043d\u043e\u0441\u0442.",protectedAccess:"\u0417\u0430\u0449\u0438\u0442\u0435\u043d \u043e\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b \u043d\u0430 \u0434\u043e\u0441\u0442\u044a\u043f\u0430",protectedDesc:"\u0417\u043e\u043d\u0438\u0442\u0435 \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438 \u0438 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438 \u0441\u0430 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438 \u043f\u043e \u0440\u043e\u043b\u0438, \u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u0441\u0435\u0441\u0438\u0438, OTP \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0438 \u0443\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u0435\u043d\u0438 API \u0437\u0430\u044f\u0432\u043a\u0438.",checklist:"\u0412\u0430\u0448\u0438\u044f\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043d \u0441\u043f\u0438\u0441\u044a\u043a \u0437\u0430 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442",checklistItem1:"\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u043e\u0442\u043e \u0441\u0438 \u0438\ufffd\ufffd\u0435 \u0437\u0430 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u044a\u0441 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a, \u043a\u043e\u0433\u0430\u0442\u043e \u043d\u0435 \u0438\u0441\u043a\u0430\u0442\u0435 \u0438\u0441\u0442\u0438\u043d\u0441\u043a\u043e\u0442\u043e \u0432\u0438 \u0438\u043c\u0435 \u0434\u0430 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430.",checklistItem2:"\u041f\u043e\u0434\u0434\u044a\u0440\u0436\u0430\u0439\u0442\u0435 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u0437\u0430 \u0441\u043f\u0435\u0448\u0435\u043d \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b \u0442\u043e\u0447\u043d\u0438, \u0430\u043a\u043e \u0440\u0435\u0448\u0438\u0442\u0435 \u0434\u0430 \u0433\u0438 \u043f\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435.",checklistItem3:"\u041f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f\u0442\u0430 \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e \u0437\u0430 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043a\u0430\u043c\u0435\u0440\u0430 \u0438 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d \u043f\u0440\u0435\u0434\u0438 \u043e\u0431\u0430\u0436\u0434\u0430\u043d\u0438\u044f.",checklistItem4:"\u0410\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u0439\u0442\u0435 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u0440\u044a\u0447\u043d\u043e \u043e\u0442 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438/\u041f\u0440\u043e\u0444\u0438\u043b, \u0430\u043a\u043e \u043f\u043e\u0434\u043a\u0430\u043d\u0430\u0442\u0430 \u0437\u0430 \u0432\u043b\u0438\u0437\u0430\u043d\u0435 \u0435 \u0431\u0438\u043b\u0430 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u0430\u0442\u0430.",checklistItem5:"\u041d\u0435 \u0441\u043f\u043e\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u0435\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u0438 \u043f\u0430\u0440\u043e\u043b\u0438, \u043f\u0430\u0440\u043e\u043b\u0438 \u0438\u043b\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u043d\u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0430\u043a\u0430\u0443\u043d\u0442\u0430 \u0432 \u0441\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u0442\u0430 \u0437\u0430 \u0447\u0430\u0442.",checklistItem6:"\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u041c\u043e\u044f\u0442 \u043f\u0440\u043e\u0444\u0438\u043b \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0437\u0430 \u0434\u0430 \