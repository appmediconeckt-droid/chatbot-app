\u0941\u0939\u094b\u0938\u094d",pyjmdam:"\u092a\u091b\u093e\u0921\u093f",p13cyvef:"\u0905\u0939\u093f\u0932\u0947 \u0928\u0948 \u092e\u0926\u094d\u0926\u0924 \u091a\u093e\u0939\u093f\u0928\u094d\u091b?",pp3ccct:"\u0924\u0941\u0930\u0941\u0928\u094d\u0924\u0948 \u092e\u0926\u094d\u0926\u0924 \u092a\u0941\u0917\u094d\u0928\u0941\u0939\u094b\u0938\u094d - \u0915\u0941\u0928\u0948 \u0905\u0928\u0932\u0915 \u0906\u0935\u0936\u094d\u092f\u0915 \u091b\u0948\u0928\u0964",pg43fcb:"\u0938\u0902\u0915\u091f \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928",pe35won:"Tele-MANAS \xb7",pp9u4ue:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928",p2sc9b1:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u093f\u0930\u094d\u0938\u0928\u0941\u092d\u092f\u094b",p76voo8:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u093f\u0938\u0947\u091f OTP \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0917\u0930\u094d\u0928 \u0906\u092b\u094d\u0928\u094b \u0926\u0930\u094d\u0924\u093e \u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pd03ywl:"\u0907\u092e\u0947\u0932 \u0920\u0947\u0917\u093e\u0928\u093e *",p8j8ry0:"\u0906\u092b\u094d\u0928\u094b \u0926\u0930\u094d\u0924\u093e \u0907\u092e\u0947\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p5xb4hz:"\u0930\u093f\u0938\u0947\u091f OTP \u092a\u0920\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",p1euz9g3:"\u0906\u092b\u094d\u0928\u094b \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e\u0926 \u091b?",p1t4d3di:"\u0932\u0917\u0907\u0928 \u092e\u093e \u092b\u0930\u094d\u0915\u0928\u0941\u0939\u094b\u0938\u094d",pwma6xl:"OTP \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pw0vy4i:"\u092a\u0920\u093e\u0907\u090f\u0915\u094b \u096c \u0905\u0902\u0915\u0915\u094b \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u09