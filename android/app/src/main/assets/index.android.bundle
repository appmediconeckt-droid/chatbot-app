dyHaveChat:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u092f\u093e \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0936\u0940 \u0906\u0927\u0940\u091a \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u0945\u091f \u0906\u0939\u0947.",tapChatNowToContinue:"\u0924\u0941\u092e\u091a\u0947 \u0938\u0902\u092d\u093e\u0937\u0923 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0924\u093e \u091a\u0945\u091f \u0915\u0930\u093e \u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e.",sessionRequestWillBeSent:"\u0924\u0941\u092e\u091a\u0940 \u0938\u0924\u094d\u0930 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u0940 \u091c\u093e\u0908\u0932.",youCanChatOnceAccepts:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0928\u0947 \u0924\u0941\u092e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u091a\u0945\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",chatting:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u093f\u0928\u093e\u0935\u0940\u092a\u0923\u0947 \u091a\u0945\u091f \u0915\u0930\u0924 \u0906\u0939\u093e\u0924:",sessionRequestSent:"\u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u093e\u0920\u0935\u0932\u0940",sessionRequestMessage:"\u0938\u0924\u094d\u0930 \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u093e\u0920\u0935\u0932\u0940. \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0928\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u091a\u0945\u091f \u0909\u0918\u0921\u0942 \u0936\u0915\u0924\u093e.",counselorNotSelected:"\u0924\u094d\u0930\u0941\u091f\u0940",counselorNotSelectedMessage:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u093e \u0928\u093e\u0939\u0940",invalidDate:"\u0905\u0935\u0948\u0927 \u0924\u093e\u0930\u0940\u0916",pleaseChooseValidDateTime:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092d\u0947\u091f\u0940\u091a\u0940 \u0924\u093e\u0930\u0940\u0916 \u0906\u0923\u093f \u0935\u0947\u0933 \u0928\u093f\u0935\u0921\u093e.",invalidTime:"\u0905\u0935\u0948\u0927 \u0935\u0947\u0933",pleaseChooseFutureDateTime:"\u0915\u0943\u092a\u092f\u093e \u092d\u0947\u091f\u0940\u0938\u093e\u0920\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u093e\u0924\u0940\u0932 \u0924\u093e\u0930\u0940\u0916 \u0906\u0923\u093f \u0935\u0947\u0933 \u0928\u093f\u0935\u0921\u093e.",clinicalNotesRequired:"\u0915\u094d\u0932\u093f\u0928\u093f\u0915\u0932 \u0928\u094b\u091f\u094d\u0938 \u0906\u0935\u0936\u094d\u092f\u0915",pleaseAddReasonForBooking:"\u0915\u0943\u092a\u092f\u093e \u0939\u0940 \u092d\u0947\u091f \u092c\u0941\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0947 \u0924\u0941\u092e\u091a\u0947 \u0915\u093e\u0930\u0923 \u091c\u094b\u0921\u093e.",bookedSuccessfully:"\u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u092c\u0941\u0915 \u0915\u0947\u0932\u0947",appointmentRequestSent:"\u092d\u0947\u091f\u0940\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u093e\u0920\u0935\u0932\u0940. \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0932\u093e \u0938\u0942\u091a\u093f\u0924 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947.",bookingFailed:"\u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u092f\u0936\u0938\u094d\u0935\u0940",failedToBook:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092c\u0941\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940.",accepted:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0947",searchCounselorPlaceholder:"\u0928\u093e\u0935, \u0938\u094d\u092a\u0947\u0936\u0932\u093e\u092f\u091d\u0947\u0936\u0928 \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0925\u093e\u0928\u093e\u0928\u0941\u0938\u093e\u0930 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e",sessionReasonPlaceholder:"\u092f\u093e \u0938\u0924\u094d\u0930\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u093e\u092f \u091a\u0930\u094d\u091a\u093e \u0915\u0930\u093e\u092f\u091a\u0940 \u0906\u0939\u0947 \u0924\u0947 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e..."},helpPage:{title:"\u092e\u0926\u0924 \u0938\u092e\u0930\u094d\u0925\u0928",centerTitle:"Humaeli \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0947\u0902\u0926\u094d\u0930",centerDesc:"\u0909\u091c\u0935\u094d\u092f\u093e Humaeli \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u093e\u0935\u0930 \u091c\u093e\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u0902\u091a\u0947 \u0928\u093f\u0935\u093e\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0972\u092a\u091a\u094d\u092f\u093e \u092c\u093e\u0939\u0947\u0930 \u0924\u093e\u0924\u0921\u0940\u091a\u094d\u092f\u093e \u092e\u0926\u0924\u0940\u0936\u0940 \u0915\u0927\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e\u0935\u093e \u0939\u0947 \u0938\u092e\u091c\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u0947 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0935\u093e\u092a\u0930\u093e.",aiWellnessChat:"\u090f\u0906\u092f \u0935\u0947\u0932\u0928\u0947\u0938 \u091a\u0945\u091f",aiWellnessDesc:"\u092e\u093e\u0928\u0938\u093f\u0915-\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f\u093e\u091a\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u0935\u093f\u091a\u093e\u0930\u093e, \u0935\u094d\u0939\u0949\u0907\u0938 \u0907\u0928\u092a\u0941\u091f \u0935\u093e\u092a\u0930\u093e, \u0926\u094d\u0930\u0941\u0924 \u0909\u0924\u094d\u0924\u0930\u0947 \u092e\u093f\u0933\u0935\u093e \u0906\u0923\u093f \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930\u0942\u0928 \u0924\u0941\u092e\u091a\u0940 \u0905\u0932\u0940\u0915\u0921\u0940\u0932 AI \u091a\u0945\u091f \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e.",aiWellnessAction:"AI \u091a\u0945\u091f \u0909\u0918\u0921\u093e",counselorSupport:"\u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u092e\u0930\u094d\u0925\u0928",counselorDesc:"\u0915\u093e\u0933\u091c\u0940 \u0938\u0941\u0930\u0942 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0928\u093e\u0935, \u0938\u094d\u092a\u0947\u0936\u0932\u093e\u092f\u091d\u0947\u0936\u0928, \u092d\u093e\u0937\u093e, \u0938\u094d\u0925\u093e\u0928, \u0930\u0947\u091f\u093f\u0902\u0917 \u0906\u0923\u093f \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u0925\u093f\u0924\u0940\u0928\u0941\u0938\u093e\u0930 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u092c\u094d\u0930\u093e\u0909\u091d \u0915\u0930\u093e.",counselorAction:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e",appointments:"\u092d\u0947\u091f\u0940",appointmentsDesc:"\u0906\u0917\u093e\u092e\u0940 \u0906\u0923\u093f \u092e\u093e\u0917\u0940\u0932 \u092d\u0947\u091f\u0940\u0902\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e, \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915\u093e\u0902\u0938\u0939 \u0938\u0924\u094d\u0930 \u092c\u0941\u0915 \u0915\u0930\u093e.",appointmentsAction:"\u092d\u0947\u091f\u0940 \u092a\u0939\u093e",walletPayments:"\u0935\u0949\u0932\u0947\u091f \u0906\u0923\u093f \u092a\u0947\u092e\u0947\u0902\u091f",walletDesc:"\u092a\u0948\u0938\u0947 \u091c\u094b\u0921\u093e, \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0902\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e, \u0935\u0949\u0932\u0947\u091f \u0905\u0939\u0935\u093e\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u0947\u092e\u0947\u0902\u091f \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.",walletAction:"\u092a\u093e\u0915\u0940\u091f \u0909\u0918\u0921\u093e",beforeContact:"\u0906\u092a\u0923 \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940",checklist1:"\u0932\u094b\u0921\u093f\u0902\u0917 \u0938\u092e\u0938\u094d\u092f\u0947\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\ufffd\ufffd\ufffd \u0915\u0928\u0947\u0915\u094d\u0936\u0928\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e \u0906\u0923\u093f \u0972\u092a \u0930\u093f\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u093e.",checklist2:"\u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0924\u093e\u0928\u093e \u0928\u0935\u0940\u0928\u0924\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f, \u0905\u091a\u0942\u0915 \u0935\u0947\u0933 \u0906\u0923\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928\u093e\u0935 \u0924\u092f\u093e\u0930 \u0920\u0947\u0935\u093e.",checklist3:"\u0915\u0945\u092e\u0947\u0930\u093e, \u092e\u093e\u092f\u0915\u094d\u0930\u094b\u092b\u094b\u0928, \u0938\u0942\u091a\u0928\u093e \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928 \u0938\u092e\u0938\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940, \u092a\u094d\u0930\u0925\u092e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0972\u092a \u092a\u0930\u0935\u093e\u0928\u0917\u094d\u092f\u093e \u0924\u092a\u093e\u0938\u093e.",checklist4:"\u092a\u0947\u092e\u0947\u0902\u091f \u0938\u092e\u0938\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940, \u0972\u092a\u092e\u0927\u094d\u092f\u0947 \u0926\u093e\u0916\u0935\u0932\u0947\u0932\u0940 \u0924\u093e\u0930\u0940\u0916, \u0930\u0915\u094d\u0915\u092e, \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0906\u0923\u093f \u0935\u0949\u0932\u0947\u091f \u0936\u093f\u0932\u094d\u0932\u0915 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.",commonIssues:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e",aiChatNotReply:"AI \u091a\u0945\u091f \u0909\u0924\u094d\u0924\u0930 \u0926\u0947\u0924 \u0928\u093e\u0939\u0940",aiChatNotReplyDesc:"\u0924\u0941\u092e\u091a\u0947 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u092a\u093e\u0938\u093e, \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u0902\u0926\u0947\u0936 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e \u0906\u0923\u093f \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930\u0942\u0928 AI \u091a\u0945\u091f \u092a\u0941\u0928\u094d\u0939\u093e \u0909\u0918\u0921\u093e. \u0924\u0930\u0940\u0939\u0940 \u0905\u092f\u0936\u0938\u094d\u0935\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u0938, \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0938\u0939 \u0905\u091a\u0942\u0915 \u0924\u094d\u0930\u0941\u091f\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u093e.",counselorChatNotOpen:"\u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0917\u092a\u094d\u092a\u093e \u0909\u0918\u0921\u0924 \u0928\u093e\u0939\u0940",counselorChatNotOpenDesc:"\u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u092e\u0930\u094d\u0925\u0928 \u0909\u0918\u0921\u093e, \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0935\u093f\u0928\u0902\u0924\u0940 \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u093e. \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0917\u092a\u094d\u092a\u093e \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u091a\u0945\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 \u0926\u093f\u0938\u0924\u093e\u0924.",callNotConnecting:"\u0915\u0949\u0932 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924 \u0928\u093e\u0939\u0940",callNotConnectingDesc:"\u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915\u093e\u0928\u0947 \u0924\u0941\u092e\u091a\u0947 \u091a\u0945\u091f/\u0938\u0924\u094d\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e, \u0926\u094b\u0928\u094d\u0939\u0940 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u0911\u0928\u0932\u093e\u0907\u0928 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u092e\u093e\u092f\u0915\u094d\u0930\u094b\u092b\u094b\u0928/\u0915\u0945\u092e\u0947\u0930\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u094d\u092f\u093e \u0906\u0939\u0947\u0924.",walletPaymentIssue:"\u0935\u0949\u0932\u0947\u091f \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u092e\u0938\u094d\u092f\u093e",walletPaymentIssueDesc:"\u0928\u0935\u0940\u0928\u0924\u092e \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0905\u0939\u0935\u093e\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 Wallet \u0909\u0918\u0921\u093e. \u0938\u092a\u094b\u0930\u094d\u091f\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0924\u093e\u0928\u093e \u0924\u093e\u0930\u0940\u0916, \u0930\u0915\u094d\u0915\u092e \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e.",languageWrongTitle:"\u092d\u093e\u0937\u093e \u0915\u093f\u0902\u0935\u093e \u092d\u093e\u0937\u093e\u0902\u0924\u0930 \u091a\u0941\u0915\u0940\u091a\u0947 \u0926\u093f\u0938\u0924\u0947",languageWrongDesc:"\u0921\u0945\u0936\u092c\u094b\ufffd\ufffd\u094d\u0921/\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c\u092e\u0927\u0942\u0928 \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u0915 \u0935\u093e\u092a\u0930\u093e. \u0915\u093e\u0939\u0940 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0915\u093f\u0902\u0935\u093e \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0926\u093e\u0924\u094d\u092f\u093e\u0928\u0947 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092d\u093e\u0937\u0947\u0924 \u0930\u093e\u0939\u0942 \u0936\u0915\u0924\u093e\u0924.",needMoreHelp:"\u0906\u0923\u0916\u0940 \u092e\u0926\u0924 \u0939\u0935\u0940 \u0906\u0939\u0947?",needMoreHelpDesc:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932/\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0935\u0930\u0942\u0928 \u0916\u093e\u0924\u0947 \u0924\u092a\u0936\u0940\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f, \u0972\u092a \u0906\u0935\u0943\u0924\u094d\u0924\u0940, \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0908\u092e\u0947\u0932/\u092b\u094b\u0928 \u0906\u0923\u093f \u0938\u092e\u0938\u094d\u092f\u093e \u0928\u0947\u092e\u0915\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0935\u0947\u0933\u0940 \u0906\u0932\u0940 \u092f\u093e\u0938\u0939 \u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928. \u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u092e\u0926\u0924\u0940\u0938\u093e\u0920\u0940, 9152987821 \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0947\u0935\u093e\u0902\u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e.",myProfile:"\u092e\u093e\u091d\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",settings:"\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c",emailSupport:"\u0908\u092e\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928"},privacyPage:{title:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923",centerTitle:"Humaeli \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930",centerDesc:"\u0939\u0947 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0939\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0924\u0947 \u0915\u0940 Humaeli \u0924\u0941\u092e\u091a\u093e \u092a\u094d\u0930\u094b\ufffd\ufffd\u093e\u0907\u0932, \u091a\u0945\u091f, \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f, \u0935\u0949\u0932\u0947\u091f, \u0915\u0949\u0932, \u0938\u094d\u0925\u093e\u0928 \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u0924\u093e \u0921\u0947\u091f\u093e \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0972\u092a\u092e\u0927\u094d\u092f\u0947 \u0915\u0938\u093e \u0935\u093e\u092a\u0930\u0924\u094b.",otpProtected:"OTP \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924",otpProtectedDesc:"\u0908\u092e\u0947\u0932 \u0906\u0923\u093f \u092b\u094b\u0928 \u092c\u0926\u0932",anonymousCare:"\u0928\u093f\u0928\u093e\u0935\u0940 \u0915\u093e\u0933\u091c\u0940 \u0913\u0933\u0916",anonCareDesc:"\u0938\u092a\u094b\u0930\u094d\u091f \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915\u093e\u0902\u0928\u093e \u0926\u093e\u0916\u0935\u0932\u0947",sensitiveAreas:"\u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0947",sensitiveAreasDesc:"\u0917\u092a\u094d\u092a\u093e, \u0915\u0949\u0932, \u092d\u0947\u091f\u0940, \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",dataUsedTitle:"\u0972\u092a\u092e\u0927\u094d\u092f\u0947 \u0935\u093e\u092a\u0930\u0932\u0947\u0932\u093e \u0921\u0947\u091f\u093e",profileHealth:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0906\u0923\u093f \u0906\u0930\u094b\u0917\u094d\u092f \u0924\u092a\u0936\u0940\u0932",profileHealthDesc:"\u0924\u0941\u092e\u091a\u0947 \u0928\u093e\u0935, \u0928\u093f\u0928\u093e\u0935\u0940 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0928\u093e\u0935, \u0935\u092f, \u0932\u093f\u0902\u0917, \u0938\u0902\u092a\u0930\u094d\u0915 \u0924\u092a\u0936\u0940\u0932, \u092b\u094b\u091f\u094b/\u0905\u0935\u0924\u093e\u0930, \u092a\u0924\u094d\u0924\u093e, \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u092a\u0930\u094d\u0915, \u092e\u0942\u0932\u092d\u0942\u0924 \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932 \u0906\u0923\u093f \u0935\u093f\u092e\u093e \u092b\u0940\u0932\u094d\u0921 \u0924\u0941\u092e\u091a\u0940 \u0930\u0941\u0917\u094d\u0923 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0930\u093e\u0916\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0940 \u091c\u093e\u0924\u093e\u0924.",aiConversations:"\u090f\u0906\u092f \u091a\u0945\u091f \u0906\u0923\u093f \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u0902\u092d\u093e\u0937\u0923\u0947",aiConversationsDesc:"\u0938\u0902\u0926\u0947\u0936, \u0926\u094d\u0930\u0941\u0924 \u092a\u094d\u0930\u0924\u094d\u092f\u0941\u0924\u094d\u0924\u0930\u0947, \u091a\u0945\u091f \u0938\u094d\u0925\u093f\u0924\u0940, \u0938\u0902\u0932\u0917\u094d\u0928\u0915, \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u0945\u091f \u0938\u0924\u094d\u0930\u0947 \u0906\u0923\u093f \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0924\u092a\u0936\u0940\u0932 \u0938\u0902\u092d\u093e\u0937\u0923\ufffd\ufffd\ufffd \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0907\u0924\u093f\u0939\u093e\u0938 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0930\u0947\u091f\u093f\u0902\u0917 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f\u0932\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.",appointments:"\u092d\u0947\u091f\u0940 \u0906\u0923\u093f \u0938\u0924\u094d\u0930\u0947",appointmentsDesc:"\u092d\u0947\u091f\u0940\u091a\u0940 \u0924\u093e\u0930\u0940\u0916, \u0935\u0947\u0933, \u0915\u093e\u0930\u0923/\u0928\u094b\u091f\u094d\u0938, \u0938\u094d\u0925\u093f\u0924\u0940, \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930, \u0915\u0949\u0932 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e \u0906\u0923\u093f \u0938\u0924\u094d\u0930 \u0907\u0924\u093f\u0939\u093e\u0938 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u0906\u0923\u093f \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915\u093e\u0902\u0928\u093e \u0915\u093e\u0933\u091c\u0940 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0924\u093e\u0924.",wallet:"\u0935\u0949\u0932\u0947\u091f \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930",walletDesc:"\u092a\u0947\u092e\u0947\u0902\u091f \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917\u0938\u093e\u0920\u0940 \u0935\u0949\u0932\u0947\u091f \u0936\u093f\u0932\u094d\u0932\u0915, \u091f\u0949\u092a-\u0905\u092a, \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0930\u0947\u0915\u0949\u0930\u094d\u0921, \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0905\u0939\u0935\u093e\u0932 \u0906\u0923\u093f \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.",location:"\u0938\u094d\u0925\u093e\u0928 \u0906\u0923\u093f \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0938\u0902\u0926\u0930\u094d\u092d",locationDesc:"\u0938\u0924\u094d\u0930\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0916\u093e\u0924\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u0924\u0947\u0932\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928-\u091c\u093e\u0917\u0930\u0942\u0915 \u0915\u093e\u0933\u091c\u0940 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0938\u0941\u0927\u093e\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u093e\u0907\u0928\u0905\u092a, \u0932\u0949\u0917\u093f\u0928 \u0915\u093f\u0902\u0935\u093e \u092e\u0945\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u093f\u092b\u094d\u0930\u0947\u0936\u0935\u0930 \u0938\u094d\u0925\u093e\u0928 \u0915\u0945\u092a\u094d\u091a\u0930 \u0915\u0947\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.",security:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0906\u0923\u093f \u0916\u093e\u0924\u0947 \u092a\u094d\u0930\u0935\u0947\u0936",securityDesc:"\u0932\u0949\u0917\u093f\u0928 \u091f\u094b\u0915\u0928, \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0924\u093e, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u094d\u0925\u093f\u0924\u0940, OTP \u092a\u0921\u0924\u093e\u0933\u0923\u0940, \u092d\u0942\u092e\u093f\u0915\u093e \u0906\u0923\u093f \u0916\u093e\u0924\u0947 \u0938\u094d\u0925\u093f\u0924\u0940 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0906\u0923\u093f \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0935\u0947\u0917\u0933\u0947 \u0906\u0923\u093f \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.",whoCanSee:"\u0915\u094b\u0923 \u0915\u093e\u092f \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u094b",visibleToYou:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0926\u0943\u0936\u094d\u092f\u092e\u093e\u0928",visibleDesc:"\u0924\u0941\ufffd\ufffd\ufffd\u091a\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921 \u0924\u0941\u092e\u091a\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, AI \u091a\u0945\u091f\u094d\u0938, \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u0902\u0935\u093e\u0926, \u092d\u0947\u091f\u0940, \u0935\u0949\u0932\u0947\u091f, \u0915\u0949\u0932 \u0907\u0924\u093f\u0939\u093e\u0938, \u0930\u0947\u091f\u093f\u0902\u0917 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928/\u0905\u092a\u0921\u0947\u091f \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923\u0947 \u0926\u093e\u0916\u0935\u0924\u094b.",sharedForCare:"\u0915\u093e\u0933\u091c\u0940\u0938\u093e\u0920\u0940 \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0947\u0932\u0947",sharedDesc:"\u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0947\u0932\u0940 \u0938\u0924\u094d\u0930\u0947, \u092d\u0947\u091f\u0940 \u0906\u0923\u093f \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0902\u092d\u093e\u0937\u0923\u0947 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e\u0924. \u0928\u093f\u0928\u093e\u0935\u0940 \u0913\u0933\u0916 \u091c\u093f\u0925\u0947 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0905\u0938\u0947\u0932 \u0924\u093f\u0925\u0947 \u0935\u093e\u092a\u0930\u0932\u0940 \u091c\u093e\u0924\u0947.",protectedAccess:"\u092a\u094d\u0930\u0935\u0947\u0936 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924",protectedDesc:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0906\u0923\u093f \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092d\u0942\u092e\u093f\u0915\u093e, \u0938\u0915\u094d\u0930\u093f\u092f \u0938\u0924\u094d\u0930\u0947, OTP \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0906\u0923\u093f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0943\u0924 API \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u0935\u093f\u092d\u0915\u094d\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.",checklist:"\u0924\u0941\u092e\u091a\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f",checklistItem1:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u0916\u0930\u0947 \u0928\u093e\u0935 \u0926\u093e\u0916\u0935\u093e\u092f\u091a\u0947 \u0928\u0938\u0947\u0932 \u0924\u0947\u0935\u094d\u0939\u093e \u0938\u092e\u0941\u092a\u0926\u0947\u0936\u0915 \u0938\u0902\u0935\u093e\u0926\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0947 \u0905\u0928\u093e\u092e\u093f\u0924 \u0928\u093e\u0935 \u0935\u093e\u092a\u0930\u093e.",checklistItem2:"\u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u092a\u0930\u094d\u0915 \u0906\u0923\u093f \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u091a\u0947 \u0924\u092a\u0936\u0940\u0932 \u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u0930\u093e\u092f\u091a\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0905\u091a\u0942\u0915 \u0920\u0947\u0935\u093e.",checklistItem3:"\u0915\u0949\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u