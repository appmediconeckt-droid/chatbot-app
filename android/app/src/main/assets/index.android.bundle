5\u093e",p156tq0x:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u0908\u092e\u0947\u0932 \u090f\u0902\u091f\u0930 \u0915\u0930\u093e",p1es6jgh:"\u0908\u092e\u0947\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",p1ncbamm:"\u0939\u0941\u092e\u0932\u0940 - \u0924\u0941\u092e\u091a\u0947 \u092e\u093e\u0928\u0938\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f",p1mkbgjw:"\u092e\u093e\u0928\u0935 \u0905\u0927\u093f\u0915\u093e\u0930\u092a\u094d\u0930\u093e\u092a\u094d\u0924",p67t5ik:"\u092e\u093e\u0928\u0938\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0938\u092e\u0930\u094d\u0925\u0928",p15kdwif:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u093e\u0928\u0938\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u0920\u0940\u0923 \u0915\u093e\u0933\u093e\u0924 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930, \u092e\u093e\u0928\u0938\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u091c\u094d\u091e, \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u092a\u094d\u0930\u0945\u0915\u094d\u091f\u093f\u0936\u0928\u0930\u094d\u0938 \u0906\u0923\u093f \u092e\u093e\u0928\u0938\u094b\u092a\u091a\u093e\u0930 \u0924\u091c\u094d\u091c\u094d\u091e\u093e\u0902\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940",puqjq8w:"\u0924\u0941\u092e\u091a\u0940 \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0902\u0936\u0940 \u091c\u0941\u0933\u0923\u0940 \u0915\u0930\u093e",pglw0op:"\u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u093e",pdkk7ab:"\u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0906\u0927\u093e\u0930",p6s9e29:"\u091c\u0935\u0933\u092a\u093e\u0938\u091a\u094d\u092f\u093e \u0930\u0941\u0917\u094d\u0923\u093e\u0902\u0928\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u093e",p1kc2xvx:"\u0938\u094d\u0925\u093e\u0928 \u0915\u093e\u092f\u092e\u091a\u0947 \u0905\u0935\u0930\u094b\u0927\u093f\u0924 \u0915\u0947\u0932\u0947. \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0909\u0918\u0921\u093e \u2192 \u092f\u093e \u0972\u092a\u0938\u093e\u0920\u0940 \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u093e, \u0928\u0902\u0924\u0930 \u092a\u0930\u0924 \u092f\u093e.",pj1z8my:"\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0936\u093f\u0935\u093e\u092f, \u091c\u0935\u0933\u092a\u093e\u0938\u091a\u094d\u092f\u093e \u0930\u0941\u0917\u094d\u0923\u093e\u0902\u0928\u093e \u0924\u0941\u092e\u091a\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u093e\u092a\u0921\u0923\u093e\u0930 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0916\u093e\u0924\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u0924\u093e \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0905\u0938\u0947\u0932. \u0915\u0943\u092a\u092f\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u094d\u092f\u093e.",pe2sfkx:"\u0938\u094d\u0925\u093e\u0928 \u0905\u0926\u094d\u092f\u093e\u092a \u0905\u0935\u0930\u094b\u0927\u093f\u0924 \u0906\u0939\u0947. \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0926\u0943\u0936\u094d\u092f\u092e\u093e\u0928\u0924\u093e \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092f\u093e\u0902\u0938\u093e\u0930\u0916\u0940 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u092f\u094b\u0917\u094d\u092f\u0930\u093f\u0924\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924.",p1bc8b0q:"\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0936\u093f\u0935\u093e\u092f \u0924\u0941\u092e\u094d\u0939\u0940 \u091c\u0935\u0933\u092a\u093e\u0938\u091a\u0947 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930, \u0916\u093e\u0924\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e \u0906\u0923\u093f \u0906\u0923\u0940\u092c\u093e\u0923\u0940 \u0938\u092e\u0930\u094d\u0925\u0928 \u0917\u092e\u093e\u0935\u093e\u0932. \u0915\u0943\u092a\u092f\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u094d\u092f\u093e.",p1kxnr6x:"\u0938\u094d\u0925\u093e\u0928 \u0905\u0926\u094d\u092f\u093e\u092a \u0905\u0935\u0930\u094b\u0927\u093f\u0924 \u0906\u0939\u0947. \u091c\u0935\u0933\u092a\u093e\u0938\u091a\u0947 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0906\u0923\u093f \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0939\u093e\u092f\u094d\u092f \u092f\u093e\u0902\u0938\u093e\u0930\u0916\u0940 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u092f\u094b\u0917\u094d\u092f\u0930\u093f\u0924\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924.",p1qfkxpw:"\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0909\u0918\u0921\u093e",p19izdw2:"\u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0930\u0924 \u0906\u0939\u0947...",pudz60s:"\u0938\u094d\u0925\u093e\u0928 \u092e\u093f\u0933\u0935\u0924 \u0906\u0939\u0947...",p1nyz8sj:"\ud83d\udd04 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",p129dr11:"\ud83d\udccd \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0938 \u0905\u0928\u0941\u092e\u0924\u0940 \u0926\u094d\u092f\u093e",p13kffw5:"\u0938\u094d\u0925\u093e\u0928\u093e\u0936\u093f\u0935\u093e\u092f \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e",pr2p72l:"\u0938\u094d\u0925\u093e\u0928\u093e\u091a\u0940 \u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0947\u0932\u0940",pi9375l:"\u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u093e",p1xmhdqy:"\u0915\u093e\u0939\u0940 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0938\u094d\u0925\u093e\u0928\u093e\u0936\u093f\u0935\u093e\u092f \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u0906\u092e\u094d\u0939\u0940 \u0924\u0947 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u091c\u094b\u0930\u0926\u093e\u0930 \u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0930\u0924\u094b.",p1ismk4q:"\u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u0905\u0928\u0941\u092d\u0935\u093e\u0938\u093e\u0920\u0940, \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0938 \u0905\u0928\u0941\u092e\u0924\u0940 \u0926\u094d\u092f\u093e. \u0939\u0947 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0940 \u091a\u093e\u0902\u0917\u0932\u0940 \u0938\u0947\u0935\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0923\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0924\u0947.",p1rsaitz:"\u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094d\u0925\u093e\u0928\u093e\u091a\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0915\u093e \u0906\u0939\u0947",p1lwhuaj:"\ud83d\udd10 \u0924\u0941\u092e\u094d\u0939\u0940 \u0972\u092a \u0935\u093e\u092a\u0930\u0924 \u0905\u0938\u0924\u093e\u0928\u093e\u091a \u0924\u0941\u092e\u091a\u0947 \u0938\u094d\u0925\u093e\u0928 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0924\u0947. \u0924\u0947 \u0915\u0927\u0940\u0939\u0940 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937\u093e\u0902\u0938\u0939 \u0935\u093f\u0915\u0932\u0947 \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940.",pi5yj9e:"\u0935\u0917\u0933\u0923\u0947 \u0924\u0941\u092e\u091a\u093e \u0905\u0928\u0941\u092d\u0935 \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0932. \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c\u092e\u0927\u094d\u092f\u0947 \u0915\u0927\u0940\u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",p1h299pn:"\u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u093e",punxvbe:"\u092e\u093e\u091d\u0940 \u0906\u0920\u0935\u0923 \u0920\u0947\u0935\u093e",p1djn4vs:"\u092e\u0947\u0932-\u0913\u092a\u0928-\u0906\u0909\u091f\u0932\u093e\u0907\u0928",p9joi0e:"\u092b\u094b\u0928-\u092a\u094b\u0930\u094d\u091f\u094d\u0930\u0947\u091f-\u0906\u0909\u091f\u0932\u093e\u0907\u0928",pcm1nee:"\u0924\u0947 \u0924\u0941\u092e\u094d\u0939\u0940\u091a \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",p39qlxn:"\u0938\u0924\u094d\u0930 \u0938\u0902\u0918\u0930\u094d\u0937 \u0906\u0922\u0933\u0932\u093e",p1nl6f5:"\u0906\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932\u0935\u0930 6-\u0905\u0902\u0915\u0940 \u0915\u094b\u0921 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u0940 \u0907\u0924\u0930 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0947\u0938 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u092a\u0941\u0922\u0947 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0947 \u0916\u093e\u0932\u0940 \u090f\u0902\u091f\u0930 \u0915\u0930\u093e.",p8ykf5k:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0906\u0927\u0940\u091a \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947. \u092f\u093e\u0935\u0930 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0915\u0930\u093e.",p18vcp24:"OTP \u092a\u093e\u0920\u0935\u0924 \u0906\u0939\u0947...",p1ntvp8x:"\u0907\u0924\u0930 \u0909\u092a\u0915\u0930\u0923\u0947 \u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u093e \u0906\u0923\u093f OTP \u092a\u093e\u0920\u0935\u093e",pn5i6fn:"6-\u0905\u0902\u0915\u0940 OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",p12n3zp8:"\u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0930\u0924 \u0906\u0939\u0947...",pohmzat:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924 \u0906\u0939\u0947...",p1e6s4y0:"\u0908\u092e\u0947\u0932\u0928\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u093e",p1aafagh:"\u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e",pasmu26:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e Humaeli \u0915\u0938\u0947 \u0935\u093e\u092a\u0930\u093e\u092f\u091a\u0947 \u0924\u0947 \u0928\u093f\u0935\u0921\u093e",pqh0i9l:"\u092a\u094b\u0930\u094d\u091f\u0932 \u0928\u093f\u0935\u0921\u093e",pyjrj1w:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e",p1rlv5t:"\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e",p19cu11q:"\u0924\u0941\u092e\u091a\u093e \u0938\u0930\u093e\u0935 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",pbe3qyw:"\u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0915\u093e\u0933\u091c\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u093e",p1d9tqw:"\u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921 \u090f\u0928\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921",p1696fig:"\u092c\u094b\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091c\u093e\u0917\u093e",p14mamw2:"\u0916\u093e\u091c\u0917\u0940, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u093e\u0924 \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u093e\u0930\u094d\u0939 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0902\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e \u091c\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u093e\u0928\u0938\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f\u093e\u0938 \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u0947\u0932\u0947\u0932\u0947 \u0906\u0939\u0947.",p16mi6u6:"\u092f\u094b\u0917\u094d\u092f \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u0936\u094b\u0927\u093e",pcyp7gf:"\u0916\u093e\u0938\u093f\u092f\u0924, \u092d\u093e\u0937\u093e, \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e, \u0938\u0932\u094d\u0932\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0906\u0923\u093f \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928\u093e\u0902\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0905\u0928\u0941\u092d\u0935\u0940 \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930 \u092c\u094d\u0930\u093e\u0909\u091d \u0915\u0930\u093e.",p1j7paqb:"\u0924\u0941\u092e\u091a\u093e \u090f\u0906\u092f \u0935\u0947\u0932\u0928\u0947\u0938 \u0938\u093e\u0925\u0940",p235k91:"\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0915\u0927\u0940\u0939\u0940 \u0924\u094d\u0935\u0930\u093f\u0924 \u092d\u093e\u0935\u0928\u093f\u0915 \u0906\u0927\u093e\u0930, \u0906\u0930\u094b\u0917\u094d\u092f \u091f\u093f\u092a\u093e \u0906\u0923\u093f \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092e\u093f\u0933\u0935\u093e.",p12cl72e:"\u0928\u092e\u0938\u094d\u0915\u093e\u0930 \ud83d\udc4b \u0906\u091c \u0915\u0938\u0947 \u0935\u093e\u091f\u0924 \u0906\u0939\u0947?",pz0a21k:"\u092a\u0941\u0938\u094d\u0924\u0915, \u0917\u092a\u094d\u092a\u093e \u0906\u0923\u093f \u092c\u0930\u0947",pahuuzy:"\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f\u094d\u0938 \u0936\u0947\u0921\u094d\u092f\u0941\u0932 \u0915\u0930\u093e, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0938\u0947\u0936\u0928\u092e\u0927\u094d\u092f\u0947 \u0938\u093e\u092e\u0940\u0932 \u0935\u094d\u0939\u093e, \u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930\u093e\u0902\u0936\u0940 \u091a\u0945\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u0906\u0930\u094b\u0917\u094d\u092f \u092a\u094d\u0930\u0935\u093e\u0938 \u091f\u094d\u0930\u0945\u0915 \u0915\u0930\u093e\u2014\u0938\u0930\u094d\u0935 \u090f\u0915\u093e\u091a \u0920\u093f\u0915\u093e\u0923\u0940.",pefpvkx:"\u092a\u0941\u0938\u094d\u0924\u0915 \u0938\u0924\u094d\u0930\u0947",pvu2nj9:"\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932",p1dfp17w:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0917\u092a\u094d\u092a\u093e",pz29fz2:"\u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921",prcdi82:"#cbd5e1",p8cqkqc:"#00652C",pyj27bj:"\u0915\u093e\u0939\u0940\u0939\u0940 \u0928\u093e\u0939\u0940",pyivru2:"\u0911\u091f\u094b",pdfz3q4:"\u092f\u0947\u0925\u0947 \u0928\u0935\u0940\u0928?",plg5b3z:"\u0906\u0927\u0940\u091a \u0938\u093e\u092e\u0940\u0932 \u091d\u093e\u0932\u0947?",p86so6m:"\u0935\u0930 \u092a\u093e\u0920\u0935\u0932\u0947\u0932\u093e \u0915\u094b\u0921 \u090f\u0902\u091f\u0930 \u0915\u0930\u093e",pwma7ac:"\u0906\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093