438\u043c\u0430\u0442\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0443 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0442\u0430 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f.",security:"\u0411\u0435\u0437\u043f\u0435\u043a\u0430 \u0442\u0430 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443",securityDesc:"\u041c\u0430\u0440\u043a\u0435\u0440\u0438 \u0432\u0445\u043e\u0434\u0443, \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a \u0430\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457, \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u0430\u0440\u043e\u043b\u044f, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u043e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u043f\u0430\u0440\u043e\u043b\u044f, \u0440\u043e\u043b\u044c \u0456 \u0441\u0442\u0430\u0442\u0443\u0441 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0449\u043e\u0431 \u0440\u043e\u0437\u0434\u0456\u043b\u044f\u0442\u0438 \u0442\u0430 \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438 \u0437\u043e\u043d\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0442\u0430 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u0430.",whoCanSee:"\u0425\u0442\u043e \u0449\u043e \u043c\u043e\u0436\u0435 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438",visibleToYou:"\