6d4",otpProtectedDesc:"\u0627\u06cc \u0645\u06cc\u0644 \u0627\u0648\u0631 \u0641\u0648\u0646 \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba",anonymousCare:"\u06af\u0645\u0646\u0627\u0645 \u062f\u06cc\u06a9\u06be \u0628\u06be\u0627\u0644 \u06a9\u06cc \u0634\u0646\u0627\u062e\u062a",anonCareDesc:"\u0645\u0634\u06cc\u0631\u0648\u06ba \u06a9\u0648 \u062f\u06a9\u06be\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u062c\u06c1\u0627\u06ba \u062a\u0639\u0627\u0648\u0646 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4",sensitiveAreas:"\u062d\u0633\u0627\u0633 \u0639\u0644\u0627\u0642\u06d2",sensitiveAreasDesc:"\u0686\u06cc\u0679\u0633\u060c \u06a9\u0627\u0644\u0632\u060c \u0645\u0644\u0627\u0642\u0627\u062a\u06cc\u06ba\u060c \u067e\u0631\u0648\u0641\u0627\u0626\u0644",dataUsedTitle:"\u0627\u06cc\u067e \u0645\u06cc\u06ba \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0688\u06cc\u0679\u0627",profileHealth:"\u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0627\u0648\u0631 \u0635\u062d\u062a \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a",profileHealthDesc:"\u0622\u067e \u06a9\u0627 \u0646\u0627\u0645\u060c \u06af\u0645\u0646\u0627\u0645 \u0688\u0633\u067e\u0644\u06d2 \u0646\u0627\u0645\u060c \u0639\u0645\u0631\u060c \u062c\u0646\u0633\u060c \u0631\u0627\u0628\u0637\u06d2 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a\u060c \u062a\u0635\u0648\u06cc\u0631/\u0627\u0648\u062a\u0627\u0631\u060c \u067e\u062a\u06c1\u060c \u06c1\u0646\u06af\u0627\u0645\u06cc \u0631\u0627\u0628\u0637\u06c1\u060c \u0628\u0646\u06cc\u0627\u062f\u06cc \u0637\u0628\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a\u060c \u0627\u0648\u0631 \u0627\u0646\u0634\u0648\u0631\u0646\u0633 \u0641\u06cc\u0644\u0688\u0632 \u0622\u067e \u06a9\u06d2 \u0645\u0631\u06cc\u0636 \u06a9\u06cc \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u0648 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\