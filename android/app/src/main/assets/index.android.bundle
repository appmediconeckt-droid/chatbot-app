927 \u091a\u093f\u0928\u094d\u0939 \u0932\u0917\u093e\u0909\u0928 \u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u092a\u093e\u0924\u094d\u0930\u094b \u092e\u093f\u0924\u093f\u092e\u093e \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964",pdb3gsb:"\uff0b \u0905\u0930\u094d\u0915\u094b \u0926\u093e\u092f\u0930\u093e \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d",ptlv9yc:"\u091a\u092f\u0928 \u0917\u0930\u093f\u090f\u0915\u093e \u092e\u093f\u0924\u093f\u0939\u0930\u0942\u092e\u093e \u0906\u0935\u0947\u0926\u0928 \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d",ppauift:"\u0906\u0935\u0930\u094d\u0924\u0940 \u0928\u093f\u092f\u092e\u0939\u0930\u0942",p1ok5rb6:"\u0926\u093f\u0928\u0939\u0930\u0942 \u091a\u092f\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pd2mie6:"\u091a\u0941\u0928\u093f\u090f\u0915\u093e \u0926\u093f\u0928\u0939\u0930\u0942\u092e\u093e \u092f\u0940 \u0938\u092e\u092f\u0939\u0930\u0942 \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0930\u0942\u092a\u092e\u093e \u0926\u094b\u0939\u094b\u0930\u094d\u092f\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d\u0964",p1w4873t:"\u0939\u092a\u094d\u0924\u093e \u0926\u093f\u0928\u0939\u0930\u0942\u092e\u093e \u0932\u093e\u0917\u0942 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",p1d59uan:"\u0938\u094d\u0932\u091f \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 -",pyulex9:"\u0905\u0939\u093f\u0932\u0947\u0938\u092e\u094d\u092e \u0915\u0941\u0928\u0948 \u0938\u094d\u0932\u091f\u0939\u0930\u0942 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u092d\u090f\u0915\u094b \u091b\u0948\u0928\u0964 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0915\u0928\u094d\u092b\u093f\u0917\u0930 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0930 \u091f\u094d\u092f\u093e\u092a \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",pr902bd:"\u0938\u094d\u0932\u091f\u0939\u0930\u0942 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u09