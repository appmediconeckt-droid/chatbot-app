    "p8lq2oq": "புதுப்பிப்புகளைச் சரிபார்க்கவும்",
    "pg6nyxd": "எண்ட்-டு-எண்ட் என்க்ரிப்ஷன்",
    "pm4qf9j": "GDPR சான்றளிக்கப்பட்ட அணுகல்",
    "p13tbyt3": "அநாமதேய ஆலோசனை",
    "p1474pj6": "பாதுகாப்பான பணப்பை பரிவர்த்தனைகள்",
    "p12ddn6e": "தனிப்பட்ட சுயவிவரம்",
    "p178beh": "பெயர், வயது மற்றும் பாலினம்",
    "p1el3mqv": "தொடர்பு விவரங்கள்",
    "p1uqyawh": "சுகாதார விருப்பத்தேர்வுகள்",
    "p1j5drmg": "உங்கள் பராமரிப்பு அனுபவத்தைத் தனிப்பயனாக்குங்கள்",
    "p1hshih": "சரியான ஆலோசகருடன் உங்களைப் பொருத்துங்கள்",
    "p4lwpxb": "அரட்டைகள் & அழைப்புகள்",
    "p16o5duv": "செய்திகள் மற்றும் விரைவான பதில்கள்",
    "pjualou": "அரட்டை நிலை மற்றும் இணைப்புகள்",
    "p8fcohj": "ஏற்றுக்கொள்ளப்பட்ட அரட்டை அமர்வுகள்",
    "pqugyus": "தொடர்ச்சியான உரையாடல் வரலாற்றை வழங்கவும்",
    "pxw259e": "அமர்வுகளின் போது ஆலோசகர் ஆதரவை இயக்கவும்",
    "ppapyhl": "நியமனங்கள்",
    "ppjebc6": "முன்பதிவு தேதி மற்றும் நேரம்",
    "prz84q3": "தேர்ந்தெடுக்கப்பட்ட ஆலோசகர்",
    "p6bzi8o": "அமர்வு குறிப்புகள்",
    "pfby3q4": "உங்கள் வரவிருக்கும் அமர்வுகளை நிர்வகிக்கவும்",
    "p1px010k": "சரியான நேரத்தில் நினைவூட்டல்களை அனுப்பவும்",
    "pl6oj3n": "பணப்பை & பரிவர்த்தனைகள்",
    "pcisb5n": "ரீசார்ஜ் மற்றும் கட்டண வரலாறு",
    "p11x8ws5": "பணத்தைத் திரும்பப்பெறும் பதிவுகள்",
    "p1jezb8u": "பரிவர்த்தனை ரசீதுகள்",
    "p1kxmxol": "பணம் செலுத்துவதைப் பாதுகாப்பாகச் செயல்படுத்தவும்",
    "p1soeejn": "துல்லியமான பில்லிங் வரலாற்றை பராமரிக்கவும்",
    "p3fb3fk": "உங்கள் தரவை அணுகவும்",
    "paxx0ja": "உங்களைப் பற்றிய Humaeli தனிப்பட்ட தரவின் நகலைக் கேட்கவும்.",
    "py8xd5m": "உங்கள் தரவை சரிசெய்யவும்",
    "pg1ugci": "எந்த நேரத்திலும் உங்கள் சுயவிவரத்திலிருந்து தவறான அல்லது காலாவதியான விவரங்களைப் புதுப்பிக்கவும்.",
    "p13743po": "உங்கள் கணக்கை நீக்கவும்",
    "p12l9hlj": "உங்கள் கணக்கு மற்றும் தொடர்புடைய தனிப்பட்ட தரவை அழிக்கக் கோரவும்.",
    "pqqlbs9": "ஒப்புதலை திரும்பப் பெறவும்",
    "p7r950p": "முக்கிய அம்சங்களுக்கான அணுகலை இழக்காமல் விருப்ப செயலாக்கத்தை நிறுத்தவும்.",
    "ph7kh1q": "ஒரு குறையை எழுப்புங்கள்",
    "pikxi8f": "சுயவிவரத்தை நிர்வகிக்கவும்",
    "pr4om3a": "விவரங்களைப் புதுப்பிக்கவும்",
    "pwprq2e": "பாதுகாப்பு அமைப்புகள்",
    "p16wv544": "கடவுச்சொற்கள் & OTP",
    "pot76bn": "தனியுரிமைக் கொள்கை",
    "p10c9lnf": "உங்கள் தனிப்பட்ட தகவலை Humaeli எவ்வாறு சேகரிக்கிறது, பயன்படுத்துகிறது மற்றும் பாதுகாக்கிறது என்பதை அறிக",
    "pbsv2pb": "பாதுகாக்கப்பட்டது",
